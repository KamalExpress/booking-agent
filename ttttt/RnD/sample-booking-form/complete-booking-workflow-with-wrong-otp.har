abel for=\"appointmentmethod\">Allocation method</label>\r\n                <select name=\"appointmentmethod\" id=\"appointmentmethod\" class=\"form-control\"\r\n                        placeholder=\"Select an option\">\r\n                    <option value=\"1\" >Same time</option>\r\n                    <option value=\"2\" >Consecutive time slots</option>\r\n                    <option value=\"3\" >Next available slots</option>\r\n                    <option value=\"4\" >Select one by one</option>\r\n                </select>\r\n            </td>\r\n            <td style=\"width:20%;vertical-align: top;padding-left: 10px;\" >\r\n                <div class=\"form-button-wrapper\">\r\n                <button type=\"button\"\r\n                      id=\"btn-search\" class=\"btn blue\" form=\"appointment\"\r\n                      onclick=\"selectPeriodslot(this);\"\r\n                      ><span>Search</span></button>\r\n                </div>\r\n            </td>\r\n        </tr>\r\n      </table>\r\n        <div style=\"width:50%;float:right;padding-top:30px;\" class=\"form-item\" >\r\n          <div id=\"appointmentmethodDetails1\" class=\"form-item hidden\"><strong>Same time</strong>: Select this option if you want to book appointments for all members of the group at exactly the same time. If there is no availability, please select another allocation method.</div>\r\n          <div id=\"appointmentmethodDetails2\" class=\"form-item hidden\"><strong>Consecutive time slots</strong>: Select this option if you want to book appointments at consecutive time slots so all members of the group are served one after the other, e.g. 09:00, 09:15 etc. If there is no availability, please select another allocation method.</div>\r\n          <div id=\"appointmentmethodDetails3\" class=\"form-item hidden\"><strong>Next available slots</strong>: Select this option if you want to book the earliest appointments for all members of the group at time slots close to each other. If there is no availability, please select another allocation method.</div>\r\n          <div id=\"appointmentmethodDetails4\" class=\"form-item hidden\"><strong>Select one by one</strong>: Select this option if you want to select time slots for each member of the group.</div>\r\n        </div>\r\n      </div>\r\n\r\n      \r\n\r\n      <div id=\"resultMessage\" class=\"appointment_alert appointment_alert-danger hidden\">You cannot book an appointment on this date. Please choose another date.</div>\r\n\r\n      <div id=\"appointment_box\" class=\"hidden\">\r\n\r\n          <h4 style='padding: 10px 0px 10px 0px;'>To complete your reservation press BOOK APPOINTMENT from below</h4>\r\n      <!--<h4 th:text=\"#{appointments.choosetip}\" style='padding: 15px 0px 20px 0px;font-weight: 700;'>Choose available dates</h4>-->\r\n\r\n      <div class=\"appointment_box\" >\r\n\r\n        <div id=\"split-main\">\r\n            <!-- TABS -->\r\n            \r\n                <nav id=\"form-tabs\">\r\n                    <ul>\r\n                        <li id=\"tab-monday\" class=\"active\" ><span class=\"menu-label\">Monday</span> </li>\r\n                        <li id=\"tab-tuesday\" ><span class=\"menu-label\">Tuesday</span> </li>\r\n                        <li id=\"tab-wednesday\" ><span class=\"menu-label\">Wednesday</span> </li>\r\n                        <li id=\"tab-thursday\" ><span class=\"menu-label\">Thursday</span> </li>\r\n                        <li id=\"tab-friday\" ><span class=\"menu-label\">Friday</span> </li>\r\n                        <li id=\"tab-saturday\" ><span class=\"menu-label\">Saturday</span> </li>\r\n                        <li id=\"tab-sunday\" ><span class=\"menu-label\">Sunday</span> </li>\r\n                    </ul>\r\n                </nav>\r\n            \r\n            <div id=\"main-area\"  class=\"tabs-monday\" style=\"padding: 10px !important\">\r\n                <table style=\"border-width: 0px\">\r\n                    <tr>\r\n                        <td style=\"width: 50%; border-right: 2px solid #cfcfcf; padding-right: 10px; vertical-align: top\">\r\n                              <div class=\"form-item\" id=\"resultDiv\">\r\n\r\n                              </div>\r\n                        </td>\r\n                        <td style=\"width: 50%;text-align: center; line-height: 2; vertical-align: top\">\r\n                            <div class=\"info_area\">\r\n\r\n                                <div style=\"border:#22BC66 solid;background-color:white;color:#22BC66;\">Available appointments</div>\r\n                                <div style=\"border:#773838 solid;background-color:#D1D1D1;color:#fff;\">Booked appointments</div>\r\n                                <br/>\r\n                                <br/>\r\n                                <div>You have chosen to book appointment(s) on</div>\r\n                                <div style=\"font-weight: bold\"><span id=\"selectedDateMsg\" style=\"text-decoration: underline\">26/07/2026</span> <span>at</span>\r\n                                <span id=\"selectedTimeMsg\" style=\"text-decoration: underline\"><span></span></span> </div>\r\n\r\n                            <div id='alertmsg' class=\"appointment_alert appointment_alert-warning\">Please select time slot to proceed with your reservation.</div>\r\n\r\n\r\n                            <div>Please press BOOK APPOINTMENT from below to complete your reservation.</div>\r\n\r\n                            <div style=\"padding-top: 50px\"><strong>* All time zones refer to our office local time</strong></div>\r\n                            </div>\r\n                        </td>\r\n                    </tr>\r\n                </table>\r\n\r\n                <div id=\"btn-onetimepassword-wrap\" class=\"form-item nolabel\">\r\n                    <button id=\"btn-onetimepassword\" class=\"btn blue\" type=\"button\" onclick=\"sendOTP()\"\r\n                            data-redirect=\"stay\" >\r\n                        <span><span>Request OTP code (via Mobile) for Appointment</span></span>\r\n                    </button>\r\n                </div>\r\n\r\n                <div class=\"form-button-wrapper\">\r\n                            <div  class='form-item required' style=\"padding-top:10px;\">\r\n                                <span id=\"submissiontext\" style=\"background-color: #fff !important;font-weight: bold\">I have read and accepted the <a target=\"_blank\" href=\"https://pk-gr.gvcworld.eu/en/terms-of-use\"><u>Terms of Use</u></a> and <a target=\"_blank\" href=\"https://pk-gr.gvcworld.eu/en/privacy-policy-gdpr-compliance\"><u>Privacy Policy</u></a></span>\r\n                                <input type=\"checkbox\" id=\"submitinfo\" name=\"submitinfo\" class='form-control'/>\r\n                                <input type=\"hidden\" id='submissionMsgCheck' name='submissionMsgCheck' value=\"Make sure that you have checked the required checkbox\" />\r\n                            </div>\r\n                   \r\n                    <button type=\"button\"\r\n                          id=\"btn-new-appointment\" class=\"btn blue\" form=\"appointment\"\r\n                            onclick=\"checkAmount(this, &#39;post&#39;)\" data-submit=\"/appointments\" data-redirect=\"stay\"\r\n                          ><span>Book your appointment</span></button>\r\n\r\n                    <!-- th:onclick=\"${appointment == null} ? 'test(this, \\'post\\')' : 'test(this, \\'put\\')'\" -->\r\n\r\n                </div>\r\n\r\n\r\n                <div  id=\"onetimepassword-wrap\" class=\"form-item nolabel\">\r\n                    <input type=\"text\" id=\"onetimepassword\"  class=\"tc noupper\" name=\"onetimepassword\" placeholder=\"Enter the OTP code\"\r\n                           autocapitalize=\"none\"/>\r\n                </div>\r\n                <div class=\"form-item resetrequired\" >\r\n                  <br/>\r\n                      <div id=\"recaptcha\" class=\"g-recaptcha\" data-sitekey=\"6LcnlCoUAAAAAJLjWXXaByTFyuOLf4K0gGu5r3d2\" data-lang=\"en\">\r\n                      </div>\r\n<!--                      <div th:if=\"${recaptcha != null && !recaptcha}\" id=\"recaptcha\" class=\"cf-turnstile\" th:attr=\"data-sitekey=${recaptchakeysite},data-lang=${recaptchalanguage!=null? recaptchalanguage : 'en'}\">-->\r\n<!--                      </div>-->\r\n                </div>\r\n\r\n\r\n\r\n\r\n             </div>\r\n            </div>\r\n        </div>\r\n      </div>\r\n    </form>\r\n\r\n  </div>\r\n\r\n</div>"
