ch(function (filter) {\r\n                    var filtersPair = filter.split('|');\r\n                    if (filtersPair[1] !== undefined){\r\n                      filtersDataParams += filtersPair[0] + '=' + filtersPair[1] + '&';\r\n                    }else{\r\n                      filtersDataParams += filtersPair[0] + '=' + $(\"#\"+filtersPair[0]).val() + '&';\r\n                    }\r\n                });\r\n                filtersDataParams += 'filterable=' + filtersIdValue + '&';\r\n            }\r\n        }\r\n\r\n        // set the ajax url\r\n\r\n        var $dataSubmit = $('#main-area-modal').find('#navigation');\r\n        var urlSubmit = (isModal && $dataSubmit.length > 0) ? $dataSubmit.val() : location.pathname;\r\n\r\n        var postData = filtersDataParams + pageable;\r\n\r\n        $.ajax({\r\n            url: urlSubmit,\r\n            type: 'POST',\r\n            data: postData\r\n        }).done(function (data, textStatus, jqXHR) {\r\n            setTimeout(function () {\r\n                isModal ? $('#mc-inner').html(data) : $('#main-wrapper').children('main').html(data);\r\n                enableSelect2();\r\n                tooltip();\r\n\r\n                $('.datepicker').datepicker({\r\n                    dateFormat: 'dd/mm/yy',\r\n                    locale: 'en',\r\n                    changeYear: true,\r\n                    changeMonth: true,\r\n                    todayHighlight: true,\r\n                    yearRange: '1910:2040',\r\n                    endDate: new Date(),\r\n                    beforeShowDay: function (date) {\r\n                        var $this = $(this);\r\n                        if (!$this.hasClass('lock-before-today') && !$this.hasClass('enable-today')) {\r\n                            var doNothing = true;\r\n                            return [doNothing];\r\n                        }\r\n\r\n                        let afterdays = $this.attr(\"afterdays\");\r\n                        if (afterdays === undefined || afterdays === '') {\r\n                            afterdays = 0;\r\n                        }              \r\n                        var datepickerString = jQuery.datepicker.formatDate('yy-mm-dd', date);\r\n                        var datepickerDate = new Date(datepickerString);\r\n                        var today = new Date();        \r\n                        if ($this.hasClass('enable-today')){\r\n                            today.setDate(today.getDate() - 1); \r\n                        }\r\n                        today.setDate(today.getDate() + parseInt(afterdays));\r\n                        var isGreaterThanToday = datepickerDate.getTime() > today;\r\n                        return [isGreaterThanToday];\r\n                    },\r\n                    onClose: function () {\r\n                      var $this = $(this);\r\n                      $this.parsley().validate();\r\n\r\n                      // statically added error\r\n                      if ($this.hasClass('benderr')) {\r\n                        $this.parsley().removeError(this.id);\r\n                        $this.removeClass('benderr');\r\n                        ubi.var.showErrorsOnTabs();\r\n                      }\r\n                    }\r\n                  });\r\n\r\n                enableDropdownLinks();\r\n                isModal ? ubi.loader.modal.stop() : ubi.loader.nonBlocking.stop();\r\n            }, 300);\r\n        });\r\n    };\r\n\r\n    table.sort = sort;\r\n\r\n})(tb);\r\n\n/**\r\n * Paging js for table list views\r\n */\r\n\r\n(function (table) {\r\n\r\n    \"use strict\";\r\n\r\n    var page = function(pageNumber, listSize, sortParam) {\r\n        var isModal = $('html').hasClass('modal');\r\n        isModal ? ubi.loader.modal.start() : ubi.loader.nonBlocking.start();\r\n        !$('#content-wrapper').hasClass('no-scroll') ? window.scrollTo(0, 0) : null;\r\n\r\n        //if more than one sorted fields\r\n        if (sortParam.indexOf(\",\")>0){\r\n            //eg from allrequiredcompleted: ASC,completed: ASC --> allrequiredcompleted,completed: ASC\r\n            //split fields\r\n            var fields = sortParam.split(\",\");\r\n            sortParam = \"\";\r\n            for (var i=0;i<fields.length-1;i++){\r\n                sortParam += fields[i].split(\":\")[0]+\",\";\r\n            }\r\n            sortParam += fields[fields.length-1];\r\n        }\r\n\r\n        var pageable = 'page=' + pageNumber + '&size=' + listSize + '&sort=' + sortParam.replace(': ', ',');//.toLowerCase();\r\n        var filtersDataParams = '';\r\n\r\n        var $this = $('.filter-wrapper').children('form').find('button.tbfilter');        \r\n        if ($this.length <= 0) {\r\n          $this = $('.filter-wrapper').find('button.tbfilter');         \r\n        }\r\n        if ($this.length > 0) {\r\n            var formID = $this.attr('form');\r\n\r\n            if (formID === undefined) {\r\n                alertify.error(ubi.getTranslationExt(\"frontend.message.error.1\")); // \"Something went wrong. Please contact the system administrator\"\r\n                throw new TypeError(\"No form attribute found\");\r\n            }\r\n\r\n            var $form = $('form#' + formID);\r\n            if ($form.length === 0) {\r\n                throw new TypeError(\"No form found with id='\" + formID + \"'\");\r\n            }\r\n\r\n//            var filtersData = $form.serializeJSON(serializeJSON_OPTIONS);\r\n//            var filtersDataTemp = Object.assign({}, filtersData);\r\n//\r\n//            for (var v in filtersDataTemp) {\r\n//              filtersDataParams += v + '=' + filtersDataTemp[v] + '&';\r\n//            }\r\n\r\n            var $filtersId = $form.find('input#filterable');           \r\n            if ($filtersId.length > 0) {\r\n                var filtersIdValue = $filtersId.val();\r\n                var filters = filtersIdValue.split('-');\r\n                filters.forEach(function (filter) {                  \r\n     