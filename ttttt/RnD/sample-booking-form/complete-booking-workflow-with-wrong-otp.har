                        }\n                            $btn.removeClass('loading');\n                            isModal ? ubi.loader.modal.stop() : ubi.loader.nonBlocking.stop();\n                        }, ubi.loader.blocking.loadingTime);\n                        \n                    } else {\n                        \n                        setTimeout(function () {\n                            page(redirect);\n                            alertify.success(data.message);\n\n                            $btn.removeClass('loading');\n                            isModal ? ubi.loader.modal.stop() : ubi.loader.nonBlocking.stop();\n                        }, ubi.loader.blocking.loadingTime);\n                    }\n                } else {\n                    \"message\" in data ? alertify.error(data.message) : alertify.error(ubi.getTranslationExt(\"frontend.message.error.1\")); // \"Something went wrong. Please contact the system administrator.\"\n                    $btn.removeClass('loading');\n                    isModal ? ubi.loader.modal.stop() : ubi.loader.nonBlocking.stop();\n                }\n                ubi.loader.blocking.stop();\n            }).error(function (data, textStatus, jqXHR) {\n                logger.e(status);\n                logger.e(data);\n                alertify.error(ubi.getTranslationExt(\"frontend.message.error.5\")); // \"Please contact the system administrator\"\n\n                $btn.removeClass('loading');\n                isModal ? ubi.loader.modal.stop() : ubi.loader.nonBlocking.stop();\n            });\n        }\n\n    };\n    \n\n    window.uploadvarbatch=uploadvarbatch;\n\n})(window);\n\n/**\n * Exporter wrapper\n */\n\n(function () {\n\n  'use strict';\n\n  var exporter = {\n      exportfile: exportfile,\n      exportfilebatch: exportfilebatch\n      \n  };\n  \n  \n  \n\n  function exportfile(btn, dataSubmit, dataRedirect, callback) {\n\n    var data = $('#appids').val();\n    data = data.toUpperCase();\n    // match all valid application ids and remove duplicates\n    //var matched = data.match(/[A-Z]{5}-[A-Z]{2}[\\d]{7}/gm);\n    var matched = data.match(/(([A-Z])|(\\d)|(-)){15}|[A-Z]{4}[\\d]{10}/gm);    \n    if (matched === null) {\n      alertify.error(ubi.getTranslationExt(\"frontend.message.error.11\"), 10); //\"No proper Application IDs found!\"\n      return;\n    } else {\n      var result = matched.filter((word, i, arr) => arr.indexOf(word) === i);\n      var numVars = result.length;\n      $('#appids').val(result.join('\\n') + '\\n');// add a newline to allow the user to resume scanning seamlessly\n      $('#numOfUniqueRecords').text(numVars);\n    }\n\n    // varcommon.filterMultipleAppIDs();\n      // Define API\n      var API_URL;\n      if (dataSubmit !== undefined && dataSubmit\n          != \"\" && dataSubmit != null) {\n        API_URL = ubi.API_URL_PREFIX + dataSubmit;\n      } else {\n        throw new TypeError(\"'data-submit' attribute couldn't be found.\");\n      }\n\n      var ajaxOptions = {\n        url: API_URL,\n        type: 'post'\n      };\n\n\n      var $this = $(btn);\n      var formID = $this.attr('form'); //TODO - Check form attribute in old browsers (check in IE11 - passed)\n\n      var hasForm = (formID !== undefined && formID != \"\") ? true : false;\n\n      if (hasForm) {\n        // Define form\n        var $form = $('form#' + formID);\n\n        if ($form.length < 1) {\n          throw new TypeError(\"No form found with id='\" + formID + \"'\");\n        }\n\n        var fields = $form.serializeJSON(serializeJSON_OPTIONS);\n        var field;\n        for (field in fields) {\n          if (typeof fields[field] === 'string') {\n            fields[field] = fields[field].trim();\n          }\n        }\n\n        ajaxOptions.data = JSON.stringify(fields);\n        ajaxOptions.contentType = \"application/json; charset=utf-8\";\n      }\n      \n      exportProcedure(dataRedirect, ajaxOptions, callback)\n  };\n  \n  function exportfilebatch(btn, formID, dataSubmit, dataRedirect, callback) {\n\t\n    var hasForm = (formID !== undefined && formID != \"\") ? true : false;\n      // Define API\n      var API_URL;\n      if (dataSubmit !== undefined && dataSubmit\n          != \"\" && dataSubmit != null) {\n        API_URL = ubi.API_URL_PREFIX + dataSubmit;\n      } else {\n        throw new TypeError(\"'data-submit' attribute couldn't be found.\");\n      }\n\n      var ajaxOptions = {\n        url: API_URL,\n        type: 'post'\n      };\n      \n      if (hasForm) {\n        // Define form\n        var $form = $('form#' + formID);\n        if ($form.length < 1) {\n          throw new TypeError(\"No form found with id='\" + formID + \"'\");\n        }\n        \n        var fields = $form.serializeJSON(serializeJSON_OPTIONS);\n        var field;\n        for (field in fields) {\n          if (typeof fields[field] === 'string') {\n            fields[field] = fields[field].trim();\n          }\n        }\n\n        ajaxOptions.data = JSON.stringify(fields);\n        console.log(ajaxOptions.data);\n        ajaxOptions.contentType = \"application/json; charset=utf-8\";\n        console.log(ajaxOptions);\n      }\n\n      exportProcedure(dataRedirect, ajaxOptions, callback);\n  };\n  \n    var myVar;    \n    function showTime(){\n        var d = new Date();\n        var t = d.toLocaleTimeString();\n        $(\"#loaderMsgCounter\").html(t); // display time on the page\n    }\n    function stopFunction(){\n        clearInterval(myVar); // stop the timer\n    }\n    \n  function preventClose(e){       \n    return \"Sure you want to leave?\";        \n  }\n  \n  function addLoadMessage(){\n      var newRow = '<div class=\"tr\" id=\"loaderMsg\" style=\"z-index: 11;position: absolute;margin-top: 260px; left: 40%; width: 460px; height: 160px; margin-left: -30px;\">'+\n                     ubi.getTranslationExt(\"frontend.message.donotclosebrowser\")+ // Please wait and do not close the browser or refresh the page!!!\n                    '<div style=\"padding-top:10px;padding-left:10px\" id=\"loaderMsgCounter\"></div>'+\n                    '</div>';\n      $('.loader').after(newRow);\n      showTime();\n      myVar = setInterval(showTime, 1000);    \n     // window.addEventListener('beforeunload', preventClose);\n     // console.log(\"add\");\n  }\n  \n  function removeLoadMessage(){      \n      $('#loaderMsg').remove();\n      stopFunction();\n     // window.removeEventListener('beforeunload', preventClose);\n     // console.log(\"remove\");\n  }\n  \n  function exportProcedure(dataRedirect, ajaxOptions, callback){\n      // Start CRUDer\n      $('body').addClass('loading');\n      addLoadMessage();\n      \n      \n      var customRedirect;\n      customRedirect = dataRedirect !== 'undefined'\n        && dataRedirect !== \"\" ? dataRedirect : undefined;\n\n      $.ajax(ajaxOptions).done(function (data, textStatus, jqXHR) {\n        // tb.filter($(\"#btn-filter-var\"));\n        //Check if the new record is created\n        if (textStatus.toUpperCase() == \"SUCCESS\" && (data == \"\" || data === undefined || data.code.toUpperCase() === \"SUCCESS\")) {\n          setTimeout(function () {\n              \n            if (data && data.returnobject && data.returnobject.fileName){\n                var downloadUrl = '/download/'+data.returnobject.fileName+'/file/'+data.returnobject.fileDownloadUri;\n                if (data.returnobject.repository && data.returnobject.repository !== \"\" && data.returnobject.repository !== undefined){\n                    downloadUrl = '/download/'+data.returnobject.fileName+'/b/'+data.returnobject.repository+\"/\"+data.returnobject.fileDownloadUri;\n                }\n                console.log(downloadUrl);\n                window.open(downloadUrl);\n            }\n\n            data != \"\" && \"message\" in data && data.message != null\n                ? alertify.success(data.message, 20)\n                : null;\n\n            // Remove loader\n            removeLoadMessage();\n            $('body').removeClass('loading');\n\n            /*if (typeof callback === 'function') {\n\n              callback(data, textStatus, jqXHR);\n\n            }*/\n\n          }, ubi.loader.blocking.loadingTime);\n        } else {\n          \"message\" in data ? alertify.error(data.message) : alertify.error(\n              ubi.getTranslationExt(\"frontend.message.error.1\")) ;// \"Something went wrong. Please contact the system administrator.\")\n          removeLoadMessage();\n          $('body').removeClass('loading');\n        }\n\n        if (typeof callback === 'function') {\n\n          callback(data, textStatus, jqXHR);\n\n        }\n      }).fail(function (jqXHR, textStatus, errorThrown) {\n        \"responseJSON\" in jqXHR && \"message\" in jqXHR.responseJSON\n            ? alertify.error(jqXHR.responseJSON.message) : alertify.error(\n            ubi.getTranslationExt(\"frontend.message.error.2\")) ;// \"Something went wrong. Try again later.\"\n        removeLoadMessage();\n        $('body').removeClass('loading');\n      });\n  }\n    \n  window.exporter = exporter;\n\n})(window);\n\n/**\n * Add/Remove vars in a group\n */\n\n(function (window) {\n\n    'use strict';\n\n    var groupedit = {\n        singleRemove: singleRemove,\n        multiRemove: multiRemove,\n        removeFromGroup: removeFromGroup,\n        singleAdd: singleAdd,\n        multiAdd: multiAdd,\n        addInGroup: addInGroup\n    };\n\n    function singleRemove(btnid, varid) {\n        removeFromGroup(btnid, varid);\n    }\n\n    function multiRemove(btnid) {\n        var selected = new Array();\n        $('input[name=selectvar]:checked').each(function () {\n            selected += $(this).val()+\",\";\n        });\n        removeFromGroup(btnid, selected);\n    }\n\n    function removeFromGroup(btnid, selected) {\n        var $btn = $(\"#\" + btnid);\n        alertify.confirm(ubi.getTranslationExt('frontend.message.group.remove.title'), ubi.getTranslationExt('frontend.message.group.remove.message'),\n            innerCrud,\n            function(){                \n                alertify.alert(ubi.getTranslationExt('frontend.message.group.remove.title'), ubi.getTranslationExt('frontend.message.group.remove.cancelled'));\n            }\n        ).set({\n            labels: {ok: ubi.getTranslationExt('frontend.message.group.remove.submit'), cancel: ubi.getTranslationExt('frontend.message.group.remove.cancel')},           \n            reverseButtons: true,\n            transition: 'fade'\n        });\n        function innerCrud() {\n            var API_URL = ubi.API_URL_PREFIX + $btn.attr(\"data-submit\");\n            var redirect = $btn.attr('data-redirect');\n\n            var varsData = new FormData();\n            varsData.append('varids', selected);\n\n            $btn.addClass('loading');\n\n            $.ajax({\n                type: 'POST',\n                data: varsData,\n                url: API_URL,\n                processData: false,\n                contentType: false\n            }).done(function (data, textStatus, jqXHR) {\n                if (textStatus.toUpperCase() == \"SUCCESS\") {\n                    page(redirect);\n                    if (data.code.toUpperCase() === \"SUCCESS\") {\n                        alertify.success(data.message);\n                    } else if (data.code.toUpperCase() === \"INVALID\") {\n                        alertify.message(data.message + data.returnobject,20);\n                    }\n                } else {\n                    \"message\" in data ? alertify.error(data.message) : alertify.error(ubi.getTranslationExt(\"frontend.message.error.1\")); // \"Something went wrong. Please contact the system administrator.\"\n                }\n            }).error(function (data, textStatus, jqXHR) {\n                alertify.error(ubi.getTranslationExt(\"frontend.message.error.5\")); // \"Please contact the system administrator\"\n            });\n\n            $btn.removeClass('loading');\n        };\n    };\n\n    function singleAdd(btnid, varid) {\n        addInGroup(btnid, varid);\n    };\n\n    function multiAdd(btnid) {\n        var selected = new Array();\n        $('input[name=selectvar]:checked').each(function () {\n            selected += $(this).val()+\",\";\n        });\n        addInGroup(btnid, selected);\n    };\n\n    function addInGroup(btnid, selected) {\n        var $btn = $(\"#\" + btnid);\n        alertify.confirm(ubi.getTranslationExt('frontend.message.group.add.title'), ubi.getTranslationExt('frontend.message.group.add.message'),\n            innerCrud,\n            function(){                \n                alertify.alert(ubi.getTranslationExt('frontend.message.group.add.title'), ubi.getTranslationExt('frontend.message.group.add.cancelled'));\n            }\n        ).set({\n            labels: {ok: ubi.getTranslationExt('frontend.message.group.add.submit'), cancel: ubi.getTranslationExt('frontend.message.group.add.cancel')},\n            reverseButtons: true,\n            transition: 'fade'\n        });\n        function innerCrud() {\n            var API_URL = ubi.API_URL_PREFIX + $btn.attr(\"data-submit\");\n            var redirect = $btn.attr('data-redirect');\n\n            var varsData = new FormData();\n            varsData.append('varids', selected);\n\n            $btn.addClass('loading');\n\n            $.ajax({\n                type: 'POST',\n                data: varsData,\n                url: API_URL,\n                processData: false,\n                contentType: false\n            }).done(function (data, textStatus, jqXHR) {\n                if (textStatus.toUpperCase() == \"SUCCESS\") {\n                    page(redirect);\n                    if (data.code.toUpperCase() === \"SUCCESS\") {\n                        alertify.success(data.message);\n                    } else if (data.code.toUpperCase() === \"INVALID\") {\n                        alertify.message(data.message + data.returnobject,20);\n                    }\n                } else {\n                    \"message\" in data ? alertify.error(data.message) : alertify.error(ubi.getTranslationExt(\"frontend.message.error.1\")); //\"Something went wrong. Please contact the system administrator.\"\n                }\n            }).error(function (data, textStatus, jqXHR) {\n                alertify.error(ubi.getTranslationExt(\"frontend.message.error.5\")); // \"Please contact the system administrator\"\n            });\n\n            $btn.removeClass('loading');\n        };\n    };\n\n    window.groupedit=groupedit;\n\n})(window);\n\n/**\n * Define notification crawl routing pages\n */\n\n(function () {\n\n    'use strict';\n    \n   \n   \n    var appendFiltersSearch = function appendFiltersSearch(btn) {\n        if (event.keyCode == 13) {\n          appendfilter($(\"#\"+btn), true);\n        }\n      }\n    \n    var appendfilter = function ($this, isappend) {\n        if (isappend == undefined){\n            isappend = true;\n        }\n\n        $('html').hasClass('modal') ? ubi.loader.modal.start() : ubi.loader.nonBlocking.start();\n\n        var $this = $($this);\n\n        if ($this.hasClass('loading')) {\n          logger.i(\"CRUD is in use. Please wait.\");\n          return;\n        }\n\n        var formID = $this.attr('form');\n\n        if (formID === undefined) {\n          alertify.error(ubi.getTranslationExt(\"frontend.message.error.1\")); //\"Something went wrong. Please contact the system administrator\"\n          throw new TypeError(\"No form attribute found\");\n        }\n\n        var $form = $('form#' + formID);\n        if ($form.length === 0) {\n          throw new TypeError(\"No form found with id='\" + formID + \"'\");\n        }\n\n        var validatorResult = ubi.validator.validate(formID, ajaxFilter, $form.children());\n        if (!validatorResult) {\n          logger.e(\"Please check the form fields again\");\n        }\n\n\n        function ajaxFilter() {\n\n          //$this.addClass('loading');\n\n          // set the ajax url\n          var isModal = $('html').hasClass('modal');\n          var $dataSubmit = $('#main-area-modal').find('#navigation');\n          var urlSubmit = (isModal && $dataSubmit.length > 0) ? $dataSubmit.val() : location.pathname;\n\n          var filtersData = $form.serializeJSON(serializeJSON_OPTIONS);\n          var filtersDataTemp = Object.assign({}, filtersData);\n        //  console.log( $('#application').val());\n          //console.log(filtersDataTemp);          \n          // 'id' in filtersDataTemp ? delete filtersDataTemp.id : null;\n\n          var filtersDataParams = '';\n          var filterable = '';\n\n          for (var v in filtersDataTemp) {\n            filtersDataParams += v + '=' + filtersDataTemp[v] + '&';\n            filterable += v + '|' + filtersDataTemp[v] + '-';\n          }\n\n          if (filterable != '') {\n            filterable = filterable.slice(0, -1);\n            filtersDataParams += 'filterable=' + filterable;        // Always submit the id in order to know when the filters are submitted\n\n\n            $.ajax({\n              url: urlSubmit,\n              type: 'POST',\n              data: filtersDataParams\n            }).done(function (data, textStatus, jqXHR) {\n              setTimeout(function () {\n                \n                $('#filterTip').html(\"\");  \n                if (!isappend){\n                    $('#listbody').html(\"\") ;\n                }\n                if (data.length!=0){\n                    if ($('#ap_'+$('#application').val()).length>0){                        \n                    }else{\n                        $('#listbody').prepend(data);\n                        $('#application').val(\"\");\n                        $('#numOfRecords').html( $('#listbody tr').length);\n                    }\n                }else if ($('#application').val().length>0){\n                    $('#filterTip').html(\"Application ID '\"+$('#application').val()+\"' not found\");\n                }\n                enableSelect2();\n                tooltip();\n                isModal ? ubi.loader.modal.stop() : ubi.loader.nonBlocking.stop();\n              }, 300);\n            });\n          //if empty search\n          }else{\n            enableSelect2();\n            tooltip();\n            isModal ? ubi.loader.modal.stop() : ubi.loader.nonBlocking.stop();          \n          }\n        }\n\n      };\n       \n    window.appendfilter = appendfilter;\n    window.appendFiltersSearch = appendFiltersSearch;\n    \n})();\n\n/**\n * Define notification crawl routing pages\n */\n\n(function () {\n\n    'use strict';\n\n    function confirmPeriodEdit($this, action) {\n        var title = $(\"#\" + action + \"PopupTitle\").val();\n        var msg = $(\"#\" + action + \"PopupMsg\").val();\n\n        alertify.confirm(title, msg,\n            function() {\n                if (action == \"put\") {\n                    ubi.crud.put($this);\n                }\n                /*else if (action == \"delete\") {\n                    console.log(\"to delete period\");\n                    ubi.crud.delete($this);\n                }*/\n            },\n            function () {\n                logger.i(\"Action cancelled\");\n            }\n        ).set({\n            labels: {ok: ubi.getTranslationExt('frontend.message.generic.ok'), cancel: ubi.getTranslationExt('frontend.message.generic.cancel')},\n            reverseButtons: true,\n            transition: 'fade'\n        });\n    }\n\n    function confirmPeriodAction($this, action, prompt) {\n\n        var $btn = $($this);\n        var title = $(\"#\" + action + \"PopupTitle\").val();\n        var msg = $(\"#\" + action + \"PopupMsg\").val();\n\n        var $this = $($this);\n\n        var formID = $this.attr('form'); //TODO - Check form attribute in old browsers (check in IE11 - passed)\n\n        var hasForm = (formID !== undefined && formID != \"\") ? true : false;\n\n        let moreHolidays = false;\n        if ($('#moreHolidays').val() !== undefined && $('#moreHolidays').val() != \"\"){\n            moreHolidays = ($('#moreHolidays').val() === 'true' );\n        }\n        console.log($this.attr('data-submit'));\n        console.log($this.attr('data-submit').indexOf(\"check\"));\n\n        // the prompt should show:\n        // only when it is not a \"check\" request AND\n        // if the flag is explicitly set to true OR there are holidays in vac/country\n        if ((moreHolidays || prompt) && $this.attr('data-submit').indexOf(\"check\") < 0 ){\n        alertify.confirm(title, msg,\n            innerCrud,\n            function () {\n                    alertify.alert(ubi.getTranslationExt('frontend.message.cancelled.title'), ubi.getTranslationExt('frontend.message.cancelled.msg'));\n            }\n        ).set({\n                labels: {ok: ubi.getTranslationExt('frontend.message.generic.proceed'), cancel: ubi.getTranslationExt('frontend.message.generic.cancel')},\n            reverseButtons: true,\n            transition: 'fade'\n        });\n        }else{\n            innerCrud();\n        }\n\n        function innerCrud() {  // copied from crud.js\n            // Define API\n            var API_URL;\n            if ($this.attr('data-submit') !== undefined && $this.attr('data-submit')\n                != \"\" && $this.attr('data-submit') != null) {\n                API_URL = ubi.API_URL_PREFIX + $this.attr('data-submit');\n            } else {\n                throw new TypeError(\"'data-submit' attribute couldn't be found.\");\n            }\n\n            var ajaxOptions = {\n                url: API_URL,\n                type: action\n            };\n\n            if (hasForm) {\n                // Define form\n                var $form = $('form#' + formID);\n                if ($form.length < 1) {\n                    throw new TypeError(\"No form found with id='\" + formID + \"'\");\n                }\n\n                var fields = $form.serializeJSON(serializeJSON_OPTIONS);\n                var field;\n                for (field in fields) {\n                    if (typeof fields[field] === 'string') {\n                        fields[field] = fields[field].trim();\n                    }\n                }\n\n                ajaxOptions.data = JSON.stringify(fields);\n                ajaxOptions.contentType = \"application/json; charset=utf-8\";\n            }\n\n            // Start CRUDer\n            $this.addClass('loading');\n\n            var customRedirect;\n            customRedirect = $this.attr('data-redirect') !== 'undefined'\n            && $this.attr('data-redirect') !== \"\" ? $this.attr('data-redirect') : undefined;\n\n            $.ajax(ajaxOptions).done(function (data, textStatus, jqXHR) {\n                //Check if the new record is created\n                if (textStatus.toUpperCase() == \"SUCCESS\" && (data == \"\" || data === undefined || data.code.toUpperCase() === \"SUCCESS\")) {\n                    setTimeout(function () {\n\n                        var redirectURL;\n                        var pathname = window.location.pathname + window.location.search;\n\n                        if (typeof customRedirect !== 'undefined' && typeof customRedirect === 'string') {\n                            redirectURL = customRedirect;\n                        } else if (\"returnobject\" in data && typeof data.returnobject === 'object'\n                            && data.returnobject != null && \"redirectURL\" in data.returnobject) {\n                            redirectURL = data.returnobject.redirectURL;\n                        } else {\n                            // Initialize redirect URL. By default it reloads current page\n                            redirectURL = pathname;\n                        }\n\n                        // Inform user\n                        logger.i(\"Successful API communication at \\\"\" + API_URL\n                            + \"\\\" using method \" + action);\n\n                        data != \"\" && \"message\" in data && data.message != null\n                            ? alertify.success(data.message)\n                            : null;\n\n                        // Remove loader\n                        $this.removeClass('loading');\n\n                        if (data && data.returnobject) {\n                            var robj = data.returnobject;\n                            var bucketName = \"/b/excels\";\n                            setTimeout(function() {\n                                window.open('/download/' + robj.fileName + bucketName + '/' + robj.fileDownloadUri);\n                            }, 2000);\n                        } else {\n                        }\n\n                        // Redirection\n                        if (window.location.search.indexOf('redirect=') !== -1) {\n                            window.history.back();\n                        } else {\n                            redirectURL != \"stay\" ? page(redirectURL) : null;\n                        }\n\n                        /*if (typeof callback === 'function') {\n\n                          callback(data, textStatus, jqXHR);\n\n                        }*/\n\n                    }, ubi.loader.blocking.loadingTime);\n                } else {\n                    \"message\" in data ? alertify.error(data.message) : alertify.error(\n                        ubi.getTranslationExt(\"frontend.message.error.1\")); //\"Something went wrong. Please contact the system administrator.\"\n                    $this.removeClass('loading');\n                }\n\n                if (typeof callback === 'function') {\n\n                    callback(data, textStatus, jqXHR);\n\n                }\n            }).fail(function (jqXHR, textStatus, errorThrown) {\n                \"responseJSON\" in jqXHR && \"message\" in jqXHR.responseJSON\n                    ? alertify.error(jqXHR.responseJSON.message) : alertify.error(\n                    ubi.getTranslationExt(\"frontend.message.error.2\")); //\"Something went wrong. Try again later.\"\n                $this.removeClass('loading');\n            });\n        }//End of inner function\n    }\n\n    window.confirmPeriodAction = confirmPeriodAction;\n\n})();\n\n/**\n * Define notification crawl routing pages\n */\n\n(function () {\n\n    'use strict';\n\n    function unsubscribe($this, action) {\n\n        console.log($($this));\n        var $btn = $($this);\n\n        var $this = $($this);\n\n        var formID = $this.attr('form'); //TODO - Check form attribute in old browsers (check in IE11 - passed)\n\n        var hasForm = (formID !== undefined && formID != \"\") ? true : false;\n\n        alertify.confirm(ubi.getTranslationExt('frontend.message.user.unsubscribeprompt.title'), ubi.getTranslationExt('frontend.message.user.unsubscribeprompt.msg'),\n            innerCrud,\n            function () {\n                alertify.alert(ubi.getTranslationExt('frontend.message.user.unsubscribeprompt.title'), ubi.getTranslationExt('frontend.message.user.unsubscribeprompt.cancelled'));\n            }\n        ).set({\n            labels: {ok: ubi.getTranslationExt('frontend.message.generic.proceed'), cancel: ubi.getTranslationExt('frontend.message.generic.cancel')},\n            reverseButtons: true,\n            transition: 'fade'\n        });\n\n        function innerCrud() {  // copied from crud.js\n            // Define API\n            var API_URL;\n            if ($this.attr('data-submit') !== undefined && $this.attr('data-submit')\n                != \"\" && $this.attr('data-submit') != null) {\n                API_URL = ubi.API_URL_PREFIX + $this.attr('data-submit');\n            } else {\n                throw new TypeError(\"'data-submit' attribute couldn't be found.\");\n            }\n\n            var ajaxOptions = {\n                url: API_URL,\n                type: action\n            };\n\n            if (hasForm) {\n                // Define form\n                var $form = $('form#' + formID);\n                if ($form.length < 1) {\n                    throw new TypeError(\"No form found with id='\" + formID + \"'\");\n                }\n\n                var fields = $form.serializeJSON(serializeJSON_OPTIONS);\n                var field;\n                for (field in fields) {\n                    if (typeof fields[field] === 'string') {\n                        fields[field] = fields[field].trim();\n                    }\n                }\n\n                ajaxOptions.data = JSON.stringify(fields);\n                ajaxOptions.contentType = \"application/json; charset=utf-8\";\n            }\n\n            // Start CRUDer\n            $this.addClass('loading');\n\n            var customRedirect;\n            customRedirect = $this.attr('data-redirect') !== 'undefined'\n            && $this.attr('data-redirect') !== \"\" ? $this.attr('data-redirect') : undefined;\n\n            $.ajax(ajaxOptions).done(function (data, textStatus, jqXHR) {\n                //Check if the new record is created\n                if (textStatus.toUpperCase() == \"SUCCESS\" && (data == \"\" || data === undefined || data.code.toUpperCase() === \"SUCCESS\")) {\n                    setTimeout(function () {\n\n                        var redirectURL;\n                        var pathname = window.location.pathname + window.location.search;\n\n                        if (typeof customRedirect !== 'undefined' && typeof customRedirect === 'string') {\n                            redirectURL = customRedirect;\n                        } else if (\"returnobject\" in data && typeof data.returnobject === 'object'\n                            && data.returnobject != null && \"redirectURL\" in data.returnobject) {\n                            redirectURL = data.returnobject.redirectURL;\n                        } else {\n                            // Initialize redirect URL. By default it reloads current page\n                            redirectURL = pathname;\n                        }\n\n                        // Inform user\n                        logger.i(\"Successful API communication at \\\"\" + API_URL\n                            + \"\\\" using method \" + action);\n\n                        data != \"\" && \"message\" in data && data.message != null\n                            ? alertify.success(data.message)\n                            : null;\n\n                        // Remove loader\n                        $this.removeClass('loading');\n                        ubi.removeAccess();\n                        ubi.goHome();\n\n                        // Redirection\n                        if (window.location.search.indexOf('redirect=') !== -1) {\n                            window.history.back();\n                        } else {\n                            redirectURL != \"stay\" ? page(redirectURL) : null;\n                        }\n\n                        /*if (typeof callback === 'function') {\n\n                          callback(data, textStatus, jqXHR);\n\n                        }*/\n\n                    }, ubi.loader.blocking.loadingTime);\n                } else {\n                    \"message\" in data ? alertify.error(data.message) : alertify.error(\n                        ubi.getTranslationExt(\"frontend.message.error.1\")); //\"Something went wrong. Please contact the system administrator.\"\n                    $this.removeClass('loading');\n                }\n\n                if (typeof callback === 'function') {\n\n                    callback(data, textStatus, jqXHR);\n\n                }\n            }).fail(function (jqXHR, textStatus, errorThrown) {\n                \"responseJSON\" in jqXHR && \"message\" in jqXHR.responseJSON\n                    ? alertify.error(jqXHR.responseJSON.message) : alertify.error(\n                    ubi.getTranslationExt(\"frontend.message.error.2\")); //\"Something went wrong. Try again later.\"\n                $this.removeClass('loading');\n            });\n        }//End of inner function\n    }\n\n    window.unsubscribe = unsubscribe;\n\n})();\n\n(function () {\n\n    'use strict';\n\n    function openclientwindow($this) {\n        \n        // TODO - Check if $this is string in order to skip $this DOM object and continue with the rest call\n        var $this = $($this);\n\n        if ($this.hasClass('loading')) {\n            logger.i(\"CRUD is in use. Please wait.\");\n            return;\n        }\n\n        var formID = $this.attr('form'); //TODO - Check form attribute in old browsers (check in IE11 - passed)\n\n       // Define API\n        var API_URL;\n        if ($this.attr('data-submit') !== undefined && $this.attr('data-submit')\n                != \"\" && $this.attr('data-submit') != null) {\n            API_URL = ubi.API_URL_PREFIX + $this.attr('data-submit');\n        } else {\n            throw new TypeError(\"'data-submit' attribute couldn't be found.\");\n        }\n\n        \n        $this.attr('disabled', true);\n        \n        $this.prop(\"onclick\", null).off(\"click\");\n        \n        \n        window.open(API_URL);\n               \n    }\n    \n\n\n    window.openclientwindow = openclientwindow;\n})();\n/**\n *\n * Reference: http://parsleyjs.org/doc/index.html#custom\n *\n * Custom form validators using parsley.js\n *\n * ------------------\n * Validator methods\n * ------------------\n * validateString -\tIs passed the input's value as a string.\n * validateNumber\t- Use this instead of validateString when only numeric values are acceptable. Parsley will parse the input's value and pass the number, or reject the value if it's not an acceptable number\n * validateDate\t- Define this to treate date values. Parsley will parse the input's value and pass the date, or reject the value if it's not an acceptable date. The format used must be that [of the standard](https://html.spec.whatwg.org/multipage/infrastructure.html#valid-date-string), e.g. \"2017-02-28\".\n * validateMultiple\t- Is passed an array of values, in the case of checkboxes.\n *\n * ----------------\n * requirementType\n * ----------------\n * 'string'\tThe most generic kind; requirement passed as is, with no checking.\n * 'integer'\tFor integers only (e.g. used by minlength)\n * 'number'\tTo be used when decimal numbers are acceptable\n * 'date'\tTo be used for dates. The format used must be that [of the standard](https://html.spec.whatwg.org/multipage/infrastructure.html#valid-date-string), e.g. \"2017-02-28\".\n * 'regexp'\tRequirement can be either a full regexp string (e.g. /hel+o/i) or just a simple expression (e.g. hel+o)\n * 'boolean'\tAny value other than \"false\" will be considered to true, including the empty string. This is so data-parsley-required and data-parsley-required=true be treated the same way.\n *\n *\n * ================================================================================\n * PLEASE before implementing your own custom validator, check the built-in\n * validators -> http://parsleyjs.org/doc/index.html#validators\n * ================================================================================\n *\n */\n\n(function (window) {\n\n    'use strict';\n\n    function getLanguage() {\n        var language;\n        language = getCookie('org.springframework.web.servlet.i18n.CookieLocaleResolver.LOCALE');\n        return language;\n    }//EoM\n\n    function getCookie(cn) {\n        var name = cn + \"=\";\n        var allCookie = decodeURIComponent(document.cookie).split(';');\n        var cval = [];\n        for (var i = 0; i < allCookie.length; i++) {\n            if (allCookie[i].trim().indexOf(name) == 0) {\n                cval = allCookie[i].trim().split(\"=\");\n            }\n        }\n        return (cval.length > 0) ? cval[1] : \"\";\n    }//EoM\n\n//    ubi.loader.blocking.start();\n\n    var transarray;\n\n    $.get({\n        url: \"/api/v1/translations\",\n        contentType: \"application/json; charset=utf-8\"\n    }).done(function (data, status, xhr) {\n        if (\"SUCCESS\" === data.code) {\n//            console.log(data.returnobject);\n            transarray = data.returnobject; \n\n            window.Parsley.addValidator('val2', {//Length 25 CHR, Space, \"-\", \"/\" Number\n                requirementType: 'string',\n                validateString: function (value) {\n                    console.log(value);\n                    return /^(([A-Z])|(\\s)|([-])|([/])|([\\d])){1,25}$/.test(value.toUpperCase());\n                },\n                messages: {\n                    en: getTranslation('frontend.error.1',transarray)                    \n//                    en: \"FJField should have maximum lenghth of 25 symbols; acceptable symbols: latin-characters(uppercase), spaces, numbers, '-','/'\",\n//                    ru: \"оле должно иметь максимальную длину 25 символов; допустимые символы: латинские буквы (в верхнем регистре), пробелы, цифры, '-', '/'\"\n                }\n            });\n\n            window.Parsley.addValidator('val3', {//Length 25  CHR, Space, \"-\", \"/\"\n                requirementType: 'string',\n                validateString: function (value) {\n                    console.log(value);\n                    return /^(([A-Z])|(\\s)|([-])|([/])){1,25}$/.test(value.toUpperCase());\n                },\n                messages: {\n                    en: getTranslation('frontend.error.2',transarray)                                        \n//                    en: \"JField should have maximum lenghth of 25 symbols; acceptable symbols: latin-characters(uppercase), spaces, '-','/'\"\n                }\n            });\n\n            window.Parsley.addValidator('val15', {//Length 15  CHR, Space, \"_\", \"-\", Number\n                requirementType: 'string',\n                validateString: function (value) {\n                    console.log(value);\n                    return /^(([A-Z])|(\\s)|([-])|([_])|([\\d])){1,15}$/.test(value.toUpperCase());\n                },\n                messages: {\n                    en: getTranslation('frontend.error.groupname',transarray)\n//                    en: \"JField should have maximum lenghth of 15 symbols; acceptable symbols: latin-characters(uppercase), spaces, '-','/'\"\n                }\n            });\n\n            window.Parsley.addValidator('val4', {//Length 25  CHR, Space\n                requirementType: 'string',\n                validateString: function (value) {\n                    console.log(value);\n                    return /^(([A-Z])|(\\s)){1,25}$/.test(value.toUpperCase());\n                },\n                messages: {\n                    en: getTranslation('frontend.error.3',transarray)                       \n//                    en: \"JField should have maximum lenghth of 25 symbols; acceptable symbols: latin-characters(uppercase), spaces\"\n                }\n            });\n\n            window.Parsley.addValidator('val5', {//Length 10  CHR, Number\n                requirementType: 'string',\n                validateString: function (value) {\n                    console.log(value);\n                    return /^(([A-Z])|(\\d)){1,10}$/.test(value.toUpperCase());\n                },\n                messages: {\n                    en: getTranslation('frontend.error.4',transarray)                            \n//                    en: \"Field should have maximum lenghth of 10 symbols; acceptable symbols: latin-characters(uppercase), numbers\"\n                }\n            });\n\n            window.Parsley.addValidator('val6', {//Length 9   CHR, Number\n                requirementType: 'string',\n                validateString: function (value) {\n                    console.log(value);\n                    return /^(([A-Z])|(\\d)){1,9}$/.test(value.toUpperCase());\n                },\n                messages: {\n                    en: getTranslation('frontend.error.5',transarray)                            \n//                    en: \"JField should have maximum lenghth of 9 symbols; acceptable symbols: latin-characters(uppercase), numbers\"\n                }\n            });\n\n            // validator for countries with exact phone number # of digits (i.e. not 20)\n            window.Parsley.addValidator('phoneStrict', {\n                requirementType: 'string',\n                validateString: function (value, length) {\n                    console.log(value);\n                    var matcher = new RegExp(\"^((?!(0){2})[0-9]{\" + length + \"})$\", \"g\");\n                    return matcher.test(value.toUpperCase());\n                },\n                messages: {\n                    en: getTranslation('frontend.error.6.1',transarray)\n//                    en: \"JField should contain only numbers (up to 14 digits)\"\n                }\n            });\n\n            window.Parsley.addValidator('val7', {//Length 14  Number\n                requirementType: 'string',\n                validateString: function (value) {\n                    console.log(value);\n                    return /^((?!(0){1})[0-9]{1,14})$/.test(value.toUpperCase());\n                },\n                messages: {\n                    en: getTranslation('frontend.error.6',transarray)\n//                    en: \"JField should contain only numbers (up to 14 digits)\"\n                }\n            });\n\n            window.Parsley.addValidator('val8', {//Numbers from 1 to 90\n                requirementType: 'string',\n                validateString: function (value) {\n                    console.log(value);\n                    return /^([1-9]|[1-9][0-9]|[1-9][0-9][0-9]|90)$/.test(value.toUpperCase());                },\n                messages: {\n                    en: getTranslation('frontend.error.7',transarray)                            \n//                    en: \"JField should contain only numbers from 1 to 90\"\n                }\n            });\n\n            window.Parsley.addValidator('val9_25', {//All ASCII characters inside of the range of 32-126 (exclude lower case)\n                requirementType: 'string',\n                validateString: function (value) {\n                    console.log(value);\n                    return /^([\\x20-\\x60|\\x7b\\-\\xe]){1,25}$/.test(value.toUpperCase());\n                },\n                messages: {\n                    en: getTranslation('frontend.error.14.25',transarray)\n//                    en: \"JField should have maximum lenghth of 25 symbols; acceptable symbols: latin-characters(uppercase), spaces\"\n                }\n            });\n\n            window.Parsley.addValidator('val9_40', {//All ASCII characters inside of the range of 32-126 (exclude lower case)\n                requirementType: 'string',\n                validateString: function (value) {\n                    console.log(value);\n                    return /^([\\x20-\\x60|\\x7b\\-\\xe]){1,40}$/.test(value.toUpperCase());\n                },\n                messages: {\n                    en: getTranslation('frontend.error.14.40',transarray)\n//                    en: \"JField should have maximum lenghth of 40 symbols; acceptable symbols: latin-characters(uppercase), spaces\"\n                }\n            });\n\n            window.Parsley.addValidator('val9_50', {//All ASCII characters inside of the range of 32-126 (exclude lower case)\n                requirementType: 'string',\n                validateString: function (value) {\n                    console.log(value);\n                    return /^([\\x20-\\x60|\\x7b\\-\\xe]){1,50}$/.test(value.toUpperCase());\n                },\n                messages: {\n                    en: getTranslation('frontend.error.14.50',transarray)\n//                    en: \"JField should have maximum lenghth of 50 symbols; acceptable symbols: latin-characters(uppercase), spaces\"\n                }\n    