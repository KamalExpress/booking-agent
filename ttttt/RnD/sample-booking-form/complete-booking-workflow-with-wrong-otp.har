idth = Math.round($errorEl.outerWidth() / 2);\r\n\r\n    $errorEl.css({\r\n      'top': formItemElementsHeight + 'px',\r\n      'left': '50%',\r\n      'margin-left': '-' + errorElWidth + 'px'\r\n    });\r\n\r\n\r\n    // only for visa request page\r\n    if ($('#form-tabs').length > 0) {\r\n      ubi.var.showErrorsOnTabs();\r\n    }\r\n\r\n  });\r\n\r\n  _self.Parsley.on('field:success', function () {\r\n    if ($('#form-tabs').length > 0) {\r\n      window.ubi.var.showErrorsOnTabs();\r\n    }\r\n  });\r\n\r\n  // Multi Level View open/close functionality\r\n  _self.multilevelViewToggle = function ($this) {\r\n\r\n    var $this = $($this);\r\n\r\n    if ($this[0].nodeName == 'H4') {\r\n      var $ul_li = $this.parent();\r\n      if (!$ul_li.hasClass('level')) return;\r\n      !$ul_li.hasClass('open') ? $ul_li.addClass('open') : $ul_li.removeClass('open');\r\n    } else if ($this[0].nodeName == 'H5') {\r\n      var $ul_li_ul_li = $this.parent();\r\n      // if (!$ul_li_ul_li.hasClass('level')) return;\r\n      !$ul_li_ul_li.hasClass('open') ? $ul_li_ul_li.addClass('open') : $ul_li_ul_li.removeClass('open');\r\n    }\r\n\r\n  };\r\n\r\n  // Tooltip\r\n  // TODO - Add an arrow graphic, change color to darkblue and make more curved\r\n  _self.tooltip = function () {\r\n    $('.tooltip').each(function () {\r\n      var $this = $(this);\r\n      var title = $this.attr('data-tooltip-title') != \"\" ? $this.attr('data-tooltip-title') : undefined;\r\n      if (title === undefined) return true;\r\n      var styles = $this.attr('data-tooltip-style') != \"\" ? $this.attr('data-tooltip-style') : undefined;\r\n      //TODO - create an array of styles\r\n      var stylesWrap = styles !== undefined ? 'style=\"' + styles + '\"' : '';\r\n      $this.append('<div class=\"tooltip-box\"' + stylesWrap + '>' + title + '</div>');\r\n    });\r\n  };\r\n\r\n  // Modal\r\n  _self.modal = {\r\n\r\n    identifier: \"\",\r\n\r\n    open: function (api_url, options) {\r\n      // var modalID = arguments.length > 2 && arguments[2] !== undefined ? arguments[2] : true;\r\n      // var cache = arguments.length > 2 && arguments[3] !== undefined ? arguments[3] : true;\r\n      // cache ? logger.i('Modal with \"' + modalID + '\" identifier created') : null;\r\n\r\n      if (options !== undefined) {\r\n        var mdClasses = 'classes' in options ? options.classes : null;\r\n        var callback = 'callback' in options && typeof options.callback === 'function' ? options.callback : null;\r\n      }\r\n\r\n      modal.init();\r\n\r\n      $('#modal').addClass(mdClasses);\r\n\r\n      $('html').addClass('modal');\r\n      // if (!cache || modalID === undefined || modal.identifier == \"\" || modal.identifier != modalID) {\r\n      $('#mc-inner').html(\"\");\r\n      ubi.loader.modal.start();\r\n      $.post(api_url, function (data) {\r\n        setTimeout(function () {\r\n          $('#mc-inner').html(data);\r\n          ubi.loader.modal.stop();\r\n          // modal.identifier = (modalID !== undefined ? modalID : \"\");\r\n          tooltip();\r\n          callback != null ? callback() : null;\r\n        }, ubi.loader.modal.loadingTime);\r\n      });\r\n      // }\r\n    },\r\n\r\n    close: function () {\r\n      $('html').removeClass('modal');\r\n    },\r\n\r\n    closeListener: function (e) {\r\n      e.target.id == 'modal' ? $('html').removeClass('modal') : null;\r\n    },\r\n\r\n    init: function () {\r\n      $('#modal').removeClass('small');\r\n    }\r\n  };\r\n\r\n  // Sticky titles\r\n  // TODO - Generic\r\n  _self.sticky = function (selector) {\r\n\r\n    selector = selector === undefined ? '#group-wrapper' : selector;\r\n    var stickySourceSelector = arguments.length > 1 && arguments[1] !== undefined ? arguments[1] : '.grp-date';\r\n    var stickyDestSelector = arguments.length > 2 && arguments[2] !== undefined ? arguments[2] : '#last-synchro .sticky';\r\n\r\n    var $wrap = $(selector);\r\n\r\n    if ($wrap.length === 0) return;\r\n\r\n    var $sticker = $(stickyDestSelector);\r\n    var point = $sticker.offset().top;\r\n\r\n    var stickies = $(selector).find(stickySourceSelector);\r\n    var stickiesSize = stickies.length;\r\n\r\n    var i, $current, $next;\r\n    $wrap.on(\"scroll\", function (e) {\r\n\r\n      if (this.scrollTop <= 10) {\r\n        $sticker.removeClass('show');\r\n        return;\r\n      }\r\n\r\n      $sticker.addClass('show');\r\n      for (i = 0; i < stickiesSize; i++) {\r\n        $current = $(stickies[i]);\r\n        if ((i + 1) < stickiesSize) {\r\n          $next = $(stickies[i + 1]);\r\n          if ($current.offset().top <= point && $next.offset().top > point) {\r\n            $sticker.text($current.text());\r\n            break;\r\n          }\r\n        } else {\r\n          // $next is null. We are in the last element\r\n          if ($current.offset().top <= point) {\r\n            $sticker.text($current.text());\r\n            break;\r\n          }\r\n        }\r\n      }\r\n\r\n    });\r\n  };\r\n\r\n  // Dark Master modal black opacity actions\r\n  _self.dmActions = function () {\r\n    removeOuterButtonWrapper();\r\n  };\r\n\r\n  // Catch all clicks of document in a single function\r\n  $(document).on('click', function (e) {\r\n    var $miniMenuWrapper = $('#mini-menu-wrapper');\r\n    var $miniMenuOpenItem = $miniMenuWrapper.find('li.open');\r\n    if ($miniMenuOpenItem.length === 0) return;\r\n\r\n    // Close mini menu second level if the user clicked outside the target\r\n    (function () {\r\n      var $miniMenuContainer = $miniMenuWrapper.find('ul');\r\n\r\n      var hasClickedMenuItem = false;\r\n      $miniMenuWrapper.find('.mm-icons').each(function (i, v) {\r\n        if ($(v).is(e.target)) {\r\n          hasClickedMenuItem = true;\r\n          return false;\r\n        }\r\n      });\r\n      var hasClickedOutside = (!$miniMenuContainer.is(e.target) && $miniMenuContainer.has(e.target).length === 0);\r\n\r\n      !hasClickedMenuItem && hasClickedOutside ? $miniMenuWrapper.find('li.open').removeClass('open') : null;\r\n    })();\r\n  });\r\n\r\n  // Enable select2\r\n  _self.enableSelect2 = function () {\r\n    // Enable select2 only for desktop devices\r\n    if (!ubi.isTouchDevice()) {\r\n      setTimeout(function () {\r\n        var $select2Opened = $('body').children('.select2-container--open');\r\n        $select2Opened.length > 0 ? $select2Opened.remove() : null;\r\n      });\r\n\r\n      $('select').each(function (i, v) {\r\n        var $this = $(v);\r\n        var noMinimumResultsForSearch = $this.children('option').length <= 10 && !$this.hasClass('allowtags');\r\n\r\n        /**BEGIN: recalculate label's width**/\r\n        var max_length = -1;\r\n        if ($this.children('option').length >= 2){\r\n\r\n            var numOfOptions = $this.children('option').length;\r\n            var lengths = [\r\n                ($(\"#\"+$this.attr('id')+\" option:nth-child(2)\").text()).length, //second element (the first is empty or all)\r\n                ($(\"#\"+$this.attr('id')+\" option:nth-child(\"+Math.round(numOfOptions/2)+\")\").text()).length, //med\r\n                ($(\"#\"+$this.attr('id')+\" option:last\").text()).length //last\r\n                ];\r\n\r\n            for (var j=0; j<lengths.length; j++){\r\n                if (max_length < lengths[j]){\r\n                    max_length = lengths[j];\r\n                }\r\n            }\r\n        }\r\n\r\n        var labelText = $('label[for='+  $this.attr('id')  +']').text();\r\n        if (labelText.length < max_length){\r\n            $('label[for='+  $this.attr('id')  +']').css('width', max_length*10);\r\n        }\r\n        /**END: recalculate label's width**/\r\n\r\n        $this.select2({\r\n          placeholder: $this.attr('placeholder') || 'Select an option',\r\n          language: {\r\n            noResults: function (params) {\r\n                if ($(\"#no-results\").val() !== undefined && $(\"#no-results\").val() !== \"\"){\r\n                    return $(\"#no-results\").val();\r\n                }else{\r\n                    return \"No results found.\";\r\n                }\r\n            }\r\n          },\r\n          templateSelection : function (tag, container){\r\n     \t\t// here we are finding option element of tag and\r\n            // if it has property 'locked' we will add class 'locked-tag' \r\n            // to be able to style element in select\r\n            //var $option = $('#select2 option[value=\"'+tag.id+'\"]');\r\n            var $option = $('#'+$this.attr(\"id\")+' option[value=\"'+tag.id+'\"]');\r\n            if ($option.attr('locked')){\r\n               $(container).addClass('locked-tag');\r\n               tag.locked = true; \r\n            }\r\n            return tag.text;\r\n          },\r\n          allowClear: $this.hasClass('allowclear'),\r\n          tags: $this.hasClass('allowtags'),\r\n          closeOnSelect: !$this.hasClass('closeonselect'),\r\n          minimumResultsForSearch: (noMinimumResultsForSearch ? 'Infinity' : null),\r\n          maximumSelectionLength: ($this.attr('data-max-selection') != '' ? $this.attr('data-max-selection') : null),\r\n          width: 'resolve'\r\n        });\r\n      }).on('select2:unselecting', function(e){\r\n   \t\t// before removing tag we check option element of tag and \r\n        // if it has property 'locked' we will create error to prevent all select2 functionality\r\n         if ($(e.params.args.data.element).attr('locked')) {\r\n             e.select2.pleaseStop();\r\n          }\r\n       });\r\n    }\r\n  };\r\n\r\n  // Enable dropdown\r\n  _self.enableDropdownLinks = function () {\r\n    $('.dropdown').click(function () {\r\n      var dropdownMenuID = '#' + this.id + '-myDropdown';\r\n      var dropdownMenu = $(dropdownMenuID);      \r\n      $('.dropdown-content').not(dropdownMenuID).hide();\r\n      dropdownMenu.toggle('slow', function () {\r\n        // Animation complete.\r\n      });\r\n\r\n      // on click of the document, close the menus\r\n      $(document).one('click', function () {\r\n        //menu.hide();\r\n        dropdownMenu.hide();\r\n      });\r\n      //Preventing of return false if it is not export. In case of change language the 'return false' is not working\r\n      if ($('#' + this.id).hasClass(\"export\")){\r\n        return false;\r\n      }\r\n      \r\n    });\r\n    \r\n  };\r\n\r\n  // Rows view \"show more\"/\"show less\" collapsible functionality\r\n  _self.rowsViewCollapse = function ($this) {\r\n    var $this = $($this);\r\n    var $text = $this.children('.text');\r\n    var $arrow = $this.children('.arrow');\r\n    var $fieldset = $this.parents('td').find('fieldset.show-more');\r\n\r\n    if ($fieldset.children().length === 0) {\r\n      $this.removeClass('darkblue');\r\n      $this.css('cursor', 'no-drop');\r\n    } else if (!$this.hasClass('active')) {\r\n      $this.addClass('active');\r\n      $arrow.removeClass('down').addClass('up');\r\n      $text.text(\"Show less\");\r\n\r\n      $fieldset.removeClass('hide');\r\n    } else {\r\n      $this.removeClass('active');\r\n      $arrow.removeClass('up').addClass('down');\r\n      $text.text(\"Show more\");\r\n      $fieldset.addClass('hide');\r\n    }\r\n  };\r\n\r\n  // Simple search show/hide input field\r\n  // TODO - remove it\r\n  _self.simpleSearchToggle = function ($this) {\r\n    var $this = $($this);\r\n    var $li = $this.parent('li');\r\n    var $searchWrapper = $('#search');\r\n\r\n    if (!$li.hasClass('open-custom')) {\r\n      $li.addClass('open-custom');\r\n      $searchWrapper.removeClass('hide');\r\n      setTimeout(function () {\r\n        $searchWrapper.children('input').focus();\r\n      }, 450);\r\n    } else {\r\n      $li.removeClass('open-custom');\r\n      $searchWrapper.addClass('hide');\r\n    }\r\n  };\r\n\r\n  _self.collapsable = function ($this) {\r\n    var $this = $($this);\r\n    var $fieldset = $this.parent();\r\n    var $i = $this.children('i');\r\n\r\n    if (!$fieldset.hasClass('collapsed')) {\r\n      $fieldset.addClass('collapsed');\r\n      $i.removeClass('fa-minus-square').addClass('fa-plus-square');\r\n    } else {\r\n      $fieldset.removeClass('collapsed');\r\n      $i.removeClass('fa-plus-square').addClass('fa-minus-square');\r\n    }\r\n  }\r\n\r\n\r\n})(window);\r\n\r\n\n/**\n * Notifications js logic\n */\n\n(function(window) {\n    'use strict';\n\n    var API_URL = '/api/v1/notification';\n\n    var $nfWrapper;\n    var $nfNumber;\n    // supported entities for webSockets\n    var entities = {\n        'MRZ': {\n            showNotification: false,\n        },\n        'FINGER': {\n            showNotification: true,\n        },\n    };\n\n    var notification = {\n\n        seen: false,\n\n        loadMoreFlag: true,\n\n        init: function () {\n            $nfWrapper = $('#nf-wrapper');\n            $nfNumber = $nfWrapper.parents('.icon-indicator');\n            var counter = 0;\n\n            // Count unread notifications\n            $('#nf-wrapper').find('li').not('.loading').filter(function () {\n                var $nfData = $(this).children('.nf-data');\n                $nfData.attr('data-seen') == 'false' ? counter++ : null;\n            });\n            $nfNumber.text(counter);\n            if (counter > 0) {\n                $nfWrapper.removeClass('seen');\n            } else {\n                $nfWrapper.addClass('seen');\n                notification.seen = true;\n            }\n        },\n\n        socket: function(data) {\n\n            console.log('socket');\n            if (!('body' in data)) {\n                throw new Error(\"No body returned from socket\");\n            }\n\n            var sockBody = JSON.parse(data.body);\n\n            // Auto refresh when we get a message\n            function refresh() {\n                page(window.location.pathname + window.location.search);\n            }\n            function refreshFromNew(varid){\n                page(\"/visa-request/\"+varid);\n            }\n            //leave log as it is\n            console.log(sockBody.topicID + sockBody.entityID);\n            console.log($('#socket-' + sockBody.topicID + sockBody.entityID));\n            console.log($('#socket-' + sockBody.topicID + sockBody.entityID).length);\n            ((sockBody.entityType in entities) && $('#socket-' + sockBody.topicID + sockBody.entityID).length > 0) ? refresh() : null;\n            ((sockBody.entityType in entities) && $('#socket-new' + sockBody.topicID).length > 0) ? refreshFromNew(sockBody.entityID) : null;\n\n            if (!entities[sockBody.entityType].showNotification) return false;\n\n            // console.log('continue appending notification to the notification header area');\n\n            setTimeout(function() {\n                renderNotification(sockBody, function (notificationHtml) {\n                    var nfEmpty = $('#notifications main ul li.empty');\n                    nfEmpty.length == 1 ? nfEmpty.remove() : null;\n\n                    $('#notifications main ul').prepend(notificationHtml);\n                });\n                // notify user with a sound\n                ubi.audio.notification.stop().play();\n                // update notification\n                (function() {\n                    // TODO - Check if ui reached 99 notifications\n                    notification.seen = false;\n                    var nfNumber = parseInt($nfNumber.text());\n                    $nfWrapper.removeClass('seen');\n                    $nfNumber.text(++nfNumber);\n                })();\n            }, ubi.loader.nonBlocking.loadingTime);\n        }\n    };\n\n    function renderNotification(data, renderFunc) {\n        var readClass = data.read ? ' class=\"read\"' : '';\n        var date = moment(data.timestamp).format('DD/MM/YYYY - H:mm');\n        var link = data.redirectURL == \"\" || data.redirectURL == null ? 'javascript:void(0)' : data.redirectURL;\n\n        var nfRow =\n            '<li' + readClass + '>' +\n                '<div class=\"nf-data hidden\" data-id=\"' + data.id + '\" data-seen=\"' + data.seen + '\"></div>' +\n                '<a href=\"' + link + '\" class=\"tr\" data-submit=\"/notification/read/true/' + data.id + '\" data-redirect=\"stay\" onclick=\"notification.readAndRedirect(event)\">' +\n                    '<div class=\"nf-cat\"><i class=\"' + data.classes + '\" aria-hidden=\"true\"></i></div>' +\n                    '<div class=\"nf-title-wrapper\">' +\n                        // '<div class=\"nf-title\">' + data.text + ': ' + data.entityName + ', status: ' + data.entityStatus + '</div>' +\n                        '<div class=\"nf-title\">' + data.message + '</div>' +\n                        '<div class=\"nf-time\">' + date + '</div>' +\n                    '</div>' +\n                '</a>' +\n\n                '<div class=\"nf-controls\">' +\n                    '<a href=\"javascript:void(0)\" onclick=\"notification.dismiss(this)\" data-submit=\"/notification/dismiss/' + data.id + '\" data-redirect=\"stay\" class=\"dismiss\"><i class=\"fa fa-times\" aria-hidden=\"true\"></i></a>' +\n                    '<a href=\"javascript:void(0)\" onclick=\"notification.read(this)\" data-submit=\"/notification/read/true/' + data.id + '\" data-redirect=\"stay\" class=\"mark-read unread\"><i class=\"fa fa-circle\" aria-hidden=\"true\"></i></a>' +\n                    '<a href=\"javascript:void(0)\" onclick=\"notification.read(this)\" data-submit=\"/notification/read/false/' + data.id + '\" data-redirect=\"stay\" class=\"mark-read read\"><i class=\"fa fa-circle-o\" aria-hidden=\"true\"></i></a>' +\n                '</div>' +\n            '</li>';\n\n        renderFunc(nfRow);\n    }\n\n    function renderEmptyNotification() {\n        var nfRow =\n            '<li class=\"empty\">' +\n                '<a href=\"javascript:void(0)\" class=\"tr\">' +\n                    '<div class=\"nf-title-wrapper\">' +\n                        '<div class=\"nf-title\">No notifications available</div>' +\n                    '</div>' +\n                '</a>' +\n            '</li>';\n\n        $('#notifications main ul').html(nfRow);\n    }\n\n    var loadingHTML = function () {\n        return '<li class=\"loading\">' +\n                '<div class=\"box-left box-all\">' +\n                    '<div class=\"box-inner box-1 gradient-anime\"></div>' +\n                '</div>' +\n                '<div class=\"box-inner box-middle box-all\">' +\n                    '<div class=\"box-inner box-2 gradient-anime\"></div>' +\n                    '<div class=\"box-inner box-3 gradient-anime\"></div>' +\n                '</div>' +\n                '<div class=\"box-right box-all\">' +\n                    '<div class=\"box-inner box-4 gradient-anime\"></div>' +\n                    '<div class=\"box-inner box-5 gradient-anime\"></div>' +\n                '</div>' +\n            '</li>';\n    }\n\n    var removeLoading = function () {\n        var $nfMainUL = $('#notifications').children('main').children('ul');\n        $nfMainUL.children('li.loading').animate({\n            'height': 0\n        }, 200, function() {\n            $(this).remove();\n            // Show the empty notification message if the user dismiss them all\n            $('#nf-wrapper').find('li').length === 0 ? renderEmptyNotification() : null;\n        });\n    }\n\n    /*\n     * Listeners\n     */\n\n    notification.haveSeen = function () {\n        if (notification.seen) return;\n\n        var seenNotifications = [];\n        $('#notifications').find('.nf-data').filter(function() {\n            var $this = $(this);\n            if ($this.attr('data-seen') == 'false') {\n                seenNotifications.push($this.attr('data-id'));\n            }\n        });\n\n        $.ajax({\n            url: API_URL + '/seen',\n            type: 'PUT',\n            contentType: 'application/json; charset=utf-8',\n            data: JSON.stringify(seenNotifications)\n        }).done(function (data, textStatus, jqXHR) {\n            if (data.code.toUpperCase() === 'SUCCESS') {\n                notification.seen = true;\n                $nfWrapper.addClass('seen');\n                $nfNumber.text(0);\n            }\n        }).fail(function (jqXHR, textStatus, errorThrown) {\n            console.error(jqXHR.status + \" (\" + errorThrown + \"). Please contact the system administrator\");\n        });\n    };\n\n    notification.batchRead = function () {\n        var data = [];\n        var $data = $('#nf-wrapper').find('li').not('.loading').filter(function() {\n            if (!$(this).hasClass('read')) { // get uread IDs\n                data.push($(this).children('.nf-data').attr('data-id'));\n                return this;\n            }\n        });\n\n        if (data.length === 0) return;\n\n        data = JSON.stringify(data);\n\n        $.ajax({\n            url: API_URL + '/batchread',\n            type: 'PUT',\n            contentType: 'application/json; charset=utf-8',\n            data: data\n        }).done(function (data, textStatus, jqXHR) {\n            if (data.code.toUpperCase() === 'SUCCESS') {\n                $data.addClass('read');\n            }\n        }).fail(function (jqXHR, textStatus, errorThrown) {\n            console.error(jqXHR.status + \" (\" + errorThrown + \"). Please contact the system administrator\");\n        });\n    };\n\n    notification.dismiss = function ($this) {\n        ubi.crud.put($this, function() {\n            // DOM logic when dismiss happens\n            var $li = $($this.closest('li'));\n            $li.animate({\n                'height': 0\n            }, 300, function() {\n                $li.remove();\n                // Show the empty notification message if the user dismiss them all\n                $('#nf-wrapper').find('li').length === 0 ? renderEmptyNotification() : null;\n            });\n        });\n    };\n\n    notification.read = function ($this) {\n        var $this = $($this);\n\n        ubi.crud.put($this, function() {\n            // DOM logic when notification is read\n            var $li = $($this.closest('li'));\n            !$li.hasClass('read') ? $li.addClass('read') : $li.removeClass('read');\n        });\n    };\n\n    notification.readAndRedirect = function (e) {\n        e.preventDefault();\n        var $this = $(e.currentTarget);\n        var $li = $($this.closest('li'));\n        var link = $this.attr('href');\n        link != 'javascript:void(0)' ? page(link) : null;\n        if (!$li.hasClass('read')) {\n            ubi.crud.put($this, function() {\n                // DOM logic when notification is read\n                !$li.hasClass('read') ? $li.addClass('read') : $li.removeClass('read');\n\n            });\n        }\n    };\n\n    notification.loadMore = function () {\n        if (!notification.loadMoreFlag) return;\n\n        var loadingHeight = 55; // the height of <li class=loading/> element\n        var $nfMain = $('#notifications').children('main');\n        var $nfMainUL = $nfMain.children('ul');\n        var $loading = $nfMainUL.children('li.loading');\n        var nfMainHeight = $nfMain.outerHeight();\n        var nfMainULHeight = $nfMainUL.outerHeight();\n\n        var lastID = $nfMainUL.children('li').not('.loading').last().children('.nf-data').attr('data-id');\n\n        // Change opacity according to scrollTop\n        if (nfMainULHeight-($nfMain.scrollTop()+nfMainHeight) <= loadingHeight) {\n            var loadingComparison = loadingHeight - (nfMainULHeight-($nfMain.scrollTop()+nfMainHeight));\n\n            if (loadingComparison >= 0 && loadingComparison < 5) {\n                $loading.css('opacity', 0);\n            } else if (loadingComparison >= 5 && loadingComparison < 10) {\n                $loading.css('opacity', 0.1);\n            } else if (loadingComparison >= 10 && loadingComparison < 15) {\n                $loading.css('opacity', 0.2);\n            } else if (loadingComparison >= 15 && loadingComparison < 20) {\n                $loading.css('opacity', 0.3);\n            } else if (loadingComparison >= 20 && loadingComparison < 25) {\n                $loading.css('opacity', 0.4);\n            } else if (loadingComparison >= 25 && loadingComparison < 30) {\n                $loading.css('opacity', 0.5);\n            } else if (loadingComparison >= 30 && loadingComparison < 35) {\n                $loading.css('opacity', 0.6);\n            } else if (loadingComparison >= 35 && loadingComparison < 40) {\n                $loading.css('opacity', 0.7);\n            } else if (loadingComparison >= 40 && loadingComparison < 45) {\n                $loading.css('opacity', 0.8);\n            } else if (loadingComparison >= 45 && loadingComparison < 50) {\n                $loading.css('opacity', 0.9);\n            } else if (loadingComparison >= 50 && loadingComparison < 55) {\n                $loading.css('opacity', 1);\n            } else {\n                $loading.css('opacity', 1);\n            }\n        }\n\n        if (($nfMain.scrollTop()+nfMainHeight) == nfMainULHeight) {\n            $.ajax({\n                url: API_URL + '/previous/' + lastID,\n                type: 'GET'\n            }).done(function (data, textStatus, jqXHR) {\n                if (data.code.toUpperCase() === 'SUCCESS') {\n                    if (data.returnobject != 'eonf' && data.returnobject.length > 0) {\n                        setTimeout(function () {\n\n                            // Remove loading\n                            removeLoading();\n\n                            // Attach new notifications\n                            data.returnobject.forEach(function (obj) {\n                                // TODO - remove loading li and add it at the end\n                                renderNotification(obj, function (notificationHtml) {\n                                    $nfMainUL.append(notificationHtml);\n                                });\n                            });\n\n                            // Reattach loading\n                            $nfMainUL.append(loadingHTML());\n\n                            // move closer to the new notifications\n                            // $nfMain.animate({ scrollTop: $nfMain.scrollTop() + 100 }, 300);\n\n                        }, ubi.loader.nonBlocking.loadingTime);\n                    } else {\n                        removeLoading();\n                        notification.loadMoreFlag = false;\n                        logger.i(\"No more results to show\");\n                    }\n                }\n            }).fail(function (jqXHR, textStatus, errorThrown) {\n                console.error(jqXHR.status + \" (\" + errorThrown + \"). Please contact the system administrator\");\n            });\n        }\n    };\n\n\n    window.notification = notification;\n\n})(window);\n\n/**\n * Language Selector\n */\n\n(function(window) {\n\n  'use strict';\n\n  ubi.languageSelector = undefined;\n\n  var languageSelectorEvent = function () {\n    var $target = $(this);\n\n    var locale = $target.attr('data-lang');\n    var userlang = $target.attr('user-lang');\n    \n    if (locale !== undefined && locale !== '') {      \n      let path = window.location.href;  \n      var values = locale.split(\"_\");\n      var restPath = \"\";\n      if (path.search('register') >= 0 || path.search('login') >= 0 || path.search('resetpassword') >= 0) {\n        let name = 'register';\n        if (path.search('login') >= 0){\n          name = 'login';\n        } else if (path.search('resetpassword') >= 0){\n          //get the rest path after resetpassword if user_id/validation_id\n          var pathValues = path.split(\"resetpassword/\");\n          // Log to console\n          if (pathValues.length>1){\n            var pathValue = pathValues[1].split(\"/\");  \n            if (pathValue.length >=2 && Number.isInteger(Number(pathValue[0]))){              \n              if (pathValue[1].search(\"\\\\?\") > -1){                  \n                pathValue[1] = pathValue[1].substring(0, pathValue[1].search(\"\\\\?\"));\n              }\n              restPath =  \"/\" + pathValue[0] + \"/\" + pathValue[1];              \n            }\n          }\n          \n          \n          name = 'resetpassword';\n        }                  \n        path = path.substring(0, path.search(name)) + name + restPath +\"/\" + values[1] + '/' + values[0] + '?lang=' + locale;      \n        \n        window.location.replace(path);\n      }else {        \n         if (userlang !== undefined && userlang !== '') {            \n           $.ajax({\n                type: 'POST',\n                url: '/api/v1/user/language/'+values[0] ,\n                processData: false,\n                contentType: false\n            }).done(function (data, textStatus, jqXHR) {\n                window.location.replace('?lang=' + locale);\n            }).error(function (data, textStatus, jqXHR) {\n                alertify.error(ubi.getTranslationExt(\"frontend.message.error.5\")); // \"Please contact the system administrator\"\n            });\n         }else{\n           window.location.replace('?lang=' + locale);\n         }        \n      }\n      \n    }\n  };\n\n  var languageSelector = {\n    addEvents: function () {\n      $(document).on('click', '#lang-wrapper li.lang-selector', languageSelectorEvent);\n    },\n\n    removeEvents: function () {\n      $(document).off('click', '#lang-wrapper li.lang-selector', languageSelectorEvent);\n    }\n  };\n\n  ubi.languageSelector = languageSelector;\n\n})(window);\n\n/**\r\n * Viva Request js logic\r\n */\r\n\r\n(function (window) {\r\n\r\n    'use strict';\r\n\r\n    function gotoAnchor(anchor) {\r\n        window.location.href = '#' + anchor;\r\n\r\n        if (window.scrollY > 0) {\r\n            window.scrollTo(0, 0);\r\n        }\r\n    }\r\n\r\n    function resetErrorsOnTabs() {\r\n        $('#form-tabs li').children('.errors-num').text('');\r\n    }\r\n\r\n    // Calculate position for error messages\r\n    function calcPositionForErrorMsgs($activeFieldsWrapper) {\r\n        $activeFieldsWrapper.find('.form-item').each(function (i, v) {\r\n\r\n            var $formItem = $(v);\r\n\r\n            var $errorEl = $formItem.children('ul');\r\n            var $formItemElements = $formItem.children();\r\n            var formItemElementsHeight = 0;\r\n\r\n            // Calc top position\r\n            var k = 0;\r\n            $formItemElements.each(function (i, v) {\r\n                var $v = $(v);\r\n                if ($v.hasClass('select2-hidden-accessible') || $v.hasClass('parsley-errors-list') || !$v.is(':visible') || $v.is('i')) {\r\n                    return true;\r\n                }\r\n                formItemElementsHeight += $v.outerHeight() + parseInt($v.css('margin-top')) + parseInt($v.css('margin-bottom'));\r\n                k++;\r\n            });\r\n\r\n            // Calc left position\r\n            $errorEl.css('left', 0);\r\n            var errorElWidth = Math.round($errorEl.outerWidth() / 2);\r\n\r\n            $errorEl.css({\r\n                'top': formItemElementsHeight + 'px',\r\n                'left': '50%',\r\n                'margin-left': '-' + errorElWidth + 'px'\r\n            });\r\n        });\r\n    }\r\n\r\n    function enableTabEvents() {\r\n        $('#form-tabs li').on('click', function () {\r\n            var id = this.id.split('-')[1];\r\n            var $this = $(this);\r\n\r\n            if ($this.hasClass('active'))\r\n                return false;\r\n\r\n            $('#form-tabs li').removeClass('active');\r\n            $(this).addClass('active');\r\n\r\n            // $('form#visa-request').children('.tabs-content').hide(0);\r\n            gotoAnchor(id);\r\n            var $activeFieldsWrapper = $('#' + id);\r\n            // $activeFieldsWrapper.show();\r\n\r\n            calcPositionForErrorMsgs($activeFieldsWrapper);\r\n        });\r\n\r\n    }\r\n\r\n    function attachErrorStatically(errorId, element, message) {\r\n        var $el = $('#' + element);\r\n        if ($el.length > 0) {\r\n            $el.addClass('benderr');\r\n            $el.parsley().addError(errorId, {message: message});\r\n        }else if (element === \"duplicate\" || element === \"existsInDB\" || element === \"generalerror\" ){\r\n            //only for duplicate errors  existsInDB\r\n            alertify.error(message);\r\n        }\r\n    }\r\n\r\n    /**\r\n     *\r\n     * @param {Array} errors\r\n     * @returns {boolean} if has errors return true else false\r\n     */\r\n    function checkForErrors(errors) {\r\n        if (errors.length === 0)\r\n            return false;\r\n\r\n        // get error messages if exists\r\n        $.each(errors, function (i, v) {\r\n            attachErrorStatically(v.errorId, v.element, v.message);\r\n        });\r\n\r\n        // calculate parsley message position\r\n        var $activeFieldsWrapper = $('#' + $('#form-tabs').children('ul').children('.active')[0].id.split('-')[1]);\r\n        calcPositionForErrorMsgs($activeFieldsWrapper);\r\n\r\n        // finally show error number indicators on tabs\r\n        showErrorsOnTabs();\r\n\r\n        return true;\r\n    }\r\n\r\n    /*\r\n     * Resets a field without a Message\r\n     * @returns {Boolean}\r\n     */\r\n    function resetFieldWithoutMsg(targetid) {\r\n        console.log('Reseting field: ' + targetid)\r\n        $('#' + targetid).val('').trigger('change');\r\n        //return false;\r\n    }\r\n\r\n    /*\r\n     * Resets a field with a Message\r\n     * @returns {Boolean}\r\n     */\r\n    function resetFieldWithMsg(targetid, msg) {\r\n        console.log('Reseting field: ' + targetid)\r\n        $('#' + targetid).val('').trigger('change');\r\n        alertify.error(msg);\r\n        //return false;\r\n    }\r\n\r\n    function enableUpdateButton(){\r\n        $(\"#form-tabs li\").on('click',ubi.checkTabName);\r\n    }\r\n\r\n    ubi.checkTabName = function (event)  {\r\n        //alert(this.id); id of clicked li by directly accessing DOMElement property\r\n        //alert($(this).html()); gets innerHTML of clicked li\r\n        //alert($(this).text()); gets text contents of clicked li\r\n        let tabName = $(this).attr('id'); // jQuery's .attr() method, same but more verbose\r\n        if (tabName === 'tab-extraservices') {\r\n            //$(\"#btn-newvisa\").hide();\r\n            $(\"#btn-newvisa\").attr('disabled', true);\r\n        } else {\r\n            //$(\"#btn-newvisa\").show();\r\n            $(\"#btn-newvisa\").attr('disabled', false);\r\n        }\r\n    }\r\n\r\n    /*\r\n     * Validator that assures that a date is earlier that now()\r\n     * @param {type} event\r\n     * @returns {undefined}\r\n     */\r\n    ubi.checkDateIsInPastIncludingNow = function (event) {\r\n        console.log('checkDateIsInPastIncludingNow');\r\n        var checkdates = event.target.value;\r\n        if (checkdates === '')\r\n            return;\r\n        var checkdate = createDateFromInput(checkdates);\r\n        var now = new Date();\r\n        now = createDateFromInput(now.getDate() + '/' + (now.getMonth() + 1) + '/' + now.getFullYear());\r\n//        console.log(checkdate,now);\r\n        if (checkdate > now) {\r\n            console.log('Date is NOT acceptable');\r\n            resetFieldWithMsg(event.target.id, ubi.getTranslationExt('frontend.error.22')); //'The field should be earlier than now'\r\n            return;\r\n        } else {\r\n            console.log('Date is acceptable');\r\n            return;\r\n        }\r\n    }//checkDateIsInPastIncludingNow\r\n\r\n    ubi.checkDateIsInPastExcludingNow = function (event) {\r\n        console.log('checkDateIsInPastExcludingNow');\r\n        var checkdates = event.target.value;\r\n        if (checkdates === '')\r\n            return;\r\n        var checkdate = createDateFromInput(checkdates);\r\n        var now = new Date();\r\n        now = createDateFromInput(now.getDate() + '/' + (now.getMonth() + 1) + '/' + now.getFullYear());\r\n//        console.log(checkdate,now);\r\n        if (checkdate >= now) {\r\n            console.log('Date is NOT acceptable');\r\n            resetFieldWithMsg(event.target.id, ubi.getTranslationExt('frontend.error.22')); //'The field should be earlier than now'\r\n            return;\r\n        } else {\r\n            console.log('Date is acceptable');\r\n            return;\r\n        }\r\n    }//checkDateIsInPastExcludingNow\r\n\r\n    /*\r\n     * Validator that assures that a date is later that now()\r\n     * @param {type} event\r\n     * @returns {undefined}\r\n     */\r\n    ubi.checkDateIsInFutureExcludingNow = function (event) {\r\n        console.log('checkDateIsInFutureExcludingNow');\r\n        var checkdates = event.target.value;\r\n        if (checkdates === '')\r\n            return;\r\n        var checkdate = createDateFromInput(checkdates);\r\n        var now = new Date();\r\n        now = createDateFromInput(now.getDate() + '/' + (now.getMonth() + 1) + '/' + now.getFullYear());\r\n//        console.log(checkdate,now);\r\n        if (checkdate <= now) {\r\n            console.log(now, 'Date is NOT acceptable');\r\n            resetFieldWithMsg(event.target.id, ubi.getTranslationExt('frontend.error.25')); //'The field should be later than now'\r\n            return;\r\n        } else {\r\n            console.log('Date is acceptable');\r\n            return;\r\n        }\r\n    }//checkDateIsInFutureExcludingNow\r\n\r\n    ubi.checkPairedDateIsBefore = function (event, futuredate) {\r\n        var target = event.target;\r\n        var value1 = target.value;\r\n        var value2 = document.getElementById(futuredate).value;\r\n        if (value1 !== '' && value2 !== '') {\r\n            if (value1 === value2) {\r\n                resetFieldWithoutMsg(event.target.id);\r\n                alertify.error(ubi.getTranslationExt('frontend.error.44')); // 'Dates should not match'\r\n                return;\r\n            } else\r\n            if (createDateFromInput(value1) > createDateFromInput(value2)) {\r\n                resetFieldWithMsg(event.target.id, ubi.getTranslationExt('frontend.error.45')); //'The date should be always preceding'\r\n                return;\r\n            }\r\n        } else\r\n        if (value1 === '') {\r\n            resetFieldWithoutMsg(futuredate);\r\n            return;\r\n        }\r\n    }//ubi.checkpaireddateisinfuture\r\n\r\n    ubi.checkPairedDateIsAfter = function (event, pastdate) {\r\n        console.log('checkPairedDateIsAfter');\r\n        var target = event.target;\r\n        var value1 = target.value;\r\n        var value2 = document.getElementById(pastdate).value;\r\n        //check that it is in the past\r\n        if (value1 !== '' && value2 !== '') {\r\n            if (value1 === value2) {\r\n                resetFieldWithoutMsg(event.target.id);\r\n                alertify.error(ubi.getTranslationExt('frontend.error.44')); // 'Dates should not match'\r\n                return\r\n            } else\r\n            if (createDateFromInput(value1) < createDateFromInput(value2)) {\r\n                resetFieldWithMsg(event.target.id, ubi.getTranslationExt('frontend.error.46')); // 'The date should be always foregoing'\r\n                return;\r\n            }\r\n        } else\r\n        if (value2 === '' && value1 !== '' &&  pastdate!== 'traveldocumentissuedate') {\r\n            resetFieldWithMsg(event.target.id, ubi.getTranslationExt('frontend.error.47')); // 'This field should be completed second'\r\n            return;\r\n        }\r\n\r\n    }//ubi.checkpaireddateisinfuture\r\n\r\n    function hideDivField(field) {\r\n        $('#div' + field).addClass(\"hidden\");\r\n    }\r\n\r\n    function showDivField(field) {\r\n        $('#div' + field).removeClass(\"hidden\");\r\n    }\r\n\r\n    ubi.checkpropersequenceforFirst = function (event, middle, last, msg) {\r\n        var target = event.target;\r\n        var value1 = target.value;\r\n        var value2 = document.getElementById(middle).value;\r\n        var value3 = document.getElementById(last).value;\r\n        if (msg === undefined){\r\n            msg = ubi.getTranslationExt('frontend.error.48'); // 'Fields should be field in a correct order'\r\n        }\r\n        console.log('checkpropersequenceforFirst: ' + value1 + ' value2: ' + value2 + ' value3: ' + value3);\r\n        //Resetting Other Field Rules\r\n        if (value1 === '') {\r\n            resetFieldWithoutMsg(last);\r\n            resetFieldWithoutMsg(middle);\r\n            return;\r\n        } else\r\n        //Activation of Child\r\n        if (value1 !== '') {\r\n            //render child in any case\r\n            showDivField(middle);\r\n            if (value1 === value2) { //prevent identical\r\n                resetFieldWithMsg(middle, msg)\r\n                return;\r\n            }\r\n            if (value1 === value3) { //prevent identical\r\n                resetFieldWithMsg(last, msg)\r\n                return;\r\n            }\r\n\r\n            return;\r\n        }\r\n    }//EoM\r\n\r\n    ubi.checkpropersequenceforMiddle = function (event, first, last, msg) {\r\n        var target = event.target;\r\n        var value1 = document.getElementById(first).value;\r\n        var value2 = target.value;\r\n        var value3 = document.getElementById(last).value;\r\n        console.log('checkpropersequenceforMiddle: ' + value1 + ' value2: ' + value2 + ' value3: ' + value3);\r\n        if (msg === undefined){\r\n            msg = ubi.getTranslationExt('frontend.error.48'); // 'Fields should be field in a correct order'\r\n        }\r\n        //Resetting Other Field Rules\r\n        if (value2 === '') {\r\n            resetFieldWithoutMsg(last);\r\n            if (value1 === '')\r\n                hideDivField(event.target.id);\r\n            return;\r\n        } else\r\n        //Activation of Child\r\n        if (value2 !== '') {\r\n            showDivField(last);\r\n            if (value2 === value1) { //prevent identical\r\n                resetFieldWithMsg(event.target.id, msg)\r\n                return;\r\n            }\r\n            if (value2 === value3) { //prevent identical\r\n                resetFieldWithMsg(last, msg)\r\n                return;\r\n            }\r\n        }\r\n    }//EoM\r\n\r\n    ubi.checkpropersequenceforLast = function (event, first, middle, msg) {\r\n        var target = event.target;\r\n        var value1 = document.getElementById(first).value;\r\n        var value2 = document.getElementById(middle).value;\r\n        var value3 = target.value;\r\n        if (msg === undefined){\r\n            msg = ubi.getTranslationExt('frontend.error.48'); // 'Fields should be field in a correct order'\r\n        }\r\n        console.log('checkpropersequenceforLast: ' + value1 + ' value2: ' + value2 + ' value3: ' + value3);\r\n        //Requirement for being hidden\r\n        if (value3 === '' && (value1 === '' || value2 === '')) {\r\n            hideDivField(event.target.id);\r\n            return;\r\n        } else\r\n        if (value3 !== '' && ((value3 === value2) || (value3 === value1))) {\r\n            resetFieldWithMsg(event.target.id, msg)\r\n            return;\r\n        }\r\n    }//EoM\r\n\r\n    /**\r\n     *    Frontend validators for preventing future dates   //TODO complete it\r\n     */\r\n    function enableValidatorforDatesInThePast() {\r\n        $('#mrzdateofbirth').on('change', ubi.checkDateIsInPastIncludingNow);                          //Field 4           AllowToday\r\n        $('#dateofbirth').on('change', ubi.checkDateIsInPastIncludingNow);                          //Field 4           AllowToday\r\n        $('#traveldocumentissuedate').on('change', ubi.checkDateIsInPastIncludingNow);              //Field 14          AllowToday      > dateofbirth\r\n        $('#mrztraveldocumentissuedate').on('change', ubi.checkDateIsInPastIncludingNow);              //Field 14          AllowToday      > dateofbirth\r\n        $('#visa1validfrom').on('change', ubi.checkDateIsInPastIncludingNow);                       //Field 26.1.1      AllowToday\r\n        $('#visa2validfrom').on('change', ubi.checkDateIsInPastIncludingNow);                       //Field 26.2.1      AllowToday\r\n        $('#visa3validfrom').on('change', ubi.checkDateIsInPastIncludingNow);                       //Field 26.3.1      AllowToday\r\n        $('#fingerprintspreviouscollectiondate').on('change', ubi.checkDateIsInPastExcludingNow);   //Field 27.2        NotAllow\r\n        $('#entrypermitvalidfrom').on('change', ubi.checkDateIsInPastIncludingNow);                 //Field 28.2        AllowToday\r\n        $('#fmdateofbirth').on('change', ubi.checkDateIsInPastIncludingNow);                        //Field 34.4        AllowToday\r\n    }//enableValidatorforDatesInThePast\r\n\r\n    function enableValidatorforDatesInTheFuture() {\r\n        $('#traveldocumentvaliduntil').on('change', ubi.checkDateIsInFutureExcludingNow);           //Field 15          NotAllow\r\n        $('#mrztraveldocumentvaliduntil').on('change', ubi.checkDateIsInFutureExcludingNow);           //Field 15          NotAllow\r\n        $('#residencepermitvaliduntil').on('change', ubi.checkDateIsInFutureExcludingNow);          //Field 18.4        NotAllow\r\n        $('#intendeddateofarrival').on('change', ubi.checkDateIsInFutureExcludingNow);              //Field 29          NotAllow\r\n    }//enableValidatorforDatesInTheFuture\r\n\r\n    function enableValidatorPairedDates() {\r\n        //Fields 14 15\r\n        $('#traveldocumentissuedate').on('change', function (event) {\r\n            ubi.checkPairedDateIsBefore(event, 'traveldocumentvaliduntil');\r\n        });\r\n        $('#traveldocumentvaliduntil').on('change', function (event) {\r\n            ubi.checkPairedDateIsAfter(event, 'traveldocumentissuedate');\r\n        });\r\n\r\n        //Fields 26.1.1 26.1.2\r\n        $('#visa1validfrom').on('change', function (event) {\r\n            ubi.checkPairedDateIsBefore(event, 'visa1validto');\r\n        });\r\n        $('#visa1validto').on('change', function (event) {\r\n            ubi.checkPairedDateIsAfter(event, 'visa1validfrom');\r\n        });\r\n\r\n        //Fields 26.2.1 26.2.2\r\n        $('#visa2validfrom').on('change', function (event) {\r\n            ubi.checkPairedDateIsBefore(event, 'visa2validto');\r\n        });\r\n        $('#visa2validto').on('change', function (event) {\r\n            ubi.checkPairedDateIsAfter(event, 'visa2validfrom');\r\n        });\r\n\r\n        //Fields 26.3.1 26.3.2\r\n        $('#visa3validfrom').on('change', function (event) {\r\n            ubi.checkPairedDateIsBefore(event, 'visa3validto');\r\n        });\r\n        $('#visa3validto').on('change', function (event) {\r\n            ubi.checkPairedDateIsAfter(event, 'visa3validfrom');\r\n        });\r\n\r\n        //Fields 28.2 28.3\r\n        $('#entrypermitvalidfrom').on('change', function (event) {\r\n            ubi.checkPairedDateIsBefore(event, 'entrypermitvalidto');\r\n        });\r\n        $('#entrypermitvalidto').on('change', function (event) {\r\n            ubi.checkPairedDateIsAfter(event, 'entrypermitvalidfrom');\r\n        });\r\n\r\n        //Fields 29 30\r\n        $('#intendeddateofarrival').on('change', function (event) {\r\n            ubi.checkPairedDateIsBefore(event, 'intendeddateofdeparture');\r\n        });\r\n        $('#intendeddateofdeparture').on('change', function (event) {\r\n            ubi.checkPairedDateIsAfter(event, 'intendeddateofarrival');\r\n        });\r\n\r\n    }//enableValidatorPairedDates\r\n\r\n    function enableValidatorForProperSequentialFilling() {\r\n        //7.1.1 7.1.2 7.1.3     Nationality\r\n        $('#currentnationality1').on('change', function (event) {\r\n            ubi.checkpropersequenceforFirst(event, 'currentnationality2', 'currentnationality3');\r\n          //  ubi.checkpropersequenceforFirst(event, 'currentnationality2', 'nationalityatbirth');\r\n        });\r\n        $('#currentnationality2').on('change', function (event) {\r\n            ubi.checkpropersequenceforMiddle(event, 'currentnationality1', 'currentnationality3', ubi.getTranslationExt('frontend.error.18')); // 'Fields should be different'\r\n            //ubi.checkpropersequenceforMiddle(event, 'currentnationality1', 'nationalityatbirth');\r\n        });\r\n        $('#currentnationality3').on('change', function (event) {\r\n            ubi.checkpropersequenceforLast(event, 'currentnationality1', 'currentnationality2', ubi.getTranslationExt('frontend.error.18')); //'Fields should be different'\r\n            //ubi.checkpropersequenceforLast(event, 'currentnationality1', 'nationalityatbirth');\r\n        });\r\n        /*$('#nationalityatbirth').on('change', function (event) {\r\n            ubi.checkpropersequenceforLast(event, 'currentnationality1', 'currentnationality2');\r\n            ubi.checkpropersequenceforLast(event, 'currentnationality1', 'currentnationality3');\r\n        });*/\r\n\r\n        //21.1.1 Travel purpose\r\n        $('#travelpurpose1').on('change', function (event) {\r\n            ubi.checkpropersequenceforFirst(event, 'travelpurpose2', 'travelpurpose3');\r\n        });\r\n        $('#travelpurpose2').on('change', function (event) {\r\n            ubi.checkpropersequenceforMiddle(event, 'travelpurpose1', 'travelpurpose3');\r\n        });\r\n        $('#travelpurpose3').on('change', function (event) {\r\n            ubi.checkpropersequenceforLast(event, 'travelpurpose1', 'travelpurpose2');\r\n        });\r\n\r\n        //21.2.1 Other purpose\r\n        $('#purpose1other').on('change', function (event) {\r\n            ubi.checkpropersequenceforFirst(event, 'purpose2other', 'purpose3other');\r\n        });\r\n        $('#purpose2other').on('change', function (event) {\r\n            ubi.checkpropersequenceforMiddle(event, 'purpose1other', 'purpose3other');\r\n        });\r\n        $('#purpose3other').on('change', function (event) {\r\n            ubi.checkpropersequenceforLast(event, 'purpose1other', 'purpose2other');\r\n        });\r\n\r\n        //22.1 22.2 22.3  Member state(s) of destination\r\n        $('#memberstatedestination1').on('change', function (event) {\r\n            ubi.checkpropersequenceforFirst(event, 'memberstatedestination2', 'memberstatedestination3');\r\n        });\r\n        $('#memberstatedestination2').on('change', function (event) {\r\n            ubi.checkpropersequenceforMiddle(event, 'memberstatedestination1', 'memberstatedestination3');\r\n        });\r\n        $('#memberstatedestination3').on('change', function (event) {\r\n            ubi.checkpropersequenceforLast(event, 'memberstatedestination1', 'memberstatedestination2');\r\n        });\r\n\r\n        //26.1.1 26.2.1 26.3.1 Previous Visas\r\n        $('#visa1validfrom').on('change', function (event) {\r\n            ubi.checkpropersequenceforFirst(event, 'visa2validfrom', 'visa3validfrom');\r\n        });\r\n        $('#visa2validfrom').on('change', function (event) {\r\n            ubi.checkpropersequenceforMiddle(event, 'visa1validfrom', 'visa3validfrom');\r\n        });\r\n        $('#visa3validfrom').on('change', function (event) {\r\n            ubi.checkpropersequenceforLast(event, 'visa1validfrom', 'visa2validfrom');\r\n        });\r\n        //hidden\r\n        $('#visa1').on('change', function (event) {\r\n            console.log('Hidden event');\r\n            ubi.checkpropersequenceforFirst(event, 'visa2', 'visa3');\r\n        });\r\n        $('#visa2').on('change', function (event) {\r\n            ubi.checkpropersequenceforMiddle(event, 'visa1', 'visa3');\r\n        });\r\n        $('#visa3').on('change', function (event) {\r\n            ubi.checkpropersequenceforLast(event, 'visa1', 'visa2');\r\n        });\r\n\r\n    }//enableValidatorForProperSequentialFilling\r\n\r\n    ubi.checkNotOverlappingTriggeredbyFirstField = function (event, to2, from1, to1) {\r\n        var target = event.target;\r\n        var from2s = target.value;\r\n        var to2s = document.getElementById(to2).value;\r\n        var from1s = document.getElementById(from1).value;\r\n        var to1s = document.getElementById(to1).value;\r\n\r\n        if (from1s !== '' && to1s !== '' && from2s !== '' && to2s !== '') {\r\n            //Create dates\r\n            var from1d = createDateFromInput(from1s);\r\n            var to1d = createDateFromInput(to1s);\r\n            var from2d = createDateFromInput(from2s);\r\n            var to2d = createDateFromInput(to2s);\r\n            //console.log('checking ...\\n'+from1d+' \\n'+to1d+' \\n'+from2d+' \\n'+to2d);\r\n            if (from1d < to1d && from2d < to2d) {\r\n                //console.log('Checking overlap');\r\n                //Check overlap for from2d\r\n                if (from2d > from1d && from2d < to1d) {\r\n                    resetFieldWithoutMsg(to2);\r\n                    resetFieldWithoutMsg(event.target.id);\r\n                    alertify.error(ubi.getTranslationExt('frontend.error.49')); // 'Date ranges should not overlap'\r\n                    console.log('Overlap found');\r\n                    return;\r\n                }\r\n                //Check overlap for to2d\r\n                if (to2d < to1d && to2d > from1d) {\r\n                    resetFieldWithoutMsg(to2);\r\n                    resetFieldWithoutMsg(event.target.id);\r\n                    alertify.error(ubi.getTranslationExt('frontend.error.49')); // 'Date ranges should not overlap'\r\n                    console.log('Overlap found');\r\n                    return;\r\n                }\r\n            }\r\n\r\n        }\r\n    }//EoM\r\n\r\n    ubi.checkNotOverlappingTriggeredbySecondField = function (event, from2, from1, to1) {\r\n        var target = event.target;\r\n        var to2s = target.value;\r\n        var from2s = document.getElementById(from2).value;\r\n        var from1s = document.getElementById(from1).value;\r\n        var to1s = document.getElementById(to1).value;\r\n\r\n        if (from1s !== '' && to1s !== '' && from2s !== '' && to2s !== '') {\r\n            //Create dates\r\n            var from1d = createDateFromInput(from1s);\r\n            var to1d = createDateFromInput(to1s);\r\n            var from2d = createDateFromInput(from2s);\r\n            var to2d = createDateFromInput(to2s);\r\n            //console.log('checking ...\\n'+from1d+' \\n'+to1d+' \\n'+from2d+' \\n'+to2d);\r\n            if (from1d < to1d && from2d < to2d) {\r\n                //console.log('Checking overlap');\r\n                //Check overlap for from2d\r\n                if (from2d > from1d && from2d < to1d) {\r\n                    resetFieldWithoutMsg(from2);\r\n                    resetFieldWithoutMsg(event.target.id);\r\n                    alertify.error(ubi.getTranslationExt('frontend.error.49')); // 'Date range should not overlap'\r\n                    console.log('Overlap found');\r\n                    return;\r\n                }\r\n                //Check overlap for to2d\r\n                if (to2d < to1d && to2d > from1d) {\r\n                    resetFieldWithoutMsg(from2);\r\n                    resetFieldWithoutMsg(event.target.id);\r\n                    alertify.error(ubi.getTranslationExt('frontend.error.49')); // 'Date range should not overlap'\r\n                    console.log('Overlap found');\r\n                    return;\r\n                }\r\n            }\r\n\r\n        }\r\n    }//EoM\r\n\r\n    function enableValidatorForOverlappingAvoidance() {\r\n        $('#visa2validfrom').on('change', function (event) {\r\n            ubi.checkNotOverlappingTriggeredbyFirstField(event, 'visa2validto', 'visa1validfrom', 'visa1validto');\r\n        });\r\n        $('#visa2validto').on('change', function (event) {\r\n            ubi.checkNotOverlappingTriggeredbySecondField(event, 'visa2validfrom', 'visa1validfrom', 'visa1validto');\r\n        });\r\n\r\n        $('#visa3validfrom').on('change', function (event) {\r\n            ubi.checkNotOverlappingTriggeredbyFirstField(event, 'visa3validto', 'visa2validfrom', 'visa2validto');\r\n        });\r\n        $('#visa3validto').on('change', function (event) {\r\n            ubi.checkNotOverlappingTriggeredbySecondField(event, 'visa3validfrom', 'visa2validfrom', 'visa2validto');\r\n        });\r\n        $('#visa3validfrom').on('change', function (event) {\r\n            ubi.checkNotOverlappingTriggeredbyFirstField(event, 'visa3validto', 'visa1validfrom', 'visa1validto');\r\n        });\r\n        $('#visa3validto').on('change', function (event) {\r\n            ubi.checkNotOverlappingTriggeredbySecondField(event, 'visa3validfrom', 'visa1validfrom', 'visa1validto');\r\n        });\r\n\r\n    }//enableValidatorForOverlappingAvoidance\r\n\r\n    function enableHostingEvents() {\r\n        $('#hostingoption').on('change', function (event) {     //$('#maritalstatus')\r\n\r\n            var value = event.target.value;\r\n            console.log('Hosting option change:', value);\r\n            var cl = value.toLowerCase().replace(/_/g, '');\r\n\r\n            // hide all at first\r\n            $('.parent-fm-wrap').hide();\r\n            // show only the related family member fields\r\n            $('.' + cl).show();\r\n\r\n            $('#costoftravling-init-text').hide();\r\n            $('#accommodation-init-text').hide();\r\n\r\n\r\n            if (value === 'EU_FAMILY_MEMBER') {\r\n                // reset all values on cost of traveling\r\n                resetCostTabAll();\r\n                $('#accommodation-inner').find('.form-control').not('.noreset').val('').trigger('change');\r\n                $('#accommodation-inner').find('.form-control').attr('checked', false);\r\n                //$('#means-support-wrap').hide();\r\n                // hide cost of traveling form if value is EU_FAMILY_MEMBER\r\n                //show no obligation\r\n                $('#costoftravelling-nodrop').removeClass(\"hidden\");\r\n                $('#accommodation-nodrop').removeClass(\"hidden\");\r\n                //hide inner\r\n                $('#costoftravelling-inner').addClass(\"hidden\");\r\n                $('#accommodation-inner').addClass(\"hidden\");\r\n            } else {    //we have obbligation\r\n                //show inner\r\n                $('#costoftravelling-inner').removeClass(\"hidden\");\r\n                $('#accommodation-inner').removeClass(\"hidden\");\r\n                //hide no-obligation\r\n                $('#costoftravelling-nodrop').addClass(\"hidden\");\r\n                $('#accommodation-nodrop').addClass(\"hidden\");\r\n            }\r\n\r\n            if (value === 'EU_FAMILY_MEMBER') {\r\n                $('#host1').removeClass(\"hidden\");\r\n                $('#host1').show();\r\n                $('#host2').addClass(\"hidden\");\r\n                $('#host2').hide();\r\n                $('#host2').find('.form-control').not('.noreset').val('').trigger('change');\r\n                $('#host3').addClass(\"hidden\");\r\n                $('#host3').hide();\r\n                $('#host3').find('.form-control').not('.noreset').val('').trigger('change');\r\n                $('#fminvitinganysurname').val('');\r\n                $('#hostingSelectDiv').addClass(\"hidden\");\r\n                $('#accommodationname').val('');\r\n\r\n            }\r\n\r\n            if (value === 'INVITING_PERSON') {\r\n                if ($('#fminvitinganysurname').val()==='HOTEL OR TEMPORARY ACCOMMODATION'){\r\n                    $('#fminvitinganysurname').val('');\r\n                }\r\n                $('#host2').removeClass(\"hidden\");\r\n                $('#host2').show();\r\n                $('#host1').addClass(\"hidden\");\r\n                $('#host1').hide();\r\n                $('#host1').find('.form-control').not('.noreset').val('').trigger('change');\r\n                $('#host3').addClass(\"hidden\");\r\n                $('#host3').hide();\r\n                $('#host3').find('.form-control').not('.noreset').val('').trigger('change');\r\n                $('#fminvitinganysurname').val('');\r\n                $('#hostingSelectDiv').removeClass(\"hidden\");\r\n                $('#accommodationname').val('');\r\n                $('#accommodationnameDiv').addClass(\"hidden\");\r\n\r\n\r\n            }\r\n\r\n            if (value === 'INVITING_COMPANY') {\r\n                $('#host3').removeClass(\"hidden\");\r\n                $('#host3').show();\r\n                $('#host1').addClass(\"hidden\");\r\n                $('#host1').hide();\r\n                $('#host1').find('.form-control').not('.noreset').val('').trigger('change');\r\n                $('#host2').addClass(\"hidden\");\r\n                $('#host2').hide();\r\n                $('#host2').find('.form-control').not('.noreset').val('').trigger('change');\r\n                $('#fminvitinganysurname').val('');\r\n                $('#hostingSelectDiv').removeClass(\"hidden\");\r\n                $('#accommodationnameDiv').removeClass(\"hidden\");\r\n            }\r\n\r\n            if (value === 'HOTEL_TEMP_ACCOMMODATION') {\r\n                $('#host1').addClass(\"hidden\");\r\n                $('#host1').hide();\r\n                $('#host1').find('.form-control').not('.noreset').val('').trigger('change');\r\n\r\n                $('#host2').addClass(\"hidden\");\r\n                $('#host2').hide();\r\n                $('#host2').find('.form-control').not('.noreset').val('').trigger('change');\r\n\r\n                $('#host3').addClass(\"hidden\");\r\n                $('#host3').hide();\r\n                $('#host3').find('.form-control').not('.noreset').val('').trigger('change');\r\n\r\n                //$('#fminvitinganysurname').val('HOTEL OR TEMPORARY ACCOMMODATION');\r\n                $('#hostingSelectDiv').removeClass(\"hidden\");\r\n                $('#accommodationnameDiv').removeClass(\"hidden\");\r\n\r\n            }\r\n        });\r\n\r\n        $('#fmrelationshiptype').on('change', function (event) {\r\n            var target = event.target;\r\n            var value = target.value;\r\n            //alert(value);\r\n            if (value === '6') {\r\n                $('#divfmrelationshiptypeother').removeClass(\"hidden\");\r\n                $('#divfmrelationshiptypeother').addClass(\"required\");\r\n                $('#divfmrelationshiptypeother').show();\r\n            } else {\r\n                $('#divfmrelationshiptypeother').addClass(\"hidden\");\r\n                $('#divfmrelationshiptypeother').removeClass(\"required\");\r\n                $('#divfmrelationshiptypeother').hide();\r\n                $('#fmrelationshiptypeother').val('');\r\n            }\r\n        });\r\n\r\n\r\n    }\r\n\r\n    function resetCostTabAll() {\r\n        $('#means-support-wrap').addClass(\"hidden\");\r\n        $('input[name=costoption]').attr('checked', false);\r\n        $('#meansofsupport1').prop('selectedIndex', 0)\r\n        $('#meansofsupport2').prop('selectedIndex', 0)\r\n        $('#meansofsupport3').prop('selectedIndex', 0)\r\n        document.getElementById('meansofsupportother1').value = '';\r\n        document.getElementById('meansofsupportother2').value = '';\r\n        document.getElementById('meansofsupportother3').value = '';\r\n    }\r\n\r\n    function enableCostTravelingEvents() {\r\n        $('#costoption').on('change', function (event) {\r\n            var value = event.target.value;\r\n            console.log('Cost option change:', value);\r\n            if (value != '') {\r\n                $('#means-support-wrap').removeClass(\"hidden\");\r\n            }\r\n\r\n            if (value === 'APPLICANT') {\r\n                console.log('Applicant');\r\n                $('#means1').removeClass(\"hidden\");\r\n                $('#means2').addClass(\"hidden\");\r\n                $('#means2').find('.form-control').val('').trigger('change');\r\n                $('#means3').addClass(\"hidden\");\r\n                $('#means3').find('.form-control').val('').trigger('change');\r\n                $('input[name=\"meansofsupportlist2[][id]\"]:checked').prop('checked', false);\r\n                $('input[name=\"meansofsupportlist3[][id]\"]:checked').prop('checked', false);\r\n            } else if (value === 'SPONSOR_REFERRED_3X') {\r\n                $('#means1').addClass(\"hidden\");\r\n                $('#means1').find('.form-control').val('').trigger('change');\r\n                $('#means2').removeClass(\"hidden\");\r\n                $('#means3').addClass(\"hidden\");\r\n                $('#means3').find('.form-control').val('').trigger('change');\r\n                $('input[name=\"meansofsupportlist1[][id]\"]:checked').prop('checked', false);\r\n                $('input[name=\"meansofsupportlist3[][id]\"]:checked').prop('checked', false);\r\n            } else if (value === 'OTHER_SPONSOR') {\r\n                $('#means1').addClass(\"hidden\");\r\n                $('#means1').find('.form-control').val('').trigger('change');\r\n                $('#means2').addClass(\"hidden\");\r\n                $('#means2').find('.form-control').val('').trigger('change');\r\n                $('#means3').removeClass(\"hidden\");\r\n                $('input[name=\"meansofsupportlist1[][id]\"]:checked').prop('checked', false);\r\n                $('input[name=\"meansofsupportlist2[][id]\"]:checked').prop('checked', false);\r\n            } else {\r\n                //should never be here\r\n            }\r\n        });\r\n    }\r\n\r\n    function cleanEUMemberData(isEUMember){\r\n        if (isEUMember){\r\n            //clear employer data\r\n            $('#employername').val('');\r\n            $('#employerstreet').val('');\r\n            $('#employerpostal').val('');\r\n            $('#employercity').val('');\r\n\r\n            $('#employercountry').val('');\r\n            $('#employerphonenumberprefix').val('');\r\n            $('#employerphonenumber').val('');\r\n\r\n            //clear Cost of Travelling\r\n            $('#costoption').val('');\r\n            if ($( \"[id^='meansofsupportlist']\" )){\r\n                $.each($( \"[id^='meansofsupportlist']\" ), function(index, elem){\r\n                    $(\"#\"+elem.id).prop('checked', false);\r\n                });\r\n            }\r\n            $.each($( \"[id^='meansofsupportother']\" ), function(index, elem){\r\n                $(\"#\"+elem.id).val('');\r\n                $(\"#div\"+elem.id).addClass(\"hidden\");\r\n            });\r\n            $('#meansofsupportothersponsorname').val('');\r\n        }\r\n    }\r\n\r\n    function enableEUMemberEvents() {\r\n        $('#eumember').on('change', function (event) {\r\n\r\n            var value = event.target.value;\r\n            if (value && value === 'true') {\r\n                console.log('Eu changed to true - Adapting dropdowns');\r\n                //hide-show\r\n                $('#employerschool').addClass(\"hidden\");\r\n                //remove choices\r\n                $(\"#hostingoption option[value='EU_FAMILY_MEMBER']\").remove();\r\n                $(\"#hostingoption option[value='INVITING_PERSON']\").remove();\r\n                $(\"#hostingoption option[value='INVITING_COMPANY']\").remove();\r\n                $(\"#hostingoption option[value='HOTEL_TEMP_ACCOMMODATION']\").remove();\r\n                var $option1 = $(\"#placeholderhidden option[value='EU_FAMILY_MEMBER']\").clone();\r\n                $(\"#hostingoption\").append($option1);\r\n                //autoselect\r\n                $('#hostingoption').val('EU_FAMILY_MEMBER').trigger('change');\r\n\r\n                $('#fmnamediv').addClass(\"required\");\r\n                $('#fmsurnamediv').addClass(\"required\");\r\n                $('#fmnationalitydiv').addClass(\"required\");\r\n                $('#fmdateofbirthdiv').addClass(\"required\");\r\n                $('#fmtraveldociddiv').addClass(\"required\");\r\n                $('#fmrelationshiptypediv').addClass(\"required\");\r\n\r\n                $('#costoption').val('').trigger('change');\r\n                cleanEUMemberData(true);\r\n\r\n\r\n\r\n            } else { //false\r\n                //hide-show\r\n                $('#employerschool').removeClass(\"hidden\");\r\n                //remove choices\r\n                $(\"#hostingoption option[value='EU_FAMILY_MEMBER']\").remove();\r\n                $(\"#hostingoption option[value='INVITING_PERSON']\").remove();\r\n                $(\"#hostingoption option[value='INVITING_COMPANY']\").remove();\r\n                $(\"#hostingoption option[value='HOTEL_TEMP_ACCOMMODATION']\").remove();\r\n                var $option2 = $(\"#placeholderhidden option[value='INVITING_PERSON']\").clone();\r\n                var $option3 = $(\"#placeholderhidden option[value='INVITING_COMPANY']\").clone();\r\n                var $option4 = $(\"#placeholderhidden option[value='HOTEL_TEMP_ACCOMMODATION']\").clone();\r\n\r\n                $(\"#hostingoption\").append($option4);\r\n                $(\"#hostingoption\").append($option2);\r\n                $(\"#hostingoption\").append($option3);\r\n//                $(\"#hostingoption\").append( $(\"#placeholderhidden option[value='INVITING_PERSON']\") );\r\n//                $(\"#hostingoption\").append( $(\"#placeholderhidden option[value='INVITING_COMPANY']\") );\r\n\r\n\r\n                //autoselect\r\n                $('#hostingoption').val('HOTEL_TEMP_ACCOMMODATION').trigger('change');\r\n\r\n                $('#fmnamediv').removeClass(\"required\");\r\n                $('#fmsurnamediv').removeClass(\"required\");\r\n                $('#fmnationalitydiv').removeClass(\"required\");\r\n                $('#fmdateofbirthdiv').removeClass(\"required\");\r\n                $('#fmtraveldociddiv').removeClass(\"required\");\r\n                $('#fmrelationshiptypediv').removeClass(\"required\");\r\n            }\r\n        });\r\n    }\r\n\r\n    function enableMaritalStatusOtherEvents() {\r\n        $('#maritalstatus').on('change', function (event) {\r\n            var target = event.target;\r\n            var value = target.value;\r\n            //alert(value);\r\n            if (value === '1') {\r\n                $('#divmaritalstatusother').removeClass(\"hidden\");\r\n                $('#divmaritalstatusother').addClass(\"required\");\r\n                $('#divmaritalstatusother').show();\r\n            } else {\r\n                $('#divmaritalstatusother').addClass(\"hidden\");\r\n                $('#divmaritalstatusother').removeClass(\"required\");\r\n                $('#divmaritalstatusother').hide();\r\n                $('#maritalstatusother').val('');\r\n            }\r\n        });\r\n    }\r\n\r\n    function enableTravelDocumentTypeOtherEvents() {\r\n        $('#traveldocumenttype').on('change', function (event) {\r\n            var target = event.target;\r\n            var value = target.value;\r\n            //alert(value);\r\n            if (value === '13') {\r\n                $('#divtraveldocumenttypeother').removeClass(\"hidden\");\r\n                $('#divtraveldocumenttypeother').addClass(\"required\");\r\n                $('#divtraveldocumenttypeother').show();\r\n            } else {\r\n                $('#divtraveldocumenttypeother').addClass(\"hidden\");\r\n                $('#divtraveldocumenttypeother').removeClass(\"required\");\r\n                $('#divtraveldocumenttypeother').hide();\r\n                $('#traveldocumenttypeother').val('');\r\n            }\r\n        });\r\n    }\r\n\r\n    function enableCurrentOccupationOtherEvents() {\r\n        $('#currentoccupation').on('change', function (event) {\r\n            var target = event.target;\r\n            var value = target.value;\r\n            //alert(value);\r\n            if (value === '36') {\r\n                $('#divcurrentoccupationother').removeClass(\"hidden\");\r\n                $('#divcurrentoccupationother').addClass(\"required\");\r\n                $('#divcurrentoccupationother').show();\r\n            } else {\r\n                $('#divcurrentoccupationother').addClass(\"hidden\");\r\n                $('#divcurrentoccupationother').removeClass(\"required\");\r\n                $('#divcurrentoccupationother').hide();\r\n                $('#currentoccupationother').val('');\r\n            }\r\n        });\r\n    }\r\n\r\n    function enableResidenceOtherEvents() {\r\n        $('#residenceinothercountry').on('change', function (event) {\r\n            var target = event.target;\r\n            var value = target.value;\r\n            //alert(value);\r\n            if (value === 'true') {\r\n                $('#divresidenceother').removeClass(\"hidden\");\r\n                $('#divresidenceother').addClass(\"required\");\r\n                $('#divresidenceother').show();\r\n            } else {\r\n                $('#divresidenceother').addClass(\"hidden\");\r\n                $('#divresidenceother').removeClass(\"required\");\r\n                $('#divresidenceother').hide();\r\n                $('#divresidenceother').find('.form-control').val('');\r\n            }\r\n        });\r\n    }\r\n\r\n    function enableInsurance() {\r\n        $('#hasinsurance').on('change', function (event) {\r\n            var target = event.target;\r\n            var value = target.value;\r\n            console.log(value);\r\n            if (value === 'true') {\r\n                $('#divinsurance').addClass(\"hidden\");\r\n                $('#divinsurance').removeClass(\"required\");\r\n                $('#divinsurance').hide();\r\n                $('#divinsurance').find('.form-control').removeClass(\"required\");\r\n            } else {\r\n                $('#divinsurance').removeClass(\"hidden\");\r\n                $('#divinsurance').addClass(\"required\");\r\n                $('#divinsurance').show();\r\n                $('#divinsurance').find('.form-control').addClass(\"required\");\r\n            }\r\n        });\r\n    }\r\n\r\n    function enableDeliveryAddress() {\r\n            $('#deliverysameasresidence').on('change', function (event) {\r\n                var target = event.target;\r\n                var value = target.value;\r\n                console.log(value);\r\n                if (value === 'true') {\r\n                    $('#divdelivery').addClass(\"hidden\");\r\n                    $('#divdelivery').removeClass(\"required\");\r\n                    $('#divdelivery').hide();\r\n                    $('#divdelivery').find('.form-control').removeClass(\"required\");\r\n                } else {\r\n                    $('#divdelivery').removeClass(\"hidden\");\r\n                    $('#divdelivery').addClass(\"required\");\r\n                    $('#divdelivery').show();\r\n                    $('#divdelivery').find('.form-control').addClass(\"required\");\r\n                    // clear the delivery fields every time the user changes answer to No\r\n                    $('#divdelivery').find('.form-control').val('');\r\n                }\r\n            });\r\n        }\r\n\r\n    function enableMeansofsupportOtherEvents() {\r\n        $('#meansofsupportArray1').on('change', function (event) {\r\n            console.log('Means1 changed');\r\n            var target = event.target;\r\n            var isOtherSelected = false;\r\n            var values = $('input[name=\"meansofsupportlist1[][id]\"]:checked');\r\n            for (var i = 0; i < values.length; i++) {\r\n              var value = values[i];\r\n              if (values[i].value === '6'){\r\n                  isOtherSelected = true;\r\n              }\r\n            }\r\n            //var value = target.value;\r\n            if (isOtherSelected) {\r\n                $('#divmeansofsupportother1').removeClass(\"hidden\");\r\n                $('#divmeansofsupportother1').addClass(\"required\");\r\n                $('#divmeansofsupportother1').show();\r\n            } else {\r\n                $('#divmeansofsupportother1').addClass(\"hidden\");\r\n                $('#divmeansofsupportother1').removeClass(\"required\");\r\n                $('#divmeansofsupportother1').hide();\r\n                document.getElementById('meansofsupportother1').value = '';\r\n            }\r\n        });\r\n\r\n        $('#meansofsupportArray2').on('change', function (event) {\r\n            console.log('Means2 changed');\r\n            var target = event.target;\r\n            var isOtherSelected = false;\r\n            var values = $('input[name=\"meansofsupportlist2[][id]\"]:checked');\r\n            for (var i = 0; i < values.length; i++) {\r\n              var value = values[i];\r\n              if (values[i].value === '6'){\r\n                  isOtherSelected = true;\r\n              }\r\n            }\r\n            //var value = target.value;\r\n            if (isOtherSelected) {\r\n                $('#divmeansofsupportother2').removeClass(\"hidden\");\r\n                $('#divmeansofsupportother2').addClass(\"required\");\r\n                $('#divmeansofsupportother2').show();\r\n            } else {\r\n                $('#divmeansofsupportother2').addClass(\"hidden\");\r\n                $('#divmeansofsupportother2').removeClass(\"required\");\r\n                $('#divmeansofsupportother2').hide();\r\n                document.getElementById('meansofsupportother2').value = '';\r\n            }\r\n        });\r\n\r\n        $('#meansofsupportArray3').on('change', function (event) {\r\n            console.log('Means3 changed');\r\n            var target = event.target;\r\n            var isOtherSelected = false;\r\n            var values = $('input[name=\"meansofsupportlist3[][id]\"]:checked');\r\n            for (var i = 0; i < values.length; i++) {\r\n              var value = values[i];\r\n              if (values[i].value === '6'){\r\n                  isOtherSelected = true;\r\n              }\r\n            }\r\n            //var value = target.value;\r\n            if (isOtherSelected) {\r\n                $('#divmeansofsupportother3').removeClass(\"hidden\");\r\n                $('#divmeansofsupportother3').addClass(\"required\");\r\n                $('#divmeansofsupportother3').show();\r\n            } else {\r\n                $('#divmeansofsupportother3').addClass(\"hidden\");\r\n                $('#divmeansofsupportother3').removeClass(\"required\");\r\n                $('#divmeansofsupportother3').hide();\r\n                document.getElementById('meansofsupportother3').value = '';\r\n            }\r\n        });\r\n\r\n    }//EoM\r\n\r\n\r\n    function enablePreviousVisas() {\r\n        $('#othervisasandpermits').on('change', function (event) {\r\n            var target = event.target;\r\n            var value = target.value;\r\n            //alert(value);\r\n            if (value === 'true') {\r\n                $('#divpreviousvisas').removeClass(\"hidden\");\r\n                $('#divpreviousvisas').show();\r\n            } else {\r\n                $('#divpreviousvisas').addClass(\"hidden\");\r\n                $('#divpreviousvisas').hide();\r\n                $('#divpreviousvisas').find('.form-control').val('');\r\n            }\r\n        });\r\n    }//EoM\r\n\r\n    function enablePreviousFingerprintsEvents() {\r\n        $('#fingerprintscollectedpreviously').on('change', function (event) {\r\n            var target = event.target;\r\n            var value = target.value;\r\n            console.log(\"enablePreviousFingerprintsEvents = \"+value);\r\n            //alert(value);\r\n            if (value === '1') {\r\n                if ($('#divfingerprintsprevious2')){\r\n                    $('#divfingerprintsprevious2').addClass(\"hidden\");\r\n                    $('#divfingerprintsprevious2').hide();\r\n                    $('#divfingerprintsprevious2').find('.form-control').val('');\r\n                }\r\n                $('#divfingerprintsprevious').removeClass(\"hidden\");\r\n                $('#divfingerprintsprevious').show();\r\n            } else if (value === '0') {\r\n                $('#divfingerprintsprevious').addClass(\"hidden\");\r\n                $('#divfingerprintsprevious').hide();\r\n                $('#divfingerprintsprevious').find('.form-control').val('');\r\n                if ($('#divfingerprintsprevious2')){\r\n                    $('#divfingerprintsprevious2').addClass(\"hidden\");\r\n                    $('#divfingerprintsprevious2').hide();\r\n                    $('#divfingerprintsprevious2').find('.form-control').val('');\r\n                }\r\n            } else if (value === '2') {\r\n                $('#divfingerprintsprevious').addClass(\"hidden\");\r\n                $('#divfingerprintsprevious').hide();\r\n                $('#divfingerprintsprevious').find('.form-control').val('');\r\n                $('#divfingerprintsprevious2').removeClass(\"hidden\");\r\n                $('#divfingerprintsprevious2').show();\r\n            } else{\r\n                $('#divfingerprintsprevious').addClass(\"hidden\");\r\n                $('#divfingerprintsprevious').hide();\r\n                $('#divfingerprintsprevious').find('.form-control').val('');\r\n                if ($('#divfingerprintsprevious2')){\r\n                    $('#divfingerprintsprevious2').addClass(\"hidden\");\r\n                    $('#divfingerprintsprevious2').hide();\r\n                    $('#divfingerprintsprevious2').find('.form-control').val('');\r\n                }\r\n            }\r\n        });\r\n    }//EoM\r\n\r\n    function enableEntryPermitEvents() {\r\n        $('#entrypermitissuedforfinaldestination').on('change', function (event) {\r\n            var target = event.target;\r\n            var value = target.value;\r\n            //alert(value);\r\n            if (value === 'true') {\r\n                $('#diventrypermitissuedforfinaldestination').removeClass(\"hidden\");\r\n                $('#diventrypermitissuedforfinaldestination').show();\r\n            } else {\r\n                $('#diventrypermitissuedforfinaldestination').addClass(\"hidden\");\r\n                $('#diventrypermitissuedforfinaldestination').hide();\r\n                $('#diventrypermitissuedforfinaldestination').find('.form-control').val('');\r\n            }\r\n        });\r\n    }//EoM\r\n\r\n    //Calculations\r\n    function createDateFromInput(input) {\r\n        var s = input.split('/'); //split Date of birth dd/MM/yyyy  Days = s[0] | Months = s[1] | Years = s[2]\r\n        //he ISO 8601 syntax (YYYY-MM-DD)\r\n        var newDateofFieldFormat = s[2] + '-' + s[1] + '-' + s[0];\r\n        var dateoffieldDate = new Date(newDateofFieldFormat);\r\n        dateoffieldDate.setHours(0, 0, 0, 0);\r\n        return dateoffieldDate;\r\n    }//EoM\r\n\r\n    function dateDiffInYears(dateold, datenew) {\r\n        var ynew = datenew.getFullYear();\r\n        var mnew = datenew.getMonth();\r\n        var dnew = datenew.getDate();\r\n        var yold = dateold.getFullYear();\r\n        var mold = dateold.getMonth();\r\n        var dold = dateold.getDate();\r\n        var diff = ynew - yold;\r\n        if (mold > mnew)\r\n            diff--;\r\n        else {\r\n            if (mold === mnew) {\r\n                if (dold > dnew)\r\n                    diff--;\r\n            }\r\n        }\r\n        return diff;\r\n    }//EoM\r\n\r\n    //na dw an mporw na xrhsimopoihsw ayto\r\n    function isAgeLessThan12(dateold, datenew, age) {\r\n        if (age < 12){\r\n          return true;\r\n        }\r\n        if (age > 12){\r\n          return false;\r\n        }\r\n        \r\n        var ynew = datenew.getFullYear();\r\n        var mnew = datenew.getMonth();\r\n        var dnew = datenew.getDate();\r\n        var yold = dateold.getFullYear();\r\n        \r\n        var mold = dateold.getMonth();\r\n        var dold = dateold.getDate();                \r\n        \r\n        if (mold > mnew)\r\n            return true;\r\n        else {\r\n            if (mold === mnew) {\r\n                if (dold >= dnew)\r\n                    return true;\r\n                    \r\n            }\r\n        }\r\n        return false;\r\n    }//EoM\r\n\r\n\r\n    function enableVarappointment(){\r\n\r\n        $('#indiwithoutappointmentfromfilter').on('change',function(event){\r\n            let withoutappointment = $(\"#indiwithoutappointmentfromfilter\").val();\r\n            if(withoutappointment){\r\n                $(\"#withappointmentfromfilter\").prop(\"checked\",false);\r\n                $(\"#tawithoutappointmentfromfilter\").prop(\"checked\",false);\r\n                $(\"#appointmentid\").val('').trigger('change');\r\n                $(\"#appointmentPassport\").addClass(\"hidden\");\r\n                $(\"#appointmentDate\").addClass(\"hidden\");\r\n                $(\"#appointmentName\").addClass(\"hidden\");\r\n                $(\"#appointmentSurname\").addClass(\"hidden\");\r\n                $(\"#appointmentType\").addClass(\"hidden\");\r\n                $(\"#appointmentPaidamount\").addClass(\"hidden\");\r\n\r\n            }\r\n        });\r\n\r\n        $('#withappointmentfromfilter').on('change',function(event){\r\n            let withappointmentfromfilter = $(\"#withappointmentfromfilter\").val();\r\n            $(\"#indiwithoutappointmentfromfilter\").prop(\"checked\",false);\r\n            $(\"#tawithoutappointmentfromfilter\").prop(\"checked\",false);\r\n        });\r\n\r\n        $('#appointmentid').on('change',function(event){\r\n            let appointmentid = $(\"#appointmentid\").val();\r\n            let applicationid = $(\"#application\").val();\r\n\r\n            // console.log(applicationid);\r\n            // console.log(appointmentid);\r\n\r\n            //create\r\n            if(appointmentid && (applicationid === undefined || applicationid === '')){\r\n                $(\"#withappointmentfromfilter\").prop(\"checked\",true);\r\n                $(\"#indiwithoutappointmentfromfilter\").prop(\"checked\",false);\r\n                $(\"#tawithoutappointmentfromfilter\").prop(\"checked\",false);\r\n                if(appointmentid === ''){\r\n                    alertify.error($(\"#alertmsg\").html());\r\n                }else{\r\n                    $.ajax({\r\n                    type: 'POST',\r\n                    url: \"/api/v1/var/appointmentdetails/\"+appointmentid,\r\n                    processData: false,\r\n                    contentType: false\r\n                    }).done(function (data, textStatus, jqXHR) {\r\n                    if (textStatus.toUpperCase() == \"SUCCESS\" && data.code.toUpperCase() === \"SUCCESS\") {\r\n                        var date = new Date();\r\n                        var ynew = date.getFullYear();\r\n                        var mnew = (date.getMonth() + 1).toString().padStart(2,\"0\");\r\n                        var dnew = date.getDate();\r\n                        var nowDate = dnew + \"/\" + mnew + \"/\" + ynew;\r\n                        console.log(nowDate);\r\n                        if(nowDate == data.returnobject.fromtimestamp){\r\n                            $(\"#appointmentDate\").removeClass(\"hidden\");\r\n                            $(\"#appointmentDate\").text(data.returnobject.fromtimestamp);\r\n                        }else{\r\n                            $(\"#appointmentDate\").removeClass(\"hidden\");\r\n                            $(\"#appointmentDate\").text(data.returnobject.fromtimestamp);\r\n                            $(\"#appointmentDate\").css(\"color\",\"red\");\r\n                        }\r\n                        $(\"#appointmentPassport\").removeClass(\"hidden\");\r\n                        $(\"#appointmentName\").removeClass(\"hidden\");\r\n                        $(\"#appointmentSurname\").removeClass(\"hidden\");\r\n                        $(\"#appointmentType\").removeClass(\"hidden\");\r\n                        $(\"#appointmentPaidamount\").removeClass(\"hidden\");\r\n\r\n                        $(\"#appointmentPassport\").text(data.returnobject.passport);\r\n                        $(\"#appointmentName\").text(data.returnobject.firstname);\r\n                        $(\"#appointmentSurname\").text(data.returnobject.surname);\r\n                        $(\"#appointmentPaidamount\").text(data.returnobject.paidamount);\r\n\r\n//                        $(\"#appointmentType\").text(data.returnobject.type);\r\n\r\n\r\n                        switch (data.returnobject.type) {\r\n                          case 0:\r\n                            $(\"#appointmentType\").text(\"Submision Type C\");\r\n                            break;\r\n                          case 1:\r\n                            $(\"#appointmentType\").text(\"Travel Agent\");\r\n                            break;\r\n                          case 2:\r\n                            $(\"#appointmentType\").text(\"Visa D\");\r\n                            break;\r\n                          case 3:\r\n                            $(\"#appointmentType\").text(\"Passport Return\");\r\n                            break;\r\n                          case 4:\r\n                            $(\"#appointmentType\").text(\"TA Passport Return\");\r\n                            break;\r\n                          case 5:\r\n                            $(\"#appointmentType\").text(\"VIP\");\r\n                            break;\r\n                          case 6:\r\n                            $(\"#appointmentType\").text(\"Prime Time\");\r\n                            break;\r\n                          case 7:\r\n                            $(\"#appointmentType\").text(\"Submission Call Center\");\r\n                            break;\r\n                          case 8:\r\n                            $(\"#appointmentType\").text(\"Personal Assistance\");\r\n                            break;\r\n                          case 9:\r\n                            $(\"#appointmentType\").text(\"Tour Leaders\");\r\n                            break;\r\n                        }\r\n                    }else{\r\n                        alertify.error(data.message);\r\n                    }\r\n                    }).error(function (data, textStatus, jqXHR) {\r\n                        alertify.error(data.message);\r\n                        });\r\n                    }\r\n            }\r\n\r\n                        //update\r\n                        if(appointmentid && application){\r\n                        console.log(\"inside update\");\r\n                        console.log(appointmentid);\r\n                        console.log(applicationid);\r\n                            $(\"#withappointmentfromfilter\").prop(\"checked\",true);\r\n                            $(\"#indiwithoutappointmentfromfilter\").prop(\"checked\",false);\r\n                            $(\"#tawithoutappointmentfromfilter\").prop(\"checked\",false);\r\n                            if(appointmentid === ''){\r\n                                alertify.error($(\"#alertmsg\").html());\r\n                            }else{\r\n                                $.ajax({\r\n                                type: 'POST',\r\n                                url: \"/api/v1/var/appointmentdetails/\"+appointmentid+\"/\"+applicationid,\r\n                                processData: false,\r\n                                contentType: false\r\n                                }).done(function (data, textStatus, jqXHR) {\r\n                                if (textStatus.toUpperCase() == \"SUCCESS\" && data.code.toUpperCase() === \"SUCCESS\") {\r\n                                    var date = new Date();\r\n                                    var ynew = date.getFullYear();\r\n                                    var mnew = (date.getMonth() + 1).toString().padStart(2,\"0\");\r\n                                    var dnew = date.getDate();\r\n                                    var nowDate = dnew + \"/\" + mnew + \"/\" + ynew;\r\n                                    console.log(nowDate);\r\n                                    if(nowDate == data.returnobject.fromtimestamp){\r\n                                        $(\"#appointmentDate\").removeClass(\"hidden\");\r\n                                        $(\"#appointmentDate\").text(data.returnobject.fromtimestamp);\r\n                                    }else{\r\n                                        $(\"#appointmentDate\").removeClass(\"hidden\");\r\n                                        $(\"#appointmentDate\").text(data.returnobject.fromtimestamp);\r\n                                        $(\"#appointmentDate\").css(\"color\",\"red\");\r\n                                    }\r\n                                    $(\"#appointmentPassport\").removeClass(\"hidden\");\r\n                                    $(\"#appointmentName\").removeClass(\"hidden\");\r\n                                    $(\"#appointmentSurname\").removeClass(\"hidden\");\r\n                                    $(\"#appointmentType\").removeClass(\"hidden\");\r\n                                    $(\"#appointmentPaidamount\").removeClass(\"hidden\");\r\n                                    $(\"#appointmentPassport\").text(data.returnobject.passport);\r\n                                    $(\"#appointmentName\").text(data.returnobject.firstname);\r\n                                    $(\"#appointmentSurname\").text(data.returnobject.surname);\r\n                                    $(\"#appointmentPaidamount\").text(data.returnobject.paidamount);\r\n\r\n\r\n                                    switch (data.returnobject.type) {\r\n                                      case 0:\r\n                                        $(\"#appointmentType\").text(\"Submision Type C\");\r\n                                        break;\r\n                                      case 1:\r\n                                        $(\"#appointmentType\").text(\"Travel Agent\");\r\n                                        break;\r\n                                      case 2:\r\n                                        $(\"#appointmentType\").text(\"Visa D\");\r\n                                        break;\r\n                                      case 3:\r\n                                        $(\"#appointmentType\").text(\"Passport Return\");\r\n                                        break;\r\n                                      case 4:\r\n                                        $(\"#appointmentType\").text(\"TA Passport Return\");\r\n                                        break;\r\n                                      case 5:\r\n                                        $(\"#appointmentType\").text(\"VIP\");\r\n                                        break;\r\n                                      case 6:\r\n                                        $(\"#appointmentType\").text(\"Prime Time\");\r\n                                        break;\r\n                                      case 7:\r\n                                        $(\"#appointmentType\").text(\"Submission Call Center\");\r\n                                        break;\r\n                                      case 8:\r\n                                        $(\"#appointmentType\").text(\"Personal Assistance\");\r\n                                        break;\r\n                                      case 9:\r\n                                        $(\"#appointmentType\").text(\"Tour Leaders\");\r\n                                        break;\r\n                                    }\r\n                                }else{\r\n                                    alertify.error(data.message);\r\n                                }\r\n                                }).error(function (data, textStatus, jqXHR) {\r\n                                    alertify.error(data.message);\r\n                                    });\r\n                                }\r\n                        }\r\n        });\r\n\r\n        $('#tawithoutappointmentfromfilter').on('change',function(event){\r\n            let tawithoutappointmentfromfilter = $(\"#tawithoutappointmentfromfilter\").val();\r\n            console.log(\"tawithoutappointmentfromfilter\");\r\n            console.log(tawithoutappointmentfromfilter);\r\n            if(tawithoutappointmentfromfilter){\r\n                $(\"#withappointmentfromfilter\").prop(\"checked\",false);\r\n                $(\"#indiwithoutappointmentfromfilter\").prop(\"checked\",false);\r\n                $(\"#appointmentid\").val('').trigger('change');\r\n                $(\"#appointmentPassport\").addClass(\"hidden\");\r\n                $(\"#appointmentDate\").addClass(\"hidden\");\r\n                $(\"#appointmentName\").addClass(\"hidden\");\r\n                $(\"#appointmentSurname\").addClass(\"hidden\");\r\n                $(\"#appointmentType\").addClass(\"hidden\");\r\n                $(\"#appointmentPaidamount\").addClass(\"hidden\");\r\n\r\n            }\r\n        });\r\n    }\r\n\r\n\r\n    function enableUSSR(){\r\n            $('#dateofbirth').on('change', function (event) {\r\n                var datebirth = event.target.value;\r\n                var ussrfall = '26/12/1991';\r\n                var ussrfallcast = createDateFromInput(ussrfall);\r\n\r\n\r\n\r\n            let country = $(\"#traveldocumentissuingcountry\").val();\r\n            if((country === '218' || country === '34' || country === '271' || country === '139' || country === '12' ) && (createDateFromInput(datebirth) < ussrfallcast)){\r\n\r\n            ubi.loader.blocking.start();\r\n            $.get({\r\n                url: \"/api/v1/countrytype/\" + '237',\r\n                contentType: \"application/json; charset=utf-8\"\r\n            }).done(function (data, status, xhr) {\r\n                if (\"SUCCESS\" === data.code) {\r\n                    logger.i(\"Country loaded successful\");\r\n                    console.log('Country loaded successful');\r\n                    console.log(data);\r\n                    var lang = getLanguage();\r\n//                        console.log('lang', lang);\r\n                    var rcountry = data.returnobject;\r\n                    console.log('rcountry : ' + rcountry);\r\n                    var mlname = rcountry.name;\r\n                    if (lang === 'ru-RU')\r\n                        mlname = rcountry.nameru;\r\n                    if (lang === 'am-AM')\r\n                        mlname = rcountry.nameam;\r\n                    if (lang === 'cn-CN')\r\n                        mlname = rcountry.namecn;\r\n                    if (lang === 'ar')\r\n                        mlname = rcountry.namear;\r\n                    if (lang === 'ku')\r\n                        mlname = rcountry.nameku;\r\n                    if (lang === 'sr')\r\n                        mlname = rcountry.namesr;\r\n                    if (lang === 'sq')\r\n                        mlname = rcountry.namesq;\r\n                    if (lang === 'in')\r\n                       mlname = rcountry.namein;\r\n\r\n                    //coutry of birth\r\n                    $('#countryofbirth').val(237);\r\n                    $('#countryofbirth').trigger('change', true);\r\n\r\n                    //nationality at birth\r\n                    $('#nationalityatbirth').val(237);\r\n                    $('#nationalityatbirth').trigger('change', true);\r\n\r\n                }else {\r\n                          alertify.error(data.message);\r\n                      }\r\n                              ubi.loader.blocking.stop();\r\n                });\r\n\r\n\r\n                }else{\r\n                let country = $(\"#currentnationality1\").val();\r\n                console.log(country);\r\n            }\r\n            });\r\n    }\r\n\r\n    function enableLegalGuardianEvents() {\r\n        $('#dateofbirth').on('change', function (event) {\r\n            var datebirth = event.target.value;\r\n            if (datebirth === '') {\r\n                $('#legalguardian-inner').addClass(\"hidden\");\r\n                $('#legalguardian-inner').find('.form-control').val('');\r\n                return;\r\n            }\r\n            var nowDate = new Date();\r\n            var nowplus90 = addDays(nowDate, 90);\r\n            console.log('Date of birth           :' + createDateFromInput(datebirth));\r\n            //console.log('Date in 90 days from now:' + nowplus90);\r\n            //check now + worst case scenario\r\n            /**\r\n             * 29/01/2021 change nowplus90 to nowDate by Ele (email:  [External] FW: Child under 12 issue (22/01/2021))\r\n             */\r\n            var age = dateDiffInYears(createDateFromInput(datebirth), nowDate);//nowplus90); \r\n            var isLessThan12 = isAgeLessThan12(createDateFromInput(datebirth), nowDate, age); //nowplus90\r\n            console.log('Age: ' + age);            \r\n            if (age >= 18) {\r\n                $('#legalguardian-inner').addClass(\"hidden\");\r\n                $('#legalguardian-inner').find('.form-control').val('');\r\n            } else {\r\n                $('#legalguardian-inner').removeClass(\"hidden\");\r\n                //alertify.success('Legal Guardian fields (Field-10) should be filled', 5);\r\n                //if age <=12 --> set previous fingerprints\r\n                if (isLessThan12){\r\n                    $('#fingerprintscollectedpreviously').val(2); //Not applicable\r\n                    $(\"#fingerprintscollectedpreviously\").trigger('change');\r\n                    $('#fingerprintsexceptionreasontype').val(1); //[A] CHILD UNDER 12 YEARS\r\n                    $(\"#fingerprintsexceptionreasontype\").trigger('change');\r\n                }else{\r\n\r\n                }\r\n            }\r\n            //if age> 12 and fingerprintsexceptionreasontype == [A] CHILD UNDER 12 YEARS then remove selection\r\n            if (!isLessThan12 && $('#fingerprintsexceptionreasontype').val() === '1'){\r\n                $(\"#fingerprintscollectedpreviously option[selected]\").removeAttr(\"selected\");\r\n                $(\"#fingerprintscollectedpreviously\")[0].selectedIndex = 0;\r\n                $(\"#fingerprintscollectedpreviously\").trigger('change');\r\n\r\n                $(\"#fingerprintsexceptionreasontype option[selected]\").removeAttr(\"selected\");\r\n                $(\"#fingerprintsexceptionreasontype\")[0].selectedIndex = 0;\r\n                $(\"#fingerprintsexceptionreasontype\").trigger('change');\r\n            }\r\n\r\n            //check arrival\r\n            var arrivaldate = document.getElementById('intendeddateofarrival').value;\r\n            if (datebirth !== '' && arrivaldate !== '') {\r\n                console.log('Date birth     :' + createDateFromInput(datebirth));\r\n                console.log('Date arrival   :' + createDateFromInput(arrivaldate));\r\n                var age2 = dateDiffInYears(createDateFromInput(datebirth), createDateFromInput(arrivaldate));\r\n                console.log('Age2:' + age2);\r\n                if (age2 >= 18) {\r\n                    $('#legalguardian-inner').addClass(\"hidden\");\r\n                    $('#legalguardian-inner').find('.form-control').val('');\r\n                } else {\r\n                    $('#legalguardian-inner').removeClass(\"hidden\");\r\n                }\r\n            }\r\n        });\r\n\r\n        $('#intendeddateofarrival').on('change', function (event) {\r\n            var target = event.target;\r\n            var date2 = target.value;\r\n            var date1 = document.getElementById('dateofbirth').value;\r\n            if (date1 !== '' && date2 !== '') {\r\n                var age = dateDiffInYears(new Date(date1), new Date(date2));\r\n                if (age >= 18) {\r\n                    $('#legalguardian-inner').addClass(\"hidden\");\r\n                } else {\r\n                    $('#legalguardian-inner').removeClass(\"hidden\");\r\n                    //alertify.success('Departure Date(Field 30) automatically adjusted', 5);\r\n                }\r\n            }\r\n        });\r\n    }//EoM\r\n\r\n    function formatDate(date) {\r\n        let month = String(date.getMonth() + 1);\r\n        let day = String(date.getDate());\r\n        const year = String(date.getFullYear());\r\n        if (month.length < 2)\r\n            month = '0' + month;\r\n        if (day.length < 2)\r\n            day = '0' + day;\r\n        return `${day}/${month}/${year}`;\r\n    }//EoM\r\n\r\n    function addDays(date, days) {\r\n        var result = new Date(date);\r\n        result.setDate(result.getDate() + days);\r\n        return result;\r\n    }//EoM\r\n    \r\n     function date_diff_indays(date1, date2) {\r\n        let dt1 = new Date(date1);\r\n        let dt2 = new Date(date2);\r\n        return Math.floor((Date.UTC(dt2.getFullYear(), dt2.getMonth(), dt2.getDate()) - Date.UTC(dt1.getFullYear(), dt1.getMonth(), dt1.getDate()) ) /(1000 * 60 * 60 * 24));\r\n    }\r\n\r\n    function enableTraveldateCalculationEvents() {\r\n        //OnChange of Entries\r\n        $('#numberofentriesrequested').on('change', function (event) {\r\n                        console.log(\"Entry  \");\r\n            var target = event.target;\r\n            var nr = target.value;\r\n                \r\n            if (nr === '1') { //SINGLE\r\n                        console.log(\"Entry  1\");\r\n                console.log(\"Making date of departure readonly\");    //TODO add loading state\r\n                //16/09/2020: Commented by Feroukas\r\n               // document.getElementById('intendeddateofdeparture').setAttribute(\"readonly\", \"readonly\");\r\n               // $('#intendeddateofdeparture').datepicker(\"destroy\");\r\n                document.getElementById('durationofstay').removeAttribute(\"readonly\");\r\n\r\n                var duration = document.getElementById('durationofstay').value;\r\n                var arrivaldate = document.getElementById('intendeddateofarrival').value;\r\n                var departuredate = document.getElementById('intendeddateofdeparture').value;\r\n                \r\n                //16/09/2020: Commented by Feroukas\r\n               /* if (duration != '' && arrivaldate != '') {\r\n                    var ardate = createDateFromInput(arrivaldate);\r\n                    var newdate = addDays(ardate, parseInt(duration) - 1);\r\n                    $('#intendeddateofdeparture').val(formatDate(newdate));\r\n//                    alertify.success('Departure Date(Field 30) automatically adjusted', 5);\r\n                //16/09/2020: Added by Feroukas\r\n                }else*/ if (departuredate != '' && arrivaldate != '') {\r\n                    duration = date_diff_indays(createDateFromInput(arrivaldate), createDateFromInput(departuredate))+1 ;\r\n                    $('#durationofstay').val(duration);\r\n                }\r\n            } else\r\n            if (nr === '2') { //TWO\r\n                    console.log(\"Entry   2\");\r\n\r\n                document.getElementById('intendeddateofdeparture').removeAttribute(\"readonly\");\r\n                $('#intendeddateofdeparture').datepicker({\r\n                    dateFormat: 'dd/mm/yy',\r\n                    locale: 'en',\r\n                    changeYear: true,\r\n                    changeMonth: true,\r\n                    todayHighlight: true,\r\n                    yearRange: '1910:2040',\r\n                    endDate: new Date(),\r\n                    beforeShowDay: function (date) {\r\n                        var $this = $(this);\r\n                        if (!$this.hasClass('lock-before-today') && !$this.hasClass('enable-today')) {\r\n                            var doNothing = true;\r\n                            return [doNothing];\r\n                        }\r\n\r\n                        let afterdays = $this.attr(\"afterdays\");\r\n                        if (afterdays === undefined || afterdays === '') {\r\n                            afterdays = 0;\r\n                        }              \r\n                        var datepickerString = jQuery.datepicker.formatDate('yy-mm-dd', date);\r\n                        var datepickerDate = new Date(datepickerString);\r\n                        var today = new Date();   \r\n                        if ($this.hasClass('enable-today')){\r\n                            today.setDate(today.getDate() - 1); \r\n                        }\r\n                        today.setDate(today.getDate() + parseInt(afterdays));\r\n                        var isGreaterThanToday = datepickerDate.getTime() > today;\r\n                        \r\n                        return [isGreaterThanToday];\r\n                    },\r\n                    onClose: function () {\r\n                        var $this = $(this);\r\n                        $this.parsley().validate();\r\n\r\n                        // statically added error\r\n                        if ($this.hasClass('benderr')) {\r\n                            $this.parsley().removeError(this.id);\r\n                            $this.removeClass('benderr');\r\n                            ubi.var.showErrorsOnTabs();\r\n                        }\r\n                    }\r\n                });\r\n                document.getElementById('durationofstay').removeAttribute(\"readonly\");\r\n            } else\r\n            if (nr === '3') { //MULTIPLE\r\n                                    console.log(\"Entry  3\");\r\n                document.getElementById('intendeddateofdeparture').removeAttribute(\"readonly\");\r\n                $('#intendeddateofdeparture').datepicker({\r\n                    dateFormat: 'dd/mm/yy',\r\n                    locale: 'en',\r\n                    changeYear: true,\r\n                    changeMonth: true,\r\n                    todayHighlight: true,\r\n                    yearRange: '1910:2040',\r\n                    endDate: new Date(),\r\n                    beforeShowDay: function (date) {\r\n                        var $this = $(this);\r\n                        if (!$this.hasClass('lock-before-today') && !$this.hasClass('enable-today')) {\r\n                            var doNothing = true;\r\n                            return [doNothing];\r\n                        }\r\n\r\n                        let afterdays = $this.attr(\"afterdays\");\r\n                        if (afterdays === undefined || afterdays === '') {\r\n                            afterdays = 0;\r\n                        }              \r\n                        var datepickerString = jQuery.datepicker.formatDate('yy-mm-dd', date);\r\n                        var datepickerDate = new Date(datepickerString);\r\n                        var today = new Date(); \r\n                        if ($this.hasClass('enable-today')){\r\n                            today.setDate(today.getDate() - 1); \r\n                        }\r\n                        today.setDate(today.getDate() + parseInt(afterdays));\r\n                        var isGreaterThanToday = datepickerDate.getTime() > today;\r\n                        \r\n                        return [isGreaterThanToday];\r\n                    },\r\n                    onClose: function () {\r\n                        var $this = $(this);\r\n                        $this.parsley().validate();\r\n\r\n                        // statically added error\r\n                        if ($this.hasClass('benderr')) {\r\n                            $this.parsley().removeError(this.id);\r\n                            $this.removeClass('benderr');\r\n                            ubi.var.showErrorsOnTabs();\r\n                        }\r\n                    }\r\n                });\r\n                var visa = $('#visatype').val();\r\n                console.log(visa);\r\n\r\n                if(visa != '4'){\r\n                    document.getElementById('durationofstay').value = 90;\r\n                }\r\n\r\n//                document.getElementById('durationofstay').setAttribute(\"readonly\", \"readonly\");\r\n            }\r\n        });\r\n\r\n        //OnChange of duration\r\n        $('#durationofstay').on('change', function (event) {\r\n            var target = event.target;\r\n            var duration = target.value;\r\n\r\n            var visa = $('#visatype').val();\r\n\r\n            if(visa === 4){\r\n\r\n            if (duration != '' && /^([1-9]|[1-9][0-9]|[1-9][0-9][0-9])$/.test(duration) === true) { //|90\r\n                                        var nr = document.getElementById('numberofentriesrequested').value;\r\n                                        var arrivaldate = document.getElementById('intendeddateofarrival').value;\r\n                                        //14/12/2020. Changed by Apostolos. Calculate for all types\r\n                                        //if (nr === '1' && arrivaldate != '')\r\n                                        if (arrivaldate != '') {\r\n                                            var ardate = createDateFromInput(arrivaldate);\r\n                                            var newdate = addDays(ardate, parseInt(duration) - 1);\r\n                                            $('#intendeddateofdeparture').val(formatDate(newdate));\r\n                        //                    alertify.success('Departure Date(Field 30) automatically adjusted', 5);\r\n                                            $('#'+$('#intendeddateofdeparture').attr(\"aria-describedby\")).removeClass(\"filled\");\r\n                                            $('#intendeddateofdeparture').removeClass(\"benderr\").removeClass(\"parsley-error\").addClass(\"parsley-success\");\r\n                                        }\r\n                                    }\r\n\r\n                                    console.log(duration);\r\n            }else{\r\n\r\n                        if (duration != '' && /^([1-9]|[1-8][0-9]|90)$/.test(duration) === true) {\r\n                            var nr = document.getElementById('numberofentriesrequested').value;\r\n                            var arrivaldate = document.getElementById('intendeddateofarrival').value;\r\n                            //14/12/2020. Changed by Apostolos. Calculate for all types\r\n                            //if (nr === '1' && arrivaldate != '')\r\n                            if (arrivaldate != '') {\r\n                                var ardate = createDateFromInput(arrivaldate);\r\n                                var newdate = addDays(ardate, parseInt(duration) - 1);\r\n                                $('#intendeddateofdeparture').val(formatDate(newdate));\r\n            //                    alertify.success('Departure Date(Field 30) automatically adjusted', 5);\r\n                                $('#'+$('#intendeddateofdeparture').attr(\"aria-describedby\")).removeClass(\"filled\");\r\n                                $('#intendeddateofdeparture').removeClass(\"benderr\").removeClass(\"parsley-error\").addClass(\"parsley-success\");\r\n                            }\r\n                        }\r\n            }\r\n\r\n\r\n        });\r\n\r\n        //OnChange of dateofarrival\r\n        $('#intendeddateofarrival').on('change', function (event) {\r\n            var target = event.target;\r\n            var arrivaldate = target.value;\r\n            if (arrivaldate != '') {\r\n                var nr = document.getElementById('numberofentriesrequested').value;\r\n                var duration = document.getElementById('durationofstay').value;\r\n                if (nr === '1' && duration != '') {\r\n                    var ardate = createDateFromInput(arrivaldate);\r\n                    var newdate = addDays(ardate, parseInt(duration) - 1);\r\n                    $('#intendeddateofdeparture').val(formatDate(newdate));\r\n                    //alertify.success('Departure Date(Field 30) automatically adjusted', 5);\r\n                    $('#'+$('#intendeddateofdeparture').attr(\"aria-describedby\")).removeClass(\"filled\");\r\n                     $('#intendeddateofdeparture').removeClass(\"benderr\").removeClass(\"parsley-error\").addClass(\"parsley-success\");\r\n                }\r\n            }\r\n        });\r\n        \r\n        //OnChange of intendeddateofdeparture\r\n        //16/09/2020: Added by Feroukas\r\n        $('#intendeddateofdeparture').on('change', function (event) {\r\n            var target = event.target;\r\n            var arrivaldate = document.getElementById('intendeddateofarrival').value;\r\n            var departuredate = target.value;\r\n            var visa = $('#visatype').val();\r\n\r\n            if (arrivaldate != '' && departuredate != '') {\r\n                var nr = document.getElementById('numberofentriesrequested').value;\r\n                //if (nr === '1') {\r\n                    var duration = date_diff_indays(createDateFromInput(arrivaldate), createDateFromInput(departuredate))+1 ;\r\n\r\n                    if(visa != '4'){\r\n                    if (duration>90){\r\n                      duration = 90;\r\n                        }\r\n                    }else{\r\n                        if(duration > 365)\r\n                        {\r\n                            duration = 365;\r\n                        }\r\n\r\n                    }\r\n\r\n                    $('#durationofstay').val(duration);\r\n                //}\r\n            }\r\n        });\r\n\r\n    }//EoM\r\n\r\n    function enablePreviousVisasCalculationEvents() {\r\n        $('#visa1validfrom').on('change', function (event) {\r\n            var value1 = event.target.value;\r\n            var value2 = document.getElementById('visa1validto').value;\r\n            if (value1 !== '' && value2 !== '') {\r\n                document.getElementById('visa1').value = 'visa1';\r\n                $('#visa1').trigger('change');\r\n            } else {\r\n                document.getElementById('visa1').value = '';\r\n                $('#visa1').trigger('change');\r\n            }\r\n        });\r\n\r\n        $('#visa1validto').on('change', function (event) {\r\n            var value1 = event.target.value;\r\n            var value2 = document.getElementById('visa1validfrom').value;\r\n            if (value1 !== '' && value2 !== '') {\r\n                document.getElementById('visa1').value = 'visa1';\r\n                $('#visa1').trigger('change');\r\n            } else {\r\n                document.getElementById('visa1').value = '';\r\n                $('#visa1').trigger('change');\r\n            }\r\n        });\r\n\r\n        $('#visa2validfrom').on('change', function (event) {\r\n            var value1 = event.target.value;\r\n            var value2 = document.getElementById('visa2validto').value;\r\n            if (value1 !== '' && value2 !== '') {\r\n                document.getElementById('visa2').value = 'visa2';\r\n                $('#visa2').trigger('change');\r\n            } else {\r\n                document.getElementById('visa2').value = '';\r\n                $('#visa2').trigger('change');\r\n            }\r\n        });\r\n\r\n        $('#visa2validto').on('change', function (event) {\r\n            var value1 = event.target.value;\r\n            var value2 = document.getElementById('visa2validfrom').value;\r\n            if (value1 !== '' && value2 !== '') {\r\n                document.getElementById('visa2').value = 'visa2';\r\n                $('#visa2').trigger('change');\r\n            } else {\r\n                document.getElementById('visa2').value = '';\r\n                $('#visa2').trigger('change');\r\n            }\r\n        });\r\n\r\n        $('#visa3validfrom').on('change', function (event) {\r\n            var value1 = event.target.value;\r\n            var value2 = document.getElementById('visa3validto').value;\r\n            if (value1 !== '' && value2 !== '') {\r\n                document.getElementById('visa3').value = 'visa3';\r\n                $('#visa3').trigger('change');\r\n            } else {\r\n                document.getElementById('visa3').value = '';\r\n                $('#visa3').trigger('change');\r\n            }\r\n        });\r\n\r\n        $('#visa3validto').on('change', function (event) {\r\n            var value1 = event.target.value;\r\n            var value2 = document.getElementById('visa3validfrom').value;\r\n            if (value1 !== '' && value2 !== '') {\r\n                document.getElementById('visa3').value = 'visa3';\r\n                $('#visa3').trigger('change');\r\n            } else {\r\n                document.getElementById('visa3').value = '';\r\n                $('#visa3').trigger('change');\r\n            }\r\n        });\r\n\r\n    }//EoM\r\n\r\n    function enableTravelDocumentValidationEvent() {\r\n        $('#traveldocumentissuingcountry').on('change', function (event) {\r\n            var parelem = $('#traveldocumentnumber2').parsley();\r\n            var parelem2 = $('#traveldocumentnumber').parsley();\r\n            var parelem4 = $('#traveldocumentiissuedby').parsley();\r\n            parelem.reset();\r\n            parelem2.reset();\r\n            \r\n            let mrzravel = $(\"#mrztraveldocumentnumber\").val();\r\n            if (mrzravel !== 0 && mrzravel !== undefined ) {\r\n                var parelem3 = $('#mrztraveldocumentnumber').parsley();\r\n                parelem3.reset();\r\n            }\r\n            \r\n            parelem4.reset();\r\n            let country = $(\"#traveldocumentissuingcountry\").val();\r\n            if (country !== 0 && country !== undefined && country !== '') {\r\n                ubi.loader.blocking.start();\r\n                $.get({\r\n                    url: \"/api/v1/countrytype/\" + country,\r\n                    contentType: \"application/json; charset=utf-8\"\r\n                }).done(function (data, status, xhr) {\r\n                    if (\"SUCCESS\" === data.code) {\r\n                        var rcountry = data.returnobject;                        \r\n                        $('#traveldocumentiissuedby').val(rcountry.name);\r\n                        \r\n                        setPassportFormat(rcountry);\r\n                    } else {\r\n                        alertify.error(data.message);\r\n                    }\r\n                    ubi.loader.blocking.stop();\r\n                });\r\n                \r\n            }\r\n        });\r\n\r\n        //OnChange of traveldocumentnumber\r\n        $('#traveldocumentnumber').on('change', function (event) {\r\n            let country = $(\"#traveldocumentissuingcountry\").val();\r\n            if (country !== 0 && country !== undefined && country !== '') {\r\n                var parelem = $('#traveldocumentnumber').parsley();\r\n                var parelem2 = $('#traveldocumentnumber2').parsley();\r\n                \r\n                parelem.reset();\r\n                parelem2.reset();\r\n                \r\n                let mrzravel = $(\"#mrztraveldocumentnumber\").val();\r\n                if (mrzravel !== 0 && mrzravel !== undefined ) {\r\n                    var parelem3 = $('#mrztraveldocumentnumber').parsley();\r\n                    parelem3.reset();\r\n                }\r\n                \r\n                var value1 = event.target.value;\r\n                if (value1 != '') {\r\n                    var value2 = document.getElementById('traveldocumentnumber2').value;\r\n                    if (value2 != '' && (value1 != value2)) {\r\n                        alertify.error(ubi.getTranslationExt('frontend.error.50'), 5); // 'Travel document numbers should match'\r\n                        var parelem = $('#traveldocumentnumber').parsley();\r\n                        parelem.addError('traveldocumentnumber', {message: ubi.getTranslationExt('frontend.error.50')}); // 'Travel document numbers should match'\r\n                    }\r\n                }\r\n            }else {\r\n                alertify.error(ubi.getTranslationExt('frontend.error.51'), 5); // 'Select an Issuing country'\r\n                var parelem = $('#traveldocumentnumber').parsley();\r\n                parelem.addError('traveldocumentnumber', {message: ubi.getTranslationExt('frontend.error.51')}); // 'Select an Issuing country'\r\n            }\r\n        });\r\n\r\n        $('#traveldocumentnumber2').on('change', function (event) {\r\n            let country = $(\"#traveldocumentissuingcountry\").val();\r\n            if (country !== 0 && country !== undefined && country !== '') {\r\n                var parelem = $('#traveldocumentnumber2').parsley();\r\n                var parelem2 = $('#traveldocumentnumber').parsley();\r\n                parelem.reset();\r\n                parelem2.reset();\r\n                var value1 = event.target.value;\r\n                if (value1 != '') {\r\n                    var value2 = document.getElementById('traveldocumentnumber').value;\r\n                    if (value2 != '' && (value1 != value2)) {\r\n                        alertify.error(ubi.getTranslationExt('frontend.error.50'), 5); // 'Travel document numbers should match'\r\n                        parelem.addError('traveldocumentnumber2', {message: ubi.getTranslationExt('frontend.error.50')}); // 'Travel document numbers should match'\r\n                    }\r\n                }\r\n            }else {\r\n                alertify.error(ubi.getTranslationExt('frontend.error.51'), 5); // 'Select an Issuing country'\r\n                parelem.addError('traveldocumentnumber2', {message: ubi.getTranslationExt('frontend.error.51')}); // 'Select an Issuing country'\r\n            }\r\n        });\r\n\r\n    }//EoM\r\n\r\n    function getLanguage() {\r\n        var language;\r\n        language = getCookie('org.springframework.web.servlet.i18n.CookieLocaleResolver.LOCALE');\r\n        return language;\r\n    }//EoM\r\n\r\n    function getCookie(cn) {\r\n        var name = cn + \"=\";\r\n        var allCookie = decodeURIComponent(document.cookie).split(';');\r\n        var cval = [];\r\n        for (var i = 0; i < allCookie.length; i++) {\r\n            if (allCookie[i].trim().indexOf(name) == 0) {\r\n                cval = allCookie[i].trim().split(\"=\");\r\n            }\r\n        }\r\n        return (cval.length > 0) ? cval[1] : \"\";\r\n    }//EoM\r\n\r\n\r\n    function checkNumberWithCountryPrefix(number, prefixcountry) {\r\n        let country = $(prefixcountry).val();\r\n        if (country !== 0 && country !== undefined && country !== '') {\r\n            // Country\r\n            ubi.loader.blocking.start();\r\n            $.get({\r\n                url: \"/api/v1/countrytype/\" + country,\r\n                contentType: \"application/json; charset=utf-8\"\r\n            }).done(function (data, status, xhr) {\r\n                if (\"SUCCESS\" === data.code) {\r\n                    var rcountry = data.returnobject;\r\n                    logger.i(\"Country loaded successful\");\r\n                    //console.log(rcountry.id + \"-\" + rcountry.name + \"(\" + rcountry.tellength + \"): \" + rcountry.telregex);\r\n                    var pattern = rcountry.telregex;\r\n                    var length = rcountry.tellength;\r\n                    if (length == '1-14') {\r\n                        length = 14;\r\n                    }\r\n                    $(number).attr('maxlength', length);\r\n                    $(number).attr('pattern', pattern);\r\n                    $(number).attr('data-parsley-pattern-message', ubi.getTranslationExt('frontend.error.6.1') + \" \" + length);\r\n                    $(number).trigger(\"change\", true);\r\n                    var element = $(number).parsley();\r\n                    element.reset();\r\n                    // $(number).attr('data-parsley-pattern-message', passportmessage);\r\n\r\n                } else {\r\n                    alertify.error(data.message);\r\n                }\r\n                ubi.loader.blocking.stop();\r\n            });\r\n        } else {\r\n            alertify.error(ubi.getTranslationExt('frontend.error.52')); // \"Error communicating with server\"\r\n        }\r\n    }\r\n\r\n    function setCurrentNationalityPassport1(){\r\n        let country = $(\"#currentnationality1\").val();\r\n        if (country !== 0 && country !== undefined && country !== '') {\r\n            // Country\r\n            ubi.loader.blocking.start();\r\n            $.get({\r\n                url: \"/api/v1/countrytype/\" + country,\r\n                contentType: \"application/json; charset=utf-8\"\r\n            }).done(function (data, status, xhr) {\r\n                if (\"SUCCESS\" === data.code) {\r\n                    logger.i(\"Country loaded successful\");\r\n                    var lang = getLanguage();\r\n//                        console.log('lang', lang);\r\n                    var rcountry = data.returnobject;\r\n                    var mlname = rcountry.name;\r\n                    if (lang === 'ru-RU')\r\n                        mlname = rcountry.nameru;\r\n                    if (lang === 'am-AM')\r\n                        mlname = rcountry.nameam;\r\n                    if (lang === 'cn-CN')\r\n                        mlname = rcountry.namecn;\r\n                    if (lang === 'ar')\r\n                        mlname = rcountry.namear;\r\n                    if (lang === 'ku')\r\n                        mlname = rcountry.nameku;\r\n                    if (lang === 'sr')\r\n                        mlname = rcountry.namesr;\r\n                    if (lang === 'sq')\r\n                        mlname = rcountry.namesq;\r\n                    if (lang === 'in')\r\n                        mlname = rcountry.namein;\r\n//                        console.log(rcountry.id);\r\n//                        console.log(rcountry.name);\r\n                    //var option1 = new Option('', '');\r\n                    var option2 = new Option(mlname, rcountry.id);\r\n                    //remove all first\r\n                    /*commented by Apostolos. Issuing country can be different by the nationality (21/07/2020)*/\r\n                    /*$('#traveldocumentissuingcountry').find('option').remove();\r\n                    $('#traveldocumentissuingcountry').append($(option2));*/\r\n                \r\n                    //add new items\r\n                    //$('#traveldocumentissuingcountry').append($(option1));\r\n                    \r\n                    $('#traveldocumentissuingcountry').val(country);\r\n                    $('#traveldocumentissuingcountry').trigger(\"change\", true);\r\n\r\n\r\n                    setPassportFormat(rcountry);\r\n                    \r\n                    /*var element3 = document.getElementById('currentnationality2');\r\n                    var element4 = document.getElementById('currentnationality3');\r\n                    var text3 = ''\r\n                    var id3 = '';\r\n                    var text4 = ''\r\n                    var id4 = ''\r\n                    if (element3.selectedIndex != -1) {\r\n                        text3 = element3.options[element3.selectedIndex].text;\r\n                        id3 = element3.value;\r\n                        var option3 = new Option(text3, id3);\r\n                        $('#traveldocumentissuingcountry').append($(option3));\r\n                    }\r\n                    if (element4.selectedIndex != -1) {\r\n                        text4 = element4.options[element4.selectedIndex].text;\r\n                        id4 = element4.value;\r\n                        var option4 = new Option(text4, id4);\r\n                        $('#traveldocumentissuingcountry').append($(option4));\r\n                    }*/\r\n                } else {\r\n                    alertify.error(data.message);\r\n                }\r\n                ubi.loader.blocking.stop();\r\n            });\r\n        } else {\r\n            //Desection happened - have to clear the dependent field\r\n            $('#traveldocumentissuingcountry').find('option').remove();\r\n        }\r\n    }\r\n    \r\n    function setPassportFormat(rcountry){\r\n        var lang = getLanguage();\r\n        if ( rcountry.paasportregex !== null && rcountry.paasportregex.length > 0 ){\r\n                $('<input>').attr({\r\n                    type: 'hidden',\r\n                    id: 'passportregex'+rcountry.id,\r\n                    name: 'passportregex'+rcountry.id,\r\n                    value: rcountry.paasportregex\r\n                }).appendTo('form');\r\n                $('#traveldocumentnumber').attr('pattern', rcountry.paasportregex);\r\n                $('#traveldocumentnumber2').attr('pattern', rcountry.paasportregex);\r\n                let mrzravel = $(\"#mrztraveldocumentnumber\").val();\r\n               // console.log(\"mrzravel=\"+mrzravel)\r\n                if (mrzravel !== 0 && mrzravel !== undefined ) {\r\n                    $('#mrztraveldocumentnumber').attr('pattern', rcountry.paasportregex);\r\n                }                        \r\n            }else{\r\n                $('#traveldocumentnumber').removeAttr('pattern');\r\n                $('#traveldocumentnumber2').removeAttr('pattern');\r\n                let mrzravel = $(\"#mrztraveldocumentnumber\").val();\r\n                if (mrzravel !== 0 && mrzravel !== undefined ) {\r\n                    $('#mrztraveldocumentnumber').removeAttr('pattern');\r\n                }\r\n            }\r\n            if ( rcountry.paasportregex !== null && rcountry.paasportregex.length > 0 ){\r\n                $('<input>').attr({\r\n                    type: 'hidden',\r\n                    id: 'passportsize'+rcountry.id,\r\n                    name: 'passportsize'+rcountry.id,\r\n                    value: rcountry.paasportsize\r\n                }).appendTo('form');\r\n                $('#traveldocumentnumber').attr('maxlength', rcountry.paasportsize);\r\n                $('#traveldocumentnumber2').attr('maxlength', rcountry.paasportsize);\r\n                let mrzravel = $(\"#mrztraveldocumentnumber\").val();\r\n                if (mrzravel !== 0 && mrzravel !== undefined ) {                            \r\n                    $('#mrztraveldocumentnumber').attr('maxlength', rcountry.paasportsize);\r\n                }\r\n            }else{\r\n                $('#traveldocumentnumber').removeAttr('maxlength');\r\n                $('#traveldocumentnumber2').removeAttr('maxlength');\r\n                let mrzravel = $(\"#mrztraveldocumentnumber\").val();\r\n                if (mrzravel !== 0 && mrzravel !== undefined ) {                            \r\n                    $('#mrztraveldocumentnumber').removeAttr('maxlength');\r\n                }\r\n            }\r\n            var passportmessage = rcountry.passportmessage;\r\n            if (lang === 'ru-RU')\r\n                passportmessage = rcountry.passportmessageru;\r\n            if (lang === 'am-AM')\r\n                passportmessage = rcountry.passportmessageam;\r\n            if (lang === 'cn-CN')\r\n                passportmessage = rcountry.passportmessagecn;\r\n            if (lang === 'ar')\r\n                passportmessage = rcountry.passportmessagear;\r\n            if (lang === 'ku')\r\n                passportmessage = rcountry.passportmessageku;\r\n            if (lang === 'sr')\r\n                passportmessage = rcountry.passportmessagesr;\r\n            if (lang === 'sq')\r\n                passportmessage = rcountry.passportmessagesq;\r\n            if (lang === 'in')\r\n                passportmessage = rcountry.passportmessagein;\r\n\r\n            if (rcountry.paasportregex !== null && rcountry.paasportregex.length > 0){\r\n                $('<input>').attr({\r\n                    type: 'hidden',\r\n                    id: 'passportmessage'+rcountry.id,\r\n                    name: 'passportmessage'+rcountry.id,\r\n                    value: passportmessage\r\n                }).appendTo('form');\r\n                $('#traveldocumentnumber').attr('data-parsley-pattern-message', passportmessage);\r\n                $('#traveldocumentnumber2').attr('data-parsley-pattern-message', passportmessage);\r\n                let mrzravel = $(\"#mrztraveldocumentnumber\").val();\r\n                if (mrzravel !== 0 && mrzravel !== undefined ) {                            \r\n                    $('#mrztraveldocumentnumber').attr('data-parsley-pattern-message', passportmessage);\r\n                }\r\n            }else{\r\n                $('#traveldocumentnumber').removeAttr('data-parsley-pattern-message');\r\n                $('#traveldocumentnumber2').removeAttr('data-parsley-pattern-message');\r\n                let mrzravel = $(\"#mrztraveldocumentnumber\").val();\r\n                if (mrzravel !== 0 && mrzravel !== undefined ) {                            \r\n                    $('#mrztraveldocumentnumber').removeAttr('data-parsley-pattern-message');\r\n                }\r\n            }\r\n    }\r\n\r\n    function ajaxCallManagement() {\r\n\r\n        //--------------------Field 1 ---------------------------\r\n        $(\"#currentnationality1\").change(function () {\r\n            setCurrentNationalityPassport1();\r\n        }); //currentnationality1\r\n\r\n        //--------------------Field 2 ---------------------------\r\n        $(\"#currentnationality2\").change(function () {\r\n            let country = $(\"#currentnationality2\").val();\r\n            if (country !== 0 && country !== undefined && country !== '') {\r\n                // Country\r\n                ubi.loader.blocking.start();\r\n                $.get({\r\n                    url: \"/api/v1/countrytype/\" + country,\r\n                    contentType: \"application/json; charset=utf-8\"\r\n                }).done(function (data, status, xhr) {\r\n                    if (\"SUCCESS\" === data.code) {\r\n                        logger.i(\"Country loaded successful\");\r\n                        var lang = getLanguage();\r\n//                        console.log('lang', lang);\r\n                        var rcountry = data.returnobject;\r\n                        var mlname = rcountry.name;\r\n                        if (lang === 'ru-RU')\r\n                            mlname = rcountry.nameru;\r\n                        if (lang === 'am-AM')\r\n                            mlname = rcountry.nameam;\r\n                        if (lang === 'cn-CN')\r\n                            mlname = rcountry.namecn;\r\n                        if (lang === 'ar')\r\n                            mlname = rcountry.namear;\r\n                        if (lang === 'ku')\r\n                            mlname = rcountry.nameku;\r\n                        if (lang === 'sr')\r\n                            mlname = rcountry.namesr;\r\n                        if (lang === 'sq')\r\n                            mlname = rcountry.namesq;\r\n                        if (lang === 'in')\r\n                            mlname = rcountry.namein;\r\n\r\n//                        console.log(rcountry.id);\r\n//                        console.log(rcountry.name);\r\n                       /* var option1 = new Option('', '');\r\n                        var option2 = new Option(mlname, rcountry.id);\r\n                        //remove all first\r\n                        $('#traveldocumentissuingcountry').find('option').remove();\r\n                        //add new items\r\n                        $('#traveldocumentissuingcountry').append($(option1));\r\n                        $('#traveldocumentissuingcountry').append($(option2));\r\n                        */\r\n                        /*if (!$('#passportregex'+rcountry.id).length && rcountry.paasportregex !== null && rcountry.paasportregex.length > 0 ){\r\n                            $('<input>').attr({\r\n                                type: 'hidden',\r\n                                id: 'passportregex'+rcountry.id,\r\n                                name: 'passportregex'+rcountry.id,\r\n                                value: rcountry.paasportregex\r\n                            }).appendTo('form');\r\n                        }\r\n                        if (!$('#passportsize'+rcountry.id).length && rcountry.paasportregex !== null && rcountry.paasportregex.length > 0 ){\r\n                            $('<input>').attr({\r\n                                type: 'hidden',\r\n                                id: 'passportsize'+rcountry.id,\r\n                                name: 'passportsize'+rcountry.id,\r\n                                value: rcountry.paasportsize\r\n                            }).appendTo('form');\r\n                        }var passportmessage = rcountry.passportmessage;\r\n                        if (lang === 'ru-RU')\r\n                            passportmessage = rcountry.passportmessageru;\r\n                        if (lang === 'am-AM')\r\n                            passportmessage = rcountry.passportmessageam;\r\n                        if (lang === 'cn-CN')\r\n                            passportmessage = rcountry.passportmessagecn;\r\n\r\n                        if (!$('#passportmessage'+rcountry.id).length && rcountry.paasportregex !== null && rcountry.paasportregex.length > 0 ){\r\n                            $('<input>').attr({\r\n                                type: 'hidden',\r\n                                id: 'passportmessage'+rcountry.id,\r\n                                name: 'passportmessage'+rcountry.id,\r\n                                value: passportmessage\r\n                            }).appendTo('form');\r\n                        }*/\r\n\r\n                       /* var element3 = document.getElementById('currentnationality1');\r\n                        var element4 = document.getElementById('currentnationality3');\r\n                        var text3 = ''\r\n                        var id3 = '';\r\n                        var text4 = ''\r\n                        var id4 = ''\r\n                        if (element3.selectedIndex != -1) {\r\n                            text3 = element3.options[element3.selectedIndex].text;\r\n                            id3 = element3.value;\r\n                            var option3 = new Option(text3, id3);\r\n                            $('#traveldocumentissuingcountry').append($(option3));\r\n                        }\r\n                        if (element4.selectedIndex != -1) {\r\n                            text4 = element4.options[element4.selectedIndex].text;\r\n                            id4 = element4.value;\r\n                            var option4 = new Option(text4, id4);\r\n                            $('#traveldocumentissuingcountry').append($(option4));\r\n                        }*/\r\n                    } else {\r\n                        alertify.error(data.message);\r\n                    }\r\n                    ubi.loader.blocking.stop();\r\n                });\r\n            } else {\r\n                //Desection happened - have to clear the dependent field  ( Keep only field1 )\r\n               /* $('#traveldocumentissuingcountry').find('option').remove();\r\n                var option1 = new Option('', '');\r\n                $('#traveldocumentissuingcountry').append($(option1));\r\n                var element3 = document.getElementById('currentnationality1');\r\n                var text3 = ''\r\n                var id3 = '';\r\n                console.log('selectedindex', ' ', element3.selectedIndex);\r\n                if (element3.selectedIndex != -1) {\r\n                    text3 = element3.options[element3.selectedIndex].text;\r\n                    id3 = element3.value;\r\n                    console.log(id3, ' ', text3);\r\n                    var option3 = new Option(text3, id3);\r\n                    $('#traveldocumentissuingcountry').append($(option3));\r\n                }*/\r\n            }//Desection management\r\n        }); //currentnationality2\r\n\r\n        //--------------------Field 3 ---------------------------\r\n        $(\"#currentnationality3\").change(function () {\r\n            let country = $(\"#currentnationality3\").val();\r\n            if (country !== 0 && country !== undefined && country !== '') {\r\n                // Country\r\n                ubi.loader.blocking.start();\r\n                $.get({\r\n                    url: \"/api/v1/countrytype/\" + country,\r\n                    contentType: \"application/json; charset=utf-8\"\r\n                }).done(function (data, status, xhr) {\r\n                    if (\"SUCCESS\" === data.code) {\r\n                        logger.i(\"Country loaded successful\");\r\n                        var lang = getLanguage();\r\n//                        console.log('lang', lang);\r\n                        var rcountry = data.returnobject;\r\n                        var mlname = rcountry.name;\r\n                        if (lang === 'ru-RU')\r\n                            mlname = rcountry.nameru;\r\n                        if (lang === 'am-AM')\r\n                            mlname = rcountry.nameam;\r\n                        if (lang === 'cn-CN')\r\n                            mlname = rcountry.namecn;\r\n//                        console.log(rcountry.id);\r\n//                        console.log(rcountry.name);\r\n                      /*  var option1 = new Option('', '');\r\n                        var option2 = new Option(mlname, rcountry.id);\r\n                        //remove all first\r\n                        $('#traveldocumentissuingcountry').find('option').remove();\r\n                        //add new items\r\n                        $('#traveldocumentissuingcountry').append($(option1));\r\n                        $('#traveldocumentissuingcountry').append($(option2));*/\r\n\r\n                        /*if (!$('#passportregex'+rcountry.id).length && rcountry.paasportregex !== null && rcountry.paasportregex.length > 0 ){\r\n                            $('<input>').attr({\r\n                                type: 'hidden',\r\n                                id: 'passportregex'+rcountry.id,\r\n                                name: 'passportregex'+rcountry.id,\r\n                                value: rcountry.paasportregex\r\n                            }).appendTo('form');\r\n                        }\r\n                        if (!$('#passportsize'+rcountry.id).length && rcountry.paasportregex !== null && rcountry.paasportregex.length > 0 ){\r\n                            $('<input>').attr({\r\n                                type: 'hidden',\r\n                                id: 'passportsize'+rcountry.id,\r\n                                name: 'passportsize'+rcountry.id,\r\n                                value: rcountry.paasportsize\r\n                            }).appendTo('form');\r\n                        }\r\n                        var passportmessage = rcountry.passportmessage;\r\n                        if (lang === 'ru-RU')\r\n                            passportmessage = rcountry.passportmessageru;\r\n                        if (lang === 'am-AM')\r\n                            passportmessage = rcountry.passportmessageam;\r\n                        if (lang === 'cn-CN')\r\n                            passportmessage = rcountry.passportmessagecn;\r\n\r\n                        if (!$('#passportmessage'+rcountry.id).length && rcountry.paasportregex !== null && rcountry.paasportregex.length > 0 ){\r\n                            $('<input>').attr({\r\n                                type: 'hidden',\r\n                                id: 'passportmessage'+rcountry.id,\r\n                                name: 'passportmessage'+rcountry.id,\r\n                                value: passportmessage\r\n                            }).appendTo('form');\r\n                        }*/\r\n\r\n                       /* var element3 = document.getElementById('currentnationality1');\r\n                        var element4 = document.getElementById('currentnationality2');\r\n                        var text3 = ''\r\n                        var id3 = '';\r\n                        var text4 = ''\r\n                        var id4 = ''\r\n                        if (element3.selectedIndex != -1) {\r\n                            text3 = element3.options[element3.selectedIndex].text;\r\n                            id3 = element3.value;\r\n                            var option3 = new Option(text3, id3);\r\n                            $('#traveldocumentissuingcountry').append($(option3));\r\n                        }\r\n                        if (element4.selectedIndex != -1) {\r\n                            text4 = element4.options[element4.selectedIndex].text;\r\n                            id4 = element4.value;\r\n                            var option4 = new Option(text4, id4);\r\n                            $('#traveldocumentissuingcountry').append($(option4));\r\n                        }*/\r\n                    } else {\r\n                        alertify.error(data.message);\r\n                    }\r\n                    ubi.loader.blocking.stop();\r\n                });\r\n            } else {\r\n                //Desection happened - have to clear the dependent field  ( Keep only field1 and field2 )\r\n              /*  $('#traveldocumentissuingcountry').find('option').remove();\r\n                var option1 = new Option('', '');\r\n                $('#traveldocumentissuingcountry').append($(option1));\r\n                var element3 = document.getElementById('currentnationality1');\r\n                var element4 = document.getElementById('currentnationality2');\r\n                var text3 = ''\r\n                var id3 = '';\r\n                var text4 = ''\r\n                var id4 = ''\r\n                if (element3.selectedIndex != -1) {\r\n                    console.log(element3.selectedIndex);\r\n                    text3 = element3.options[element3.selectedIndex].text;\r\n                    id3 = element3.value;\r\n                    var option3 = new Option(text3, id3);\r\n                    $('#traveldocumentissuingcountry').append($(option3));\r\n                }\r\n                if (element4.selectedIndex != -1) {\r\n                    console.log(element4.selectedIndex);\r\n                    text4 = element4.options[element4.selectedIndex].text;\r\n                    id4 = element4.value;\r\n                    var option4 = new Option(text4, id4);\r\n                    $('#traveldocumentissuingcountry').append($(option4));\r\n                }*/\r\n            }//Desection\r\n        }); //currentnationality3\r\n\r\n        // Phone/Fax fields\r\n        $(\"#residencephonenumberprefix\").change(function () {\r\n            checkNumberWithCountryPrefix(\"#residencephonenumber\", \"#residencephonenumberprefix\")\r\n        });\r\n        $(\"#residenceotherphonenumberprefix\").change(function () {\r\n            checkNumberWithCountryPrefix(\"#residenceotherphonenumber\", \"#residenceotherphonenumberprefix\")\r\n        });\r\n        $(\"#deliveryphonenumberprefix\").change(function () {\r\n            checkNumberWithCountryPrefix(\"#deliveryphonenumber\", \"#deliveryphonenumberprefix\");\r\n        });\r\n        $(\"#deliveryotherphonenumberprefix\").change(function () {\r\n            checkNumberWithCountryPrefix(\"#deliveryotherphonenumber\", \"#deliveryotherphonenumberprefix\");\r\n        });\r\n        $(\"#employerphonenumberprefix\").change(function () {\r\n            checkNumberWithCountryPrefix(\"#employerphonenumber\", \"#employerphonenumberprefix\");\r\n        });\r\n        $(\"#accommodationtelephoneprefix\").change(function () {\r\n            checkNumberWithCountryPrefix(\"#accommodationtelephone\", \"#accommodationtelephoneprefix\");\r\n        });\r\n        $(\"#accommodationtelefaxprefix\").change(function () {\r\n            checkNumberWithCountryPrefix(\"#accommodationtelefax\", \"#accommodationtelephoneprefix\");\r\n        });\r\n        $(\"#fminvitingcompanytelephoneprefix\").change(function () {\r\n            checkNumberWithCountryPrefix(\"#fminvitingcompanytelephone\", \"#fminvitingcompanytelephoneprefix\");\r\n        });\r\n        $(\"#fminvitingcompanyfaxprefix\").change(function () {\r\n            checkNumberWithCountryPrefix(\"#fminvitingcompanyfax\", \"#fminvitingcompanytelephoneprefix\");\r\n        });\r\n        $(\"#fmcontacttelephoneprefix\").change(function () {\r\n            checkNumberWithCountryPrefix(\"#fmcontacttelephone\", \"#fmcontacttelephoneprefix\");\r\n        });\r\n        $(\"#fmcontacttelefaxprefix1\").change(function () {\r\n            checkNumberWithCountryPrefix(\"#fmcontacttelefax\", \"#fmcontacttelephoneprefix\");\r\n        });\r\n\r\n\r\n    }//EoM ajaxCallManagement\r\n\r\n\r\n    function feesManagement() {\r\n\r\n\r\n        $(\"#visafeeoffering\").change(function () {\r\n            let visaoffering = $(\"#visafeeoffering\").val();\r\n            let vac = $(\"#vac\").val();\r\n\r\n            console.log(\"Fetching exchnage rate for VAC: \", vac, \" offering: \", visaoffering);\r\n            if (vac !== 0 && vac !== undefined && vac !== '' && visaoffering !== '') {\r\n\r\n                if ($(\"#changestatus\")!== undefined && $(\"#changestatus\") !== '' && $(\"#changestatus\").attr(\"is-required\") !== undefined ){\r\n                    $(\"#changestatus\").attr(\"required\", $(\"#changestatus\").attr(\"is-required\"));\r\n                }\r\n\r\n                // Country\r\n                ubi.loader.blocking.start();\r\n                //-------1st call\r\n                $.get({\r\n                    url: \"/api/v1/vac/\" + vac + \"/exchangerate\",\r\n                    contentType: \"application/json; charset=utf-8\"\r\n                }).done(function (data, status, xhr) {\r\n                    if (\"SUCCESS\" === data.code) {\r\n                        var rate = data.returnobject;\r\n                        console.log(\"Rate loaded successfuly:\", rate);\r\n                        $.get({\r\n                            url: \"/api/v1/visaoffering/\" + visaoffering + \"/cost\",\r\n                            contentType: \"application/json; charset=utf-8\"\r\n                        }).done(function (data, status, xhr) {\r\n                            if (\"SUCCESS\" === data.code) {\r\n                                var cost = data.returnobject.value;\r\n                                var costType  = data.returnobject.id;\r\n                                console.log(\"Cost loaded successfuly (\"+costType+\"): \", cost);\r\n\r\n                                $.get({\r\n                                    url: \"/api/v1/vac/\" + vac + \"/numofdecimals\",\r\n                                    contentType: \"application/json; charset=utf-8\"\r\n                                }).done(function (data, status, xhr) {\r\n                                    if (\"SUCCESS\" === data.code) {\r\n                                        logger.i(\"Info loaded successful\");\r\n                                        var numOfDecimals = data.returnobject;\r\n                                        //$(\"#visafeeofferingcostinref\").text(cost);\r\n                                        if (costType === \"REF\"){\r\n                                            $(\"#visafeeofferingcostinlocal\").text((cost * rate).toFixed(numOfDecimals));\r\n                                        }else{\r\n                                            $(\"#visafeeofferingcostinlocal\").text(cost);\r\n                                        }\r\n                                        recalculateFees();\r\n                                    } else {\r\n                                        alertify.error(data.message);\r\n                                    }\r\n                                });\r\n\r\n                            } else {\r\n                                alertify.error(data.message);\r\n                            }\r\n                        }); //done---1st call\r\n                    } else {\r\n                        alertify.error(data.message);\r\n                    }\r\n                }); //done---1st call\r\n\r\n                //------------------\r\n                ubi.loader.blocking.stop();\r\n                //recalculate\r\n            } else {\r\n                console.log(\"Visa Fee Deselected\", \"0.00\");\r\n                //$(\"#visafeeofferingcostinref\").text('0');\r\n                $(\"#visafeeofferingcostinlocal\").text('0.00');\r\n                recalculateFees();\r\n            }\r\n        });\r\n\r\n        $(\"#servicefeeoffering\").change(function () {\r\n            let serviceoffering = $(\"#servicefeeoffering\").val();\r\n            let vac = $(\"#vac\").val();\r\n            console.log(\"Fetching exchnage rate for VAC: \", vac, \"service offering: \", serviceoffering);\r\n            if (vac !== 0 && vac !== undefined && vac !== '' && serviceoffering !== '') {\r\n\r\n\r\n                if ($(\"#changestatus\")!== undefined && $(\"#changestatus\") !== '' && $(\"#changestatus\").attr(\"is-required\") !== undefined ){\r\n                    $(\"#changestatus\").attr(\"required\", $(\"#changestatus\").attr(\"is-required\"));\r\n                }\r\n                // Country\r\n                ubi.loader.blocking.start();\r\n                //-------1st call\r\n                $.get({\r\n                    url: \"/api/v1/vac/\" + vac + \"/exchangerate\",\r\n                    contentType: \"application/json; charset=utf-8\"\r\n                }).done(function (data, status, xhr) {\r\n                    if (\"SUCCESS\" === data.code) {\r\n                        var rate = data.returnobject;\r\n                        console.log(\"Rate loaded successfuly:\", rate);\r\n                        $.get({\r\n                            url: \"/api/v1/serviceoffering/\" + serviceoffering + \"/cost\",\r\n                            contentType: \"application/json; charset=utf-8\"\r\n                        }).done(function (data, status, xhr) {\r\n                            if (\"SUCCESS\" === data.code) {\r\n                                var cost = data.returnobject;\r\n                                console.log(\"Cost loaded successfuly: \", cost);\r\n                                $.get({\r\n                                    url: \"/api/v1/vac/\" + vac + \"/numofdecimals\",\r\n                                    contentType: \"application/json; charset=utf-8\"\r\n                                }).done(function (data, status, xhr) {\r\n                                    if (\"SUCCESS\" === data.code) {\r\n                                        logger.i(\"Info loaded successful\");\r\n                                        var numOfDecimals = data.returnobject;\r\n                                        /*if (parseFloat(cost)%1==0){\r\n                                            $(\"#servicefeeofferingcostinref\").text(cost.toFixed(0));\r\n                                        }else{\r\n                                            $(\"#servicefeeofferingcostinref\").text(cost.toFixed(2));\r\n                                        }  */\r\n                                        $(\"#servicefeeofferingcostinlocal\").text((cost * rate).toFixed(numOfDecimals));\r\n                                        recalculateFees();\r\n                                    } else {\r\n                                        alertify.error(data.message);\r\n                                    }\r\n                                });\r\n                            } else {\r\n                                alertify.error(data.message);\r\n                            }\r\n                        }); //done---1st call\r\n                    } else {\r\n                        alertify.error(data.message);\r\n                    }\r\n                }); //done---1st call\r\n\r\n                //------------------\r\n                ubi.loader.blocking.stop();\r\n                //recalculate\r\n            } else {\r\n                console.log(\"Service Fee Deselected\", \"0.00\");\r\n              //  $(\"#servicefeeofferingcostinref\").text('0');\r\n                $(\"#servicefeeofferingcostinlocal\").text('0.00');\r\n                recalculateFees();\r\n            }\r\n        });\r\n\r\n\r\n        $(document).on(\"change\", \".vasfee select\", function () {\r\n            let element = $(this);\r\n            let vasoffering = $(this).val();\r\n            let vac = $(\"#vac\").val();\r\n            let issmsservice = false;\r\n            let isunitable = false;\r\n\r\n            if ($(this).find(\":selected\").hasClass( \"isunitable\" )){\r\n                isunitable = true;\r\n            }\r\n\r\n            if ($(this).find(\":selected\").hasClass( \"issmsservice\" )){\r\n                issmsservice = true;\r\n                $('#residenceotherphonenumberdiv').addClass(\"required\");\r\n            }else{\r\n                $('#residenceotherphonenumberdiv').removeClass(\"required\");\r\n            }\r\n            $(\"#residenceotherphonenumber\").attr(\"required\", issmsservice);\r\n\r\n            if ($( \"[id^='vasfeeoffering_']\" )){\r\n                $.each($( \"[id^='vasfeeoffering_']\" ), function(index, elem){\r\n                    if (elem.id !== element.attr(\"id\") && elem.value === element.val() ){\r\n                        resetFieldWithMsg(element.attr(\"id\"), 'VAS fees should be different!');\r\n                        return;\r\n                    }\r\n                });\r\n            }\r\n\r\n            console.log(\"Fetching exchnage rate for VAC: \", vac, \" vasoffering: \", vasoffering, \" isunitable: \", isunitable);\r\n\r\n            if ($(this).attr(\"id\").match(/\\d+/)){\r\n                let countID = (parseInt($(this).attr(\"id\").match(/\\d+/)[0]));\r\n                $(\"#vasfeeofferingselection_\"+countID).attr(\"readonly\", !isunitable);\r\n                if (isunitable){\r\n                    $(\"#vasfeeofferingselection_\"+countID).removeClass(\"disabledtext\");\r\n                }else {\r\n                    $(\"#vasfeeofferingselection_\"+countID).addClass(\"disabledtext\");\r\n                    $(\"#vasfeeofferingselection_\"+countID).val(1);\r\n                }\r\n\r\n            }\r\n\r\n            let amount = $(this).parents('.vasfee').find('.amount').val();\r\n\r\n            if (vac !== 0 && vac !== undefined && vac !== '' && vasoffering !== '') {\r\n\r\n\r\n\r\n                if ($(\"#changestatus\")!== undefined && $(\"#changestatus\") !== '' && $(\"#changestatus\").attr(\"is-required\") !== undefined ){\r\n                    $(\"#changestatus\").attr(\"required\", $(\"#changestatus\").attr(\"is-required\"));\r\n                }\r\n\r\n                // Country\r\n                ubi.loader.blocking.start();\r\n                //-------1st call\r\n                $.get({\r\n                    url: \"/api/v1/vac/\" + vac + \"/exchangerate\",\r\n                    contentType: \"application/json; charset=utf-8\"\r\n                }).done(function (data, status, xhr) {\r\n                    if (\"SUCCESS\" === data.code) {\r\n                        var rate = data.returnobject;\r\n                        console.log(\"Rate loaded successfuly:\", rate);\r\n                        $.get({\r\n                            url: \"/api/v1/vasoffering/\" + vasoffering + \"/cost\",\r\n                            contentType: \"application/json; charset=utf-8\"\r\n                        }).done(function (data, status, xhr) {\r\n                            if (\"SUCCESS\" === data.code) {\r\n                                var costInLocal = data.returnobject;\r\n                                console.log(\"Cost loaded successfuly: \", costInLocal);\r\n                                $.get({\r\n                                    url: \"/api/v1/vac/\" + vac + \"/numofdecimals\",\r\n                                    contentType: \"application/json; charset=utf-8\"\r\n                                }).done(function (data, status, xhr) {\r\n                                    if (\"SUCCESS\" === data.code) {\r\n                                        logger.i(\"Info loaded successful\");\r\n                                        logger.i(\"Info loaded successful\");\r\n                                        var numOfDecimals = data.returnobject;\r\n                                        /*var vasfeeinref = amount * cost;\r\n\r\n                                        if (parseFloat(vasfeeinref)%1==0){\r\n                                            vasfeeinref = vasfeeinref.toFixed(0);\r\n                                        }else{\r\n                                            vasfeeinref = vasfeeinref.toFixed(2);\r\n                                        }*/\r\n                                        //element.parents('.vasfee').find('.vasfeeofferingcostinref').text(vasfeeinref);\r\n                                        element.parents('.vasfee').find('.vasfeeofferingcostinlocal').text((amount * costInLocal).toFixed(numOfDecimals));\r\n                                        recalculateFees();\r\n                                    } else {\r\n                                        alertify.error(data.message);\r\n                                    }\r\n                                });\r\n                            } else {\r\n                                alertify.error(data.message);\r\n                            }\r\n                        }); //done---1st call\r\n                    } else {\r\n                        alertify.error(data.message);\r\n                    }\r\n                }); //done---1st call\r\n\r\n                //------------------\r\n                ubi.loader.blocking.stop();\r\n                //recalculate\r\n            } else {\r\n                console.log(\"Vas Fee Deselected\", \"0.00\");\r\n                //element.parents('.vasfee').find('.vasfeeofferingcostinref').text('0');\r\n                element.parents('.vasfee').find('.vasfeeofferingcostinlocal').text('0.00');\r\n                recalculateFees();\r\n            }\r\n        });\r\n\r\n        //$(\".vasfee .amount\").change(function () {\r\n        $(document).on(\"change\", \".vasfee .amount\", function () {\r\n            let element = $(this);\r\n            let amount = $(this).val();\r\n            let vac = $(\"#vac\").val();\r\n            let vasoffering = $(this).parents('.vasfee').find('.vasfeeoffering').val();\r\n            console.log(\"Fetching exchnage rate for VAC: \", vac, \" vasoffering: \", vasoffering);\r\n//            let continref = $(this).parents('.vasfee').find('.vasfeeofferingcostinref').text();\r\n//            let continlocal = $(this).parents('.vasfee').find('.vasfeeofferingcostinlocal').text();\r\n\r\n            if (vac !== 0 && vac !== undefined && vac !== '' && vasoffering != '') {\r\n                // Country\r\n                ubi.loader.blocking.start();\r\n                //-------1st call\r\n                $.get({\r\n                    url: \"/api/v1/vac/\" + vac + \"/exchangerate\",\r\n                    contentType: \"application/json; charset=utf-8\"\r\n                }).done(function (data, status, xhr) {\r\n                    if (\"SUCCESS\" === data.code) {\r\n                        var rate = data.returnobject;\r\n                        console.log(\"Rate loaded successfuly:\", rate);\r\n                        $.get({\r\n                            url: \"/api/v1/vasoffering/\" + vasoffering + \"/cost\",\r\n                            contentType: \"application/json; charset=utf-8\"\r\n                        }).done(function (data, status, xhr) {\r\n                            if (\"SUCCESS\" === data.code) {\r\n                                var costInLocal = data.returnobject;\r\n                                console.log(\"Cost loaded successfuly: \", costInLocal);\r\n                                $.get({\r\n                                    url: \"/api/v1/vac/\" + vac + \"/numofdecimals\",\r\n                                    contentType: \"application/json; charset=utf-8\"\r\n                                }).done(function (data, status, xhr) {\r\n                                    if (\"SUCCESS\" === data.code) {\r\n                                        logger.i(\"Info loaded successful\");\r\n                                        var numOfDecimals = data.returnobject;\r\n                                        /*var vasfeeofferingcostinref = (amount * cost);\r\n                                        if (parseFloat(vasfeeofferingcostinref)%1==0){\r\n                                            vasfeeofferingcostinref = vasfeeofferingcostinref.toFixed(0);\r\n                                        }else{\r\n                                            vasfeeofferingcostinref = vasfeeofferingcostinref.toFixed(2);\r\n                                        }\r\n                                        element.parents('.vasfee').find('.vasfeeofferingcostinref').text(vasfeeofferingcostinref);*/\r\n                                        element.parents('.vasfee').find('.vasfeeofferingcostinlocal').text((amount * costInLocal).toFixed(numOfDecimals));\r\n                                        recalculateFees();\r\n                                    } else {\r\n                                        alertify.error(data.message);\r\n                                    }\r\n                                });\r\n\r\n                            } else {\r\n                                alertify.error(data.message);\r\n                            }\r\n                        }); //done---1st call\r\n                    } else {\r\n                        alertify.error(data.message);\r\n                    }\r\n                }); //done---1st call\r\n\r\n                //------------------\r\n                ubi.loader.blocking.stop();\r\n                //recalculate\r\n            } else {\r\n                console.log(\"Vas Fee Deselected\", \"0.00\");\r\n                //element.parents('.vasfee').find('.vasfeeofferingcostinref').text('0');\r\n                element.parents('.vasfee').find('.vasfeeofferingcostinlocal').text('0.00');\r\n                recalculateFees();\r\n            }\r\n        });\r\n\r\n        $(document).on(\"click\", \".vasfee .vasfeeofferingdelete\", function () {\r\n            console.log(\"Deleting vasoffering \");\r\n            $(this).closest('tr').remove();\r\n            recalculateFees();\r\n        });\r\n\r\n        $(\".vasfeeofferingadd\").click(function () {\r\n\r\n            var lastRow = $(this).parents('.fees').find('.template');\r\n            var numofvasfeeoffering = $(\"#numofvasfeeoffering\").val();\r\n\r\n            console.log(\"Cloning\", lastRow);\r\n            var newRow = lastRow.clone();\r\n\r\n            newRow.removeClass('hidden');\r\n            newRow.removeClass('template');\r\n            newRow.find('select').attr(\"id\", \"vasfeeoffering_\"+numofvasfeeoffering);\r\n            newRow.find('input').attr(\"id\", \"vasfeeofferingselection_\"+numofvasfeeoffering);\r\n            lastRow.before(newRow);\r\n            newRow.find('.select2').remove();\r\n            newRow.find('select').select2({\r\n                matcher: matchStart,\r\n                templateResult: formatResult,\r\n            });\r\n            $(\"#numofvasfeeoffering\").val(parseInt(numofvasfeeoffering)+1);\r\n\r\n        /*    let vac = $(\"#vac\").val();\r\n            let localCurrency = 'LOCAL';\r\n            if ($(\"#localCurrency\").val() !== 0 && $(\"#localCurrency\").val() !== undefined && $(\"#localCurrency\").val() !== '' ) {\r\n                localCurrency = $(\"#localCurrency\").val();\r\n            }\r\n            console.log('vac', vac);\r\n            //fetch choices\r\n            ubi.loader.blocking.start();\r\n            $.get({\r\n                url: \"/api/v1/vac/\" + vac + \"/vasfeeoffering\",\r\n                contentType: \"application/json; charset=utf-8\"\r\n            }).done(function (data, status, xhr) {\r\n                if (\"SUCCESS\" === data.code) {\r\n                    logger.i(\"Loaded successful\");\r\n                    var array = data.returnobject;\r\n                    var htmlVar = \"\";\r\n                    for (var i = 0; i < array.length; i++) {\r\n                        console.log(array[i].isunitable);\r\n                        htmlVar += '<option value=\"' + array[i].id + '\">'\r\n                                + array[i].name +' - '+ array[i].costinlocal + '  '+localCurrency\r\n                                + '</option>';\r\n                    }\r\n\r\n                    console.log('newRow',newRow);\r\n                    newRow.find('select').html(htmlVar);\r\n                    newRow.find('.select2').remove();\r\n                    newRow.find('select').select2({\r\n                      });\r\n\r\n                } else {\r\n                    alertify.error(data.message);\r\n                }\r\n                ubi.loader.blocking.stop();\r\n            });*/\r\n\r\n\r\n        });\r\n\r\n        $(\".vasfeeoffering\").select2({\r\n            matcher: matchStart,\r\n            templateResult: formatResult,\r\n          });\r\n\r\n\r\n    }//EoM feesManagement Ajax Calls\r\n\r\n    function formatResult(node) {\r\n        var level = 0;\r\n        var classAttr = '';\r\n        if(node.element !== undefined){\r\n          level = (node.element.className);\r\n          if (level==='hidden'){\r\n            return null;\r\n          }else if(level.trim() !== ''){\r\n            level = (parseInt(level.match(/\\d+/)[0]));\r\n            classAttr = ' class=\"'+node.element.className+'\"';\r\n          }\r\n        }\r\n\r\n        var $result = $('<span '+classAttr+' style=\"padding-left:' + (20 * level) + 'px;\">' + node.text + '</span>');\r\n        return $result;\r\n      };\r\n\r\n\r\n    function matchStart(params, data){\r\n        if (typeof params.term === 'undefined'){\r\n\t    return data;\r\n\t}\r\n\r\n\tif (data.text.toUpperCase().indexOf(params.term.toUpperCase()) > -1 ||\r\n            ($(data.element).attr(\"label\")!=='' && typeof $(data.element).attr(\"label\") !== 'undefined' && $(data.element).attr(\"label\").toUpperCase().indexOf(params.term.toUpperCase()) > -1)||\r\n            ($(data.element).attr(\"title\")!=='' && typeof $(data.element).attr(\"title\") !== 'undefined' && $(data.element).attr(\"title\").toUpperCase().indexOf(params.term.toUpperCase()) > -1)\r\n\t ){\r\n\t    var modifiedData = $.extend({}, data, true);\r\n\t    return modifiedData;\r\n\t }\r\n\r\n\tvar modifiedData = $.extend(modifiedData, data, true);\r\n\tvar currChildrenArray = [];\r\n\t$.each(data.children, function(index, elem){\r\n\t        if(elem.text.toUpperCase().indexOf(params.term.toUpperCase()) > -1){\r\n\t\t       currChildrenArray.push(elem);\r\n\t         }\r\n\t  });\r\n\tif(currChildrenArray.length > 0){\r\n\t\tmodifiedData.children = currChildrenArray;\r\n\t\treturn modifiedData;\r\n\t}\r\n\treturn null;\r\n    }\r\n\r\n\r\n    function recalculateFees() {\r\n        //let totalcostinref = 0.00;\r\n        let totalcostinlocal = 0.00;\r\n        //get values\r\n        //let visafeeofferingcostinref = parseFloat($(\"#visafeeofferingcostinref\").text());\r\n        let visafeeofferingcostinlocal = parseFloat($(\"#visafeeofferingcostinlocal\").text());\r\n        //let servicefeeofferingcostinref = parseFloat($(\"#servicefeeofferingcostinref\").text());\r\n        let servicefeeofferingcostinlocal = parseFloat($(\"#servicefeeofferingcostinlocal\").text());\r\n        let vac = $(\"#vac\").val();\r\n\r\n        $.get({\r\n            url: \"/api/v1/vac/\" + vac + \"/numofdecimals\",\r\n            contentType: \"application/json; charset=utf-8\"\r\n        }).done(function (data, status, xhr) {\r\n            if (\"SUCCESS\" === data.code) {\r\n                logger.i(\"Info loaded successful\");\r\n                var numOfDecimals = data.returnobject;\r\n\r\n                //totalcostinref = (visafeeofferingcostinref + servicefeeofferingcostinref);\r\n                totalcostinlocal = (visafeeofferingcostinlocal + servicefeeofferingcostinlocal).toFixed(numOfDecimals);\r\n                //Iterate\r\n                /*$(\".vasfee .vasfeeofferingcostinref\").each(function (index) {\r\n                    totalcostinref = parseFloat(totalcostinref) + parseFloat($(this).text());\r\n                    console.log(index + \": \" + $(this).text());\r\n                });*/\r\n                $(\".vasfee .vasfeeofferingcostinlocal\").each(function (index) {\r\n                    totalcostinlocal = parseFloat(totalcostinlocal) + parseFloat($(this).text());\r\n                    console.log(index + \": \" + $(this).text());\r\n                });\r\n\r\n                //Final\r\n               /* if (parseFloat(totalcostinref)%1==0){\r\n                    totalcostinref = totalcostinref.toFixed(0);\r\n                }else{\r\n                    totalcostinref = totalcostinref.toFixed(2);\r\n                }\r\n                $(\"#totalcostinref\").text(totalcostinref);*/\r\n                $(\"#totalcostinlocal\").text(totalcostinlocal.toFixed(numOfDecimals));\r\n            } else {\r\n                alertify.error(data.message);\r\n            }\r\n        });\r\n\r\n    }//EoM\r\n\r\n    function changeTravelDocumentIssuingCountry(fieldname){\r\n        let country = $(\"#\"+fieldname).val();\r\n        if (country !== 0 && country !== undefined && country !== '') {\r\n            // Country\r\n            if ($('#passportregex'+country).length){\r\n                $('#traveldocumentnumber').attr('pattern', $('#passportregex'+country).val());\r\n                $('#traveldocumentnumber2').attr('pattern', $('#passportregex'+country).val());\r\n                let mrzravel = $(\"#mrztraveldocumentnumber\").val();\r\n                if (mrzravel !== 0 && mrzravel !== undefined ) {\r\n                    $('#mrztraveldocumentnumber').attr('pattern', $('#passportregex'+country).val());\r\n                }\r\n            }else{\r\n                $('#traveldocumentnumber').removeAttr('pattern');\r\n                $('#traveldocumentnumber2').removeAttr('pattern');\r\n                let mrzravel = $(\"#mrztraveldocumentnumber\").val();\r\n                if (mrzravel !== 0 && mrzravel !== undefined ) {\r\n                    $('#mrztraveldocumentnumber').removeAttr('pattern');\r\n                }\r\n            }\r\n            if ($('#passportsize'+country).length){\r\n                $('#traveldocumentnumber').attr('maxlength', $('#passportsize'+country).val());\r\n                $('#traveldocumentnumber2').attr('maxlength', $('#passportsize'+country).val());\r\n                let mrzravel = $(\"#mrztraveldocumentnumber\").val();\r\n                if (mrzravel !== 0 && mrzravel !== undefined ) {\r\n                    $('#mrztraveldocumentnumber').attr('maxlength', $('#passportsize'+country).val());\r\n                }\r\n            }else{\r\n                $('#traveldocumentnumber').removeAttr('maxlength');\r\n                $('#traveldocumentnumber2').removeAttr('maxlength');\r\n                let mrzravel = $(\"#mrztraveldocumentnumber\").val();\r\n                if (mrzravel !== 0 && mrzravel !== undefined ) {\r\n                    $('#mrztraveldocumentnumber').removeAttr('maxlength');\r\n                }\r\n            }\r\n            if ($('#passportmessage'+country).length){\r\n                $('#traveldocumentnumber').attr('data-parsley-pattern-message', $('#passportmessage'+country).val());\r\n                $('#traveldocumentnumber2').attr('data-parsley-pattern-message', $('#passportmessage'+country).val());\r\n                let mrzravel = $(\"#mrztraveldocumentnumber\").val();\r\n                if (mrzravel !== 0 && mrzravel !== undefined ) {\r\n                    $('#mrztraveldocumentnumber').attr('data-parsley-pattern-message', $('#passportmessage'+country).val());\r\n                }\r\n            }else{\r\n                $('#traveldocumentnumber').removeAttr('data-parsley-pattern-message');\r\n                $('#traveldocumentnumber2').removeAttr('data-parsley-pattern-message');\r\n                let mrzravel = $(\"#mrztraveldocumentnumber\").val();\r\n                if (mrzravel !== 0 && mrzravel !== undefined ) {\r\n                    $('#mrztraveldocumentnumber').removeAttr('data-parsley-pattern-message');\r\n                }\r\n            }\r\n\r\n\r\n        }\r\n    }\r\n\r\n    function selectTravelDocumentIssuingCountry(){\r\n        //--------------------Field 1 ---------------------------\r\n      /*  $(\"#traveldocumentissuingcountry\").change(function () {\r\n            changeTravelDocumentIssuingCountry(\"traveldocumentissuingcountry\");\r\n        }); //traveldocumentissuingcountry */\r\n    }//EoM\r\n\r\n    function enableVisaTypes(){\r\n        //if visa type exists\r\n        if ($('#visatype').length){\r\n            $(\"#vac\").change(function () {\r\n\r\n                let vac = $(\"#vac\").val();\r\n                console.log('vac', vac);\r\n                //fetch choices\r\n                if (vac !== 0 && vac !== undefined && vac !== '') {\r\n                    // vac\r\n                    ubi.loader.blocking.start();\r\n                    $.get({\r\n                        url: \"/api/v1/vac/\" + vac + \"/visatype\",\r\n                        contentType: \"application/json; charset=utf-8\"\r\n                    }).done(function (data, status, xhr) {\r\n                        if (\"SUCCESS\" === data.code) {\r\n                            logger.i(\"visatype loaded successful\");\r\n                            var lang = getLanguage();\r\n    //                        console.log('lang', lang);\r\n                            var option1 = new Option('', '');\r\n                            //remove all first\r\n                            $('#visatype').find('option').remove();\r\n                            //add new items\r\n                            $('#visatype').append($(option1));\r\n\r\n                            $.each(data.returnobject, function (i, rvisatype) {\r\n                                var mlname = rvisatype.name;\r\n                                if (lang === 'ru-RU')\r\n                                    mlname = rvisatype.nameru;\r\n                                if (lang === 'am-AM')\r\n                                    mlname = rvisatype.nameam;\r\n                                if (lang === 'cn-CN')\r\n                                    mlname = rvisatype.namecn;\r\n                                var option2 = new Option(mlname, rvisatype.id);\r\n                                if (data.returnobject.length==1){\r\n                                    option2.selected = 'selected';\r\n                                }\r\n                                $('#visatype').append($(option2));\r\n                            });\r\n\r\n\r\n                        } else {\r\n                            alertify.error(data.message);\r\n                        }\r\n                        ubi.loader.blocking.stop();\r\n                    });\r\n                }\r\n\r\n\r\n            });\r\n        }\r\n    }//EoM\r\n\r\n    function displayConfirmationMessage($this, temp, verb, msgid, isApplicant){\r\n        var msgTitle = $(\"#\"+msgid+\"Title\").val();\r\n        var msg = $(\"#\"+msgid).val();\r\n        alertify.confirm(msgTitle, msg,\r\n            function(){\r\n                handleCreate($this, temp, verb, isApplicant);\r\n            },\r\n            function () {\r\n              logger.i(\"Submission cancelled\");\r\n            }\r\n        ).set({\r\n          labels: {ok: ubi.getTranslationExt('frontend.message.submit'), cancel: ubi.getTranslationExt('frontend.message.cancel')},\r\n          reverseButtons: true,\r\n          transition: 'fade'\r\n        });\r\n    }\r\n\r\n    function financialAlert($this, temp, verb){\r\n       /* var msgTitle = \"Save\";\r\n        var msg = \"You added financials. Do you want to save them?\";\r\n        alertify.confirm(msgTitle, msg,\r\n            function(){\r\n                $(\"#btn-newvisa\").attr(\"data-submit\", $(\"#btn-newvisa-savepprs\").attr(\"data-submit\").replace(\"/pprs\", \"/pprsandsave\"));\r\n                handleCreate($this, temp, verb);\r\n            },\r\n            function () {\r\n              handleCreate($this, temp, verb);\r\n            }\r\n        ).set({\r\n          labels: {ok: 'Save VAF and Fees', cancel: 'Save VAF only'},\r\n          reverseButtons: true,\r\n          transition: 'fade'\r\n        });*/\r\n        //save without asc\r\n        $(\"#btn-newvisa\").attr(\"data-submit\", $(\"#btn-newvisa-savepprs\").attr(\"data-submit\").replace(\"/pprs\", \"/pprsandsave\"));\r\n        handleCreate($this, temp, verb, false);\r\n    }\r\n\r\n    function confirmSubmission($this, temp, verb, enableConfirm, msgid, formID){\r\n        if (!enableConfirm){\r\n            refreshMRZ();\r\n            let newExtraservicesSer = $('#extraservices :input').serialize();\r\n            if ($($this).attr(\"id\") !== 'btn-newvisa-savepprs' && newExtraservicesSer !== extraservicesSer){                \r\n                financialAlert($this, temp, verb);                \r\n            }else{\r\n                handleCreate($this, temp, verb, false);\r\n            }\r\n        }else{\r\n            //check if checkbox is checked\r\n            if ($('input[name=\"submitinfo\"]:checked').length > 0){\r\n\r\n                // Define form\r\n                var $form = $('form#' + formID);\r\n                if ($form.length < 1) {\r\n                  throw new TypeError(\"No form found with id='\" + formID + \"'\");\r\n                }\r\n\r\n                var fields = $form.serializeJSON(serializeJSON_OPTIONS);\r\n                var field;\r\n                for (field in fields) {\r\n                  if (typeof fields[field] === 'string') {\r\n                    fields[field] = fields[field].trim();\r\n                  }\r\n                }\r\n\r\n\r\n                $.get({\r\n                    url: \"/api/v1/var/validate\",\r\n                    contentType: \"application/json; charset=utf-8\",\r\n                    type: 'POST',\r\n                    data: JSON.stringify(fields)\r\n                    }).done(function (data, status, xhr) {                            \r\n                        if (\"SUCCESS\" === data.code && !Array.isArray(data.returnobject)) {\r\n                            displayConfirmationMessage($this, temp, verb, msgid, true);\r\n                        }else if (Array.isArray(data.returnobject)) {      //Array of errors\r\n                             checkForErrors(data.returnobject);\r\n                        }\r\n                    });\r\n            }else{\r\n                //force to check the checkbox\r\n                var msgCheck = $(\"#\"+msgid+\"Check\").val();\r\n                alertify.error(msgCheck);\r\n            }\r\n\r\n\r\n        }//end of else\r\n    }//EoM\r\n\r\n    function enableMrzEvents(){\r\n        if ($( \"input[id^='mrz']\" )){\r\n            $( \"input[id^='mrz']\" ).change(function () {\r\n                let formfieldname = this.id.substr(3);\r\n                let formfield = $( \"#\"+formfieldname);\r\n                if (formfield && formfield.length && formfield.length > 0){\r\n                    formfield.val(this.value);\r\n                    formfield.trigger('change', true);\r\n                }\r\n            });\r\n        }\r\n        if ($( \"select[id^='mrz']\" )){\r\n            $( \"select[id^='mrz']\" ).not(\"mrztraveldocumentissuingcountry\").change(function () {\r\n                let formfieldname = this.id.substr(3);\r\n                let formfield = $( \"#\"+formfieldname);\r\n                if (formfield && formfield.length && formfield.length > 0){\r\n                    formfield.val(this.value);\r\n                    formfield.trigger('change', true);\r\n                }\r\n                if (this.id==='mrzcurrentnationality1'){\r\n                    //$( \"#mrztraveldocumentissuingcountry\").find('option').remove();\r\n                    //add new items\r\n                    var selectedText = $( \"#mrzcurrentnationality1 option:selected\").text();\r\n                    /*commented by Apostolos. Issuing country can be different by the nationality (21/07/2020)*/\r\n                    /*\r\n                    var option1 = new Option(selectedText,  this.value);\r\n                    $('#mrztraveldocumentissuingcountry').append($(option1));*/\r\n                    $('#mrztraveldocumentissuingcountry').val(this.value);\r\n                    $('#mrztraveldocumentissuingcountry').trigger('change', true);\r\n                    \r\n                    /*commented by Apostolos. Issuing country can be different by the nationality (21/07/2020)*/\r\n                    /*var option2 = new Option(selectedText,  this.value);\r\n                    $(\"#traveldocumentissuingcountry\").find('option').remove();\r\n                    $('#traveldocumentissuingcountry').append($(option2));*/\r\n                    $('#traveldocumentissuingcountry').val(this.value);\r\n                    $('#traveldocumentissuingcountry').trigger('change', true);\r\n                }\r\n            });\r\n            //traveldocumentissuingcountry\r\n            $(\"#mrztraveldocumentissuingcountry\").change(function () {\r\n                let country = $(\"#mrztraveldocumentissuingcountry\").val();\r\n                if (country !== 0 && country !== undefined && country !== '') {\r\n                    $('#traveldocumentissuingcountry').val(this.value);\r\n                    $('#traveldocumentissuingcountry').trigger('change', true);\r\n\r\n                }\r\n            });\r\n\r\n        }\r\n\r\n    }\r\n\r\n    function refreshMRZ(){\r\n        if ($( \"input[id^='mrz']\" )){\r\n            $.each($( \"input[id^='mrz']\" ).not(\"mrztraveldocumentnumber\"), function(index, elem){\r\n                let formfieldname = elem.id.substr(3);\r\n                let formfield = $( \"#\"+formfieldname);\r\n                if (formfield && formfield.length && formfield.length > 0 && elem.value !== formfield.val()){\r\n                    elem.value = formfield.val();\r\n                }\r\n            });\r\n            $.each($( \"input[id^='mrz']\" ).not(\"mrztraveldocumentnumber\"), function(index, elem){\r\n\r\n                var parelem = $('#traveldocumentnumber').parsley();\r\n                var parelem2 = $('#traveldocumentnumber2').parsley();\r\n                var parelem3 = $('#mrztraveldocumentnumber').parsley();\r\n                parelem.reset();\r\n                parelem2.reset();\r\n                parelem3.reset();\r\n\r\n                let formfieldname = elem.id.substr(3);\r\n                let formfield = $( \"#\"+formfieldname);\r\n                if (formfield && formfield.length && formfield.length > 0 && elem.value !== formfield.val()){\r\n                    elem.value = formfield.val();\r\n                }\r\n\r\n            });\r\n\r\n        }\r\n        if ($( \"select[id^='mrz']\" )){\r\n            $.each($( \"select[id^='mrz']\" ).not(\"mrztraveldocumentissuingcountry\"), function(index, elem){\r\n                let formfieldname = elem.id.substr(3);\r\n                let formfield = $( \"#\"+formfieldname);\r\n                if (formfield && formfield.length && formfield.length > 0 && elem.value !== formfield.val()){\r\n                    elem.value = formfield.val();\r\n                    $('#'+elem.name).trigger('change', true);\r\n                }\r\n                if (formfieldname==='mrzcurrentnationality1'){\r\n                    setCurrentNationalityPassport1();\r\n                }\r\n            });\r\n            $(\"#mrztraveldocumentissuingcountry\").change(function () {\r\n                changeTravelDocumentIssuingCountry(\"mrztraveldocumentissuingcountry\");\r\n            }); //mrztraveldocumentissuingcountry\r\n        }\r\n    }\r\n\r\n\r\n    /*\r\n     * Overide window event for proper hooking\r\n     */\r\n    function onPageLoad() {\r\n        //Ajax calls\r\n        ajaxCallManagement();\r\n\r\n        onFieldFocus();\r\n        enableTabEvents();\r\n        enableVisaTypes();\r\n        //Travel document events\r\n        enableTravelDocumentValidationEvent();\r\n        //Generic Date Validators\r\n        enableValidatorforDatesInThePast();\r\n        enableValidatorforDatesInTheFuture();\r\n        enableValidatorPairedDates();\r\n        //Sequential Field Validators\r\n        enableValidatorForProperSequentialFilling();\r\n        enableValidatorForOverlappingAvoidance();\r\n        //Dynamic show/hide\r\n        enableEUMemberEvents();\r\n        enableMaritalStatusOtherEvents();\r\n        enableTravelDocumentTypeOtherEvents();\r\n        enableResidenceOtherEvents();\r\n        enableCurrentOccupationOtherEvents();\r\n        enableMeansofsupportOtherEvents();\r\n        enableDeliveryAddress();\r\n        enablePreviousVisas();\r\n        enablePreviousFingerprintsEvents();\r\n        enableEntryPermitEvents();\r\n        enableHostingEvents();\r\n        enableCostTravelingEvents();\r\n        enableInsurance();\r\n        //Calculations\r\n        enableLegalGuardianEvents();\r\n        enableTraveldateCalculationEvents();\r\n        enablePreviousVisasCalculationEvents();\r\n        selectTravelDocumentIssuingCountry();\r\n        enableUSSR();\r\n        enableVarappointment();\r\n        enableUpdateButton();\r\n\r\n        if ($(\"#mrz\" )){\r\n            enableMrzEvents();\r\n        }\r\n       \r\n        \r\n\r\n        //if mode=create new ==> set hosting (hide eu option from hosting)\r\n        let varid = $(\"#id\").val();\r\n        if (varid === undefined) {\r\n            $('#eumember').trigger('change');\r\n        }\r\n        //Conditional Mandatory Validators\r\n        //\r\n        if ($(\"#extraservices\" )){\r\n            feesManagement();\r\n            extraservicesSer = $('#extraservices :input').serialize();\r\n        }\r\n\r\n        //find active tab\r\n        let activeTab = 'personal';\r\n        if ($('#form-tabs').find('ul li.active') !== undefined && $('#form-tabs').find('ul li.active').attr(\"id\") !== undefined)  {\r\n            activeTab = $('#form-tabs').find('ul li.active').attr(\"id\").split(\"-\")[1];\r\n        }\r\n        \r\n        if (activeTab === \"photoupload\" ){\r\n            loadAndPreviewPhoto();\r\n        }\r\n\r\n        //disable update vaf button after redirection in financials tab\r\n        if (activeTab === \"extraservices\" ){\r\n            $(\"#btn-newvisa\").attr('disabled', true);\r\n        }\r\n\r\n        //Go to index\r\n        gotoAnchor(activeTab);\r\n        onPrepareExport();\r\n       //onUnloadAlert();\r\n\r\n\r\n    }//EoM\r\n\r\n    function onUnloadAlert(){\r\n        $('#main-wrapper').on('change keyup keydown', 'input, textarea, select', function (e) {\r\n           $('#main-wrapper').addClass('changed-input');\r\n        });\r\n\r\n        $(window).on('beforeunload', function () {\r\n            let msg = commitChangesAlert();\r\n            if (msg !== ''){\r\n                return msg;\r\n            }\r\n        });\r\n\r\n\r\n        $(\".tr\").on('click', function () {\r\n            let msg = commitChangesAlert();\r\n            if (msg !== ''){\r\n                alertify.confirm(\"Submit\", msg,\r\n                    function(){\r\n                        return;\r\n                    },\r\n                    function(){\r\n                    }\r\n                ).set({\r\n                    labels: {ok: 'Submit', cancel: 'Cancel'},\r\n                    reverseButtons: true,\r\n                    transition: 'fade'\r\n                });\r\n            }\r\n        });\r\n    }\r\n\r\n    function commitChangesAlert(){\r\n\r\n        if ($('.changed-input').length) {\r\n            return 'You haven\\'t saved your changes.';\r\n        }\r\n        return \"\";\r\n    }\r\n\r\n\r\n    function onPrepareExport() {\r\n         //create drop up buttons\r\n         $(\".dropup\").click(function () {\r\n           var dropupMenuID = \"#\"+this.id+\"-myDropup\";\r\n           var dropupMenu = $(dropupMenuID);\r\n           $(\".dropup-content\").not(dropupMenuID).hide();\r\n           dropupMenu.toggle( \"slow\", function() {\r\n            // Animation complete.\r\n            });\r\n\r\n            // on click of the document, close the menus\r\n            $(document).one(\"click\", function () {\r\n                //menu.hide();\r\n                dropupMenu.hide();\r\n            });\r\n            return false;\r\n\t});\r\n\r\n    }//EoM\r\n\r\n\r\n    var extraservicesSer = \"\";\r\n\r\n    function onFieldFocus() {\r\n        function removeErrors() {\r\n            var $this = $(this);\r\n            if ($this.hasClass('benderr')) {\r\n                $this.parsley().removeError(this.id);\r\n                $this.removeClass('benderr');\r\n                showErrorsOnTabs();\r\n            }\r\n        }\r\n\r\n        $('#visa-request').find('.form-control').on('keydown', removeErrors);\r\n\r\n        $('#visa-request').find('.form-control').on('select2:select', removeErrors);\r\n    }\r\n    \r\n    //clear all previous errors\r\n    function removeAllErrors(){\r\n      $('#form-tabs li').each(function (i, v) {        \r\n            var $this = $(this);\r\n            var tabId = v.id;\r\n            var tabContentId = tabId.split('-')[1];\r\n\r\n            $('#' + tabContentId).each(function (i2, v2) {\r\n                var $tabContent = $(v2);    \r\n                           \r\n                $tabContent.find('.parsley-errors-list.filled').each(function (i1, v1) {                \r\n                  v1.remove();\r\n                });\r\n                $this.children('.errors-num').text('');                \r\n            })\r\n        });\r\n        \r\n    }\r\n\r\n    // show error number indicators on tabs\r\n    function showErrorsOnTabs() {\r\n        $('#form-tabs li').each(function (i, v) {\r\n            var $this = $(this);\r\n            var tabId = v.id;\r\n            var tabContentId = tabId.split('-')[1];\r\n\r\n            $('#' + tabContentId).each(function (i, v) {\r\n                var $tabContent = $(v);\r\n                var errorsNum = $tabContent.find('.parsley-errors-list.filled').length;\r\n\r\n                if (errorsNum > 0) {\r\n                    $this.children('.errors-num').text(errorsNum);\r\n                } else {\r\n                    $this.children('.errors-num').text('');\r\n                }\r\n            })\r\n        })\r\n    }\r\n\r\n    function handleCreate($this, temp, verb, isApplicant) {\r\n        removeAllErrors();\r\n        \r\n        var $this = $($this);\r\n        var formID = $this.attr('form');\r\n        var $form = $('#' + formID);\r\n        //TODO for immediate return in case of non existing of mandatory\r\n        $form.parsley().reset();\r\n        resetErrorsOnTabs();\r\n        var dataRedirectArray = $this.attr('data-redirect').split(\"/\");\r\n        //add hash only in case of edit and add\r\n        if (window.location.hash.length>0 && $this.attr('data-redirect')!==\"stay\"\r\n                && ($this.attr('data-redirect').indexOf('/group/')< 0 &&\r\n                    $this.attr('data-redirect').indexOf('/result/')< 0\r\n                ) &&\r\n                (dataRedirectArray.length>0&& !isNaN(dataRedirectArray[dataRedirectArray.length-1]))){\r\n            if (!$this.attr('data-redirect-origin')){\r\n                $this.attr('data-redirect-origin', $this.attr('data-redirect'));\r\n            }\r\n            var dataRedirect = $this.attr('data-redirect-origin');\r\n            if (!dataRedirect.endsWith(\"/\")){\r\n                dataRedirect = dataRedirect + \"/\";\r\n            }\r\n            $this.attr('data-redirect', dataRedirect + window.location.hash.split(\"#\")[1]);\r\n\r\n        }\r\n        \r\n        var originDataRedirect = $this.attr('data-redirect');\r\n        //when the below code is acitve, user didn't redirect after (save draft -> submit) and all buttons goes to page not found.\r\n        // if (isApplicant) {\r\n        //   $this.attr('data-redirect', 'stay');\r\n        // }\r\n        ubi.crud[verb]($this, function (data) {\r\n            if (isApplicant){\r\n              $this.attr('data-redirect', originDataRedirect);\r\n            }\r\n            var robj = data.returnobject;\r\n            if (Array.isArray(robj)) {      //Array of errors              \r\n                //checkForErrors(robj);\r\n                if (checkForErrors(robj)) {\r\n                    console.log(\"errors\");\r\n                    document.documentElement.scrollTop = 0;\r\n                }\r\n            } else if ($this.attr('data-redirect').indexOf('/result/0')>= 0){\r\n                $this.attr('data-redirect', '/visa-request/result/' + robj);\r\n                page('/visa-request/result/' + robj);\r\n            } else if (!isNaN(robj) && robj > 0 && temp) {\r\n                page('/visa-request/' + robj); //+ window.location.hash\r\n            }\r\n\r\n        }, {skipValidation: temp}); // if true skip validation\r\n\r\n    }\r\n    \r\n    function changeVisaType(btnName){\r\n        $('#'+btnName).click();\r\n    }\r\n\r\n    function loadAndPreviewPhoto() {\r\n        var varid = $('#id').val();\r\n        var API_URL = ubi.API_URL_PREFIX + \"/var/\" + varid + \"/dophotopreview\";\r\n\r\n        // todo extra checks for other users\r\n        $.ajax({\r\n            type: 'GET',\r\n            url: API_URL,\r\n            processData: false,\r\n            contentType: false\r\n        }).done( function (data, textStatus, jqXHR) {\r\n            console.log(\"Status: \" + textStatus + \", code: \" + jqXHR.status);\r\n            $(\"#photodiv\").html('<img id=\"photo\" src=\"data:image/jpg;base64,' + data + '\" />');\r\n            // $('#photofile').attr('src', \"data:image/jpg;base64,' + data + '\");\r\n        }).error(function (data, textStatus, jqXHR) {\r\n            console.log(\"Status: \" + textStatus + \", code: \" + jqXHR.status);\r\n            // alertify.error(\"No photo exists for this application\")\r\n            $(\"#photodiv\").html('<img id=\"photo\" src=\"/dist/images/photo.jpg\" />');\r\n        });\r\n    }\r\n\r\n    // export to the outside world\r\n    window.ubi.var = {\r\n        onPageLoad: onPageLoad,\r\n        showErrorsOnTabs: showErrorsOnTabs,\r\n        handleCreate: handleCreate,\r\n        confirmSubmission: confirmSubmission,\r\n        refreshMRZ: refreshMRZ,\r\n        loadAndPreviewPhoto: loadAndPreviewPhoto,\r\n        changeVisaType: changeVisaType,\r\n    };\r\n\r\n\r\n})(window);\r\n\r\n// Warning before leaving the page (back button, or outgoinglink)\r\n/*window.onbeforeunload = function() {\r\n   return \"Do you really want to leave our brilliant application?\";\r\n   //if we return nothing here (just calling return;) then there will be no pop-up question at all\r\n   //return;\r\n};*/\r\n\n/**\n * Notifications js logic\n */\n\n(function(window) {\n    'use strict';\n    \n    var Base64={_keyStr:\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=\",encode:function(e){var t=\"\";var n,r,i,s,o,u,a;var f=0;e=Base64._utf8_encode(e);while(f<e.length){n=e.charCodeAt(f++);r=e.charCodeAt(f++);i=e.charCodeAt(f++);s=n>>2;o=(n&3)<<4|r>>4;u=(r&15)<<2|i>>6;a=i&63;if(isNaN(r)){u=a=64}else if(isNaN(i)){a=64}t=t+this._keyStr.charAt(s)+this._keyStr.charAt(o)+this._keyStr.charAt(u)+this._keyStr.charAt(a)}return t},decode:function(e){var t=\"\";var n,r,i;var s,o,u,a;var f=0;e=e.replace(/[^A-Za-z0-9\\+\\/\\=]/g,\"\");while(f<e.length){s=this._keyStr.indexOf(e.charAt(f++));o=this._keyStr.indexOf(e.charAt(f++));u=this._keyStr.indexOf(e.charAt(f++));a=this._keyStr.indexOf(e.charAt(f++));n=s<<2|o>>4;r=(o&15)<<4|u>>2;i=(u&3)<<6|a;t=t+String.fromCharCode(n);if(u!=64){t=t+String.fromCharCode(r)}if(a!=64){t=t+String.fromCharCode(i)}}t=Base64._utf8_decode(t);return t},_utf8_encode:function(e){e=e.replace(/\\r\\n/g,\"\\n\");var t=\"\";for(var n=0;n<e.length;n++){var r=e.charCodeAt(n);if(r<128){t+=String.fromCharCode(r)}else if(r>127&&r<2048){t+=String.fromCharCode(r>>6|192);t+=String.fromCharCode(r&63|128)}else{t+=String.fromCharCode(r>>12|224);t+=String.fromCharCode(r>>6&63|128);t+=String.fromCharCode(r&63|128)}}return t},_utf8_decode:function(e){var t=\"\";var n=0;var r=c1=c2=0;while(n<e.length){r=e.charCodeAt(n);if(r<128){t+=String.fromCharCode(r);n++}else if(r>191&&r<224){c2=e.charCodeAt(n+1);t+=String.fromCharCode((r&31)<<6|c2&63);n+=2}else{c2=e.charCodeAt(n+1);c3=e.charCodeAt(n+2);t+=String.fromCharCode((r&15)<<12|(c2&63)<<6|c3&63);n+=3}}return t}};\n    \n    var uploadvarbatch = {\n        validatefile: validatefile,\n        uploadvalid: uploadvalid,\n        uploadmultiplefiles: uploadmultiplefiles\n    };\n    \n    function validatefile() {\n        \n        var $btn = $('#btn-validateupload');\n        var formID = $btn.attr('form');\n                \n\n        importstats.style.display = \"none\";\n        importgroupname.style.display = \"none\";\n\n        // Empty checker\n        var validatorResult = ubi.validator.validate(formID, innerCrud);\n        if (!validatorResult) {\n            logger.e(\"Please check the form fields again\");\n\n            ubi.scrollToSpecificElement('.parsley-error', 70, 500, true);\n        }\n        \n        function innerCrud() {\n            var $file = $('#file');\n            \n            //disappear response buttons if exist\n            downloadErrorResponse.style.display = \"none\";\n            downloadSuccessResponse.style.display = \"none\";\n            validateSuccessResponse.style.display = \"none\";\n           \n           // myfile.setFileTypes('application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');/\n//            if (hasExceededFileSize($file[0]) || !hasRightFileTypes($file[0]))\n//                return;\n\n            var API_URL = ubi.API_URL_PREFIX + $btn.attr('data-submit');\n            var redirect = $btn.attr('data-redirect');\n\n            var fieldsData = $('#' + formID).serializeJSON(serializeJSON_OPTIONS);\n            var encodedData = Base64.encode(JSON.stringify(fieldsData));\n\n            var i;\n            var file = new FormData();\n            file.append('fieldsData', encodedData);\n            for (i = 0; i < $file[0].files.length; i++) {\n                file.append('files', $file[0].files[i]);\n            }\n\n            file.append('travelagent', JSON.stringify($('#travelagent').children(\"option:selected\").val()));\n\n            var urlSuffixForTA = \"\";\n            if ($('#travelagentid').val() !== undefined) {\n                urlSuffixForTA = \"/ta/\" + $('#travelagentid').val();\n            }\n\n            $btn.addClass('loading');\n            \n            var isModal = $('html').hasClass('modal');\n            $('html').hasClass('modal') ? ubi.loader.modal.start() : ubi.loader.nonBlocking.start();\n\n            $.ajax({\n                type: 'POST',\n                data: file,\n                url: API_URL,\n                processData: false,\n                contentType: false\n            }).done(function (data, textStatus, jqXHR) {\n                if (textStatus.toUpperCase() == \"SUCCESS\" &&\n                        (data.code.toUpperCase() === \"SUCCESS\" || data.code.toUpperCase() === \"INVALID\")) {\n\n                    if (data && data.returnobject) {\n                        var robj = data.returnobject;\n\n                        var $confirmupload = $btn.parents('form').find('#btn-confirmupload');\n                        var $downloaderror = $btn.parents('form').find('#btn-downloaderror');\n\n                        var totalEntries = robj.totalEntries;\n                        var validEntries = robj.validEntries;\n                        var invalidEntries = robj.invalidEntries;\n                        var validList = robj.validList;\n\n                        $(\"#importtotal\").text(totalEntries);\n                        $(\"#importvalid\").text(validEntries);\n                        $(\"#importerror\").text(invalidEntries);\n                        importstats.style.display = \"block\";\n\n                        // if there is at least one valid entry, enable 'submit' button\n                        if (validEntries > 0) {\n                            validateSuccessResponse.style.display = \"block\";\n                            $confirmupload.off('click');\n                            $confirmupload.on('click', function() {\n                                uploadvalid(robj.importedFileValid.fileDownloadUri, validList);\n                            });\n                        }\n                        // if there is at least one invalid entry, enable 'export errors' button\n                        if (invalidEntries > 0) {\n                            downloadErrorResponse.style.display = \"block\";\n                            var errorFileName = robj.importedFileError.fileName;\n                            $downloaderror.off('click');\n                            $downloaderror.on('click', function () {\n                                var bucketName = \"/b/excels\";\n                                if (robj.importedFileError.repository && robj.importedFileError.repository !== \"\" && robj.importedFileError.repository !== undefined){\n                                    if (robj.importedFileError.repository === \"-\"){\n                                        bucketName = \"/file\";\n                                    }else{\n                                        bucketName = \"/b/\"+ robj.importedFileError.repository;\n                                    }\n                                }\n                                window.open('/download/' + errorFileName + bucketName+'/' + robj.importedFileError.fileDownloadUri + urlSuffixForTA);\n                            });\n                        }\n\n                        // depending on the response code, we show the respective message\n                        if (robj.importedFileValid.fileName && data.code.toUpperCase() === \"SUCCESS\") {\n                            setTimeout(function () {\n                                alertify.success(data.message);\n                                $btn.removeClass('loading');\n                                isModal ? ubi.loader.modal.stop() : ubi.loader.nonBlocking.stop();\n                            }, ubi.loader.blocking.loadingTime);\n                        }\n                        if (robj.importedFileError.fileName && data.code.toUpperCase() === \"INVALID\") {\n                            setTimeout(function () {\n                                alertify.error(data.message);\n                                $btn.removeClass('loading');\n                                isModal ? ubi.loader.modal.stop() : ubi.loader.nonBlocking.stop();\n                            }, ubi.loader.blocking.loadingTime);\n                        }\n\n                    } else {\n                        setTimeout(function () {\n                            page(redirect);\n                            alertify.error(ubi.getTranslationExt(\"frontend.message.error.1\")); //\"Something went wrong. Please contact the system administrator.\"\n                            $btn.removeClass('loading');\n                            isModal ? ubi.loader.modal.stop() : ubi.loader.nonBlocking.stop();\n                        }, ubi.loader.blocking.loadingTime);\n                    }\n                } else {\n                    \"message\" in data ? alertify.error(data.message) : alertify.error(ubi.getTranslationExt(\"frontend.message.error.1\")); //\"Something went wrong. Please contact the system administrator.\"\n                    $btn.removeClass('loading');\n                    isModal ? ubi.loader.modal.stop() : ubi.loader.nonBlocking.stop();\n                }\n            }).error(function (data, textStatus, jqXHR) {\n                logger.e(status);\n                logger.e(data);\n                alertify.error(ubi.getTranslationExt(\"frontend.message.error.5\")); // \"Please contact the system administrator\"\n\n                $btn.removeClass('loading');\n                isModal ? ubi.loader.modal.stop() : ubi.loader.nonBlocking.stop();\n            });\n        }\n        \n    };\n    \n    function uploadvalid(fileURI, validList) {\n        \n        var $btn = $('#btn-confirmupload');\n        var formID = $btn.attr('form');\n\n        // Empty checker\n        alertify.confirm(ubi.getTranslationExt('frontend.message.uploadbatch.valid.title'), ubi.getTranslationExt('frontend.message.uploadbatch.valid.message'),\n            innerCrud,\n            function(){\n                alertify.alert(ubi.getTranslationExt('frontend.message.uploadbatch.valid.title'), ubi.getTranslationExt('frontend.message.uploadbatch.valid.cancelled'));\n            }\n        ).set({\n            labels: {ok: ubi.getTranslationExt('frontend.message.uploadbatch.valid.submit'), cancel: ubi.getTranslationExt('frontend.message.uploadbatch.valid.cancel')},\n            reverseButtons: true,\n            transition: 'fade'\n        });\n        \n        function innerCrud() {\n            var $file = $('#file');\n            //disappear response buttons if exist\n            downloadErrorResponse.style.display = \"none\";\n            downloadSuccessResponse.style.display = \"none\";\n\n           \n           // myfile.setFileTypes('application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');/\n//            if (hasExceededFileSize($file[0]) || !hasRightFileTypes($file[0]))\n//                return;\n\n            var API_URL = ubi.API_URL_PREFIX + $btn.attr('data-submit');\n            var redirect = $btn.attr('data-redirect');\n\n            var fieldsData = $('#' + formID).serializeJSON(serializeJSON_OPTIONS);\n            var encodedData = Base64.encode(JSON.stringify(fieldsData));\n\n            var i;\n            var file = new FormData();\n            file.append('fieldsData', encodedData);\n            for (i = 0; i < $file[0].files.length; i++) {\n                file.append('files', $file[0].files[i]);\n            }\n\n            file.append('travelagent', JSON.stringify($('#travelagent').children(\"option:selected\").val()));\n            file.append('fileURI', fileURI);\n            file.append('validList', validList);\n\n            var urlSuffixForTA = \"\";\n            if (typeof $('#travelagentid').val() !== 'undefined') {\n                urlSuffixForTA = \"/ta/\" + $('#travelagentid').val();\n            }\n\n            $btn.addClass('loading');\n            \n            var isModal = $('html').hasClass('modal');\n            $('html').hasClass('modal') ? ubi.loader.modal.start() : ubi.loader.nonBlocking.start();\n\n            $.ajax({\n                type: 'POST',\n                data: file,\n                url: API_URL,\n                processData: false,\n                contentType: false\n            }).done(function (data, textStatus, jqXHR) {\n                if (textStatus.toUpperCase() == \"SUCCESS\" &&\n                        (data.code.toUpperCase() === \"SUCCESS\" || data.code.toUpperCase() === \"INVALID\")) {\n\n                    if (data && data.returnobject) {\n                        var robj = data.returnobject;\n\n                        var $downloaderror = $btn.parents('form').find('#btn-downloaderror');\n                        var $downloadsuccess = $btn.parents('form').find('#btn-downloadsuccess');\n\n                        if (data.code.toUpperCase() === \"SUCCESS\" && robj.importedFileValid.fileName) {\n                            var validFileName = robj.importedFileValid.fileName;\n                            // by ISakel: oxi download me koumpi, alla apeu8eias, gia na mh xa8ei to paragomeno excel\n                            downloadSuccessResponse.style.display = \"block\";\n                            validateSuccessResponse.style.display = \"none\";\n                            $downloadsuccess.off('click');\n                            $downloadsuccess.on('click', function () {\n                                var bucketName = \"/b/excels\";\n                                if (robj.importedFileValid.repository && robj.importedFileValid.repository !== \"\" && robj.importedFileValid.repository !== undefined){                                    \n                                    if (robj.importedFileValid.repository === \"-\"){\n                                        bucketName = \"/file\";\n                                    }else{\n                                        bucketName = \"/b/\"+ robj.importedFileValid.repository;\n                                    }\n                                }\n                                window.open('/download/' + validFileName + bucketName+'/' + robj.importedFileValid.fileDownloadUri + urlSuffixForTA);\n                            });\n                            setTimeout(function () {\n                                // show new group name in front\n                                $(\"#groupname\").text(robj.groupid);\n                                importgroupname.style.display = \"block\";\n\n                                alertify.success(\"Group: \" + robj.groupid + \"\\r\\n\" + data.message, 20);\n                                $btn.removeClass('loading');\n                                isModal ? ubi.loader.modal.stop() : ubi.loader.nonBlocking.stop();\n                            }, ubi.loader.blocking.loadingTime);\n                            var bucketName = \"/b/excels\";\n                            if (robj.importedFileValid.repository && data.returnobject.repository !== \"\" && robj.importedFileValid.repository !== undefined){                                \n                                if (robj.importedFileError.repository === \"-\"){\n                                    bucketName = \"/file\";\n                                }else{\n                                    bucketName = \"/b/\"+ robj.importedFileValid.repository;\n                                }\n                            }\n                            window.open('/download/' + validFileName + bucketName+'/' + robj.importedFileValid.fileDownloadUri + urlSuffixForTA);\n                        }\n                        if (data.code.toUpperCase() === \"INVALID\" && robj.importedFileError.fileName) {\n\n                            var totalEntries = robj.totalEntries;\n                            var validEntries = robj.validEntries;\n                            var invalidEntries = robj.invalidEntries;\n\n                            $(\"#importtotal\").text(totalEntries);\n                            $(\"#importvalid\").text(validEntries);\n                            $(\"#importerror\").text(invalidEntries);\n             