            "text": "\r\n    \r\n    \r\n    <h1 ><span>Dashboard</span></h1>\r\n    <!--<h3>Overview page</h3>-->\r\n\r\n    <div id=\"main-area\" >\r\n        <form id=\"visa-request\" class=\"classic\" onsubmit=\"return false\">\r\n        <div class=\"hidden\"></div>\r\n        <div class=\"wrapper\">\r\n            \r\n            <div class=\"form-item\">\r\n                      \r\n            </div>\r\n            \r\n            <div >\r\n                <span>Welcome to GVCW. Use the menu (Ξ) to navigate</span>\r\n            </div>\r\n            \r\n            \r\n            \r\n            <!--<div class=\"form-item\">\r\n                <a sec:authorize=\"${hasAnyRole('BACKOFFICE')}\"                    \r\n                    class=\"btn big blue\" \r\n                    th:onclick=\"openclientwindow(this)\"  th:attr=\"data-submit='/key'\"\r\n                    target=\"_blank\">\r\n                <i class=\"fas fa-download\" aria-hidden=\"true\"></i>\r\n                Encrypt\r\n                </a>      \r\n            </div>-->\r\n          <!-- /*  <div class=\"form-item\">\r\n                <a \r\n                    href=\"/api/v1/downloadclient\"\r\n                    class=\"btn big blue\"                     \r\n                    target=\"_blank\">\r\n                <i class=\"fas fa-id-card\" aria-hidden=\"true\"></i>\r\n                DOWNLOAD\r\n                </a>      \r\n            </div> */ -->\r\n            \r\n                                         \r\n            \r\n            \r\n\r\n        </div>  \r\n        </form>\r\n    </div>\r\n\r\n"
