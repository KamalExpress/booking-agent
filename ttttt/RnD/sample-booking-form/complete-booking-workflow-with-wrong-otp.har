 return /^([\\x20-\\x60|\\x7b\\-\\xe]){1,65}$/.test(value.toUpperCase());\n                },\n                messages: {\n                    en: getTranslation('frontend.error.14.65',transarray)\n                }\n            });\n            \n            window.Parsley.addValidator('longval5_50', {//All ASCII characters inside of the range of 32-126 (exclude lower case)\n                requirementType: 'string',\n                validateString: function (value) {\n                    console.log(value);\n                    return /^([\\x20-\\x60|\\x7b\\-\\xe]){1,50}$/.test(value.toUpperCase());\n                },\n                messages: {\n                    en: getTranslation('frontend.error.14.50',transarray)\n                }\n            });\n            \n            window.Parsley.addValidator('longval5_150', {//All ASCII characters inside of the range of 32-126 (exclude lower case)\n                requirementType: 'string',\n                validateString: function (value) {\n                    console.log(value);\n                    return /^([\\x20-\\x60|\\x7b\\-\\xe]){1,150}$/.test(value.toUpperCase());\n                },\n                messages: {\n                    en: getTranslation('frontend.error.14.150',transarray)\n                }\n            });  \n\n            //------------------------------------------------------------------------------------\n\n        } else {\n            alertify.error(data.message);\n        }\n    });\n\n    function getTranslation(key, array) {\n        var ret = key;\n        var localforkey = 'en';\n        var lang = getLanguage();\n        if (lang === 'ru-RU' || lang === 'ru')\n            localforkey = 'ru';\n        if (lang === 'am-AM' || lang === 'am')\n            localforkey = 'am';\n        if (lang === 'cn-CN' || lang === 'cn')\n            localforkey = 'cn';\n        if (lang.startsWith(\"ar-\") || lang === 'ar')\n            localforkey = 'ar';\n        if (lang === 'ku')\n      