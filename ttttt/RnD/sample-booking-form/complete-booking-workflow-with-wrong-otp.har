            "size": 85183,
            "mimeType": "text/html",
            "text": "<div>\r\n\r\n  <h1><span>My Appointments | Add</span></h1>\r\n  \r\n  <h3><span>Book Appointment</span></h3>\r\n  \r\n\r\n  <div id=\"main-area\">                      \r\n\r\n    <form id=\"appointment\" class=\"classic\" onsubmit=\"return false\">\r\n        <input id=\"no-results\" type=\"hidden\" value=\"No results found\"/> \r\n      <div class=\"appointment_box_tip\">Kindly note that this platform for online appointments has been designed to service individual applicants and their families and it is not intended for any professional use. Appointments booked online are to be cancelled by the applicant as soon as it is determined that these are no longer required. The correct use of the platform is being monitored regularly and any excess use will result to the cancellation of the reserved slots.</div>\r\n\r\n        <input type=\"hidden\" name=\"otpuser\" id=\"otpuser\" value=\"User{id=931995, username=amr.shah@gmail.com, password=5e80b93c0a7aef7bad58901b480ea650b6212292, firstname=AMR, lastname=SHAH, email=amr.shah@gmail.com, country=Vcountry{id=19, name=PAKISTAN}, vac=Vac{id=137, name=Islamabad Visa Application Center for Greece}, roles=null, userroles=[eu.ubitech.gvcw.repository.domain.UserRole@1d6e9e2c]}\"/>\r\n        <input type=\"hidden\" name=\"vpm\" id=\"vpm\" value=\"\"/>\r\n\r\n\r\n        <div class=\"form-item\" >\r\n          <strong>VAC</strong>:\r\n          <span>Islamabad Visa Application Center for Greece</span>\r\n          <input type=\"hidden\" name=\"vac\" id=\"vac\" value=\"137\"/>\r\n      </div>\r\n      \r\n      <table style=\"width:70%\">\r\n        <tr>\r\n            <td style=\"width:40%;vertical-align: top\" class=\"form-item required\">\r\n                <label for=\"type\">Appointment for</label>\r\n                <select name=\"type\" id=\"type\" class=\"form-control\" required=\"required\"\r\n                        placeholder=\"Select an option\">\r\n                    <option value=\"0\" >Submission Schengen Visa (Short term – Type C)</option>\r\n                    <option value=\"2\" >National visa (Long term - type D)</option>\r\n                    <option value=\"6\" >Prime Time (optional service at an additional charge)</option>\r\n                    <option value=\"26\" >Long-Term Type D (Seasonal/Dependent Employment)</option>\r\n                </select>\r\n            </td>\r\n            <td style=\"width:30%\" id=\"travelpurposesDiv\" class=\"form-item required hidden\"  >\r\n                    <label for=\"travelpurposes\" >Travel Purpose</label>\r\n                    <select name=\"travelpurposes\" id=\"travelpurposes\" class=\"form-item allowclear\"\r\n                            placeholder=\"Select an option\"\r\n                    >\r\n                        <option value=\"\"></option>\r\n                        \r\n                    </select>\r\n            </td>\r\n            <td style=\"width:30%\">\r\n            </td>\r\n        </tr>\r\n        <tr>\r\n            <td style=\"width:40%\" class=\"form-item required\" >\r\n                <label for=\"bookingfor\">Booking as</label>\r\n                <select name=\"bookingfor\" id=\"bookingfor\" class=\"form-control\" required=\"required\"\r\n                        placeholder=\"Select an option\">\r\n                    <option value=\"0\" selected=\"selected\"  >Individual</option>\r\n                    <option value=\"1\"  >Group (Family/Traveler)</option>\r\n                </select>\r\n            </td>\r\n            <td style=\"width:20%\" id='membersDiv' class=\"form-item hidden\">\r\n                <label for=\"members\"># in Group</label>\r\n                <select name=\"members\" id=\"members\" class=\"form-control\"\r\n                        placeholder=\"Select an option\">\r\n                    <option value=\"2\">2</option>\r\n                    <option value=\"3\">3</option>\r\n                    <option value=\"4\">4</option>\r\n                    <option value=\"5\">5</option>\r\n                    \r\n                    \r\n                </select>\r\n            </td>\r\n            <td style=\"width:40%\"></td>\r\n\r\n        </tr>\r\n        <tr>\r\n            \r\n        </tr>\r\n        <tr>\r\n            <td style=\"width:40%\" class=\"form-item required\" >\r\n                <label for=\"ind_email\">E-mail</label>\r\n<!--                <span style=\"background-color:white;color:red;\" sec:authorize=\"${hasAnyRole('APPLICANT')}\" th:text=\"#{user.bookappointment.email.tip}\">TIP</span>-->\r\n                <input type=\"text\" name=\"email\" id=\"ind_email\" class=\"form-control noupper\"\r\n                       placeholder=\"\"\r\n                       maxlength=\"60\"\r\n                       required=\"required\"\r\n                       data-parsley-valemail=\"\"\r\n                       data-parsley-trigger=\"focusout\"\r\n                       value=\"amr.shah@gmail.com\" readonly=\"readonly\"/>\r\n            </td>\r\n\r\n          <tr/>\r\n\r\n          <tr>\r\n            <td style=\"width:60%\" colspan=\"2\" class=\"form-item required\"  >\r\n                <label for=\"ind_passportnumber\">Phone number</label>\r\n<!--                <span style=\"background-color:white;color:red;\" sec:authorize=\"${hasAnyRole('APPLICANT')}\"-->\r\n<!--                      th:text=\"#{user.edit.phonenumber.appointment.tip}\">TIP</span>-->\r\n                <table style=\"width:100%\">\r\n                    <tr>\r\n                        <td style=\"width:30%\">\r\n                            <select name=\"phonenumberprefix[id]\" id=\"phonenumberprefix\" class=\"form-control\">\r\n                                <option value=\"\"></option>\r\n                                <option value=\"197\"\r\n                                        selected=\"selected\"\r\n                                >PAKISTAN  +92</option>\r\n                            </select>\r\n                        </td>\r\n                        <td>\r\n                            <input type=\"text\" name=\"phonenumber\" id=\"ind_phonenumber\" class=\"form-control\" placeholder=\"\"\r\n                                required=\"required\"\r\n                                pattern=\"^((?!(0){1})[0-9]{10})$\"\r\n                                maxlength=\"10\"\r\n                                data-parsley-trigger=\"focusout\"\r\n                                value=\"3345112969\" readonly=\"readonly\"/>\r\n                        </td>\r\n                        \r\n                    </tr>\r\n                    </tr>\r\n                </table>\r\n            </td>\r\n        </tr>\r\n      </table>\r\n\r\n\r\n      <h2 class=\"appointment_subtitle\"><span>Client Information</span></h2>\r\n      <input type=\"hidden\" name=\"groupid\" id=\"groupid\" value=\"\"/>\r\n\r\n      <!--INDIVIDUAL/ GROUP INFO -->\r\n      <div class=\"form-item\" id=\"groupInfoDiv\">\r\n      <div class=\"appointment_tip\">Please fill out the information of all the persons for this appointment.</div>\r\n      <table style=\"width: 90% !important\" id=\"groupTable\">\r\n          <thead>\r\n            <tr>\r\n              <th>Surname</th>\r\n              <th>Name</th>\r\n              <th>Date of Birth</th>\r\n              <th>Passport</th>\r\n              <th>Passport&#39;s Expiration Date</th>\r\n              <th>Gender</th>\r\n              <th>Nationality</th>\r\n              <th></th>\r\n          </tr>\r\n        </thead>\r\n        <tbody id=\"groupBody\">\r\n        <tr>\r\n            <td>\r\n                <span class=\"form-item required\" >\r\n                    <input type=\"text\" name=\"applicants[][surname]\" id=\"gp_surname\" class=\"form-control\"\r\n                     placeholder=\"\"\r\n                     required=\"required\"\r\n                     maxlength=\"65\"\r\n                     data-parsley-longval2=\"\"\r\n                     data-parsley-trigger=\"focusout\"\r\n                     value=\"SHAH\"/>\r\n                </span>\r\n            </td>\r\n            <td>\r\n                <span class=\"form-item required\" >\r\n                <input type=\"text\" name=\"applicants[][firstname]\" id=\"gp_firstname\" class=\"form-control\"\r\n                 placeholder=\"\"\r\n                 required=\"required\"\r\n                 maxlength=\"65\"\r\n                 data-parsley-longval2=\"\"\r\n                 data-parsley-trigger=\"focusout\"\r\n                 value=\"AMR\"/>\r\n                </span>\r\n            </td>\r\n            <td>\r\n                <span class=\"form-item required dpicker\" >\r\n                    <input type=\"text\" name=\"applicants[][dateofbirth]\" id=\"gp_dateofbirth\"\r\n                     class=\"form-control datepicker\"  placeholder=\"\"\r\n                     required=\"required\"\r\n                     maxlength=\"10\"\r\n                     data-parsley-valdate=\"\"\r\n                     data-parsley-trigger=\"focusout\"\r\n                     value=\"\"/>\r\n                    <i class=\"far fa-calendar-alt\" style=\"top: 4px !important;\"></i>\r\n                </span>\r\n            </td>\r\n            <td>\r\n                <span class=\"form-item required\" >\r\n                    <input type=\"text\" name=\"applicants[][passportnumber]\" id=\"gp_passportnumber\" class=\"form-control\"\r\n                     placeholder=\"\"\r\n                     required=\"required\"\r\n                     pattern=\"^(([A-Z])|(\\d)){7,12}\"\r\n                     maxlength=\"12\"\r\n                     data-parsley-trigger=\"focusout\"\r\n                     value=\"\" data-parsley-pattern-message=\"Field should have maximum length of 9 symbols; acceptable symbols: latin-characters(uppercase), numbers\"/>\r\n                </span>\r\n            </td>\r\n            <td>\r\n                <span class=\"form-item dpicker\" >\r\n                    <input type=\"text\" name=\"applicants[][traveldocumentvaliduntil]\" id=\"gp_traveldocumentvaliduntil\"\r\n                     class=\"form-control datepicker lock-before-today\"  placeholder=\"\"\r\n                     maxlength=\"10\"\r\n                     data-parsley-valdate=\"\"\r\n                     data-parsley-trigger=\"focusout\"                     \r\n                     value=\"\" afterdays=\"1\"\r\n                     /><i class=\"far fa-calendar-alt\" style=\"top: 4px !important;\"></i>\r\n                </span>\r\n            </td>\r\n            <td>\r\n                <span class=\"form-item\">\r\n                    <select name=\"applicants[][gender[id]]\" id=\"gp_gender\" class=\"form-control\"\r\n                            placeholder=\"Select an option\"\r\n                            >\r\n                        <option value=\"\"></option>\r\n                        <option value=\"1\"\r\n                                >FEMALE</option>\r\n                        <option value=\"2\"\r\n                                >MALE</option>\r\n                        <option value=\"3\"\r\n                                >OTHER</option>\r\n                    </select>\r\n                </span>\r\n            </td>\r\n            <td>\r\n                <span class=\"form-item\"  >\r\n                    <select name=\"applicants[][nationality[id]]]\" id=\"gp_nationality\" class=\"form-control allowclear\"\r\n                        placeholder=\"Select an option\">\r\n                        <option value=\"\"></option>\r\n                        <option value=\"2\"\r\n                                >AFGHANISTAN</option>\r\n                        <option value=\"6\"\r\n                                >ALAND ISLANDS</option>\r\n                        <option value=\"7\"\r\n                                >ALBANIA</option>\r\n                        <option value=\"79\"\r\n                                >ALGERIA</option>\r\n                    