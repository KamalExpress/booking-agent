 type for \";\n        var $file = $($selector);\n        var files = $file.get(0).files;\n        var fileType;\n        var hasAcceptedFileTypes = true;\n        var i;\n\n        for (i = 0; i < files.length; i++) {\n\n            console.log(files[i].type);\n            \n            //console.log(files[i])\n\n            fileType = FILE_TYPES[files[i].type];\n            if (fileType !== undefined) {\n                if (!fileType) {\n                    $file.addClass(\"parsley-error\");\n                    alertify.error(message);\n                } else {\n                    $file.removeClass(\"parsley-error\");\n                }\n                return fileType;\n            } else {\n                alertify.error(message + '\"' + files[i].name + '\"');\n                $file.addClass(\"parsley-error\");\n                hasAcceptedFileTypes = false;\n            }\n        }\n        return hasAcceptedFileTypes;\n    };\n\n\n    /*\n     * Listeners\n     */\n\n    file.add = function($this, callback) {\n\n        var $btn = $($this);\n        var formID = $btn.attr('form');\n\n        // Empty checker\n        var validatorResult = ubi.validator.validate(formID, innerCrud);\n        if (!validatorResult) {\n            logger.e(\"Please check the form fields again\");\n            ubi.scrollToSpecificElement('.parsley-error', 70, 500, true);\n        }\n\n        function innerCrud() {\n            var $file = $btn.parents('form').find('#file');\n\n            if (hasExceededFileSize($file[0]) || !hasRightFileTypes($file[0])) return;\n\n            var API_URL = ubi.API_URL_PREFIX + $btn.attr('data-submit');\n            var redirect = $btn.attr('data-redirect');\n\n            var fieldsData = $('#' + formID).serializeJSON(serializeJSON_OPTIONS);\n            var encodedData = Base64.encode(JSON.stringify(fieldsData));\n            // var encodedData = btoa(unescape(encodeURIComponent(fileData)));\n\n            var i;\n            var file = new FormData();\n            file.append('fieldsData', encodedData);\n            for (i = 0; i < $file[0].files.length; i++) {\n                file.append('files', $file[0].files[i]);\n            }\n\n            /*for (var pair of file.entries()) {\n                logger.o(pair[0] + ', ' + pair[1]);\n            }\n            return;*/\n\n            $btn.addClass('loading');\n\n            $.ajax({\n                type: 'POST',\n                data: file,\n                url: API_URL,\n                processData: false,\n                contentType: false\n            }).done(function (data, textStatus, jqXHR) {\n                if (textStatus.toUpperCase() == \"SUCCESS\" && data.code.toUpperCase() === \"SUCCESS\") {\n                    setTimeout(function () {\n                        page(redirect);\n                        alertify.success(data.message);\n\n                        $btn.removeClass('loading');\n                    }, ubi.loader.blocking.loadingTime);\n                } else {\n                    \"message\" in data ? alertify.error(data.message) : alertify.error(ubi.getTranslationExt(\"frontend.message.error.1\")); // \"Something went wrong. Please contact the system administrator.\"\n                    $btn.removeClass('loading');\n                }\n                if (typeof callback === 'function') {\n                    callback(data, textStatus, jqXHR);\n                }\n            }).error(function (data, textStatus, jqXHR) {\n                logger.e(status);\n                logger.e(data);\n                alertify.error(ubi.getTranslationExt(\"frontend.message.error.5\")); // \"Please contact the system administrator\"\n\n                $btn.removeClass('loading');\n            });\n        }\n    };\n\n    file.edit = function($this) {\n\n        var $btn = $($this);\n        var formID = $btn.attr('form');\n\n        // Empty checker\n        var validatorResult = ubi.validator.validate(formID, innerCrud);\n        if (!validatorResult) {\n            logger.e(\"Please check the form fields again\");\n            ubi.scrollToSpecificElement('.parsley-error', 70, 500, true);\n        }\n\n        function innerCrud() {\n            var $file = $btn.parents('form').find('#file');\n\n            if (hasExceededFileSize($file[0]) || !hasRightFileTypes($file[0])) return;\n\n            var API_URL = ubi.API_URL_PREFIX + $btn.attr('data-submit');\n            var redirect = $btn.attr('data-redirect');\n\n            var fieldsData = $('#' + formID).serializeJSON(serializeJSON_OPTIONS);\n            fieldsData.mediaInstanceBinaries = [];\n            var image;\n            for (image in removeImages) {\n                fieldsData.mediaInstanceBinaries.push({\n                    id: image\n                });\n            }\n            fieldsData.mediaInstanceBinaries.length === 0 ? delete fieldsData.mediaInstanceBinaries : null;\n\n            var encodedData = Base64.encode(JSON.stringify(fieldsData));\n\n            var i;\n            var file = new FormData();\n            file.append('fieldsData', encodedData);\n            for (i = 0; i < $file[0].files.length; i++) {\n                file.append('files', $file[0].files[i]);\n            }\n\n            $btn.addClass('loading');\n\n            $.ajax({\n                type: 'POST',\n                data: file,\n                url: API_URL,\n                processData: false,\n                contentType: false\n            }).done(function (data, textStatus, jqXHR) {\n                if (textStatus.toUpperCase() == \"SUCCESS\" && data.code.toUpperCase() === \"SUCCESS\") {\n                    setTimeout(function () {\n                        page(redirect);\n                        alertify.success(data.message);\n\n                        $btn.removeClass('loading');\n                    }, ubi.loader.blocking.loadingTime);\n                } else {\n                    \"message\" in data ? alertify.error(data.message) : alertify.error(ubi.getTranslationExt(\"frontend.message.error.1\")); // \"Something went wrong. Please contact the system administrator.\"\n                    $btn.removeClass('loading');\n                }\n            }).error(function (data, textStatus, jqXHR) {\n                logger.e(status);\n                logger.e(data);\n                alertify.error(ubi.getTranslationExt(\"frontend.message.error.5\")); // \"Please contact the system administrator\"\n\n                $btn.removeClass('loading');\n            });\n        }\n    };\n\n    file.download = function () {\n        // TODO\n    };\n\n    file.remove = function ($this) {\n        var $this = $($this);\n        var $clickedWrapper = $this.parent();\n        var mediaID = $clickedWrapper.attr('data-media-id');\n\n        if (!$clickedWrapper.hasClass('remove')) {\n            $clickedWrapper.addClass('remove');\n            removeImages[mediaID] = true;\n        } else {\n            // undo\n            $clickedWrapper.removeClass('remove');\n            delete removeImages[mediaID];\n        }\n    };\n\n    // Generic checker for all file types\n    $('body').on('change', 'input[type=file].generic', function () {\n        //var $this = $(this);\n        hasExceededFileSize(this);\n        hasRightFileTypes(this);\n        \n        // enable placeholder with bullets with file names and a help text\n    });\n\n    ubi.file = file;\n\n})();\n\n/**\n * Auth\n */\n\n(function() {\n\n    \"use strict\";\n\n    ubi.loginHandler = function($this) {\n        ubi.crud.post($this, function(data, textStatus, jqXHR) {\n            if (textStatus.toUpperCase() === 'SUCCESS') {                \n                ubi.setLogin(true);\n                if ($(\"#destination\").val() !== undefined && $(\"#destination\").val()\n                    != \"\" && $(\"#destination\").val() != null) {                    \n                    if ($(\"#destination\").val() === \"appointments\" || $(\"#destination\").val() === \"visa-request\") {\n                        window.location.href = \"/\"+$(\"#destination\").val()+\"/add\";\n                    }else {\n                        window.location.href = \"/\"+$(\"#destination\").val();\n                    }\n                }else{\n                    ubi.goHome();\n                }\n            }\n        });\n        \n    };\n\n    ubi.sendOtpHandler = function($this){\n                ubi.crud.post($this, function(data, textStatus, jqXHR) {\n                    if (textStatus.toUpperCase() === 'SUCCESS') {\n                    if(data.code.toUpperCase() === \"INVALID\" || data.code.toUpperCase() === \"EXCEPTION\"){\n                            alertify.error(data.message, {mode: \"notification-error\"});\n                    }else{\n                            $(\"#btn-register\").show();\n                            $(\"#recaptcha\").show();\n                            $(\"#onetimepassword-wrap\").show();\n                            $(\"#onetimepassword-otp\").hide();\n                            $(\"#btn-onetimepassword\").hide();\n//                            $(\"#phonenumber\").prop(\"disabled\",true);\n                            setTimeout(function (){$(\"#btn-onetimepassword\").show()},10000 * 18); //10 seconds(milliseconds) * x to minutes\n                            setTimeout(function (){$(\"#btn-onetimepassword\").text(\"RESEND OTP CODE\")},10000  * 18 );\n//                            setTimeout(function (){$(\"#btn-onetimepassword\").text(ubi.getKeyTranslation('otp.request.resend'))},10000  * 18 );\n\n                            setTimeout(function (){$(\"#btn-register\").hide()},10000 * 18); //10 seconds(milliseconds) * x to minutes\n                            setTimeout(function (){$(\"#recaptcha\").hide()},10000 * 18); //10 seconds(milliseconds) * x to minutes\n                            setTimeout(function (){$(\"#onetimepassword-wrap\").hide()},10000 * 18); //10 seconds(milliseconds) * x to minutes\n                            $(\"#btn-register\").attr('data-redirect','/register/resultotp');\n\n\n                    }\n                    }\n                });\n    };\n\n\n    ubi.resetPasswordHandler = function($this) {\n        ubi.crud.post($this, function(data, textStatus, jqXHR) {\n            if (textStatus.toUpperCase() === 'SUCCESS') {\n                alertify.success(data.message);\n                page.redirect(\"/login\");\n            }\n        });\n    };\n\n    ubi.logout = function($this) {\n        var $btn = $($this);            \n        ubi.crud.post($this, function() {\n            ubi.removeAccess();\n            let path = $btn.attr(\"data-submit\");            \n            if (path.search(\"lang=\") > 0) {            \n              let locale =  path.split(\"lang=\")[1];               \n               ubi.goHome(locale);\n            }else {\n               ubi.goHome();\n            }\n        });\n    };\n\n    // Handle register\n    ubi.registerHandler = function($this) {\n\n        ubi.crud.post($this, function(data, textStatus, jqXHR) {\n            if (data.code.toUpperCase() === 'SUCCESS') {\n                // alertify.success(data.message);\n                page.redirect(\"/login\");\n            } else {\n                alertify.error(data.message, {mode: \"notification-error\"});\n            }\n        });\n\n    }\n\n    /*\n     * Actions\n     */\n\n    /**\n     * Function to trigger Signin when a user press enter on password text field\n     *\n     * @param {type} e\n     * @returns {undefined}\n     */\n\n    ubi.keyPressedOnLoginPasswordField = function(e) {\n        var key = e.keyCode || e.which;\n        //On enter pressed send login request\n        if (key === 13) {\n            ubi.loginHandler($('#btn-login'));\n        }\n    };\n\n    ubi.keyPressedOnRegisterField = function(e) {\n        var key = e.keyCode || e.which;\n        //On enter pressed send login request\n        if (key === 13) {\n            ubi.crud.post($('#btn-register'));\n        }\n    };\n\n    ubi.keyPressedOnResetPasswordField = function(e) {\n        var key = e.keyCode || e.which;\n        //On enter pressed send login request\n        if (key === 13) {\n            ubi.crud.post($('#btn-reset-password'));\n        }\n    };\n\n\n})();\n\n/**\n * Main coding part for table component\n */\n\n(function (window) {\n    \"use strict\";\n\n    var table = {\n        reset: function () {\n            // TODO - Delete localStorage\n            page(location.pathname);\n        },\n        //clear filtering form\n        reset2: function (id) {\n            var formID = $('#' + id).attr('form');\n            var $form = $('form#' + formID);\n            $form.find(':input').each(function() {\n                \n                switch(this.type) {\n                    case 'password':\n                    case 'select-multiple':\n                    case 'select-one':\n                    case 'text':\n                    case 'search':\n                    case 'textarea':\n                        $(this).val('');\n                        break;\n                    case 'checkbox':\n                    case 'radio':\n                        this.checked = false;\n                }\n            });\n            $('#filterable').val(\"-\");\n            tb.filter($('#' + id));\n        }\n    };\n\n    window.tb = table;\n\n})(window);\n/**\r\n * Filtering table views\r\n */\r\n\r\n(function (table) {\r\n\r\n  \"use strict\";\r\n\r\n  var filter = function ($this) {\r\n\r\n    $('html').hasClass('modal') ? ubi.loader.modal.start() : ubi.loader.nonBlocking.start();\r\n\r\n    var $this = $($this);\r\n\r\n    if ($this.hasClass('loading')) {\r\n      logger.i(\"CRUD is in use. Please wait.\");\r\n      return;\r\n    }\r\n\r\n    var formID = $this.attr('form');\r\n\r\n    if (formID === undefined) {\r\n      alertify.error(ubi.getTranslationExt(\"frontend.message.error.1\")); // \"Something went wrong. Please contact the system administrator\"\r\n      throw new TypeError(\"No form attribute found\");\r\n    }\r\n\r\n    var $form = $('form#' + formID);\r\n    if ($form.length === 0) {\r\n      throw new TypeError(\"No form found with id='\" + formID + \"'\");\r\n    }\r\n\r\n    var validatorResult = ubi.validator.validate(formID, ajaxFilter, $form.children());\r\n    if (!validatorResult) {\r\n      logger.e(\"Please check the form fields again\");\r\n    }\r\n\r\n\r\n    function ajaxFilter() {\r\n\r\n      $this.addClass('loading');\r\n\r\n      // set the ajax url\r\n      var isModal = $('html').hasClass('modal');\r\n      var $dataSubmit = $('#main-area-modal').find('#navigation');\r\n      var urlSubmit = (isModal && $dataSubmit.length > 0) ? $dataSubmit.val() : location.pathname;\r\n\r\n      var filtersData = $form.serializeJSON(serializeJSON_OPTIONS);\r\n      var filtersDataTemp = Object.assign({}, filtersData);\r\n      console.log(filtersDataTemp);\r\n      // 'id' in filtersDataTemp ? delete filtersDataTemp.id : null;\r\n\r\n      var filtersDataParams = '';\r\n      var filterable = '';\r\n\r\n      for (var v in filtersDataTemp) {\r\n        filtersDataParams += v + '=' + filtersDataTemp[v] + '&';\r\n        filterable += v + '|' + filtersDataTemp[v] + '-';\r\n      }\r\n\r\n      if (filterable != '') {\r\n        filterable = filterable.slice(0, -1);\r\n        filtersDataParams += 'filterable=' + filterable;        // Always submit the id in order to know when the filters are submitted\r\n      }\r\n      if (filterable==='' && $('#filterable').val()===\"-\"){\r\n          filtersDataParams = 'filterable=-'\r\n      }\r\n\r\n      $.ajax({\r\n        url: urlSubmit,\r\n        type: 'POST',\r\n        data: filtersDataParams\r\n      }).done(function (data, textStatus, jqXHR) {\r\n        setTimeout(function () {\r\n          // console.log(data);\r\n          // TODO - fix selector after testing\r\n          isModal ? $('#mc-inner').html(data)