 v) {\r\n      if (v !== $li[0]) {\r\n        $(this).removeClass('open');\r\n      }\r\n    });\r\n\r\n    if (!$li.hasClass('open')) {\r\n      $li.addClass('open');\r\n    } else {\r\n      $li.removeClass('open');\r\n    }\r\n  };\r\n\r\n  // Menu toggle\r\n  _self.mainMenuToggle = function mainMenuToggle() {\r\n    if (!$('body').hasClass('screen-small')) {\r\n      var open = function () {\r\n        $('body').removeClass('menu-close');\r\n        $('body').hasClass('screen-med') ? $('html').addClass('dark') : null;\r\n        $('#menu-toggle').removeClass('active');\r\n      }\r\n      var close = function () {\r\n        $('body').addClass('menu-close');\r\n        $('body').hasClass('screen-med') ? $('html').removeClass('dark') : null;\r\n        $('#menu-toggle').addClass('active');\r\n      }\r\n      $('body').hasClass('menu-close') ? open() : close();\r\n    } else {\r\n      $('body').addClass('dark');\r\n      !$('body').hasClass('open-menu') ? openMenuSmallScreen() : closeMenuSmallScreen();\r\n    }\r\n  };\r\n  var openMenuSmallScreen = function () {\r\n    $('body').addClass('open-menu');\r\n    $('html').addClass('dark');\r\n    $('#header-wrapper #mini-menu-wrapper > nav > ul > li#menu-toggle-small > i').removeClass('fa-bars').addClass('fa-times');\r\n  }\r\n  var closeMenuSmallScreen = function () {\r\n    $('body').removeClass('open-menu');\r\n    $('html').removeClass('dark');\r\n    $('#header-wrapper #mini-menu-wrapper > nav > ul > li#menu-toggle-small > i').removeClass('fa-times').addClass('fa-bars');\r\n  }\r\n\r\n  _self.removeOuterButtonWrapper = function () {\r\n    if ($('#button-wrapper-outer').length > 0) {\r\n      $('.table-wrapper table td.click').removeClass('open');\r\n      $('#button-wrapper-outer').remove();\r\n      $('html').removeClass('dark');\r\n    }\r\n  };\r\n\r\n  // closeMenu is called when clicking on the dark-cover\r\n  // TODO - move it and make it more generic + change its name because it is used for both closing menu and button-wrapper\r\n  _self.closeMenu = function () {\r\n    // We have different approach when closing menu on medium sized devices to small sized devices\r\n    $('html').removeClass('dark');\r\n    $('body').hasClass('screen-med') ? $('body').addClass('menu-close') : closeMenuSmallScreen();\r\n    removeOuterButtonWrapper();\r\n  };\r\n\r\n  // Menu multilevel open/close\r\n  $(document).on('click', '#menu > ul > li.level > a', function (e) {\r\n    e.preventDefault();\r\n\r\n    if ($('body').hasClass('menu-close')) return;\r\n\r\n    var $this = $(this);\r\n    var $li = $this.parent();\r\n    var $arrow = $this.children('.arrow');\r\n    var $ulul = $this.parent().children('ul');\r\n    var ulHeight;\r\n\r\n    // Close others\r\n    $('#menu > ul > li.level.open > a').each(function (i, v) {\r\n      if ($(v)[0] !== $this[0]) {\r\n        $('#menu > ul > li.level.open > a > span.arrow').removeClass('down');\r\n        $('#menu > ul > li.level.open > ul').animate({\r\n          'height': 0\r\n        }, 300);\r\n        $('#menu > ul > li.level.open').removeClass('open');\r\n      }\r\n    });\r\n\r\n    (function menuLevelToggle() {\r\n      if (!$li.hasClass('open')) {\r\n        $ulul.css('height', 'auto');\r\n        ulHeight = $ulul.outerHeight();\r\n        $ulul.css('height', 0);\r\n\r\n        $li.addClass('open');\r\n        $arrow.addClass('down');\r\n\r\n        $ulul.animate({\r\n          'height': ulHeight + 'px'\r\n        }, 300);\r\n      } else {\r\n        $li.removeClass('open');\r\n        $arrow.removeClass('down');\r\n\r\n        $ulul.animate({\r\n          'height': '0px'\r\n        }, 300);\r\n      }\r\n    })();\r\n  });\r\n\r\n  $(document).on('click', '#menu ul li a', function (e) {\r\n    var $this = $(this);\r\n    var $li = $this.parent();\r\n\r\n    if ($('body').hasClass('menu-close')) {\r\n      e.preventDefault();\r\n      $('body').removeClass('menu-close');\r\n      $('body').hasClass('screen-med') ? $('html').addClass('dark') : null;\r\n    } else if ($('body').hasClass('screen-med') && !$li.hasClass('level')) {\r\n      $('body').addClass('menu-close');\r\n      $('html').removeClass('dark');\r\n    } else if ($('body').hasClass('screen-small') && !$li.hasClass('level')) {\r\n      closeMenuSmallScreen();\r\n    }\r\n\r\n  });\r\n\r\n  // Table actions open/close + wrapper width calculation (Desktop devices)\r\n  // $(document).on('click', 'td.action', function(e) {\r\n  _self.tableActions = function (e) {\r\n    var $this = $(e.currentTarget);\r\n\r\n    if (mqMedium.matches || mqSmall.matches || $this.hasClass('stop')) return;\r\n\r\n    if ($this.hasClass('disabled') || $(e.target).hasClass('btn')) return;\r\n\r\n    /*if (mqMedium.matches || mqSmall.matches) {\r\n     removeOuterButtonWrapper();\r\n     var buttonWrapperHtml = $this.children('.button-wrapper').html();\r\n     $('#layout-container').append('<div id=\"button-wrapper-outer\" class=\"button-wrapper\">' + buttonWrapperHtml + '</div>');\r\n     $('html').addClass('dark');\r\n     !$this.hasClass('open') ? $this.addClass('open') : $this.removeClass('open');\r\n\r\n     return;\r\n     }*/\r\n\r\n    // Calculate button-wrapper width\r\n    if (!$this.hasClass('calced')) {\r\n      var btnWrapperWidth = 0;\r\n      var $buttonWrapper = $this.children('.button-wrapper');\r\n      var $btns = $buttonWrapper.children('.btn');\r\n\r\n      $btns.each(function (i, v) {\r\n        btnWrapperWidth += $(v).outerWidth();\r\n        btnWrapperWidth += parseInt($(v).css('margin-right'));\r\n      });\r\n      $buttonWrapper.css('width', (btnWrapperWidth + 13) + 'px');\r\n\r\n      $this.addClass('calced');\r\n    }\r\n\r\n    !$this.hasClass('open') ? $this.addClass('open') : $this.removeClass('open');\r\n  }\r\n  // Table actions open/close (devices < 1024)\r\n  _self.tableActionsTR = function (e) {\r\n    if (!(mqMedium.matches || mqSmall.matches)) return;\r\n\r\n    if (e.target.nodeName == \"SELECT\") return;\r\n\r\n