            "text": "\n\n            <header id=\"header-wrapper\" class=\"column tr\" role=\"banner\">\n                <div id=\"menu-toggle\" class=\"classic-btn tr\" onclick=\"mainMenuToggle(this)\"><i\n                        class=\"fa fa-bars\"\n                        aria-hidden=\"true\"></i></div>\n\n                <div id=\"search-fullbg\" onclick=\"ubi.search.close()\"></div>\n\n                \n        <div id=\"mini-menu-wrapper\">\n            <nav>\n                <ul>\n                    \n                    \n\n                    \n                    <li id=\"lang-wrapper\">\n                        <div class=\"icon-wrapper\">\n                            <i onclick=\"miniMenuToggleBox(this)\" class=\"fas fa-globe click mm-icons\"></i>\n                            <div class=\"icon-indicator tr\">\n                                <span class=\"flag-icon flag-icon-gb\"></span>\n                            </div>\n                        </div>\n                        <div class=\"box dropdown tr\">\n                            <ul>\n                                <!--\n                                  internet country domain -> https://www.worldstandards.eu/other/tlds\n                                */-->\n                                <li class=\"lang-selector tr active\"  user-lang=\"en\" data-lang=\"en_US\"\n                                    ><span>English</span><span class=\"flag-icon flag-icon-gb tr\"></span></li>\n                                \n                                \n                                \n                                \n                                \n                                \n                                \n                                \n                            </ul>\n                        </div>\n                    \n                    <li>\n                        <i onclick=\"miniMenuToggleBox(this)\" class=\"fas fa-user-circle click mm-icons\"\n                           aria-hidden=\"true\"></i>\n                        <div id=\"account\" class=\"box tr\">\n                            <div class=\"box-field box-close-btn\"><i onclick=\"miniMenuToggleBox(this)\"\n                                                                    class=\"fas fa-times click\"\n                                                                    aria-hidden=\"true\"></i></div>\n                            <div class=\"box-field box-title\"><span>Profile Navigation</span>\n                                \n                            </div>\n                            <div class=\"box-field box-image\">\n                                <i class=\"fas fa-user-circle\" aria-hidden=\"true\"></i>\n                            </div>\n                            <div class=\"box-field box-name\">AMR SHAH</div>\n                            <div class=\"box-field box-email\"><span>amr.shah@gmail.com</span></div>\n                            <div class=\"box-field box-buttons\">\n                                <a href=\"/user/931995\" id=\"manage-account\" class=\"btn darkblue\"><span>Manage Account</span></a>\n                                <button class=\"btn blue\" onclick=\"ubi.logout(this)\" \n                                        data-redirect=\"stay\" data-submit=\"/user/logout?lang=en_US\"><span>Sign out</span>\n                                </button>\n                            </div>\n                        </div>\n                    </li>\n\n                    <li id=\"menu-toggle-small\">\n                        <i onclick=\"mainMenuToggle(this)\" class=\"fa fa-bars click mm-icons\"\n                           aria-hidden=\"true\"></i>\n                    </li>\n                </ul>\n            </nav>\n        </div>\n    \n            </header>\n\n            <div id=\"content-wrapper\" class=\"column\">\n\n                <div id=\"main-wrapper\" class=\"tr\">\n                    <div class=\"dark-cover tr\" onclick=\"closeMenu()\"></div>\n                    <div class=\"loader tr hide\"></div>\n                    <main class=\"tr\" role=\"main\">\n                        \n                    </main>\n                </div>\n\n                <aside id=\"layout-sidebar-first\" class=\"tr\" role=\"complementary\">\n\n                    <div id=\"logo\">\n                        <a href=\"javascript:ubi.home()\"><img src=\"/dist/images/logo_pk.png\"/></a>\n                    </div>\n\n                    <nav id=\"menu-wrapper\">\n\n                        <div id=\"menu\">\n\n                            <div id=\"menu-top-left\" class=\"menu-corners\"></div>\n                            <div id=\"menu-top-right\" class=\"menu-corners\"></div>\n                            <div id=\"menu-bottom-right\" class=\"menu-corners\"></div>\n                            <div id=\"menu-bottom-left\" class=\"menu-corners\"></div>\n\n\n\n                            <ul>\n                                <!--ToDo: delete element\n                                TEMPORARY: display username& user-roles-->\n                                <li>\n                                <div><a href=\"#\" class=\"tr\" style='color: #e85353 !important'><i class=\"fas fa-user\" aria-hidden=\"true\"></i>===<span>amr.shah@gmail.com</span>===\n                                       \n                                        <span><br/>VAC:[<span>Islamabad</span>]</span></a>\n                                        \n                                </div>\n                                </li>\n\n\n                                <li id=\"menu-dashboard\">\n                                    <a href=\"javascript:ubi.home()\" class=\"tr\">\n                                        <i class=\"fas fa-home\" aria-hidden=\"true\"></i>\n                                        \n                                        <span>Dashboard</span>\n                                    </a>\n                                </li>\n\n<!--                                <li sec:authorize=\"hasAnyRole('FRONTDESK')\" id=\"menu-appointment\">\n                                    <a href=\"/appointment\" class=\"tr\">\n                                        <i class=\"fas fa-tachometer-alt\" aria-hidden=\"true\"></i>\n                             /appointment           <span th:text=\"#{navigation.appointments}\"></span>\n                                    </a>\n                                </li>-->\n\n                                <li id=\"menu-visa-request\">\n                                    <a href=\"/visa-request\" class=\"tr\">\n                                        <i class=\"fas fa-passport\" aria-hidden=\"true\"></i>\n                                        <span>My Draft Applications</span>\n                                        \n                                    </a>\n                                </li>\n\n                                <li id=\"menu-visa-request-add\">\n                                    <a href=\"/visa-request/add\" class=\"tr\">\n                                        <i class=\"fas fa-passport\" aria-hidden=\"true\"></i>\n                                        <span>New Online Application</span>\n                                        \n                                    </a>\n                                </li>\n\n\n\n\n                                <li id=\"menu-visa-submitted\">\n                                    <a href=\"/visa-request/submitted\" class=\"tr\">\n                                        <i class=\"fas fa-passport\" aria-hidden=\"true\"></i>\n                                        <span>My Submitted Applications</span>\n                                    </a>\n                                </li>\n                                <li id=\"menu-visa-request-track\">\n                                    <a href=\"/visa-request/track\" class=\"tr\">\n                                        <i class=\"fas fa-passport\" aria-hidden=\"true\"></i>\n                                        <span>Track my Application</span>\n                                    </a>\n                                </li>\n                                 <!-- /*th:if=\"${@environment.getActiveProfiles()[0] eq 'development'}\"*/-->\n                                <li id=\"menu-appointments\">\n                                    <a href=\"/appointments\" class=\"tr\">\n                                        <i class=\"fas fa-calendar-alt\" aria-hidden=\"true\"></i>\n                                        <span>My Appointments</span>\n                                        \n                                    </a>\n                                </li>\n                                \n\n                                <li id=\"menu-appointments-add\">\n                                    <a href=\"/appointments/add\" class=\"tr\">\n                                        <i class=\"fas fa-calendar-alt\" aria-hidden=\"true\"></i>\n                                        <span>Book Appointment</span>\n                                    </a>\n                                </li>\n\n\n                                <li id=\"menu-insurance\">\n                                    <a href=\"/insurance\" class=\"tr\">\n                                        <i class=\"fas fa-shield-alt\" aria-hidden=\"true\"></i>\n                                        <span>Book my Travel Medical Insurance</span>\n                                    </a>\n                                </li>\n\n\n\n                                \n\n                                \n\n                                \n\n                                \n\n                                \n\n\n                                \n\n                                \n\n                                \n\n                                \n\n                                \n\n\n                                \n\n                                \n\n                                \n\n                                \n\n                                \n\n                                \n\n                                \n\n                                \n\n                                \n\n                                \n\n                                \n\n                                \n\n                                                                \n                                \n                                \n                                \n                                \n\n                                \n\n                                \n\n                                \n\n                                \n\n                                \n                                \n                                \n                                \n\n\n                                \n\n\n                                \n\n                                \n\n                                \n\n                                \n\n                                \n\n\n                                \n                                 \n\n                                \n\n\n                                \n\n                                \n\n\n<!--                                &lt;!&ndash; add admin payment &ndash;&gt;-->\n<!--                                <li th:if=\"${(@environment.getActiveProfiles()[0] eq 'portal')}\" sec:authorize=\"hasAnyRole('SUPERADMIN','VACADMIN') \" id=\"payments\">-->\n<!--                                    <a href=\"/canceledpayments\" class=\"tr\">-->\n<!--                                        <i class=\"fas fa-dumpster\"></i>-->\n<!--                                        <span th:text=\"Payments\"></span>-->\n<!--                                    </a>-->\n<!--                                </li>-->\n\n\n\n\n                                \n\n                                \n\n\n                                \n\n\n\n\n\n                                \n\n                                                                                               \n                                \n                                \n\n                           <!--     <li sec:authorize=\"hasAnyRole('TRANSLATIONMANAGER')\" id=\"menu-translation-element\">\n                                    <a href=\"/translation-element\" class=\"tr\">\n                                        <i class=\"fas fa-globe\"></i>\n                                        <span th:text=\"#{navigation.translationelements}\"></span>\n                                    </a>\n                                </li>-->\n\n                                \n                                \n                                \n                                \n                                \n\n                                \n                            </ul>\n\n                        </div>\n\n                        <!--<div id=\"tech-borders\"></div>-->\n                    </nav>\n\n                    <footer id=\"footer-wrapper\" role=\"contentinfo\">\n                        <div class=\"copyright\">&copy; <span>2026</span>\n                            <span>GVCW</span>\n                            <br/>\n                            <div style=\"margin-top:3px\"><a href=\"https://www.gvcworld.eu/page/about-global-visa-center-world-gvcw\"><span>About</span></a> | <a href=\"https://www.gvcworld.eu/page/terms-use\"><span>Terms of Service</span></a></div>\n                        </div>\n                    </footer>\n                </aside>\n\n            </div>\n\n            <div id=\"modal\" onclick=\"modal.closeListener(event)\">\n                <div class=\"loader tr hide\"></div>\n                <div id=\"mc\">\n                    <div id=\"cl-modal\" onclick=\"modal.close()\"></div>\n                    <div id=\"mc-inner\"></div>\n                </div>\n            </div>\n\n            <div id=\"dm\" onclick=\"dmActions()\">ddd</div>\n\n        "
          },
