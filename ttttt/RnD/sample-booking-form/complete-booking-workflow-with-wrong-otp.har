g');\n    }\n  },\n  modal: {\n    loadingTime: 600,\n    start: function () {\n      $('#modal').addClass('loading')\n    },\n    stop: function () {\n      $('#modal').removeClass('loading')\n    }\n  },\n  stopAll: function () {\n    this.blocking.stop();\n    this.nonBlocking.stop();\n  }\n};\n\n/* Alertifyjs setup */\n// Notifier\n//alertify.set('notifier','delay', 0);\n//alertify.set('notifier','position', 'bottom-left');\n\n// serializeJSON default options\nvar serializeJSON_OPTIONS = {\n  skipFalsyValuesForTypes: ['string', 'number']\n};\n\n// Add more validators to parsleyjs\nubi.validators = [\n  'input[type=password]',\n  'input[type=email]',\n  'input[type=file]'\n];\n\n// Setup audio files\nubi.audio.create('notification', '/dist/audio/notification.mp3');\n\n// Initial setup of webSockets. Start webSocket from router.js\nfunction enableWS() {\n    ubi.socket = socketWrap();\n    ubi.socket.dev = ubi.isDevMode();\n\n    /*ubi.socket.connect('/stomp', function () {\n        if (!ubi.socket.isSubscribed('notification'))\n            ubi.socket.subscribe({\n                id: 'notification',\n                url: '/user/notifications',\n                call: notification.socket\n            });\n    });*/\n}\nubi.hasAccess() ? enableWS() : null;\n\n// setup file types\n// TODO\n(function (fileTypes) {\n  ubi.file.setFileTypes(fileTypes);\n})('image/jpeg, image/png, text/plain, text/csv, application/x-x509-ca-cert, application/vnd.ms-excel');\n\n\n// set all input text fields to uppercase\n$(document).on('keyup', 'input[type=text]:not(.noupper)', function () {\n  var $this = $(this);\n  var typed = this.value.replace(/  +/g, ' ');\n\n  $this.val(typed.toUpperCase());\n});\n\n//$(document).find('input[type=text]').on('keyup', function (event) {\n//    var value = event.target.value;\n//    alert(value);\n//});\n//\n//$(document).find('.form-control').not('.noupper').keyup(function() {\n//  alert( \"Handler for .keyup() called.\" );\n//});\n/**\n * Responsive\n */\n\n(function(window) {\n\n    'use strict';\n\n    var device = {\n        medium: function() {\n            logger.i(\"===> Medium sized devices <===\");\n            $('body').addClass('screen-med menu-close');\n        },\n\n        small: function() {\n            logger.i(\"===> Small sized devices <===\");\n            $('body').addClass('screen-small');\n        },\n\n        orientation: function() {\n            logger.i(\"===> Orientation Landscape <===\");\n            $('body').addClass('screen-orientation');\n        },\n\n        reset: function(classes, selector) {\n            selector = (selector === undefined ? 'body' : selector);\n            $('html').removeClass('dark');\n            $(selector).removeClass(classes);\n        }\n    };\n    window.mqMedium        =  matchMedia(\"(min-width: 521px) and (max-width: 1024px)\");\n    window.mqSmall         =  matchMedia(\"(max-width: 520px)\");\n    window.mqOrientation   =  matchMedia(\"only screen and (max-height: 600px) and (orientation: landscape)\");\n    mqMedium.addListener(function() {\n        mqMedium.matches ? device.medium() : device.reset('screen-med menu-close');\n    });\n    mqSmall.addListener(function() {\n        mqSmall.matches ? device.small() : device.reset('screen-small');\n    });\n    mqOrientation.addListener(function() {\n        mqOrientation.matches ? device.orientation() : device.reset('screen-orientation');\n    });\n\n    mqMedium.matches ? device.medium() : (mqSmall.matches ? device.small() : device.reset('screen-medium screen-small screen-orientation menu-close'));\n    mqOrientation.matches ? device.orientation() : device.reset('screen-orientation');\n\n})(window);\n// Declare UBI validator. Acts as a wrapper for Parsley.js. It registers for validation all input types defined by the private fieldSelector variable.\n// To use it in a view, replace normal add/edit JS handlers' content with a call to UBIValidator.validate and place the pre-existing business logic as an anonymous function bound to the callback parameter.\n(function () {\n  'use strict';\n\n  function uiValidator() {\n\n    var validator = {}, namespacemap = [],\n      fieldSelector = ['input[type=text]', 'input[type=number]', 'textarea', 'select', 'checkbox'];\n\n    fieldSelector = (typeof ubi.validators === 'object' && Array.isArray(ubi.validators) && ubi.validators.length > 0) ? fieldSelector.join() + \",\" + ubi.validators.join() : fieldSelector.join();\n\n    validator.validate = function (namespace, callback, customselector) {\n\n      namespacemap[namespace] = [];\n\n      $((customselector !== undefined) ? customselector : fieldSelector).each(function () {\n        namespacemap[namespace].push($(this).parsley());\n      });\n\n      var result = true, i, j;\n\n      for (i = 0, j = namespacemap[namespace].length; i < j; i = i + 1) {\n        namespacemap[namespace][i].validate();\n        result = result && namespacemap[namespace][i].isValid();\n      }\n\n      if (result) {\n        callback();\n        return true;\n      } else {\n        return false;\n      }\n\n    };\n\n    validator.emptyValueNullifier = function (key, value) {\n      if (value === undefined || value === '') {\n        return null;\n      } else {\n        return value;\n      }\n    };\n\n    return validator;\n  }\n\n  ubi.validator = !('validator' in ubi) ? uiValidator() : null;\n\n}());\n/**\n * Main initial setup for charts. Add generic logic if needed.\n */\n\n(function(window) {\n\n    'use strict';\n\n    var chart = {};\n\n    chart.common = {\n\n        API_URL: '/api/v1/chart',\n\n        keepPlaceholder: function(selector) {\n            var $chartSelector = $(selector);\n            $(selector + ' .diagram-wrapper').removeClass('loading');\n            $(selector + ' .diagram-text').removeClass('hide');\n            $(selector).children('h2').addClass('hidden');\n\n            var $diagramLabel = $chartSelector.find('.diagram-label');\n            if ($chartSelector.attr('data-chart-error') !== undefined) {\n                $diagramLabel.text($chartSelector.attr('data-chart-error'));\n            }\n\n            if ($chartSelector.attr('data-chart-hide') !== undefined) {\n                $chartSelector.addClass('hidden');\n            }\n        },\n\n        removePlaceholder: function(selector) {\n            $(selector).removeClass('placeholder');\n        }\n\n    };\n\n    window.chart = chart;\n\n})(window);\n/**\n * Line Charts | Dependency: Highcharts\n */\n\n(function() {\n\n    'use strict';\n\n    var showLineChart = function(selector, options, gData) {\n\n        Highcharts.chart(selector, {\n            chart: {\n                type: 'area'\n            },\n            title: {\n                text: options.title\n            },\n            subtitle: {\n                text: options.subtitle\n            },\n            xAxis: {\n                title: {\n                    text: 'Date'\n                },\n                type: 'datetime',\n                minRange: 240000\n            },\n            yAxis: {\n                title: {\n                    text: options.context\n                }\n            },\n            tooltip: {\n                pointFormat: '{series.name}: <b>{point.y}</b>'\n            },\n            plotOptions: {\n                line: {\n                    dataLabels: {\n                        enabled: true\n                    },\n                    enableMouseTracking: false\n                }\n            },\n            legend: false,\n            credits: false,\n            series: [{\n                name: options.context,\n                data: gData\n            }]\n        });\n\n    };\n\n\n    chart.lineChart = function(API_CHART, selector, options) {\n        $.get({\n            url: chart.common.API_URL + API_CHART,\n            contentType: \"application/json; charset=utf-8\"\n        }).done(function (data, status, xhr) {\n            if (data.code === \"SUCCESS\") {\n                if ('returnobject' in data) {\n                    var jsonData = JSON.parse(data.returnobject);\n                    showLineChart(selector, options, jsonData);\n                    chart.common.removePlaceholder(selector);\n                } else {\n                    logger.e(\"No data available for chart #\" + selector);\n                    chart.common.keepPlaceholder(selector);\n                }\n            } else {\n                logger.e(data.message);\n                chart.common.keepPlaceholder(selector);\n            }\n        });\n    };\n\n})();\n/**\n * Pie Charts for report page | Dependency Highcharts\n */\n\n(function() {\n\n    'use strict';\n\n    var showPieChart = function(selector, options, gData) {\n\n        var percentage = 'percentage' in options ? options.percentage : false;\n        // var tooltipFormat = percentage ? '{series.name}: <b>{point.percentage:.1f}%</b>' : '{series.name}: <b>{point.y}</b>';\n        var tooltipFormat = '{series.name}: <b>{point.y}</b>';\n        var plotFormat = percentage ? '<b>{point.name}</b>: {point.percentage:.1f} %' : '<b>{point.name}</b>: {point.y}';\n        // Support events\n        var events = 'events' in options ? options.events : false;\n\n        Highcharts.chart(selector, {\n            chart: {\n                plotBackgroundColor: null,\n                plotBorderWidth: null,\n                plotShadow: false,\n                type: 'pie'\n            },\n            title: {\n                text: options.title\n            },\n            subtitle: {\n                text: options.subtitle\n            },\n            tooltip: {\n                pointFormat: tooltipFormat\n            },\n            credits: false,\n            plotOptions: {\n                pie: {\n                    allowPointSelect: true,\n                    cursor: 'pointer',\n                    point: {\n                        events: events\n                    },\n                    dataLabels: {\n                        enabled: true,\n                        format: plotFormat,\n                        style: {\n                            color: (Highcharts.theme && Highcharts.theme.contrastTextColor) || 'black'\n                        }\n                    }\n                }\n            },\n            series: [{\n                name: options.context,\n                colorByPoint: true,\n                data: gData\n            }]\n        });\n\n    };\n\n    chart.pieChart = function(API_CHART, selector, options) {\n        $.get({\n            url: chart.common.API_URL + API_CHART,\n            contentType: \"application/json; charset=utf-8\"\n        }).done(function (data, status, xhr) {\n            if (data.code === \"SUCCESS\") {\n                if ('returnobject' in data && data.returnobject != null) {\n                    var jsonData = JSON.parse(data.returnobject);\n                    showPieChart(selector, options, jsonData);\n                    chart.common.removePlaceholder(selector);\n                } else {\n                    logger.e(\"No data available for chart #\" + selector);\n                    chart.common.keepPlaceholder(selector);\n                }\n            } else {\n                logger.e(data.message);\n                chart.common.keepPlaceholder('#' + selector);\n            }\n        }).fail(function (jqXHR, textStatus, errorThrown) {\n            logger.e(textStatus, true);\n            chart.common.keepPlaceholder(selector);\n        });\n    };\n\n})();\n/**\n * Bubble chart | Dependency d3.js\n */\n\n(function() {\n\n    'use strict';\n\n    function showBubble(selector, jsonData) {\n\n        $(selector).children('.placeholder-wrapper').fadeOut(200);\n\n        var diameter = 320,\n            format = d3.format(\",d\"),\n            color = d3.scaleOrdinal(d3.schemeCategory20c);\n\n        var bubble = d3.pack()\n            .size([diameter, diameter])\n            .padding(1.5);\n\n        var svg = d3.select(selector).append(\"svg\")\n            .attr(\"viewBox\",\"0 0 \" + diameter + \" \" + diameter)\n            // .attr(\"viewBox\",\"0 0 960 960\")\n            // .attr(\"perserveAspectRatio\",\"xMinYMid\")\n            .attr(\"width\", diameter)\n            .attr(\"height\", diameter)\n            .attr(\"class\", \"bubble\");\n\n        var root = d3.hierarchy(classes(jsonData))\n            .sum(function (d) {\n                return d.value;\n            })\n            .sort(function (a, b) {\n                return b.value - a.value;\n            });\n\n        bubble(root);\n        var node = svg.selectAll(\".node\")\n            .data(root.children)\n            .enter().append(\"g\")\n            .attr(\"class\", \"node\")\n            .attr(\"transform\", function (d) {\n                return \"translate(\" + d.x + \",\" + d.y + \")\";\n            });\n\n        node.append(\"title\")\n            .text(function (d) {\n                return d.data.tooltip;\n                // return d.data.className + \": \" + format(d.value);\n            });\n\n        node.append(\"circle\")\n            .attr(\"r\", function (d) {\n                return d.r;\n            })\n            .style(\"fill\", function (d) {\n                //                return color(d.data.packageName);\n                return 'dd9f36';\n            });\n\n        node.append(\"text\")\n            .attr(\"dy\", \".3em\")\n            .style(\"text-anchor\", \"middle\")\n            .text(function (d) {\n                return d.data.className.substring(0, d.r / 3);\n            });\n\n        // Returns a flattened hierarchy containing all leaf nodes under the root.\n        function classes(root) {\n            var classes = [];\n\n            function recurse(name, node) {\n                if (node.children) node.children.forEach(function (child) {\n                    recurse(node.name, child);\n                });\n                else classes.push({packageName: name, className: node.name, value: node.size, tooltip: node.tooltip});\n            }\n\n            recurse(null, root);\n            return {children: classes};\n        }\n\n        d3.select(self.frameElement).style(\"height\", diameter + \"px\");\n    }\n\n    chart.bubble = function(selector, API_URL) {\n        $.get({\n            url: chart.common.API_URL + API_URL,\n            contentType: \"application/json; charset=utf-8\"\n        }).done(function (data, status, xhr) {\n            if (data.code === \"SUCCESS\") {\n                if ('returnobject' in data && data.returnobject != null && JSON.parse(data.returnobject).children.length > 0) {\n                    var data = JSON.parse(data.returnobject);\n                    showBubble(selector, data);\n                    chart.common.removePlaceholder(selector);\n                } else {\n                    logger.e(\"No data available for chart \" + selector);\n                    chart.common.keepPlaceholder(selector);\n                }\n            } else {\n                logger.e(data.message);\n                chart.common.keepPlaceholder(selector);\n            }\n        });\n    }\n\n})();\n\n/**\r\n * Main initial setup for router. Add generic logic if needed.\r\n *\r\n *\r\n * FOR ANONYMOUS ROUTING USE: router.addRouteAnonymousPost() method\r\n * FOR LOGGED IN ROUTING USE: router.addRoutePost() method\r\n */\r\n\r\n(function (window) {\r\n\r\n  'use strict';\r\n\r\n  // Add pre/post-execute code for all post requests\r\n  var preExec = function (ctx, next) {\r\n    if (ctx.hash) return false;\r\n\r\n    ubi.loader.nonBlocking.start();\r\n\r\n    genericDOMChanges();\r\n\r\n    setTimeout(function () {\r\n      // Scroll to top. Use class .no-scroll in case you don't want to scroll to top\r\n      /*!$('#main-area').hasClass('no-scroll') ? window.scrollTo(0, 0) : null;\r\n      $.post(ctx.canonicalPath, function (data) {\r\n          logger.i(\"Current page set to: \" + ctx.pathname);\r\n          ctx.htmlData = data;\r\n          next();\r\n      });*/\r\n\r\n      $.ajax({\r\n        url: ctx.canonicalPath,\r\n        type: 'POST'\r\n      }).done(function (data, textStatus, jqXHR) {\r\n        logger.i(\"Current page set to: \" + ctx.pathname);\r\n        ctx.htmlData = data;\r\n        next();\r\n      }).fail(function (jqXHR, textStatus, errorThrown) {\r\n        ubi.loader.stopAll();\r\n        logger.e(\"Error occurred with status: \" + jqXHR.status);\r\n        if (jqXHR.status === 403) {\r\n          page(\"/error/403\");\r\n        } else if (jqXHR.status === 404) {\r\n          page(\"/error/404\");\r\n        }\r\n      });\r\n    }, 300);\r\n  };\r\n  var postExec = function (ctx) {\r\n    // Paste HTML (fragment)\r\n    $(\"#main-wrapper main\").html(ctx.htmlData);\r\n    // Check pagination\r\n    checkIfNoDataWithPagination(ctx);\r\n    // Try to activate the page's menu item\r\n    $('#menu ul li').removeClass('active');\r\n    // Show back button\r\n    $('#back-button').removeClass('hide');\r\n\r\n\r\n    var menuRootID = ctx.pathname.split(\"/\")[1];\r\n    if (ctx.pathname.indexOf(\"visa-request/add\")>=0){\r\n      menuRootID = \"visa-request-add\";\r\n    }else if (ctx.pathname.indexOf(\"visa-request/track\")>=0){\r\n      menuRootID = \"visa-request-track\";\r\n    }else if (ctx.pathname.indexOf(\"visa-request/submitted\")>=0){\r\n      menuRootID = \"visa-request-submitted\";\r\n    }else if (ctx.pathname.indexOf(\"payment/grouppending\")>=0 || ctx.pathname.indexOf(\"visa-request/grouppending\")>=0){\r\n      menuRootID = \"payment-grouppending\";\r\n    }else if (ctx.pathname.indexOf(\"payment/group\")>=0){\r\n      menuRootID = \"payment-group\";\r\n    }else if (ctx.pathname.indexOf(\"group/add\")>=0){\r\n      menuRootID = \"group-add\";\r\n    }else if (ctx.pathname.indexOf(\"appointments/add\")>=0){\r\n      menuRootID = \"appointments-add\";\r\n    }\r\n\r\n    if ('sublevel' in ctx.params) {\r\n      menuRootID = 'sublevel-' + ctx.params.sublevel;\r\n    }\r\n    var $menuActiveItem = $('#menu-' + menuRootID);\r\n    var $menuLevel = $menuActiveItem.parents('.level').not('.open');\r\n    // Open menu after menu after reload\r\n    if ($menuLevel.length > 0) {\r\n      var $ulul = $menuLevel.find('ul');\r\n      var ulHeight;\r\n\r\n      $ulul.css('height', 'auto');\r\n      ulHeight = $ulul.outerHeight();\r\n      $ulul.css('height', 0);\r\n\r\n      $menuLevel.addClass('open');\r\n      $menuLevel.find('.arrow').addClass('down');\r\n\r\n      $ulul.animate({\r\n        'height': ulHeight + 'px'\r\n      }, 300);\r\n    }\r\n    $menuActiveItem.addClass('active');\r\n    // Set browser's title\r\n    ubi.setTitle();\r\n\r\n    $(\"form\").parsley();\r\n\r\n    enableSelect2();\r\n\r\n    $('.datepicker').datepicker({\r\n      dateFormat: 'dd/mm/yy',\r\n      locale: 'en',\r\n      changeYear: true,\r\n      changeMonth: true,\r\n      todayHighlight: true,\r\n      yearRange: '1910:2040',\r\n      endDate: new Date(),\r\n      beforeShowDay: function (date) {\r\n        var $this = $(this);\r\n        if (!$this.hasClass('lock-before-today') && !$this.hasClass('enable-today')) {\r\n          var doNothing = true;\r\n          return [doNothing];\r\n        }        \r\n        let afterdays = $this.attr(\"afterdays\");\r\n        if (afterdays === undefined || afterdays === '') {\r\n            afterdays = 0;\r\n        }              \r\n        var datepickerString = jQuery.datepicker.formatDate('yy-mm-dd', date);\r\n        var datepickerDate = new Date(datepickerString);\r\n        var today = new Date();    \r\n        if ($this.hasClass('enable-today')){\r\n            today.setDate(today.getDate() - 1); \r\n        }\r\n        today.setDate(today.getDate() + parseInt(afterdays));        \r\n        var isGreaterThanToday = datepickerDate.getTime() > today;\r\n        \r\n        return [isGreaterThanToday];\r\n      },\r\n      onClose: function () {\r\n        var $this = $(this);\r\n        $this.parsley().validate();\r\n\r\n        // statically added error\r\n        if ($this.hasClass('benderr')) {\r\n          $this.parsley().removeError(this.id);\r\n          $this.removeClass('benderr');\r\n          ubi.var.showErrorsOnTabs();\r\n        }\r\n      }\r\n    });\r\n\r\n    enableDropdownLinks();\r\n\r\n    // Enable tooltip if it exists\r\n    tooltip();\r\n    // Stop blocking loader\r\n    ubi.loader.nonBlocking.stop();\r\n    // language selector\r\n    ubi.languageSelector.addEvents();\r\n  };\r\n\r\n  var genericDOMChanges = function () {\r\n    $('html').removeClass('full-main');\r\n    $('.select2-container--open').remove();\r\n    // Remove button-wrapper and dark cover if exists\r\n    removeOuterButtonWrapper();\r\n    // If modal exists\r\n    $('html').hasClass('modal') ? modal.close() : null;\r\n  };\r\n\r\n  // Check if there is no data available on a table view and the page is paginated, set the pager to page-1\r\n  var checkIfNoDataWithPagination = function (ctx) {\r\n    if ($('#main-area > div.body').text().indexOf('No data') !== -1) {\r\n      var canonicalPath = ctx.canonicalPath;\r\n      var reg = new RegExp('&?page\\=[^&]+');\r\n      var extractedPage = canonicalPath.match(reg);\r\n      if (extractedPage != null) {\r\n        var pageNumber = parseInt(extractedPage[0].split('=')[1]);\r\n\r\n        if (pageNumber > 0) {\r\n          var newCanonicalPath = canonicalPath.replace(reg, 'page=' + (pageNumber - 1));\r\n          page(newCanonicalPath);\r\n        }\r\n      }\r\n    }\r\n  };\r\n\r\n    var CAPTCHA_VERSION = \"v2\";\r\n    \r\n    function enableCAPTCHA(){\r\n        if (CAPTCHA_VERSION===\"v3\"){\r\n            v3CAPTCHA();\r\n        } else {            \r\n            if ($(\"#recaptcha\").hasClass(\"g-recaptcha\")) {\r\n              v2CAPTCHA();\r\n            // } else if ($(\"#recaptcha\").hasClass(\"cf-turnstile\")) {\r\n            //   hCAPTCHA();\r\n            }\r\n        }\r\n    }\r\n    \r\n      \r\n      var onloadCallbackCAPTCHA = function() {   \r\n        var reCAPTCHASiteKey = $(\"#recaptcha\").attr('data-sitekey');\r\n        grecaptcha.render('recaptcha', {\r\n          'sitekey' : reCAPTCHASiteKey\r\n        });\r\n      };\r\n\r\n      window.onloadCallbackCAPTCHA = onloadCallbackCAPTCHA;\r\n\r\n      var onloadTurnstileCallback = function () {\r\n        var reCAPTCHASiteKey = $(\"#recaptcha\").attr('data-sitekey');\r\n        turnstile.render('#recaptcha', {\r\n          sitekey: reCAPTCHASiteKey,\r\n          callback: function(token) {\r\n            console.log(`Challenge Success ${token}`);\r\n          },\r\n        });\r\n      };\r\n\r\n  window.onloadTurnstileCallback = onloadTurnstileCallback;\r\n\r\n\r\n      \r\n    function getLanguage() {\r\n      var language;\r\n      language = getCookie('org.springframework.web.servlet.i18n.CookieLocaleResolver.LOCALE');\r\n      if (language === undefined || language === \"\" ){\r\n        language = $(\"#recaptcha\").attr('data-lang'); \r\n      }\r\n      return language;\r\n    }//EoM\r\n    \r\n    function getCookie(cn) {\r\n        var name = cn + \"=\";\r\n        var allCookie = decodeURIComponent(document.cookie).split(';');\r\n        var cval = [];\r\n        for (var i = 0; i < allCookie.length; i++) {\r\n            if (allCookie[i].trim().indexOf(name) == 0) {\r\n                cval = allCookie[i].trim().split(\"=\");\r\n            }\r\n        }\r\n        return (cval.length > 0) ? cval[1] : \"\";\r\n    }//EoM\r\n    \r\n    function v2CAPTCHA(){\r\n        //console.log(\"v2\"); \r\n        \r\n        var lang = getLanguage();\r\n        if (lang === undefined || lang === \"\" ){\r\n          lang = \"en\";\r\n        }                \r\n        \r\n        $.getScript( \"https://www.google.com/recaptcha/api.js?onload=onloadCallbackCAPTCHA&render=explicit&hl=\"+lang)\r\n            .done(function( script, textStatus ) {               \r\n            })\r\n            .fail(function( jqxhr, settings, exception ) {\r\n                console.log(jqxhr);              \r\n          });\r\n    }\r\n    \r\n    function v3CAPTCHA(){      \r\n        var reCAPTCHASiteKey = $(\"#recaptcha\").attr('data-sitekey');\r\n        $.getScript( \"https://www.google.com/recaptcha/api.js?render=\"+reCAPTCHASiteKey )\r\n            .done(function( script, textStatus ) {                \r\n                grecaptcha.ready(function() {\r\n                  grecaptcha.execute(reCAPTCHASiteKey, {action: 'homepage'}).then(function(token) {                      \r\n                  });\r\n              });\r\n            })\r\n            .fail(function( jqxhr, settings, exception ) {\r\n                console.log(jqxhr);\r\n              $( \"div.log\" ).text( \"Triggered ajaxError handler.\" );\r\n          });\r\n    }\r\n    \r\n    function hCAPTCHA(){      \r\n        var reCAPTCHASiteKey = $(\"#recaptcha\").attr('data-sitekey');\r\n        var lang = 'en';\r\n        if ($(\"#recaptcha\").attr('data-lang')) {\r\n          lang = $(\"#recaptcha\").attr('data-lang');\r\n        }\r\n        $.getScript( \"https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onloadTurnstileCallback\")\r\n            .done(function( script, textStatus) {\r\n            })\r\n            .fail(function( jqxhr, settings, exception ) {\r\n                console.log(jqxhr);\r\n              $( \"div.log\" ).text( \"Triggered ajaxError handler.\" );\r\n          });\r\n    }\r\n    \r\n  // Home TODO change landing page\r\n  function homeInit(ctx) {\r\n    if (ctx.init) {\r\n      console.log(\"Current page set to: \" + ctx.pathname);\r\n      //Urgent setup of ajax filter\r\n      ubi.setupAjaxCallFiltering();\r\n      //Check for possible page redirections\r\n      if (!ubi.hasAccess()) {\r\n        $('body').addClass('bg-tech front');\r\n        // Load content for anonymous users\r\n        if (ubi.redirectTopage !== undefined) {          \r\n          page(ubi.redirectTopage);\r\n        } else { \r\n          \r\n          let path = window.location.href;\r\n          let pathname = window.location.pathname ;    \r\n          let url = \"/anonymous/home\";\r\n          if (pathname === \"/\" && path.search(\"/?lang=\") > 0) {            \r\n            let locale =  path.split(\"/?lang=\")[1];\r\n            var values = locale.split(\"_\"); \r\n            url = url + \"/\" + values[1] + '/' + values[0];\r\n          }\r\n          \r\n          $.post(url, function (data) {          \r\n            $('#layout-container').html(data);\r\n            ubi.setTitle(\"Login\");\r\n            ubi.languageSelector.addEvents();\r\n            enableCAPTCHA();\r\n          });\r\n        }\r\n      } else {\r\n        // Load content for authenticated users\r\n        $.post(\"/auth/theme\", function (data) {\r\n          logger.d(\"Theme structure loaded\");\r\n\r\n          $('body').addClass('gvcw');\r\n\r\n          ubi.languageSelector.addEvents();\r\n\r\n          $('#layout-container').html(data);\r\n\r\n          notification.init();\r\n\r\n          if (ubi.redirectTopage === undefined) {\r\n            ubi.setTitle(\"Home\");\r\n            ubi.home();\r\n          } else {\r\n            page(ubi.redirectTopage);\r\n          }\r\n        }).fail(function (jqXHR, textStatus, errorThrown) {\r\n          logger.e(\"Error occurred with status: \" + jqXHR.status);\r\n          //alertify.error(ubi.getTranslationExt(\"frontend.message.error.4\")); // \"Something went wrong. Redirect to login page.\"\r\n          alertify.error(\"Something went wrong. Redirect to login page.\");\r\n          $('body').addClass('bg-tech');\r\n          setTimeout(function () {\r\n            ubi.removeAccess();\r\n            ubi.goHome();\r\n          }, 2000);\r\n        });\r\n      }\r\n    } else {\r\n      logger.i(\"Reload current page\");\r\n      location.reload();\r\n    }\r\n  }\r\n\r\n  ubi.home = function () {\r\n    ubi.loader.nonBlocking.start();\r\n    genericDOMChanges();\r\n    $.post(ubi.HOMEPAGE_PATH, function (data) {\r\n      $('#menu ul li').removeClass('active');\r\n      var menuRootID = ubi.HOMEPAGE_PATH.split(\"/\")[1];\r\n      var $menuActiveItem = $('#menu-' + menuRootID);\r\n      $menuActiveItem.addClass('active');\r\n      setTimeout(function () {\r\n        $(\"#main-wrapper main\").html(data);\r\n        history.pushState(null, \"/\", \"/\");\r\n        ubi.loader.nonBlocking.stop();\r\n      }, ubi.loader.nonBlocking.loadingTime);\r\n    }).fail(function (jqXHR, textStatus, errorThrown) {\r\n      if (jqXHR.responseText.indexOf(\"[templates/var.html]\")>0){\r\n          page(\"/visa-request\");\r\n      }else{\r\n        logger.e(\"Error occurred with status: \" + jqXHR.status);\r\n        alertify.error( \"Something went wrong. Redirect to login page.\");\r\n        //alertify.error(ubi.getTranslationExt(\"frontend.message.error.4\")); // \"Something went wrong. Redirect to login page.\"\r\n        $('body').addClass('bg-tech');\r\n        setTimeout(function () {\r\n          ubi.removeAccess();\r\n          ubi.goHome();\r\n        }, 2000);\r\n      }\r\n    });\r\n  };\r\n\r\n\r\n  // Initialize Road object\r\n  var router = new Road(preExec, postExec);\r\n\r\n  router.base('/');\r\n  router.addRouteCallback('/', homeInit);\r\n\r\n\r\n  window.router = router;\r\n  window.enableCAPTCHA = enableCAPTCHA;\r\n\r\n})(window);\r\n\n\n/**\n * Define notification crawl routing pages\n */\n\n(function () {\n\n    'use strict';\n\n    var varcommon = {\n        filterMultipleAppIDs: filterMultipleAppIDs,\n        clearAppIDs: clearAppIDs,\n        loadTravelAgent: loadTravelAgent,\n        loadVacByCountry: loadVacByCountry,\n        filtervar: filtervar\n    };\n\n    function filterMultipleAppIDs() {\n        var data = $('#appids').val();\n        data = data.toUpperCase();\n        // match all valid application ids and remove duplicates\n        // todo edge case where all are wrong => .filter throws error\n        //var matched = data.match(/[A-Z]{5}-[A-Z]{2}[\\d]{7}/gm);\n        var matched = data.match(/(([A-Z])|(\\d)|(-)){15}|[A-Z]{4}[\\d]{10}/gm);\n        if (matched === null) {\n            alertify.error(ubi.getTranslationExt(\"frontend.message.error.11\"), 10); //\"No proper Application IDs found!\"\n            return;\n        } else {\n            var result = matched.filter((word, i, arr) => arr.indexOf(word) === i);\n            var numVars = result.length;\n            $('#appids').val(result.join('\\n') + '\\n');// add a newline to allow the user to resume scanning seamlessly\n            $('#numOfUniqueRecords').text(numVars);\n        }\n    };\n\n\n    function clearAppIDs() {\n        // clear text area and zero the counter\n        $('#appids').val('');\n        $('#numOfUniqueRecords').text(0);\n    };\n    \n    function loadTravelAgent(){\n        let travelagent = $(\"#travelagent\").val();\n        if (travelagent !== 0 && travelagent !== undefined && travelagent !== ''\n                && $(\"#groupid\")!=null && $(\"#groupid\").length) {                        \n            ubi.loader.blocking.start();\n            let apiUrl = \"/api/v1/travelagent/\" + travelagent + \"/group\";                   \n\n            $.get({\n                url: apiUrl,\n                contentType: \"application/json; charset=utf-8\"\n            }).done(function (data, status, xhr) {\n                if (\"SUCCESS\" === data.code) {\n\n                    logger.i(\"Info loaded successful\");\n                    $(\"#groupid\").removeAttr(\"disabled\");\n                    var array = data.returnobject;\n                    var htmlVar = \"\";\n                    htmlVar += '<option value=\"\"></option>'\n                    for (var i = 0; i < array.length; i++) {\n                        htmlVar += '<option value=\"' + array[i].id + '\">'\n                                + array[i].name\n                                + '</option>';\n                    }\n                    $(\"#groupid\").html(htmlVar);                    \n                } else {\n                    alertify.error(data.message);\n                }\n            }); //done\n        }\n    }\n    \n    function loadVacByCountry(){\n        let country = $(\"#country\").val();\n        if (country !== 0 && country !== undefined && country !== ''\n                && $(\"#vac\")!=null && $(\"#vac\").length) {                        \n            ubi.loader.blocking.start();\n            let apiUrl = \"/api/v1/country/\" + country + \"/vac\";                 \n\n            $.get({\n                url: apiUrl,\n                contentType: \"application/json; charset=utf-8\"\n            }).done(function (data, status, xhr) {\n                if (\"SUCCESS\" === data.code) {\n\n                    logger.i(\"Info loaded successful\");\n                    $(\"#vac\").removeAttr(\"disabled\");\n                    var array = data.returnobject;\n                    var htmlVar = \"\";\n                    htmlVar += '<option value=\"\"></option>'\n                    for (var i = 0; i < array.length; i++) {\n                        htmlVar += '<option value=\"' + array[i].id + '\">'\n                                + array[i].shortname\n                                + '</option>';\n                    }\n                    $(\"#vac\").html(htmlVar);                    \n                } else {\n                    alertify.error(data.message);\n                }\n            }); //done\n        }\n    }\n    \n    \n    \n    function filtervar($this){\n        filterMultipleAppIDs();        \n        tb.filter($this);\n    }\n\n    window.varcommon = varcommon;\n\n})(window);\n/**\n * Define city routing pages\n */\n//new delivery for report\n(function () {\n\n  'use strict';\n\n  router.addRoutePost('delivery');\n  router.addRoutePost('delivery/:id');\n\n})();\n\n/**\n * Define city routing pages\n */\n//new delivery for report\n(function () {\n\n    'use strict';\n\n\n    router.addRoutePost('fromcentraltoconsulateindi');\n\n\n\n\n})();\n/**\n * Define availabilityslotssummary routing pages\n */\n\n(function () {\n\n    'use strict';\n    router.addRoutePost('availabilityslotssummary');\n\n})();\n/**\n * Define availabilityslotssummary routing pages\n */\n\n(function () {\n\n    'use strict';\n    router.addRoutePost('availabilityslotsanalytical');\n\n})();\n\n(function () {\n\n    'use strict';\n\n\n    router.addRoutePost('fromcentraltoconsulatebatch');\n\n\n\n\n})();\n(function () {\n\n    'use strict';\n\n\n    router.addRoutePost('fromcentraltoregionalindi');\n\n\n\n\n})();\n\n\n(function () {\n\n    'use strict';\n\n\n    router.addRoutePost('fromcentraltoregionalbatch');\n\n\n\n\n})();\n\n\n(function () {\n\n    'use strict';\n\n\n    router.addRoutePost('fromregionaltocentralindi');\n\n\n\n\n})();\n\n\n(function () {\n\n    'use strict';\n\n\n    router.addRoutePost('fromregionaltocentralbatch');\n\n\n\n\n})();\n\n\n(function () {\n\n    'use strict';\n\n\n    router.addRoutePost('fromconsulatetocentralindi');\n\n\n\n\n})();\n\n\n(function () {\n\n    'use strict';\n\n\n    router.addRoutePost('fromconsulatetocentralbatch');\n\n\n\n\n})();\n\n\n(function () {\n\n    'use strict';\n\n\n    router.addRoutePost('fromreglocaltocentralindi');\n\n\n\n\n})();\n\n\n(function () {\n\n    'use strict';\n\n\n    router.addRoutePost('fromreglocaltocentralbatch');\n\n\n\n\n})();\n\n\n(function () {\n\n    'use strict';\n\n\n    router.addRoutePost('fromcentraltocourierindi');\n\n\n\n\n})();\n\n\n(function () {\n\n    'use strict';\n\n\n    router.addRoutePost('fromcentraltocourierbatch');\n\n\n\n\n})();\n\n\n(function () {\n\n    'use strict';\n\n\n    router.addRoutePost('fromreglocaltocourierindi');\n\n\n\n\n})();\n\n\n(function () {\n\n    'use strict';\n\n\n    router.addRoutePost('fromreglocaltocourierbatch');\n\n\n\n\n})();\n\n\n(function () {\n\n    'use strict';\n\n\n    router.addRoutePost('scaninfromcentraltoconsindi');\n\n\n\n\n})();\n\n\n(function () {\n\n    'use strict';\n\n\n    router.addRoutePost('scaninfromcentraltoconsbatch');\n\n\n\n\n})();\n\n\n(function () {\n\n    'use strict';\n\n\n    router.addRoutePost('scaninfromcentraltoreglocalindi');\n\n\n\n\n})();\n\n\n(function () {\n\n    'use strict';\n\n\n    router.addRoutePost('scaninfromcentralindi');\n\n\n\n\n})();\n\n\n(function () {\n\n    'use strict';\n\n\n    router.addRoutePost('scaninfromconsindi');\n\n\n\n\n})();\n\n\n(function () {\n\n    'use strict';\n\n\n    router.addRoutePost('scaninfromregbatch');\n\n\n\n\n})();\n\n\n(function () {\n\n    'use strict';\n\n\n    router.addRoutePost('scaninfromregindi');\n\n\n\n\n})();\n/**\n * Define test routing pages\n */\n\n(function () {\n  'use strict';\n  router.addRoutePost('appointmentvarreport');\n  router.addRoutePost('appointmentvarreport/:id');\n})();\n\n/**\n * Define failed transactions routing pages\n */\n\n(function () {\n\n    'use strict';\n    router.addRoutePost('pending');\n\n})();\n/**\n * Define city routing pages\n */\n//new delivery for report\n(function () {\n\n  'use strict';\n\n  router.addRoutePost('unlockfinancials');\n  router.addRoutePost('unlockfinancials/:id');\n\n})();\n\n/**\n * Define city routing pages\n */\n\n(function () {\n\n  'use strict';\n\n  router.addRoutePost('appointmentmaster');\n  router.addRoutePost('appointmentmaster/:id');\n  router.addRoutePost('appointmentmaster/synch');\n})();\n/**\n * Anonymous routing setup\n */\n\n(function () {\n\n    'use strict';    \n    \n    function onChangeCountry() {\n      \n        ubi.languageSelector.addEvents();\n        enableSelect2();\n        selectCountry();\n        enableCAPTCHA();\n\n        $(\"#country\").change(function () {\n            selectCountry();\n        });\n\n    }//EoM onChangeCountry\n    \n    function selectCountry(){\n        \n        let country = $(\"#country\").val();\n        if (country !== 0 && country !== undefined && country !== '') {\n            // Country\n            ubi.loader.blocking.start();\n            \n            $.get({\n                url: \"/api/v1/country/vac/\"+country,\n                contentType: \"application/json; charset=utf-8\"\n            }).done(function (data, status, xhr) {\n                if (\"SUCCESS\" === data.code) {\n                    logger.i(\"Info loaded successful\");\n                    $(\"#vac\").removeAttr(\"disabled\");\n                    var array = data.returnobject;\n                    var htmlVar = \"\";\n                    htmlVar += '<option value=\"\"></option>'\n                    for (var i = 0; i < array.length; i++) {\n                        htmlVar += '<option value=\"' + array[i].id + '\">'\n                                + array[i].name\n                                + '</option>';\n                    }\n                    $(\"#vac\").html(htmlVar);\n\n                } else {\n                    alertify.error(data.message);\n                }\n            }); //done\n\n            //check validation user type, sms or email\n            $.get({\n                url: \"/api/v1/country/validationtype/\"+ country,\n                contentType: \"application/json; charset=utf-8\"\n            }).done(function (data, status, xhr) {\n                if (\"SUCCESS\" === data.code) {\n                    logger.i(\"Info loaded successful\");\n\n                    var array = data.returnobject;\n                    for (var i = 0; i < array.length; i++) {\n                            var validationtype = array[0].value;\n                            if(validationtype === \"false\"){\n                                $(\"#btn-register\").hide();\n                                $(\"#recaptcha\").hide();\n                                $(\"#onetimepassword-wrap\").hide();\n                                $(\"#btn-onetimepassword\").show();\n                            }else{\n                                $(\"#btn-register\").show();\n                                $(\"#recaptcha\").show();\n                                $(\"#onetimepassword-wrap\").hide();\n                                $(\"#btn-onetimepassword\").hide();\n                            }\n                    }\n                } else {\n                    alertify.error(data.message);\n                }\n            }); //done\n\n            $.get({\n                url: \"/api/v1/country/languages/\"+ country,\n                contentType: \"application/json; charset=utf-8\"\n            }).done(function (data, status, xhr) {\n                if (\"SUCCESS\" === data.code) {\n                    logger.i(\"Info loaded successful\");\n                    $(\"#language\").removeAttr(\"disabled\");\n                    var array = data.returnobject;\n                    var htmlVar = \"\";\n                    var selectedLang = '';\n                    if ($(\"#language\").attr('sel_lan')){\n                        selectedLang = $(\"#language\").attr('sel_lan');\n                    }\n\n                  //  htmlVar += '<option value=\"\"></option>'\n                    for (var i = 0; i < array.length; i++) {\n                        let selectOption = '';\n                        if (selectedLang === array[i].id){\n                            selectOption = ' selected ';\n                        }\n                        htmlVar += '<option '+selectOption+' value=\"' + array[i].id + '\">'\n                                + array[i].value\n                                + '</option>';\n                    }\n                    $(\"#language\").html(htmlVar);\n\n                } else {\n                    alertify.error(data.message);\n                }\n            }); //done\n\n        }\n    }\n    \n    function uploadOfflineConfig() {\n        var input = document.getElementById('configFile');\n        var $btn = $('#btn-config');\n        var file = input.files[0];\n\n        var reqData = new FormData();\n        reqData.append('configFile', file);        \n        reqData.append('country', $('#country').val());\n        reqData.append('vac', $('#vac').val());\n\n        $btn.addClass('loading');\n        $(\"body\").addClass('loading');\n        var API_URL = ubi.API_URL_PREFIX + $btn.attr('data-submit');\n        \n        $.ajax({\n            type: 'POST',\n            data: reqData,\n            url: API_URL,\n            processData: false,\n            contentType: false\n        }).done(function (data, textStatus, jqXHR) {\n            if (textStatus.toUpperCase() == \"SUCCESS\" && data.code.toUpperCase() === \"SUCCESS\") {\n              setTimeout(function () {\n                $btn.removeClass('loading');\n                $('body').removeClass('loading');\n\n                var redirect = $btn.attr('data-redirect');\n                var redirectURL = redirect;\n\n\n                data != \"\" && \"message\" in data && data.message != null\n                    ? alertify.success(data.message)\n                    : null;\n\n\n                // Redirection\n                if (window.location.search.indexOf('redirect=') !== -1) {\n                  window.history.back();\n                } else {\n                 redirectURL != \"stay\" ? page(redirectURL) : null;\n                }\n            }, ubi.loader.blocking.loadingTime);\n          }else{\n            alertify.error(data.message);\n            $btn.removeClass('loading');\n            $('body').removeClass('loading');\n          }\n                        \n        }).error(function (data, textStatus, jqXHR) {\n            logger.e(textStatus);\n            logger.e(data);\n            \"message\" in data ? alertify.error(data.message) : alertify.error(\n                    ubi.getTranslationExt(\"frontend.message.error.1\")); //\"Something went wrong. Please contact the system administrator.\"\n            //alertify.error(ubi.getTranslationExt(\"frontend.message.error.5\")); // \"Please contact the system administrator\"\n\n            $btn.removeClass('loading');\n            $('body').removeClass('loading');\n        });\n    }\n    \n    function setupChangeCountry(){\n      selectCountry();\n    }\n    \n    function loadLogin(){\n      ubi.languageSelector.addEvents();\n      enableCAPTCHA();\n    }\n\n\n    function hideShowFields(){\n        loadLogin()\n        $(\"#email\").on(\"input\",function(){\n            var email = $(\"#email\").val();\n            if(email){\n                $(\"#username\").hide();\n            }else{\n                $(\"#username\").show();\n            }\n        })\n\n        $(\"#username\").on(\"input\",function(){\n                    var username = $(\"#username\").val();\n                    if(username){\n                        $(\"#email\").hide();\n                    }else{\n                        $(\"#email\").show();\n                    }\n\n                })\n    }\n\n    function sendOtp(){\n        onChangeCountry();\n    }\n\n\n    router.addRouteAnonymousPost('login', loadLogin);\n    router.addRouteAnonymousPost('login/:destination', loadLogin);\n    router.addRouteAnonymousPost('login/:country/:language', loadLogin);\n    router.addRouteAnonymousPost('register', sendOtp);\n    router.addRouteAnonymousPost('register/:country/:language', sendOtp);\n    router.addRouteAnonymousPost('register/result');\n    router.addRouteAnonymousPost('register/resultotp');\n    router.addRouteAnonymousPost('resetpassword', hideShowFields);\n    router.addRouteAnonymousPost('validation/success');\n    router.addRouteAnonymousPost('validation/failure');\n    router.addRouteAnonymousPost('validation/already');\n    router.addRouteAnonymousPost('resetpassword/**', hideShowFields);\n\n    window.uploadOfflineConfig = uploadOfflineConfig;    \n    window.setupChangeCountry = setupChangeCountry;\n\n})();\n\n/**\n * Define city routing pages\n */\n//new delivery for report\n(function () {\n\n  'use strict';\n\n\n    function datepickerMonthYear(){\n//    console.log(\"mpike\");\n    $(\".monthPicker\").datepicker({\n    changeMonth: true,\n    changeYear: true,\n    dateFormat: \"yy/mm\",\n    locale: 'en',\n    showButtonPanel: false,\n//    currentText: \"This Month\",\n    oncChangeMonthYear: function(year, month, inst){\n        $(this).val($.datepicker.formatDate('yy/mm', new Date(year, month - 1, 1)));\n    },\n    onClose: function(dateText, inst){\n        var month = $(\".ui-datepicker-month :selected\").val();\n        var year = $(\".ui-datepicker-year :selected\").val();\n        $(this).val($.datepicker.formatDate('yy/mm', new Date(year, month, 1)));\n    }\n  }).focus(function (){\n    $(\".ui-datepicker-calendar\").hide();\n  }).after(\n    $(\"<a href='javascript: void(0);'>clear</a>\").click(function(){\n        $(this).prev().val('');\n    })\n  );\n\n    }\n\n\n\n\n\n\n  router.addRoutePost('travelagentreport',datepickerMonthYear);\n  router.addRoutePost('travelagentreport/:id');\n\n})();\n\n\n/**\n * Define city routing pages\n */\n//new delivery for report\n(function () {\n\n  'use strict';\n\n      function confirmClear($this) {\n            alertify.confirm(ubi.getTranslationExt('frontend.message.deleteappointments.title'), ubi.getTranslationExt('frontend.message.deleteappointments.message'),\n                function(){\n                  ubi.crud.post($this);\n                },\n                function(){\n                    alertify.alert(ubi.getTranslationExt('frontend.message.deleteappointments.title'), ubi.getTranslationExt('frontend.message.deleteappointments.cancelled'));\n                }\n            ).set({\n                labels: {ok: ubi.getTranslationExt('frontend.message.deleteappointments.submit'), cancel: ubi.getTranslationExt('frontend.message.deleteappointmentsdeleteappointments.cancel')},\n                reverseButtons: true,\n                transition: 'fade'\n            });\n      }\n  router.addRoutePost('clearappointments');\n  router.addRoutePost('clearappointments/:id');\n\n    window.confirmClear = confirmClear;\n\n})();\n/**\n * Define failed transactions routing pages\n */\n\n(function () {\n\n    'use strict';\n    router.addRoutePost('alltransactions');\n\n})();\n/**\n * Define city routing pages\n */\n//new delivery for report\n(function () {\n\n    'use strict';\n\n\n    router.addRoutePost('succeeded');\n\n\n\n\n})();\n/**\n * Define notification crawl routing pages\n */\n\n(function() {\n\n    'use strict';\n\n\n    router.addRoutePost('notification');\n    router.addRoutePost('notification/settings');\n\n})();\n/**\n * Define enumeration routing pages\n */\n\n(function() {\n\n    'use strict';\n    \n    function changeCurrency() {\n\n        $(\"#currencytype\").change(function () {\n            alertify.warning(ubi.getTranslationExt(\"frontend.message.country.currencychanged\"));\n            \n        });\n\n        $(\"#excelcurrencytype\").change(function () {\n            alertify.warning(ubi.getTranslationExt(\"frontend.message.country.currencychanged\"));\n        });\n\n        \n    }//EoM changeCurrency\n\n    router.addRoutePost('enumeration');\n    router.addRoutePost('enumeration/country/:id', changeCurrency);\n    router.addRoutePost('enumeration/:sublevel');\n    router.addRoutePost('enumeration/:sublevel/:id');\n    \n\n})();\n\n/**\n * Define routing pages\n */\n\n(function () {\n\n    'use strict';\n\n    function onEventsForVisaOffering() {\n\n        //OnChange of duration\n        $('#isgratis').on('change', function (event) {\n            var target = event.target;\n            var isgratis = target.value;\n            if (isgratis === 'true') {\n                $('#costinref').val('0');\n                $('#divgratis').removeClass(\"hidden\");                \n                $('#divisgratisagetriggered').removeClass(\"hidden\");                \n                $('#divgratisage').removeClass(\"hidden\");                                \n            } else {\n                $('#divgratis').addClass(\"hidden\");                \n                $('#divisgratisagetriggered').addClass(\"hidden\");                \n                $('#divgratisage').addClass(\"hidden\");                \n            }\n        });\n        \n    }//onEventsForVisaOffering\n\n    router.addRoutePost('visaoffering');\n    router.addRoutePost('visaoffering/:id', onEventsForVisaOffering);\n    \n})();\n\n/**\n * Define routing pages\n */\n\n(function () {\n\n    'use strict';\n\n    function onEventsForServiceOffering() {\n        //-----1 Event-----------\n        $(\"#country\").change(function () {\n            let country = $(\"#country\").val();\n            if (country !== 0 && country !== undefined && country !== '') {\n                // Country\n                ubi.loader.blocking.start();\n                //-------1st call\n                $.get({\n                    url: \"/api/v1/country/\" + country + \"/vac\",\n                    contentType: \"application/json; charset=utf-8\"\n                }).done(function (data, status, xhr) {\n                    if (\"SUCCESS\" === data.code) {\n                        logger.i(\"Info loaded successful\");\n                        //$(\"#vac\").removeAttr(\"disabled\");\n                        var array = data.returnobject;\n                        var htmlVar = \"\";\n                        htmlVar += '<option value=\"\"></option>'\n                        for (var i = 0; i < array.length; i++) {\n                            htmlVar += '<option value=\"' + array[i].id + '\">'\n                                    + array[i].shortname\n                                    + '</option>';\n                        }\n                        $(\"#vac\").html(htmlVar);\n                    } else {\n                        alertify.error(data.message);\n                    }\n                }); //done---1st call     \n\n                //Get currency\n                $.get({\n                    url: \"/api/v1/country/\" + country + \"/currency\",\n                    contentType: \"application/json; charset=utf-8\"\n                }).done(function (data, status, xhr) {\n                    if (\"SUCCESS\" === data.code) {\n                        logger.i(\"Info loaded successful\");\n                        //$(\"#vac\").removeAttr(\"disabled\");\n                        var ret = data.returnobject;\n                        $(\"#currencyspan\").text(ret);\n                    } else {\n                        alertify.error(data.message);\n                    }\n                }); //done  \n\n                $.get({\n                    url: \"/api/v1/country/\" + country + \"/exchangerate\",\n                    contentType: \"application/json; charset=utf-8\"\n                }).done(function (data, status, xhr) {\n                    if (\"SUCCESS\" === data.code) {\n                        logger.i(\"Info loaded successful\");\n                        var ret = data.returnobject;\n                        $(\"#exchangerate\").val(ret);\n                    } else {\n                        alertify.error(data.message);\n                    }\n                }); //done---1st call     \n\n                $.get({\n                    url: \"/api/v1/country/\" + country + \"/numofdecimals\",\n                    contentType: \"application/json; charset=utf-8\"\n                }).done(function (data, status, xhr) {\n                    if (\"SUCCESS\" === data.code) {\n                        logger.i(\"Info loaded successful\");\n                        var numOfDecimals = data.returnobject;\n                        $(\"#numofdecimals\").val(numOfDecimals);\n                    } else {\n                        alertify.error(data.message);\n                    }\n                }); //done                          \n\n                //------------------\n                ubi.loader.blocking.stop();\n            }\n        });\n\n        //-----2 Event-----------\n        $(\"#vac\").change(function () {\n            let vac = $(\"#vac\").val();\n            if (vac !== 0 && vac !== undefined && vac !== '') {\n                // Country\n                ubi.loader.blocking.start();\n                //-------1st call\n                $.get({\n                    url: \"/api/v1/vac/\" + vac + \"/exchangerate\",\n                    contentType: \"application/json; charset=utf-8\"\n                }).done(function (data, status, xhr) {\n                    if (\"SUCCESS\" === data.code) {\n                        logger.i(\"Info loaded successful\");\n                        var ret = data.returnobject;\n                        $(\"#exchangerate\").val(ret);\n                    } else {\n                        alertify.error(data.message);\n                    }\n                }); //done---1st call                                \n\n                //------------------\n                ubi.loader.blocking.stop();\n            }\n        });\n\n        //-----3 Event-----------\n        $('#isgratis').on('change', function (event) {\n            var target = event.target;\n            var isgratis = target.value;\n            if (isgratis === 'true') {\n                $(\"#costinref\").val(0);\n                $(\"#costinlocal\").val(0);\n                //hide\n                $('#divroot').addClass(\"hidden\");\n                $('#divvac').addClass(\"hidden\");\n                $('#divdeclarebase').addClass(\"hidden\");\n                $('#divcostinlocal').addClass(\"hidden\");\n                $('#divcostinref').addClass(\"hidden\");\n                \n            } else {\n                $('#divroot').removeClass(\"hidden\");\n                $('#divvac').removeClass(\"hidden\");\n                $('#divdeclarebase').removeClass(\"hidden\");\n                $('#divcostinlocal').removeClass(\"hidden\");\n                $('#divcostinref').removeClass(\"hidden\");                \n            }\n        });\n\n        //-----4 Event-----------\n        $('#costinlocal').on('change', function (event) {\n            var target = event.target;\n            var cost = target.value;\n            var rate = document.getElementById('exchangerate').value;\n            var declarebase = $(\"#declarebase :selected\").val();  // declarebase==true (local)     declarebase==false (ref)                  \n            console.log(cost, rate, declarebase);\n            if (declarebase === 'true') {\n                if (rate !== '' && rate !== '0') {      //TODO den fortonetai to rate\n                    $(\"#costinref\").val((cost / rate).toFixed(2));\n                    $.each($(\"input#offeringvaccost\"), function () {\n                        $(this).val(cost);\n                    });\n                }\n            }\n\n        });\n\n        //-----5 Event-----------\n        $('#costinref').on('change', function (event) {\n            var target = event.target;\n            var cost = target.value;\n            var rate = document.getElementById('exchangerate').value;\n            var declarebase = $(\"#declarebase :selected\").val();    // declarebase==true (local)     declarebase==false (ref)\n//            alert(declarebase);                     \n            console.log(cost, rate, declarebase);\n            if (declarebase === 'false')\n                if (rate !== '' && rate !== '0') {\n                    var numOfDecimals = 2;\n                    if ($('#numofdecimals').length){\n                        numOfDecimals = $('#numofdecimals').val();\n                    }\n                    $(\"#costinlocal\").val((cost * rate).toFixed(numOfDecimals));\n                    $.each($(\"input#offeringvaccost\"), function () {\n                        $(this).val(cost);\n                    });                    \n                }\n        });\n\n        //----- Event-----------\n        $('#root').on('change', function (event) {\n            var target = event.target;\n            var root = target.value;\n            console.log(root);\n            if (root === 'true'){                \n                $(\"#vac option[selected]\").removeAttr(\"selected\");  \n                $(\"#vac\")[0].selectedIndex = 0;\n                $(\"#vac\").trigger('change'); \n                $(\"#vac\").prop( \"disabled\", true );\n                \n                //$('#divvac').addClass(\"hidden\");\n        }else{\n             //   $('#divvac').removeClass(\"hidden\");\n                $(\"#vac\").prop( \"disabled\", false );\n            }\n        });\n\n        //-----Event-----------\n        $('#declarebase').on('change', function (event) {\n            var target = event.target;\n            var declarebase = target.value;\n            console.log(declarebase);\n            if (declarebase === 'true') {     //local\n                $(\"#costinlocal\").prop(\"disabled\", false);\n                $(\"#costinref\").prop(\"disabled\", true);\n            } else {    //ref\n                $(\"#costinref\").prop(\"disabled\", false);\n                $(\"#costinlocal\").prop(\"disabled\", true);\n            }\n        });\n\n    }//EoM\n    \n    function loadSearch() {\n                \n        $(\"#country\").change(function () {\n            varcommon.loadVacByCountry();\n        });        \n        \n    }//EoM loadSearch\n\n    router.addRoutePost('serviceoffering', loadSearch);\n    router.addRoutePost('serviceoffering/:id', onEventsForServiceOffering);\n\n})();\n\n/**\n * Define routing pages\n */\n\n(function () {\n\n    'use strict';\n\n    function onEventsForVas() {\n        //----- Event-----------\n        $('#iscategory').on('change', function (event) {\n            var target = event.target;\n            var iscategory = target.value;\n            if (iscategory === 'true') {\n                //hide\n                $('#divparent').addClass(\"hidden\");\n                $('#divlevel').addClass(\"hidden\");\n                              \n                $(\"#parent option[selected]\").removeAttr(\"selected\");  \n                $(\"#parent\")[0].selectedIndex = 0;\n                $(\"#parent\").trigger('change'); \n                $(\"#parent\").prop( \"disabled\", true );\n                \n                \n                $(\"#level option[selected]\").removeAttr(\"selected\");  \n                $(\"#level\")[0].selectedIndex = 0;\n                $(\"#level\").trigger('change'); \n                $(\"#level\").prop( \"disabled\", true );\n\n            } else {\n                $('#divparent').removeClass(\"hidden\");                \n                $('#divlevel').removeClass(\"hidden\");\n                $(\"#parent\").prop( \"disabled\", false );\n                $(\"#level\").prop( \"disabled\", false );\n            }\n        });\n\n    }//EoM \n\n    router.addRoutePost('vas');\n    router.addRoutePost('vas/:id', onEventsForVas);\n\n})();\n\n/**\n * Define routing pages\n */\n\n(function () {\n\n    'use strict';\n\n    function onEventsForVasOffering() {\n        //-----1 Event-----------\n        $(\"#country\").change(function () {\n            let country = $(\"#country\").val();\n            if (country !== 0 && country !== undefined && country !== '') {\n                // Country\n                ubi.loader.blocking.start();\n                //-------1st call\n                $.get({\n                    url: \"/api/v1/country/\" + country + \"/vac\",\n                    contentType: \"application/json; charset=utf-8\"\n                }).done(function (data, status, xhr) {\n                    if (\"SUCCESS\" === data.code) {\n                        logger.i(\"Info loaded successful\");\n                        //$(\"#vac\").removeAttr(\"disabled\");\n                        var array = data.returnobject;\n                        var htmlVar = \"\";\n                        htmlVar += '<option value=\"\"></option>'\n                        for (var i = 0; i < array.length; i++) {\n                            htmlVar += '<option value=\"' + array[i].id + '\">'\n                                    + array[i].shortname\n                                    + '</option>';\n                        }\n                        $(\"#vac\").html(htmlVar);\n                    } else {\n                        alertify.error(data.message);\n                    }\n                }); //done\n\n                //Get currency\n                $.get({\n                    url: \"/api/v1/country/\" + country + \"/currency\",\n                    contentType: \"application/json; charset=utf-8\"\n                }).done(function (data, status, xhr) {\n                    if (\"SUCCESS\" === data.code) {\n                        logger.i(\"Info loaded successful\");\n                        //$(\"#vac\").removeAttr(\"disabled\");\n                        var ret = data.returnobject;\n                        $(\"#currencyspan\").text(ret);\n                    } else {\n                        alertify.error(data.message);\n                    }\n                }); //done \n                \n                //Get Consulates\n                $.get({\n                    url: \"/api/v1/country/\" + country + \"/consulate\",\n                    contentType: \"application/json; charset=utf-8\"\n                }).done(function (data, status, xhr) {\n                    if (\"SUCCESS\" === data.code) {\n                        logger.i(\"Info loaded successful\");\n                        $(\"#consulate\").removeAttr(\"disabled\");\n                        var array = data.returnobject;\n                        var htmlVar = \"\";\n                        htmlVar += '<option value=\"\"></option>'\n                        for (var i = 0; i < array.length; i++) {\n                            htmlVar += '<option value=\"' + array[i].id + '\">'\n                                    + array[i].name\n                                    + '</option>';\n                        }\n                        $(\"#consulate\").html(htmlVar);\n                    } else {\n                        alertify.error(data.message);\n                    }\n                }); //done              \n                \n                //Get Exchange Rate\n                $.get({\n                    url: \"/api/v1/country/\" + country + \"/exchangerate\",\n                    contentType: \"application/json; charset=utf-8\"\n                }).done(function (data, status, xhr) {\n                    if (\"SUCCESS\" === data.code) {\n                        logger.i(\"Info loaded successful\");\n                        var ret = data.returnobject;\n                        $(\"#exchangerate\").val(ret);\n                    } else {\n                        alertify.error(data.message);\n                    }\n                }); //done       \n                \n                 $.get({\n                    url: \"/api/v1/country/\" + country + \"/numofdecimals\",\n                    contentType: \"application/json; charset=utf-8\"\n                }).done(function (data, status, xhr) {\n                    if (\"SUCCESS\" === data.code) {\n                        logger.i(\"Info loaded successful\");\n                        var numOfDecimals = data.returnobject;\n                        $(\"#numofdecimals\").val(numOfDecimals);\n                    } else {\n                        alertify.error(data.message);\n                    }\n                }); //done \n\n                //------------------\n                ubi.loader.blocking.stop();\n            }\n        });\n\n        //-----2 Event-----------\n        $(\"#vac\").change(function () {\n            let vac = $(\"#vac\").val();\n            if (vac !== 0 && vac !== undefined && vac !== '') {\n                // Country\n                ubi.loader.blocking.start();\n                //-------1st call\n                $.get({\n                    url: \"/api/v1/vac/\" + vac + \"/exchangerate\",\n                    contentType: \"application/json; charset=utf-8\"\n                }).done(function (data, status, xhr) {\n                    if (\"SUCCESS\" === data.code) {\n                        logger.i(\"Info loaded successful\");\n                        var ret = data.returnobject;\n                        $(\"#exchangerate\").val(ret);\n                    } else {\n                        alertify.error(data.message);\n                    }\n                }); //done---1st call                                \n\n                //------------------\n                ubi.loader.blocking.stop();\n            }\n        });\n\n        //-----3 Event-----------\n        //OnChange of duration\n        $('#isgratis').on('change', function (event) {\n            var target = event.target;\n            var isgratis = target.value;\n            if (isgratis === 'true') {\n                $(\"#costineuro\").val(0);\n                $(\"#costinlocal\").val(0);\n            }\n        });\n\n        //-----4 Event-----------\n        $('#costinlocal').on('change', function (event) {\n            var target = event.target;\n            var cost = target.value;\n            var rate = document.getElementById('exchangerate').value;\n            var declarebase = $(\"#declarebase :selected\").val();  // declarebase==true (local)     declarebase==false (ref)                  \n            console.log(cost, rate, declarebase);\n            if (declarebase === 'true') {\n                if (rate !== '' && rate !== '0') {      //TODO den fortonetai to rate                    \n                    $(\"#costinref\").val((cost / rate).toFixed(2));\n                    $.each($(\"input#offeringvaccost\"), function () {\n                        $(this).val(cost);\n                    });\n                }\n            }\n\n        });\n\n        //-----5 Event-----------\n        $('#costinref').on('change', function (event) {\n            var target = event.target;\n            var cost = target.value;\n            var rate = document.getElementById('exchangerate').value;\n            var declarebase = $(\"#declarebase :selected\").val();    // declarebase==true (local)     declarebase==false (ref)\n//            alert(declarebase);                     \n            console.log(cost, rate, declarebase);\n            if (declarebase === 'false')\n                if (rate !== '' && rate !== '0') {\n                    var numOfDecimals = 2;\n                    if ($('#numofdecimals').length){\n                        numOfDecimals = $('#numofdecimals').val();\n                    }\n                    $(\"#costinlocal\").val((cost * rate).toFixed(numOfDecimals));\n                    $.each($(\"input#offeringvaccost\"), function () {\n                        $(this).val(cost);\n                    });                    \n                }\n        });\n\n        //----- Event-----------\n        $('#root').on('change', function (event) {\n            var target = event.target;\n            var root = target.value;\n            if (root === 'true'){\n//                $('#divvac').addClass(\"hidden\");\n//                $('#divconsulate').addClass(\"hidden\");\n\n                $(\"#vac option[selected]\").removeAttr(\"selected\");  \n                $(\"#vac\")[0].selectedIndex = 0;\n                $(\"#vac\").prop( \"disabled\", true );\n                $(\"#vac\").prop( \"required\", false );\n                $(\"#vac\").trigger('change'); \n                $(\"#divvac\").removeClass(\"required\");\n                \n                \n                $(\"#consulate option[selected]\").removeAttr(\"selected\");  \n                $(\"#consulate\")[0].selectedIndex = 0;\n                $(\"#consulate\").prop( \"disabled\", true );\n                $(\"#consulate\").prop( \"required\", false );\n                $(\"#consulate\").trigger('change'); \n                $(\"#divconsulate\").removeClass(\"required\");\n            }\n            else {\n//                $('#divvac').removeClass(\"hidden\");\n//                $('#divconsulate').removeClass(\"hidden\");\n                $(\"#vac\").prop( \"disabled\", false );\n                $(\"#vac\").prop( \"required\", true );\n                $(\"#divvac\").addClass(\"required\");\n                $(\"#consulate\").prop( \"disabled\", false );\n            }\n        });\n        \n        $('#consulate').on('change', function (event) { \n            var target = event.target;           \n            var consulate = target.value;            \n            if (consulate !== ''){\n                $(\"#vac option[selected]\").removeAttr(\"selected\");  \n                $(\"#vac\")[0].selectedIndex = 0;\n                $(\"#vac\").prop( \"disabled\", true );\n                $(\"#vac\").prop( \"required\", false );\n                $(\"#divvac\").removeClass(\"required\");\n                $(\"#vac\").trigger('change'); \n            }\n            else if (!$(\"#consulate\").prop( \"disabled\")){\n                $(\"#vac\").prop( \"disabled\", false );    \n                \n                $(\"#vac\").prop( \"required\", true );\n                $(\"#divvac\").addClass(\"required\");\n                \n                $(\"#consulate\").prop( \"required\", false );\n                $(\"#divconsulate\").removeClass(\"required\");\n            }\n        });\n        \n        $('#vac').on('change', function (event) { \n            var target = event.target;           \n            var vac = target.value;            \n            if (vac !== ''){\n                $(\"#consulate\").prop( \"required\", false );\n                $(\"#divconsulate\").removeClass(\"required\");\n            }  \n            else if (!$(\"#vac\").prop( \"disabled\")){\n                $(\"#consulate\").prop( \"required\", true );\n                $(\"#divconsulate\").addClass(\"required\");\n                \n                $(\"#vac\").prop( \"required\", false );\n                $(\"#divvac\").removeClass(\"required\");\n            }\n        });\n\n        //-----Event-----------\n        $('#declarebase').on('change', function (event) {\n            var target = event.target;\n            var declarebase = target.value;\n            console.log(declarebase);\n            if (declarebase === 'true') {     //local\n                $(\"#costinlocal\").prop(\"disabled\", false);\n                $(\"#costinref\").prop(\"disabled\", true);\n            } else {    //ref\n                $(\"#costinref\").prop(\"disabled\", false);\n                $(\"#costinlocal\").prop(\"disabled\", true);\n            }\n        });\n        select2Vas();\n\n    }//EoM \n    \n     function select2Vas(){        \n        $(\"#vas\").select2({\n            matcher: matchStart,\n        });\n        \n        $(\"#country\").change(function () {\n            varcommon.loadVacByCountry();\n        });        \n        \n    }//EoM loadSearch\n \n    \n    function matchStart(params, data){        \n        \n        if (typeof params.term === 'undefined'){\n\t    return data;\n\t}\n        \n        \n\tif (data.text.toUpperCase().indexOf(params.term.toUpperCase()) > -1 ||\n            ($(data.element).attr(\"label\")!=='' && typeof $(data.element).attr(\"label\") !== 'undefined' && $(data.element).attr(\"label\").toUpperCase().indexOf(params.term.toUpperCase()) > -1)||\n            ($(data.element).attr(\"title\")!=='' && typeof $(data.element).attr(\"title\") !== 'undefined' && $(data.element).attr(\"title\").toUpperCase().indexOf(params.term.toUpperCase()) > -1)\n\t ){    \n\t    var modifiedData = $.extend({}, data, true);\n\t    return modifiedData;\n\t }\n         \n\tvar modifiedData = $.extend(modifiedData, data, true);\n\tvar currChildrenArray = [];\n\t$.each(data.children, function(index, elem){\n\t        if(elem.text.toUpperCase().indexOf(params.term.toUpperCase()) > -1){\n\t\t       currChildrenArray.push(elem);\n\t         }\n\t  });\n\tif(currChildrenArray.length > 0){\n\t\tmodifiedData.children = currChildrenArray;\n\t\treturn modifiedData;\n\t}\n\treturn null;\n    }\n\n    router.addRoutePost('vasoffering', select2Vas);\n    router.addRoutePost('vasoffering/:id', onEventsForVasOffering);\n\n})();\n\n/**\n * Define country routing pages\n */\n\n(function() {\n\n    'use strict';\n\n    router.addRoutePost('country');\n    router.addRoutePost('country/:id');\n\n})();\n\n/**\n * Define cryptographic key routing pages\n */\n\n(function() {\n\n    'use strict';\n\n    router.addRoutePost('cryptographickey');\n    router.addRoutePost('cryptographickey/:id');\n\n})();\n\n/**\n * Define city routing pages\n */\n\n(function () {\n\n  'use strict';\n\n  router.addRoutePost('translation');\n  router.addRoutePost('translation/:id');\n\n})();\n\n/**\n * Define city routing pages\n */\n\n(function () {\n\n  'use strict';\n\n  function generateToken(data, textStatus, jqXHR){\n        if (textStatus.toUpperCase() == \"SUCCESS\" && (data == \"\" || data === undefined || data.code.toUpperCase() === \"SUCCESS\")) {              \n            $('#mastertoken').val(data.returnobject);            \n        }\n  }\n  \n  function generatePortalToken(data, textStatus, jqXHR){\n        if (textStatus.toUpperCase() == \"SUCCESS\" && (data == \"\" || data === undefined || data.code.toUpperCase() === \"SUCCESS\")) {              \n            $('#masterportaltoken').val(data.returnobject);            \n        }\n  }\n  \n  function copyToClipboard(mastertokenname) {\n      var copyText = document.getElementById(mastertokenname);\n      copyText.select();\n      copyText.setSelectionRange(0, 99999)\n      document.execCommand(\"copy\");      \n  }\n    \n  router.addRoutePost('generalconfig');\n  router.addRoutePost('generalconfig/:id');\n  router.addRoutePost('configoffline');\n\n  window.generateToken = generateToken;\n  window.generatePortalToken = generatePortalToken;\n  window.copyToClipboard = copyToClipboard;\n})();\n \n/**\n * Define routing\n */\n\n(function () {\n    'use strict';\n\n    function onEventsForExchangerate() {\n        //------------1\n        $(\"#country\").change(function () {\n            let country = $(\"#country\").val();\n            if (country !== 0 && country !== undefined && country !== '') {\n                // Country\n                ubi.loader.blocking.start();\n                $.get({\n                    url: \"/api/v1/country/\" + country + \"/vac\",\n                    contentType: \"application/json; charset=utf-8\"\n                }).done(function (data, status, xhr) {\n                    if (\"SUCCESS\" === data.code) {\n                        logger.i(\"Info loaded successful\");\n                        //$(\"#vac\").removeAttr(\"disabled\");\n                        var array = data.returnobject;\n                        var htmlVar = \"\";\n                        htmlVar += '<option value=\"\"></option>'\n                        for (var i = 0; i < array.length; i++) {\n                            htmlVar += '<option value=\"' + array[i].id + '\">'\n                                    + array[i].shortname\n                                    + '</option>';\n                        }\n                        $(\"#vac\").html(htmlVar);\n                    } else {\n                        alertify.error(data.message);\n                    }\n                }); //done\n                //-------------\n                //Get currency\n                $.get({\n                    url: \"/api/v1/country/\" + country + \"/currencies\",\n                    contentType: \"application/json; charset=utf-8\"\n                }).done(function (data, status, xhr) {\n                    if (\"SUCCESS\" === data.code) {\n                        logger.i(\"Info loaded successful\");\n                        //$(\"#vac\").removeAttr(\"disabled\");\n                        var ret = data.returnobject;\n                        $(\"#currencyspan\").text(ret[0]);\n                        $(\"#excelcurrencyspan\").text(ret[1]);\n                        if (ret[0]!==ret[1]){\n                            $(\"#excelratespan\").removeClass(\"hidden\");\n                        }else{\n                            $(\"#excelratespan\").addClass(\"hidden\");\n                        }\n                        let ratePattern = ret[2];\n                        let rateMessage = ret[3];\n                                                \n                        $('#rate').attr('pattern', ratePattern);\n                        $('#rate').attr('data-parsley-pattern-message', rateMessage);\n                        \n                        $('#excelrate').attr('pattern', ratePattern);\n                        $('#excelrate').attr('data-parsley-pattern-message', rateMessage);\n                    } else {\n                        alertify.error(data.message);\n                    }\n                }); //done       \n\n                //------------------\n                ubi.loader.blocking.stop();\n            }\n        });\n        \n        $(\"#countryrepresentative\").change(function () {            \n            if ($(\"#countryrepresentative\").val() === 'true'){\n                $(\"#vac option[selected]\").removeAttr(\"selected\");  \n                $(\"#vac\")[0].selectedIndex = 0;\n                $(\"#vac\").trigger('change'); \n                $(\"#vac\").prop( \"disabled\", true );\n            }else{                \n                $(\"#vac\").prop( \"disabled\", false );\n            }\n            \n        });\n\n    }//EoM \n\n    function loadSearch() {\n                \n        $(\"#country\").change(function () {\n            varcommon.loadVacByCountry();\n        });        \n        \n    }//EoM loadSearch\n    \n    router.addRoutePost('exchangerate', loadSearch);\n    router.addRoutePost('exchangerate/:id', onEventsForExchangerate);\n\n})();\n\n/**\n * Define routing\n */\n\n(function () {\n    'use strict';\n\n    function onEventsForExchangerateplan() {\n        //------------1\n        $('#rate').on('input', function () {\n            let rate = $('#rate').val();\n            $.each( $(\"input#exchangerateplanvacrate.unlocked\") , function(){\n              $(this).val(rate);\n            });\n        });\n\n        $('#activefrom').on('change', function () {\n            let activefrom = $('#activefrom').val();\n            $.each( $(\"input#exchangerateplanvacdate\") , function(){\n              $(this).val(activefrom); \n            });\n        });\n        \n        $('#exchangerateplanvaclocked').change( function () {\n            let locked = $('#exchangerateplanvaclocked').val();\n            alert(locked);\n        });\n        //------------------2\n        $(\"#country\").change(function () {\n            let country = $(\"#country\").val();\n            if (country !== 0 && country !== undefined && country !== '') {\n                // Country\n                ubi.loader.blocking.start();\n                //-------------\n                //Get currency\n                $.get({\n                    url: \"/api/v1/country/\" + country + \"/currencies\",\n                    contentType: \"application/json; charset=utf-8\"\n                }).done(function (data, status, xhr) {\n                    if (\"SUCCESS\" === data.code) {\n                        logger.i(\"Info loaded successful\");\n                        $(\"#vac\").removeAttr(\"disabled\");\n                        var ret = data.returnobject;\n                        \n                        $(\"#currencyspan\").text(ret[0]);\n                        $(\"#excelcurrencyspan\").text(ret[1]);\n                        if (ret[0]!==ret[1]){\n                            $(\"#excelratespan\").removeClass(\"hidden\");\n                            $(\"#excelrateth\").removeClass(\"hidden\");   \n                            $( \"td[id^='excelratetd']\" ).removeClass(\"hidden\");                         \n                        }else{\n                            $(\"#excelratespan\").addClass(\"hidden\");\n                            $(\"#excelrateth\").addClass(\"hidden\");   \n                            $( \"td[id^='excelratetd']\" ).addClass(\"hidden\");  \n                        }\n                        let ratePattern = ret[2];\n                        let rateMessage = ret[3];\n                                                \n                        $('#rate').attr('pattern', ratePattern);\n                        $('#rate').attr('data-parsley-pattern-message', rateMessage);\n                        \n                        $('#excelrate').attr('pattern', ratePattern);\n                        $('#excelrate').attr('data-parsley-pattern-message', rateMessage);\n                    } else {\n                        alertify.error(data.message);\n                    }\n                }); //done       \n\n                //------------------\n                ubi.loader.blocking.stop();\n            }\n        });        \n        \n    }//EoM \n    \n    function forceApply(data, textStatus, jqXHR){\n        if (textStatus.toUpperCase() == \"SUCCESS\") {                  \n            if (data.code === \"EXCEPTION\"){\n              $('#btn-apply-exchangerateplan').addClass(\"hidden\")\n              $('#btn-force-exchangerateplan').removeClass(\"hidden\")\n            }\n            \n        }\n    }\n        \n    router.addRoutePost('exchangerateplan');\n    router.addRoutePost('exchangerateplan/:id', onEventsForExchangerateplan);\n    router.addRoutePost('exchangerateplan/apply/:id');\n    \n    window.forceApply = forceApply;\n\n})();\n\n/**\n * Define consulate routing pages\n */\n\n(function () {\n\n  'use strict';\n\n  function onChangeCountry() {\n\n    $(\"#country\").change(function () {\n      let country = $(\"#country\").val();\n      if (country !== 0 && country !== undefined && country !== '') {\n        // Country\n        ubi.loader.blocking.start();\n\n        // send request to populate cities list\n        $.get({\n          url: \"/api/v1/country/\" + country + \"/city\",\n          contentType: \"application/json; charset=utf-8\"\n        }).done(function (data, status, xhr) {\n          if (\"SUCCESS\" === data.code) {\n            logger.i(\"Cities loaded successful\");\n            $(\"#city\").removeAttr(\"disabled\");\n            var array = data.returnobject;\n            var htmlVar = \"\";\n            for (var i = 0; i < array.length; i++) {\n              htmlVar += '<option value=\"' + array[i].id + '\">'\n                  + array[i].name\n                  + '</option>';\n            }\n            $(\"#city\").html(htmlVar);\n\n          } else {\n            alertify.error(data.message);\n          }\n          ubi.loader.blocking.stop();\n        });\n\n        // send request to populate travel agents list\n        $.get({\n          url: \"/api/v1/country/\" + country + \"/travelagent\",\n          contentType: \"application/json; charset=utf-8\"\n        }).done(function (data, status, xhr) {\n          if (\"SUCCESS\" === data.code) {\n            logger.i(\"TAs loaded successful\");\n            $(\"#travelagents\").removeAttr(\"disabled\");\n            var array = data.returnobject;\n            var htmlVar = \"\";\n            for (var i = 0; i < array.length; i++) {\n              htmlVar += '<option value=\"' + array[i].id + '\">'\n                  + array[i].name\n                  + '</option>';\n            }\n            $(\"#travelagents\").html(htmlVar);\n\n          } else {\n            alertify.error(data.message);\n          }\n          ubi.loader.blocking.stop();\n        });\n      }\n    });\n    \n  }\n\n  router.addRoutePost('consulate');\n  router.addRoutePost('consulate/:id', onChangeCountry);\n\n})();\n\n\n/**\n * Define notification crawl routing pages\n */\n\n(function () {\n\n    'use strict';\n\n    router.addRoutePost('uploadvarsbatch');\n\n})();\n/**\n * Define group routing pages\n */\n\n(function () {\n\n    'use strict';\n    \n\n    function onGroupSelect() {\n        //----- Event-----------\n        $('#grouptype').on('change', function (event) {\n            var seln = $('#grouptype :selected').text();\n            //hide or show respectively\n            if (seln === 'TRAVEL AGENCY' || seln === 'TRAVEL AGENCY FAMILY' || seln === 'TRAVEL AGENCY TRAVELLERS') {\n                $('#divgroupname').addClass('hidden');\n                $('#name').attr('required', false);\n                $('#divtravelagent').removeClass('hidden');\n                $('#travelagent').val(null).change();\n                $('#travelagent').attr('required', true);\n            } else {\n                $('#divtravelagent').addClass('hidden');\n                $('#travelagent').attr('required', false);\n                $('#divgroupname').removeClass('hidden');\n                $('#name').val(seln).change();\n                $('#name').attr('required', true);\n            }\n        });\n    }\n\n    var multiCheck = function (chkbx) {\n        var status = chkbx.checked;\n        $('.varcheckbox').each(function() {\n            this.checked=status;\n        });\n        singleCheck();\n    };\n\n    var singleCheck = function(chkbx) {\n        //uncheck 'select all', if one of the listed checkbox item is unchecked\n        if(false == $(chkbx).prop('checked')){ //if this item is unchecked\n            $('#select_all').prop('checked', false); //change 'select all' checked status to false\n        }\n        //check 'select all' if all checkbox items are checked\n        if ($('.varcheckbox:checked').length == $('.varcheckbox').length ){\n            $('#select_all').prop('checked', true);\n        }\n\n        // disable/enable the button\n        if ($('.varcheckbox:checked').length) {\n            // $('#btn-multiremove-up').attr('disabled', false);\n            // $('#btn-multiremove-down').attr('disabled', false);\n            // $('#btn-multiadd-up').attr('disabled', false);\n            // $('#btn-multiadd-down').attr('disabled', false);\n            $('.multicheck').attr('disabled', false);\n        } else {\n            // $('#btn-multiremove-up').attr('disabled', true);\n            // $('#btn-multiremove-down').attr('disabled', true);\n            // $('#btn-multiadd-up').attr('disabled', true);\n            // $('#btn-multiadd-down').attr('disabled', true);\n            $('.multicheck').attr('disabled', true);\n        }\n    };\n\n    function loadSearch() {\n        $(\"#travelagent\").change(function () {\n            varcommon.loadTravelAgent();\n        });\n        $( document ).ready(function() {\n            //$(\"#application\").focus();\n            //$( \"#application\" ).focus().focus();\n            setTimeout(function() { $( \"#name\" ).focus() }, 300);\n        });\n    }//EoM loadSearch\n\n\n\n\n    function onPrepareExport() {\n        console.log(\"test labels\");\n        //create drop up buttons\n        focusSearch();\n        $(\"#btn-labels\").click(function () {\n            console.log(\"click\");\n            var dropupMenuID = \"#\"+this.id+\"-myDropup\";\n            var dropupMenu = $(dropupMenuID);\n            $(\".dropup-content\").not(dropupMenuID).hide();\n            dropupMenu.toggle( \"slow\", function() {\n                // Animation complete.\n            });\n\n            // on click of the document, close the menus\n            $(document).one(\"click\", function () {\n                //menu.hide();\n                dropupMenu.hide();\n            });\n            return false;\n        });\n    }//EoM\n\n    function focusSearch() {\n        $( document ).ready(function() {\n            //$(\"#application\").focus();\n            //$( \"#application\" ).focus().focus();\n            setTimeout(function() { $( \"#application\" ).focus() }, 300);\n        });\n    }\n\n    router.addRoutePost('group/add', onGroupSelect);\n    router.addRoutePost('group/:id', onPrepareExport);\n    router.addRoutePost('group/:id/add', focusSearch);\n    router.addRoutePost('group', loadSearch);\n\n    window.multiCheck = multiCheck;\n    window.singleCheck = singleCheck;\n\n})();\n\n/**\n * Define city routing pages\n */\n\n(function () {\n\n  'use strict';\n\n  router.addRoutePost('city');\n  router.addRoutePost('city/:id');\n\n})();\n\n/**\n * Define public holiday routing pages\n */\n\n(function () {\n\n  'use strict';\n\n  router.addRoutePost('publicholiday');\n  router.addRoutePost('publicholiday/:id');\n\n})();\n\n/**\n * Define vac holiday routing pages\n */\n\n(function () {\n\n    'use strict';\n\n    router.addRoutePost('vacholiday');\n    router.addRoutePost('vacholiday/:id');\n\n})();\n\n/**\n * Define travel agent routing pages\n */\n\n(function () {\n\n  'use strict';\n\n  router.addRoutePost('travelagent');\n  router.addRoutePost('travelagent/:id');\n\n})();\n\n/**\n * Define contractor routing pages\n */\n\n(function () {\n\n  'use strict';\n\n  router.addRoutePost('contractor');\n  router.addRoutePost('contractor/:id');\n\n})();\n\n/**\n * Define vac routing pages\n */\n\n(function () {\n\n    'use strict';\n\n    function onChangeFields() {\n\n        $(\"#country\").change(function () {\n            let country = $(\"#country\").val();\n            if (country !== 0 && country !== undefined && country !== '') {\n                // Country\n                ubi.loader.blocking.start();\n                //1\n                $.get({\n                    url: \"/api/v1/country/\" + country + \"/city\",\n                    contentType: \"application/json; charset=utf-8\"\n                }).done(function (data, status, xhr) {\n                    if (\"SUCCESS\" === data.code) {\n                        $(\"#city\").removeAttr(\"disabled\");\n                        var array = data.returnobject;\n                        var htmlVar = \"\";\n                        for (var i = 0; i < array.length; i++) {\n                            htmlVar += '<option value=\"' + array[i].id + '\">'\n                                    + array[i].name\n                                    + '</option>';\n                        }\n                        $(\"#city\").html(htmlVar);\n                    } else {\n                        alertify.error(data.message);\n                    }\n                });\n                //2\n                $.get({\n                    url: \"/api/v1/country/\" + country + \"/consulate\",\n                    contentType: \"application/json; charset=utf-8\"\n                }).done(function (data, status, xhr) {\n                    if (\"SUCCESS\" === data.code) {\n                        $(\"#consulate\").removeAttr(\"disabled\");\n                        var array = data.returnobject;\n                        var htmlVar = \"\";\n                        for (var i = 0; i < array.length; i++) {\n                            htmlVar += '<option value=\"' + array[i].id + '\">'\n                                    + array[i].name\n                                    + '</option>';\n                        }\n                        $(\"#consulate\").html(htmlVar);\n                    } else {\n                        alertify.error(data.message);\n                    }\n                });\n                //3\n                $.get({\n                    url: \"/api/v1/country/\" + country + \"/vaccode\",\n                    contentType: \"application/json; charset=utf-8\"\n                }).done(function (data, status, xhr) {\n                    if (\"SUCCESS\" === data.code) {\n                        $(\"#code\").val(data.returnobject);\n                    } else {\n                        alertify.error(data.message);\n                    }\n                }); \n                ubi.loader.blocking.stop();\n                                            \n            }\n        });\n\n        $(\"#iscentral\").change(function () {\n            let iscentral = $(\"#iscentral\").val();\n            if (iscentral !== undefined && iscentral !== '') {\n                // Country\n                ubi.loader.blocking.start();\n                if (iscentral === 'true') {\n                    $(\"#parentvac\").prop('disabled', 'disabled');\n                } else {\n                    $(\"#parentvac\").removeAttr(\"disabled\");\n                }\n                ubi.loader.blocking.stop();\n            }\n        });\n\n    }//onChangeFields\n\n    router.addRoutePost('vac');\n    router.addRoutePost('vac/:id', onChangeFields);\n\n}\n\n)();\n\n/**\n * Define notification crawl routing pages\n */\n\n(function () {\n\n  'use strict';\n    \n  \n  var assignVac = function ($this, varID) {\n        var $this = $($this);\n     \n        ubi.loader.blocking.start();\n        \n        $.ajax({\n           url: \"/api/v1/var/\"  + varID+\"/assign\",\n            type: 'POST'\n          }).done(function (data, textStatus, jqXHR) {\n            if (\"SUCCESS\" === data.code) {\n                page('/visa-request/' + varID); \n            }\n          });\n\n\n  };\n  var qualityControl = function ($this, varID) {\n        var $this = $($this);\n\n      alertify.confirm(ubi.getTranslationExt('frontend.message.qc.title'), ubi.getTranslationExt('frontend.message.qc.message'),\n          function (){\n              ubi.loader.blocking.start();\n\n              $.ajax({\n                  url: \"/api/v1/var/\"  + varID+\"/qualitycontrol\",\n                  type: 'POST'\n              }).done(function (data, textStatus, jqXHR) {\n                  if (\"SUCCESS\" === data.code) {\n                      page('/visa-request/');\n                  }\n              });},\n          function(){\n          }\n      ).set({\n          labels: {ok: ubi.getTranslationExt('frontend.message.qc.submit'), cancel: ubi.getTranslationExt('frontend.message.qc.cancel')},\n          reverseButtons: true,\n          transition: 'fade'\n      });\n\n  };\n  \n  function openclient($this){\n      //console.log($this);\n       var $this = $($this);\n       \n       var API_URL;\n        if ($this.attr('data-submit') !== undefined && $this.attr('data-submit')\n            != \"\" && $this.attr('data-submit') != null) {\n          API_URL = ubi.API_URL_PREFIX + $this.attr('data-submit');\n        } else {\n          throw new TypeError(\"'data-submit' attribute couldn't be found.\");\n        }\n     \n      console.log(API_URL);  \n        $.ajax({\n           url: API_URL,\n           type: 'PUT'\n          }).done(function (data, textStatus, jqXHR) {\n            console.log(data);\n          });\n      \n  }\n\n\n    function previewPhoto(input) {\n        var $btn = $('#btn-photoupload');\n        $btn.attr('disabled', true);\n        $('#uploadComment').css('visibility', 'visible');\n        if (!window.FileReader) {\n            alertify.error(ubi.getTranslationExt(\"frontend.message.error.6\")); // \"The file API isn't supported on this browser yet.\"\n            return;\n        }\n\n        var error = false;\n        input = document.getElementById('photofile');\n        if (!input) {\n            alertify.error(ubi.getTranslationExt(\"frontend.message.error.7\")); // \"Couldn't find the fileinput element.\"\n        } else if (!input.files) {\n            alertify.error(ubi.getTranslationExt(\"frontend.message.error.8\")); // \"This browser doesn't seem to support the `files` property of file inputs.\"\n        } else if (!input.files[0]) {\n            alertify.error(ubi.getTranslationExt(\"frontend.message.error.9\")); // \"Please select a file before clicking 'Load'\"\n        } else {\n            var file = input.files[0];\n            console.log(file);\n            // commented by aferoukas: image should be uploaded and resized on server\n            // if (file.size > 100*1024) { // max 100 KB\n            //     alertify.error( \"Image file should not exceed 100KB in size.\");\n            //     error = true;\n            // }\n            if (file.type != 'image/jpeg') {\n                alertify.error(ubi.getTranslationExt(\"frontend.message.error.10\")); // \"Please ensure that the photo is in .JPG/.JPEG format\"\n                error = true;\n            }\n            if (!error) {\n                var reader = new FileReader();\n\n                reader.onload = function (e) {\n                    $('#photo')\n                        .attr('src', e.target.result);\n                };\n                reader.readAsDataURL(input.files[0]);\n\n                $btn.attr('disabled', false);\n            }\n        }\n    }\n\n    function savebiometriccomments() {\n        var $btn = $('#btn-savebiocomments');\n        var API_URL = ubi.API_URL_PREFIX + $btn.attr('data-submit');\n\n        var reqData = new FormData();\n        reqData.append('fingerprintscomment', $('#fingerprintscomment').val());\n        reqData.append('photocomment', $('#photocomment').val());\n\n        $btn.addClass('loading');\n\n        $.ajax({\n            type: 'POST',\n            data: reqData,\n            url: API_URL,\n            processData: false,\n            contentType: false\n        }).done(function (data, textStatus, jqXHR) {\n            if (textStatus.toUpperCase() == \"SUCCESS\" && data.code.toUpperCase() === \"SUCCESS\") {\n                alertify.success(data.message);\n            }\n            if (textStatus.toUpperCase() == \"SUCCESS\" && data.code.toUpperCase() === \"INVALID\") {\n                alertify.error(data.message);\n            }\n            $btn.removeClass('loading');\n            \n            var redirect = $btn.attr('data-redirect');\n            var redirectURL = redirect;\n            \n        \n            // Redirection\n            if (window.location.search.indexOf('redirect=') !== -1) {\n              window.history.back();\n            } else {\n             redirectURL != \"stay\" ? page(redirectURL) : null;\n            }\n        }).error(function (data, textStatus, jqXHR) {\n            logger.e(textStatus);\n            logger.e(data);\n            alertify.error(ubi.getTranslationExt(\"frontend.message.error.5\")); // \"Please contact the system administrator\"\n\n            $btn.removeClass('loading');\n        });\n    }\n\n    function uploadPhoto() {\n        var input = document.getElementById('photofile');\n        var $btn = $('#btn-photoupload');\n        previewPhoto(input);\n        var file = input.files[0];\n\n        var reqData = new FormData();\n        reqData.append('photo', file);\n        \n        reqData.append('fingerprintscomment', $('#fingerprintscomment').val());\n        reqData.append('photocomment', $('#photocomment').val());\n\n        $btn.addClass('loading');\n\n        var API_URL = ubi.API_URL_PREFIX + $btn.attr('data-submit');\n        var redirect = $btn.attr('data-redirect');\n\n        $.ajax({\n            type: 'POST',\n            data: reqData,\n            url: API_URL,\n            processData: false,\n            contentType: false\n        }).done(function (data, textStatus, jqXHR) {\n            if (textStatus.toUpperCase() == \"SUCCESS\" && data.code.toUpperCase() === \"SUCCESS\") {\n                alertify.success(data.message);\n            }\n            if (textStatus.toUpperCase() == \"SUCCESS\" && data.code.toUpperCase() === \"INVALID\") {\n                alertify.error(data.message);\n            }\n            $btn.removeClass('loading');\n            \n            var redirect = $btn.attr('data-redirect');\n            var redirectURL = redirect;\n            \n        \n            // Redirection\n            if (window.location.search.indexOf('redirect=') !== -1) {\n              window.history.back();\n            } else {\n             redirectURL != \"stay\" ? page(redirectURL) : null;\n            }\n                        \n        }).error(function (data, textStatus, jqXHR) {\n            logger.e(textStatus);\n            logger.e(data);\n            alertify.error(ubi.getTranslationExt(\"frontend.message.error.5\")); // \"Please contact the system administrator\"\n\n            $btn.removeClass('loading');\n        });\n       // savebiometriccomments();\n    }\n\n    function retrieveCurrentPhoto() {\n        // var input = document.getElementById('photofile');\n        var $btn = $('#btn-photopreview');\n        var API_URL = ubi.API_URL_PREFIX + $btn.attr('data-submit');\n\n        $.ajax({\n            type: 'GET',\n            url: API_URL,\n            processData: false,\n            contentType: false\n        }).done( function (data, textStatus, jqXHR) {\n            console.log(\"Status: \" + textStatus + \", code: \" + jqXHR.status);\n            $(\"#photodiv\").html('<img id=\"photo\" src=\"data:image/jpg;base64,' + data + '\" />');\n            // $('#photofile').attr('src', \"data:image/jpg;base64,' + data + '\");\n        }).error(function (data, textStatus, jqXHR) {\n            console.log(\"Status: \" + textStatus + \", code: \" + jqXHR.status);\n            alertify.error(\"No photo exists for this application\")\n            $(\"#photodiv\").html('<img id=\"photo\" src=\"/dist/images/photo.jpg\" />');\n        });\n    }\n    \n    \n    function updateCourNum() {\n        let courNum = $(\"#couriernumber\").val();\n        let appId = $(\"#application\").val();\n\n        $.ajax({\n            type: 'POST',\n            url: \"/api/v1/var/updateCourNum/\"+courNum+\"/\"+appId,\n            processData: false,\n            contentType: false\n        }).done(function (data, textStatus, jqXHR) {\n            if (textStatus.toUpperCase() === \"SUCCESS\" && data.code.toUpperCase() === \"SUCCESS\") {\n                alertify.success(data.message);\n            }else{\n                alertify.error(data.message);\n            }\n        }).error(function (data, textStatus, jqXHR) {\n            alertify.error(data.message);\n        });\n    }\n    \n    function loadSearch() {\n                \n        $(\"#travelagent\").change(function () {\n            varcommon.loadTravelAgent();\n        });\n        $( document ).ready(function() {\n            //$(\"#application\").focus();\n            //$( \"#application\" ).focus().focus();\n            setTimeout(function() { $( \"#application\" ).focus() }, 300);\n        });\n        \n    }//EoM loadSearch\n\n    \n    function appendFilterVarTrackSearch(btn) {\n        if (event.keyCode == 13) {\n          filterVarTrack($(\"#\"+btn));\n        }\n      }\n      \n    function filterVarTrack($this) {\n        var application = $(\"#application\").val();\n        /*08/11/2021\n         * changed by Apostolos Dateofbirth to traveldocumentnumber*/\n        //var dateofbirth = $(\"#dateofbirth\").val();        \n        var traveldocumentnumber = $(\"#traveldocumentnumber\").val();        \n        if (traveldocumentnumber !== undefined && traveldocumentnumber !== ''\n                && application !== undefined && application !== '') {          \n          //var matched = dateofbirth.match(/^(0?[1-9]|[12][0-9]|3[01])[\\/](0?[1-9]|1[012])[\\/]\\d{4}$/g);          \n          var matched = \"ok\";\n          if (matched === null) {\n              alertify.error(ubi.getTranslationExt(\"frontend.message.error.13\"), 10); //\"Date should be in the format DD/MM/YYYY\"\n              return;\n          }  else{\n            tb.filter($this);\n          }\n        }else{\n          alertify.error(ubi.getTranslationExt(\"frontend.message.error.12\"), 10); //\"All fields are required!\"\n          return;\n        }     \n        \n    }//EoM filterVarTrack\n    \n    function loadVarListPage(){\n      loadSearch();\n      ubi.loadDotTag();\n    }\n    \n  router.addRoutePost('visa-request', loadVarListPage);\n  router.addRoutePost('visa-request/result/:id');\n  router.addRoutePost('visa-request/track');\n  router.addRoutePost('visa-request/submitted', loadSearch);\n  router.addRoutePost('visa-request/group/:id/add', ubi.var.onPageLoad);\n  router.addRoutePost('visa-request/:id', ubi.var.onPageLoad);\n  router.addRoutePost('visa-request/:id/:tab', ubi.var.onPageLoad);\n  router.addRoutePost('visa-request/grouppending/:id');\n\n  window.previewPhoto = previewPhoto;\n  window.retrieveCurrentPhoto = retrieveCurrentPhoto;\n  window.uploadPhoto = uploadPhoto;\n  window.savebiometriccomments = savebiometriccomments;\n  window.openclient = openclient;\n  window.assignVac = assignVac;\n  window.qualityControl = qualityControl;\n\n  window.filterVarTrack = filterVarTrack;\n  window.appendFilterVarTrackSearch = appendFilterVarTrackSearch;\n  window.updateCourNum = updateCourNum;\n\n\n})();\n\n/**\n * Define insurance routing pages\n */\n\n(function () {\n\n  'use strict';\n\n  router.addRoutePost('insurance');\n  router.addRoutePost('insurance/:id');\n\n})();\n\n\n/**\n * Define notification crawl routing pages\n */\n\n(function () {\n\n    'use strict';\n\n    function loadSearch() {\n        $('#loaderMsg').remove();\n        $(\"#travelagent\").change(function () {\n            varcommon.loadTravelAgent();\n        });\n        \n    }//EoM loadSearch\n    \n    router.addRoutePost('varbatchexporter', loadSearch);\n\n})();\n\n/**\n * Define notification crawl routing pages\n */\n\n(function () {\n\n    'use strict';\n\n    function onloadScan(){\n        $( document ).ready(function() {\n            //$(\"#application\").focus();\n            //$( \"#application\" ).focus().focus();\n            setTimeout(function() { $( \"#appids\" ).focus() }, 300);\n        });\n    }\n\n    router.addRoutePost('varindiexporter', onloadScan);\n    \n})();\n\n/**\n * Define notification crawl routing pages\n */\n\n(function () {\n\n    'use strict';\n        \n    \n    function checkValid() {\n        $(\"#checkifvalid\").change(function () {\n            //var value = event.target.value;            \n            tb.filter($(\"#checkifvalid\"));\n        });\n        \n    }//EoM checkValid\n    \n    router.addRoutePost('varbatchvalidatorfromexcel', checkValid);\n    router.addRoutePost('varbatchvalidatorfromexcelresult', checkValid);\n    \n    \n})();\n\n/**\n * Define notification crawl routing pages\n */\n\n(function () {\n\n    'use strict';\n    \n    function validateAll(data, textStatus, jqXHR){\n        \n        if (textStatus.toUpperCase() == \"SUCCESS\" && (data == \"\" || data === undefined || data.code.toUpperCase() === \"SUCCESS\")) {\n            /*$('#btn-scan').hide();            \n            if (data.returnobject!=null){\n                $(\"[id^='statusview']\" ).text('Validated');\n            }*/\n            \n            $('#result').html('');\n            $('#listdiv').hide();\n            $('#btn-upload').hide();\n            \n            if (data && data.returnobject&&Array.isArray(data.returnobject)) {                                                 \n                        \n            var resultList = \"\";\n            var dataCount = 0;\n\n            data.returnobject.forEach(function (child) {\n                var style = \"background:#fff;color:#38aed9\";\n                if (child.errorFile===true){\n                    style = \"background:#fff;color:#FF5656;font-weight: bold;\";\n                }\n                //console.log(child.fileName);\n                //console.log(child.fileDownloadUri);\n\n                resultList += '<li style=\"margin-top:20px\"><button onclick=\"window.open(\\'/download/' + child.fileName + '/b/excels/' + child.fileDownloadUri + '\\');\" class=\"btn\" style=\"'+style+'\" form=\"uploadvarsform\">'+child.fileName+'</button></li>';\n                dataCount++;\n\n            });\n\n            $('#resultMessage').show();\n            if (dataCount>1){\n                $('#result').append('<ol style=\"margin-top:20px\">'+resultList+'</ol>');\n            }else{\n                $('#result').append('<ul style=\"margin-top:20px\">'+resultList+'</ul>');\n            }\n\n          /*  setTimeout(function () {\n                alertify.success(data.message);\n                $btn.removeClass('loading');\n            }, ubi.loader.blocking.loadingTime);*/\n        }else if (data && data.returnobject && ((typeof data.returnobject) === 'string')){\n            $('#resultMessage').show();\n            $('#result').append('<span style=\"margin-top:20px;margin-top:20px;font-weight: bold;\">'+data.returnobject+'</span>');\n        }\n            \n        }\n    }\n    \n    function loadSearch() {\n        $('#loaderMsg').remove();\n        $(\"#travelagent\").change(function () {\n            varcommon.loadTravelAgent();\n        });\n        \n    }//EoM loadSearch\n    \n    router.addRoutePost('varbatchvalidator', loadSearch);\n\n    window.validateAll = validateAll;\n})();\n\n/**\n * Define notification crawl routing pages\n */\n\n(function () {\n\n    'use strict';\n    \n    router.addRoutePost('varbatchexporterfromexcel');\n    router.addRoutePost('varbatchexporterfromexcelresult');\n\n})();\n\n/**\n * Define notification crawl routing pages\n */\n\n(function () {\n\n    'use strict';\n        \n    \n    function scanoutbatch(data, textStatus, jqXHR){\n        if (textStatus.toUpperCase() == \"SUCCESS\" && (data == \"\" || data === undefined || data.code.toUpperCase() === \"SUCCESS\")) {\n            $('#btn-scan').hide();            \n            if (data.returnobject!=null){\n                data.returnobject.forEach(function (child) {                   \n                    $(\"[id^='statusview\"+child.id+\"']\" ).text(child.value);\n\n                });                            \n            }\n            \n        }\n    }\n\n    function filterscanout($this){\n        var $this = $($this);        \n        $('#scanstatustypecode').val($this.val());\n        tb.filter($this);\n    }\n\n    function loadSearch() {\n        $(\"#travelagent\").change(function () {\n            varcommon.loadTravelAgent();\n        });\n        \n    }//EoM loadSearch\n\n    router.addRoutePost('scanoutbatch', loadSearch);\n    router.addRoutePost('scaninbatch', loadSearch);\n    \n    window.scanoutbatch = scanoutbatch;\n    window.filterscanout = filterscanout;\n    \n})();\n\n/**\n * Define notification crawl routing pages\n */\n\n(function () {\n\n    'use strict';\n        \n    \n    function scanoutindi(data, textStatus, jqXHR){\n        if (textStatus.toUpperCase() == \"SUCCESS\" && (data == \"\" || data === undefined || data.code.toUpperCase() === \"SUCCESS\")) {\n            $('#btn-scan').hide();            \n            if (data.returnobject!=null){\n                data.returnobject.forEach(function (child) {                   \n                    $(\"[id^='statusview\"+child.id+\"']\" ).text(child.value);\n\n                });                            \n            }\n            \n        }\n    }\n\n    function filterscanoutindi($this){\n        varcommon.filterMultipleAppIDs();\n        var $this = $($this);        \n        $('#scanstatustypecode').val($this.val());\n        tb.filter($this);\n    }\n\n\n    function onloadScan(){\n        $( document ).ready(function() {\n            //$(\"#application\").focus();\n            //$( \"#application\" ).focus().focus();\n            setTimeout(function() { $( \"#appids\" ).focus() }, 300);\n        });\n    }\n\n    router.addRoutePost('scanoutindi', onloadScan);\n    router.addRoutePost('scaninindi', onloadScan);\n    \n    window.scanoutindi = scanoutindi;\n    window.filterscanoutindi = filterscanoutindi;\n    \n})();\n\n/**\n * Define notification crawl routing pages\n */\n\n(function () {\n\n    'use strict';\n\n    function loadSearch() {\n        $( document ).ready(function() {\n            //$(\"#application\").focus();\n            //$( \"#application\" ).focus().focus();\n            setTimeout(function() { $( \"#application\" ).focus() }, 300);\n        });\n    }//EoM loadSearch\n\n    router.addRoutePost('scanevent', loadSearch);\n   \n    \n})();\n\n/**\n * Define notification crawl routing pages\n */\n\n(function () {\n\n    'use strict';\n\n    function loadAndPreviewPhoto() {\n        var varid = $('#id').val();\n        var API_URL = ubi.API_URL_PREFIX + \"/var/\" + varid + \"/dophotopreview\";\n\n        // todo extra checks for other users\n        $.ajax({\n            type: 'GET',\n            url: API_URL,\n            processData: false,\n            contentType: false\n        }).done( function (data, textStatus, jqXHR) {\n            console.log(\"Status: \" + textStatus + \", code: \" + jqXHR.status);\n            $(\"#photodiv\").html('<img id=\"photo\" src=\"data:image/jpg;base64,' + data + '\" />');\n            // $('#photofile').attr('src', \"data:image/jpg;base64,' + data + '\");\n        }).error(function (data, textStatus, jqXHR) {\n            console.log(\"Status: \" + textStatus + \", code: \" + jqXHR.status);\n            // alertify.error(\"No photo exists for this application\")\n            $(\"#photodiv\").html('<img id=\"photo\" src=\"/dist/images/photo.jpg\" />');\n        });\n    }\n\n    function loadSearch() {\n        $(\"#travelagent\").change(function () {\n            varcommon.loadTravelAgent();\n        });\n        $( document ).ready(function() {\n            //$(\"#application\").focus();\n            //$( \"#application\" ).focus().focus();\n            setTimeout(function() { $( \"#application\" ).focus() }, 300);\n        });\n    }//EoM loadSearch\n    \n    router.addRoutePost('biometric', loadSearch);\n    router.addRoutePost('biometric/:id', loadAndPreviewPhoto);\n    \n})();\n/**\n * Define city routing pages\n */\n\n(function () {\n\n  'use strict';  \n  \n    function passportreturn(data, textStatus, jqXHR){\n        if (textStatus.toUpperCase() == \"SUCCESS\" && (data == \"\" || data === undefined || data.code.toUpperCase() === \"SUCCESS\")) {        \n            $('#btn-scan').hide();\n            $('#btn-scan-report').hide();\n            if (data.returnobject!=null){\n              $(\"[id^='statusview']\" ).text(data.returnobject.value);\n              if (data.returnobject.data !== \"\" && data.returnobject.data !==  undefined){\n                $(\"[id^='statusview']\" ).text(data.returnobject.data.value);\n              }\n                \n            }\n         //   $('#statusview').text(data.returnobject.value);\n            \n        }\n    }\n       \n    \n    function filterpassportreturn($this){\n        varcommon.filterMultipleAppIDs();\n        var $this = $($this);        \n        $('#scanstatustypecode').val($this.val());\n        tb.filter($this);\n    }\n\n    function loadSearch() {\n        $( document ).ready(function() {\n            //$(\"#application\").focus();\n            //$( \"#application\" ).focus().focus();\n            setTimeout(function() { $( \"#application\" ).focus() }, 300);\n        });\n    }//EoM loadSearch\n\n  router.addRoutePost('passportreturn', loadSearch);\n  router.addRoutePost('passportreturn/indi', loadSearch);\n  \n  window.passportreturn = passportreturn;\n  window.filterpassportreturn = filterpassportreturn;\n  \n})();\n\n\n/**\n * Define notification crawl routing pages\n */\n\n(function () {\n\n    'use strict';\n            \n    \n    function passportreturnbatch(data, textStatus, jqXHR){\n        if (textStatus.toUpperCase() == \"SUCCESS\" && (data == \"\" || data === undefined || data.code.toUpperCase() === \"SUCCESS\")) {        \n            $('#btn-scan').hide();\n            $('#btn-scan-report').hide();\n            if (data.returnobject!=null){\n              $(\"[id^='statusview']\" ).text(data.returnobject.value);\n              if (data.returnobject.data !== \"\" && data.returnobject.data !==  undefined){\n                $(\"[id^='statusview']\" ).text(data.returnobject.data.value);\n              }\n                \n            }\n            \n        }\n    }\n\n    function filterpassportreturnbatch($this){\n        var $this = $($this);        \n        $('#scanstatustypecode').val($this.val());\n        tb.filter($this);\n    }\n\n    function loadSearch() {\n        $(\"#travelagent\").change(function () {\n            varcommon.loadTravelAgent();\n        });                \n        \n    }//EoM loadSearch\n\n    router.addRoutePost('passportreturnbatch', loadSearch);\n    \n    window.passportreturnbatch  = passportreturnbatch;\n    window.filterpassportreturnbatch = filterpassportreturnbatch;\n    \n})();\n\n\n\n(function () {\n\n    'use strict';\n\n    function passporttracking(data, textStatus, jqXHR){\n        if (textStatus.toUpperCase() == \"SUCCESS\" && (data == \"\" || data === undefined || data.code.toUpperCase() === \"SUCCESS\")) {\n            $('#btn-scan').hide();\n            $('#btn-scan-report').hide();\n            if (data.returnobject!=null){\n                $(\"[id^='statusview']\" ).text(data.returnobject.value);\n                if (data.returnobject.data !== \"\" && data.returnobject.data !==  undefined){\n                    $(\"[id^='statusview']\" ).text(data.returnobject.data.value);\n                }\n\n            }\n        }\n    }\n\n    function filterpassporttracking($this) {\n        //console.log(\"here after clicking search\");\n        tb.filter($this);\n    }\n\n\n    router.addRoutePost('passporttracking');\n    router.addRoutePost('passporttracking/:id');\n\n    window.filterpassporttracking = filterpassporttracking;\n    window.passporttracking = passporttracking;\n\n})();\n\n/**\n * Define notification crawl routing pages\n */\n\n(function () {\n\n    'use strict';\n\n    function loadSearch() {\n        $(\"#travelagent\").change(function () {\n            varcommon.loadTravelAgent();\n        });\n        $( document ).ready(function() {\n            //$(\"#application\").focus();\n            //$( \"#application\" ).focus().focus();\n            setTimeout(function() { $( \"#application\" ).focus() }, 300);\n        });\n    }//EoM loadSearch\n\n    function loadSearchBulk() {\n        $(\"#travelagent\").change(function () {\n            varcommon.loadTravelAgent();\n        });\n        $( document ).ready(function() {\n            //$(\"#application\").focus();\n            //$( \"#application\" ).focus().focus();\n            setTimeout(function() { $( \"#name\" ).focus() }, 300);\n        });\n    }//EoM loadSearch\n    \n    router.addRoutePost('payment', loadSearch);\n    router.addRoutePost('payment/group', loadSearchBulk);\n    router.addRoutePost('payment/group/:id');\n    router.addRoutePost('payment/grouppending', loadSearchBulk);\n    router.addRoutePost('payment/:id');\n    \n})();\n/**\n * Define period routing pages\n */\n\n(function () {\n\n    'use strict';\n    function loadForm() {\n        $(\"#datefrom\").change(function () {\n            var fromDate = $(\"#datefrom\").val();\n            var toDate = $(\"#dateto\").val();\n            checkDates(fromDate, toDate);\n        });\n        $(\"#dateto\").change(function () {\n            var fromDate = $(\"#datefrom\").val();\n            var toDate = $(\"#dateto\").val();\n            checkDates(fromDate, toDate);\n        });\n\n               $(\"#vac\").change(function () {\n                    let vac = $(\"#vac\").val();\n\n                    if (vac !== 0 && vac !== undefined && vac !== '') {\n                        // Vac\n                        ubi.loader.blocking.start();\n\n                        // send request to populate travel agents list\n                        $.get({\n                            url: \"/api/v1/vac/\" + vac + \"/appointmentypes\",\n                            contentType: \"application/json; charset=utf-8\"\n                        }).done(function (data, status, xhr) {\n                            if (\"SUCCESS\" === data.code) {\n                                console.log(\"Types loaded successful\");\n                                logger.i(\"Types loaded successful\");\n                                console.log(data);\n                                console.log(status);\n                                console.log(xhr);\n                                var array = data.returnobject;\n        //                        htmlAppointmenttypes += '<option value=\"\" text=\"\"></option>';\n                                var htmlAppointmenttypes = '<option value=\"\" ></option>';\n                                for (var i = 0; i < array.length; i++) {\n                                    htmlAppointmenttypes += '<option value=\"' + array[i] +'\">'\n                                    + ubi.getTranslationExt(\"frontend.message.period.type.\"+array[i])\n                                    + '</option>';\n                                }\n\n                                $(\"#type\").html(htmlAppointmenttypes);\n                            } else {\n                                alertify.error(data.message);\n                            }\n                            ubi.loader.blocking.stop();\n                        });\n                        $('#type').val('').trigger('change');\n                    }\n\n                    if (vac !== 0 && vac !== undefined && vac !== '') {\n        //                getTimezone(vac);\n                    }\n                });\n\n\n    }//EoM loadForm\n\n    function checkDates(fromDate, toDate){\n        if (fromDate !== '' && toDate !== '') {\n            if (createDateFromInput(fromDate) > createDateFromInput(toDate)) {\n                alertify.error('The \\'Date To\\' should be always foregoing');\n                return;\n            }\n        }\n    }\n\n    //Calculations\n    function createDateFromInput(input) {\n        var s = input.split('/'); //split Date of birth dd/MM/yyyy  Days = s[0] | Months = s[1] | Years = s[2]\n        //he ISO 8601 syntax (YYYY-MM-DD)\n        var newDateofFieldFormat = s[2] + '-' + s[1] + '-' + s[0];\n        var dateoffieldDate = new Date(newDateofFieldFormat);\n        dateoffieldDate.setHours(0, 0, 0, 0);\n        return dateoffieldDate;\n    }//EoM\n\n    router.addRoutePost('period');\n    router.addRoutePost('period/:id', loadForm);\n    router.addRoutePost('period/:id/availability');\n\n})();\n\n/**\r\n * Define period routing pages\r\n */\r\n\r\n(function () {\r\n\r\n    'use strict';\r\n\r\n    var amount;\r\n    var serviceAmount;\r\n    var vasAmount;\r\n    var currency;\r\n    var payment;\r\n    var refundHours;\r\n\r\n    //visa payment vars\r\n    var visaamount;\r\n    var visafeeAmount;\r\n    var visacurrency;\r\n    var visapayment;\r\n    var visarefundHours;\r\n    var commission;\r\n    var visapaymentmethod;\r\n\r\n\r\n    function onChangeSelections() {\r\n\r\n        $('#gp_dateofbirth').on('change', ubi.checkDateIsInPastIncludingNow);\r\n        $('#gp_traveldocumentvaliduntil').on('change', ubi.checkDateIsInFutureExcludingNow);\r\n\r\n        if ($(\"#id\").val() !== undefined && $(\"#id\").val()  !== '') {//edit mode\r\n            setPeriodslot();\r\n        }\r\n\r\n\r\n        $(\"#bookingfor\").change(function () {\r\n            //clear previous\r\n            clearPrevious();\r\n\r\n          let bookingfor = $(\"#bookingfor\").val();\r\n          if (bookingfor !== undefined && bookingfor !== '') {\r\n\r\n              if (bookingfor === '0'){\r\n                   $(\"#membersDiv\").removeClass(\"required\");\r\n                   $(\"#membersDiv\").addClass(\"hidden\");\r\n                   $(\"#members\").attr(\"required\" , false);\r\n                   $(\"#members\").val('1');\r\n                   //$(\"#members\").trigger('change');\r\n\r\n                   $(\"#appointmentmethodDiv\").removeClass(\"required\");\r\n                   $(\"#appointmentmethodDiv\").addClass(\"hidden\");\r\n                   $(\"#appointmentmethod\").attr(\"required\" , false);\r\n                   $(\"#appointmentmethod\").val('1');\r\n                   //$(\"#appointmentmethod\").trigger('change');\r\n                   \r\n                   for (var i=1; i<=4; i++){\r\n                    $(\"#appointmentmethodDetails\"+i).addClass(\"hidden\");\r\n                   }\r\n\r\n                   //clear attribute required for group\r\n                   $(\"tr[id^='cloned']\" ).remove();\r\n\r\n              }else{\r\n                   $(\"#membersDiv\").addClass(\"required\");\r\n                   $(\"#membersDiv\").removeClass(\"hidden\");\r\n                   $(\"#members\").attr(\"required\" , true);\r\n                   $(\"#members\").val('2');\r\n                   refreshMember();\r\n\r\n\r\n                   $(\"#appointmentmethodDiv\").addClass(\"required\");\r\n                   $(\"#appointmentmethodDiv\").removeClass(\"hidden\");\r\n                   $(\"#appointmentmethod\").attr(\"required\" , true);\r\n                   $(\"#appointmentmethod\").val('1');\r\n                   $(\"#appointmentmethod\").trigger('change');\r\n                   \r\n                   $(\"#appointmentmethodDetails1\").removeClass(\"hidden\");\r\n                   \r\n              }\r\n\r\n          }\r\n        });\r\n\r\n        $(\"#members\").change(function () {\r\n           refreshMember();\r\n        });\r\n\r\n        $('#datefrom').change(function () {\r\n            clearPrevious();\r\n            //setPeriodslot();\r\n        });\r\n\r\n        $('#type').change(function () {\r\n            let vpm = $('#vpm').val();\r\n            if(vpm !== undefined && vpm !== '' && vpm === 'true'){\r\n                let type = $(\"#type\").val();\r\n                console.log(\"type\" + type)\r\n                let gp_nat = $(\"#gp_nationality\").val();\r\n                console.log(\"gp_nat \" + gp_nat);\r\n\r\n                // if(type === undefined && type !== ''){\r\n                if (type === '2') {\r\n                    $(\"#travelpurposesDiv\").removeClass(\"hidden\");\r\n                    $(\"#travelpurposesDiv\").addClass(\"required\");\r\n                    $(\"#gp_nationality\").addClass(\"required\");\r\n                    $(\"#gp_nationality\").attr(\"required\",true);\r\n\r\n                }else{\r\n                    $(\"#travelpurposesDiv\").addClass(\"hidden\");\r\n                    $(\"#travelpurposesDiv\").removeClass(\"required\");\r\n                    $(\"#gp_nationality\").attr(\"required\",false);\r\n\r\n                }\r\n                clearPrevious();\r\n            }else{\r\n                clearPrevious();\r\n\r\n            }\r\n\r\n           // setPeriodslot();\r\n        });\r\n\r\n        $('#appointmentmethod').change(function () {\r\n           clearPrevious();\r\n           let appointmentmethod = $(\"#appointmentmethod\").val();\r\n           if (appointmentmethod !== undefined && appointmentmethod !== ''){\r\n             for (var i=1; i<=4; i++){\r\n              $(\"#appointmentmethodDetails\"+i).addClass(\"hidden\");\r\n             }\r\n             $(\"#appointmentmethodDetails\"+appointmentmethod).removeClass(\"hidden\");\r\n           }\r\n           // setPeriodslot();\r\n        });\r\n\r\n\r\n        $(\"#travelpurposes\").change(function (){\r\n            let travelpurposes = $(\"#travelpurposes\").val();\r\n            if(travelpurposes === '11'){\r\n                var clearDropDown = document.getElementById('travelpurposes');\r\n                clearDropDown.innerHTML = '';\r\n\r\n                $.ajax({\r\n                    type: 'GET',\r\n                    url: \"/api/v1/periodslot/travelpurposes\",\r\n                    processData: false,\r\n                    contentType: false\r\n                }).done(function (data, textStatus, jqXHR) {\r\n                    if (textStatus.toUpperCase() == \"SUCCESS\" && data.code.toUpperCase() === \"SUCCESS\") {\r\n\r\n                        var newOptions = [];\r\n                        for(let i = 0 ; i < data.returnobject.length; i++){\r\n                            let tmp =  {value : data.returnobject[i].id,text:data.returnobject[i].name}\r\n                            newOptions.push(tmp);\r\n                        }\r\n                        newOptions.forEach(function (option){\r\n                            var newOption = document.createElement(\"option\");\r\n                            newOption.value = option.value;\r\n                            newOption.text = option.text;\r\n                            clearDropDown.appendChild(newOption);\r\n                        });\r\n\r\n                    }else{\r\n                        alertify.error(data.message);\r\n                    }\r\n                }).error(function (data, textStatus, jqXHR) {\r\n                    alertify.error(data.message);\r\n                });\r\n            }\r\n        });\r\n\r\n   }\r\n\r\n   function refreshMember(){\r\n       //clear previous\r\n        $(\"div[id^='t_']\" ).removeClass(\"appointment_slot_selected\");\r\n\r\n        clearPrevious();\r\n\r\n        let members = $(\"#members\").val();\r\n\r\n        if (members!==0 && members !== undefined && members !== '') {\r\n            // Start CRUDer\r\n            $(\"body\").addClass('loading');\r\n\r\n            var membersCount = parseInt(members);\r\n            var rowCount = $('#groupBody tr').length -1; //minus hidden\r\n\r\n            if (rowCount<membersCount){\r\n                $(\"#members\").off('change');\r\n                for (var i=rowCount+1;i<=membersCount;i++){\r\n\r\n                    $(\"#secondTr\")\r\n                        .clone()\r\n                        .attr({\"id\":\"cloned\"+i})\r\n                        .appendTo(\"#groupBody\");\r\n\r\n                    $(\"#cloned\"+i).removeClass(\"hidden\");\r\n                    $(\"#cloned\"+i).addClass(\"form-item\");\r\n                    $(\"#cloned\"+i).find(\"td input:text\").each(function() {\r\n                        if ($(this).attr(\"id\")!=='ex_traveldocumentvaliduntil'){\r\n                            $(this).attr(\"required\", true);\r\n                        }\r\n                    });\r\n                    $(\"#cloned\"+i).find(\"select\").each(function() {\r\n                        if ($(this).attr(\"id\")!=='ex_gender' &&\r\n                                $(this).attr(\"id\")!=='ex_nationality'){\r\n                            $(this).attr(\"required\", true);\r\n                        }\r\n\r\n                    });\r\n\r\n                    $(\"#cloned\"+i).find('.select2').remove();\r\n                    enableDatePicker(\"cloned\"+i, i);\r\n                }\r\n                enableSelect2();\r\n                $(\"#members\").change(function () {\r\n                    refreshMember();\r\n                })\r\n\r\n            }else{\r\n                for (var i=rowCount;i>membersCount;i--){\r\n                    $('#cloned'+i).remove();\r\n                }\r\n            }\r\n            $('body').removeClass('loading');\r\n\r\n        }\r\n   }\r\n\r\n\r\n\r\n   function enableDatePicker(name, i){\r\n\r\n        $('#'+name).find('.datepicker').each(function() {\r\n\r\n            $(this).removeClass('hasDatepicker');\r\n\r\n            if ($(this).attr(\"id\") === 'ex_dateofbirth'){\r\n                $(this).on('change', ubi.checkDateIsInPastIncludingNow);\r\n            }else{\r\n                if ($(this).attr(\"id\") === 'ex_traveldocumentvaliduntil'){\r\n                    $(this).on('change', ubi.checkDateIsInFutureExcludingNow);\r\n                }\r\n            }\r\n\r\n\r\n            let newID = $(this).attr(\"id\")+i;\r\n            $(this).attr({\"id\": newID});\r\n\r\n            $(this).datepicker({\r\n                dateFormat: 'dd/mm/yy',\r\n                locale: 'en',\r\n                changeYear: true,\r\n                changeMonth: true,\r\n                todayHighlight: true,\r\n                yearRange: '1910:2040',\r\n                endDate: new Date(),\r\n                beforeShowDay: function (date) {\r\n                    var $this = $(this);\r\n                    if (!$this.hasClass('lock-before-today') && !$this.hasClass('enable-today')) {\r\n                        var doNothing = true;\r\n                        return [doNothing];\r\n                    }\r\n\r\n                    let afterdays = $this.attr(\"afterdays\");\r\n                    if (afterdays === undefined || afterdays === '') {\r\n                        afterdays = 0;\r\n                    }              \r\n                    var datepickerString = jQuery.datepicker.formatDate('yy-mm-dd', date);\r\n                    var datepickerDate = new Date(datepickerString);\r\n                    var today = new Date();        \r\n                    if ($this.hasClass('enable-today')){\r\n                        today.setDate(today.getDate() - 1); \r\n                    }\r\n                    today.setDate(today.getDate() + parseInt(afterdays));\r\n                    var isGreaterThanToday = datepickerDate.getTime() > today;\r\n                    return [isGreaterThanToday];\r\n                },\r\n                onClose: function () {\r\n                    var $this = $(this);\r\n                    $this.parsley().validate();\r\n\r\n                    // statically added error\r\n                    if ($this.hasClass('benderr')) {\r\n                        $this.parsley().removeError(this.id);\r\n                        $this.removeClass('benderr');\r\n                        ubi.var.showErrorsOnTabs();\r\n                    }\r\n                }\r\n            });\r\n\r\n        });\r\n\r\n   }//EoM\r\n\r\n\r\n   function clearPrevious(){\r\n        //reset previous values\r\n        $(\"div[id^='t_']\" ).removeClass(\"appointment_slot_selected\");\r\n        $(\"#selectedtime\").val('');\r\n        $(\"#selectedTimeMsg\").html('');\r\n       // $(\"#periodslotid\").val('');\r\n\r\n        $(\"#gp_periodslotid\").val('');\r\n        $(\"input[id^='ex_periodslotid']\" ).val('');\r\n        $(\"#gp_time\").html('');\r\n        $(\"#gp_time\").removeClass(\"appointment_slot\").removeClass(\"appointment_slot_reserved\");\r\n        $(\"span[id^='ex_time']\").html('');\r\n        $(\"span[id^='ex_time']\").removeClass(\"appointment_slot\").removeClass(\"appointment_slot_reserved\");\r\n\r\n        if (!$(\"#resultMessage\").hasClass('hidden')){\r\n            $(\"#resultMessage\").addClass('hidden');\r\n        }\r\n        $(\"#result\").remove();\r\n        if (!$(\"#appointment_box\").hasClass('hidden')){\r\n            $(\"#appointment_box\").addClass('hidden');\r\n        }\r\n\r\n   }\r\n\r\n   function getMembers(){\r\n       let bookingfor = $(\"#bookingfor\").val();\r\n       if (bookingfor === '0'){\r\n            return 1;\r\n        }\r\n       if ($(\"#id\").val() !== 0 && $(\"#id\").val() !== undefined && $(\"#id\").val() !== ''){\r\n           return 1;\r\n       }\r\n       return $(\"#members\").val();\r\n   }\r\n\r\n\r\n\r\n\r\n\r\n\r\n   function checkIfAnApplicantAreUnder12() {\r\n        var dateOfBirthValues = [];\r\n        $('input[name=\"applicants[][dateofbirth]\"]').each(function() {\r\n            dateOfBirthValues.push($(this).val());\r\n        });\r\n\r\n       var nowDate = new Date();\r\n\r\n       let datescounter = 0;\r\n       for(let i = 0; i < dateOfBirthValues.length; i++){\r\n           let age = dateDiffInYears(createDateFromInput(dateOfBirthValues[i]), nowDate);//nowplus90);\r\n           let isLessThan12 = isAgeLessThan12(createDateFromInput(dateOfBirthValues[i]), nowDate, age); //nowplus90\r\n           if(isLessThan12){\r\n               datescounter++;\r\n           }\r\n       }\r\n\r\n       console.log(\"datescounter:  \" + datescounter);\r\n       if(datescounter === 0){\r\n           return 0;\r\n       }else{\r\n           return datescounter;\r\n       }\r\n\r\n    }\r\n\r\n    function dateDiffInYears(dateold, datenew) {\r\n        var ynew = datenew.getFullYear();\r\n        var mnew = datenew.getMonth();\r\n        var dnew = datenew.getDate();\r\n        var yold = dateold.getFullYear();\r\n        var mold = dateold.getMonth();\r\n        var dold = dateold.getDate();\r\n        var diff = ynew - yold;\r\n        if (mold > mnew)\r\n            diff--;\r\n        else {\r\n            if (mold === mnew) {\r\n                if (dold > dnew)\r\n                    diff--;\r\n            }\r\n        }\r\n        return diff;\r\n    }//EoM\r\n\r\n    function addDays(date, days) {\r\n        var result = new Date(date);\r\n        result.setDate(result.getDate() + days);\r\n        return result;\r\n    }//EoM\r\n\r\n    //na dw an mporw na xrhsimopoihsw ayto\r\n    function isAgeLessThan12(dateold, datenew, age) {\r\n        if (age < 12){\r\n            return true;\r\n        }\r\n        if (age > 12){\r\n            return false;\r\n        }\r\n\r\n        var ynew = datenew.getFullYear();\r\n        var mnew = datenew.getMonth();\r\n        var dnew = datenew.getDate();\r\n        var yold = dateold.getFullYear();\r\n\r\n        var mold = dateold.getMonth();\r\n        var dold = dateold.getDate();\r\n\r\n        if (mold > mnew)\r\n            return true;\r\n        else {\r\n            if (mold === mnew) {\r\n                if (dold >= dnew)\r\n                    return true;\r\n\r\n            }\r\n        }\r\n        return false;\r\n    }//EoM\r\n\r\n\r\n    function createDateFromInput(input) {\r\n        var s = input.split('/'); //split Date of birth dd/MM/yyyy  Days = s[0] | Months = s[1] | Years = s[2]\r\n        //he ISO 8601 syntax (YYYY-MM-DD)\r\n        var newDateofFieldFormat = s[2] + '-' + s[1] + '-' + s[0];\r\n        var dateoffieldDate = new Date(newDateofFieldFormat);\r\n        dateoffieldDate.setHours(0, 0, 0, 0);\r\n        return dateoffieldDate;\r\n    }//EoM\r\n\r\n\r\n\r\n\r\n   function setPeriodslot(){\r\n        clearPrevious();\r\n\r\n        let selectedDate = $('#datefrom').val();\r\n        let type = $('#type').val();\r\n        let bookingfor = $(\"#bookingfor\").val();\r\n        let members = $(\"#members\").val();\r\n        let appointmentmethod = $(\"#appointmentmethod\").val();\r\n        let appointmentEditId = $('h3[data-name=\"appointmentEditId\"]');\r\n        let extractedAppointmentEditId = appointmentEditId.text().split(\" \")[1];\r\n        let travelpurposes = $(\"#travelpurposes\").val();\r\n        let datesofbirth = \"\";\r\n        console.log(\"travelpurposes : \" + travelpurposes);\r\n\r\n        console.log(extractedAppointmentEditId);\r\n\r\n        // let gp_dateofbirth = $(\"#gp_dateofbirth\").val();\r\n        // console.log(\"gp_dateofbirth\" + gp_dateofbirth);\r\n\r\n\r\n        $('#selectedDateMsg').html(selectedDate);\r\n\r\n        if (selectedDate !== 0 && selectedDate !== undefined && selectedDate !== ''&&\r\n            type !== undefined && type !== ''&&\r\n            bookingfor !== undefined && bookingfor !== ''&&\r\n            members !== undefined && members !== ''&&\r\n            appointmentmethod !== undefined && appointmentmethod !== '') {\r\n\r\n            let id = 0;\r\n            if ($(\"#id\").val() !== undefined && $(\"#id\").val()  !== '') {\r\n                id = $(\"#id\").val();\r\n            }\r\n            members = getMembers();\r\n            /*if (bookingfor === '0'){\r\n                members = 1;\r\n            }*/\r\n            enableTabEvents();\r\n\r\n\r\n\r\n            let howmanyapplicantsareunder12 = checkIfAnApplicantAreUnder12();\r\n\r\n            if(travelpurposes === ''){\r\n                // console.log(\"travelpurpose should be -1\");\r\n                travelpurposes = \"-1\";\r\n            }\r\n\r\n            var jsonData = '{\"datefrom\": \"'+selectedDate+'\" ,'+\r\n                           ' \"type\": '+type+ ','+\r\n                           ' \"bookingfor\": '+bookingfor+ ','+\r\n                           ' \"members\": '+members+ ','+\r\n                           ' \"method\": '+appointmentmethod+ ','+\r\n                           ' \"travelpurposes\": '+travelpurposes+ ','+\r\n                           ' \"howmanyapplicantsareunder12\": '+howmanyapplicantsareunder12+ ','+\r\n                           ' \"appointmentId\": \"'+extractedAppointmentEditId+'\"  ,'+\r\n                           ' \"id\": '+id;\r\n\r\n            console.log(jsonData);\r\n\r\n            if ($(\"#vac\").val() !== undefined && $(\"#vac\").val()  !== '') {\r\n                jsonData += ',\"vac\": {\"id\": '+ $(\"#vac\").val() +'}';\r\n            }\r\n\r\n            jsonData += '}';\r\n\r\n\r\n            console.log(\"jsondata\" + jsonData);\r\n\r\n            var ajaxOptions = {\r\n                url: \"/api/v1/periodslot/slots\",\r\n                type: \"PUT\"\r\n            };\r\n            ajaxOptions.data = jsonData;\r\n            ajaxOptions.contentType = \"application/json; charset=utf-8\";\r\n\r\n            ubi.loader.blocking.start();\r\n            $.ajax(ajaxOptions).done(function (data, status, xhr) {         \r\n                if (\"SUCCESS\" === data.code) {\r\n                    var result = data.returnobject.slots;\r\n                    console.log(data.returnobject);\r\n                    if (result.length!==0){\r\n                        payment = data.returnobject.payment;\r\n                        currency = data.returnobject.currency;\r\n                        serviceAmount = data.returnobject.serviceFee;\r\n                        vasAmount = data.returnobject.vasFee;\r\n                        amount = data.returnobject.paidAmount;\r\n                        refundHours = data.returnobject.paymenthours;\r\n\r\n                        //visa payment properties\r\n                        visaamount = data.returnobject.visapaidAmount;\r\n                        visapayment = data.returnobject.visapayment;\r\n                        visacurrency = data.returnobject.visacurrency;\r\n                        visarefundHours = data.returnobject.visapaymenthours;\r\n                        visafeeAmount = data.returnobject.visafeeAmount;\r\n                        commission = data.returnobject.commission;\r\n\r\n                        console.log(\"visaamount: \" + visaamount + \" visapayment:\" + visapayment +  \" visacurrency:\" + visacurrency + \" visarefundHours:\" + visarefundHours + \" visafeeAmount:\" + visafeeAmount + \" commission:\" + commission) ;\r\n\r\n                        createAppointments(result);\r\n                    }else{\r\n                        $(\"#resultMessage\").removeClass('hidden');\r\n                        $(\"#result\").remove();\r\n                    }\r\n\r\n                } else {\r\n                    alertify.error(data.message);\r\n                }\r\n                ubi.loader.blocking.stop();\r\n            });\r\n        } else {\r\n            alertify.error(\"Error communicating with server\");\r\n        }\r\n   }\r\n\r\n   function createAppointments(data){\r\n       var result = '';\r\n       var count = 0;\r\n       var row = '';\r\n       var hidden = '';\r\n       var availableSlots = 0;\r\n       data.forEach(function (slot) {\r\n           availableSlots += slot.numofavailableslots;\r\n           \r\n            if (slot.isavailable && slot.isselectable){\r\n                let related = '';\r\n                if (slot.related){\r\n                    slot.related.forEach(function (relatedID) {                      \r\n                        if (related!==''){\r\n                            related += ';';\r\n                        }\r\n                        related += relatedID.id;\r\n                        //add hidden objects for related\r\n                        hidden += '<input type=\"hidden\" id=\"rel_'+slot.id+'_'+relatedID.id+'\" value=\"'+relatedID.value+'\">';\r\n                    });\r\n                }\r\n                row +=   '<td> '\r\n                        +'    <div id=\"t_'+slot.id+'\" related-data=\"'+related+'\" slot-time=\"'+slot.starttime+'\" class=\"appointment_slot appointment_slot_enabled\" onclick=\"selectTime('+slot.id+', \\''+slot.starttime+'\\')\">'+slot.starttime+'</div>'\r\n                        +'</td>';\r\n            }else if (slot.isavailable && !slot.isselectable){\r\n                row +=   '<td> '\r\n                        +'    <div id=\"t_'+slot.id+'\" slot-time=\"'+slot.starttime+'\" class=\"appointment_slot appointment_slot_notselectable\">'+slot.starttime+'</div>'\r\n                        +'</td>';\r\n            }else{              \r\n                row +=   '<td> '\r\n                        +'    <div slot-time=\"'+slot.starttime+'\" class=\"appointment_slot appointment_slot_disabled\">'+slot.starttime+'</div>'\r\n                        +'</td>';\r\n            }\r\n\r\n\r\n\r\n            count++;\r\n            if (count==4){\r\n                result += '<tr>'+row+'</tr>';\r\n                count = 0;\r\n                row = '';\r\n            }\r\n        });\r\n       \r\n        for (let i=count;i<4;i++){\r\n            row += '<td></td>';\r\n        }\r\n        if (row!==''){\r\n            result += '<tr>'+row+'</tr>';\r\n        }\r\n        result = '<table style=\"border: 0px\" id=\"result\">'+result +hidden+ '</table>';\r\n\r\n        if (!$(\"#resultMessage\").hasClass('hidden')){\r\n            $(\"#resultMessage\").addClass('hidden');\r\n        }\r\n        $(\"#result\").remove();\r\n        $(\"#resultDiv\").append(result);\r\n        if (data.length > 0){ //availableSlots>0\r\n            $(\"#appointment_box\").removeClass('hidden');\r\n        }\r\n\r\n\r\n        //if previously selected (edit mode)\r\n        if ($('#init_selecteddate')){\r\n            let selectedDate = $('#datefrom').val();\r\n            let init_selecteddate = $('#init_selecteddate').val();\r\n            if (selectedDate === init_selecteddate){\r\n                selectTime( $('#init_periodslotid').val(), $('#init_selectedtime').val());\r\n            }\r\n        }\r\n\r\n   }\r\n\r\n\r\n   function enableTabEvents() {\r\n        let selectedDate = $('#datefrom').val();\r\n\r\n        var date = new Date(formatDate(selectedDate));\r\n\r\n        var weekday = new Array(7);\r\n        weekday[0] = \"sunday\";\r\n        weekday[1] = \"monday\";\r\n        weekday[2] = \"tuesday\";\r\n        weekday[3] = \"wednesday\";\r\n        weekday[4] = \"thursday\";\r\n        weekday[5] = \"friday\";\r\n        weekday[6] = \"saturday\";\r\n\r\n        var tabName = weekday[date.getDay()];\r\n        var activeTab = $('#tab-'+tabName);\r\n\r\n        if (activeTab.hasClass('active'))\r\n            return false;\r\n\r\n        $('#form-tabs li').removeClass('active');\r\n        activeTab.addClass('active');\r\n\r\n    }\r\n\r\n\r\n    function formatDate(input){\r\n        var s = input.split('/'); //split Date of birth dd/MM/yyyy  Days = s[0] | Months = s[1] | Years = s[2]\r\n        //he ISO 8601 syntax (YYYY-MM-DD)\r\n        return s[2] + '-' + s[1] + '-' + s[0];\r\n    }\r\n\r\n    function selectTime(periodslotid, time){\r\n        let bookingfor = $(\"#bookingfor\").val();\r\n\r\n        if (bookingfor !== undefined && bookingfor !== '') {\r\n            let members = 1;\r\n            members = getMembers();\r\n            /*if (bookingfor === '1'){\r\n                members = $(\"#members\").val();\r\n            }*/\r\n            //is it is already selected, then unselect selection\r\n            let alreadySelected = false;\r\n            if ($(\"#t_\"+periodslotid).hasClass('appointment_slot_selected')){\r\n                alreadySelected = true;\r\n            }\r\n\r\n            let appointmentmethod = $(\"#appointmentmethod\").val(); //method\r\n\r\n            /*\r\n             * only if the mehod is 4: select one by one, the user can select\r\n             * more than one slots\r\n             */\r\n            if (appointmentmethod != 4){\r\n                members = 1;\r\n            }\r\n\r\n            //if individual ==> clear previous selection\r\n            if (members==1){\r\n                $(\"div[id^='t_']\" ).removeClass(\"appointment_slot_selected\");\r\n            }\r\n            let slots = getSelectedSlots();\r\n            let selectedSlots = slots.length;\r\n\r\n\r\n            if (!alreadySelected && selectedSlots<members){\r\n                $(\"#t_\"+periodslotid).addClass('appointment_slot_selected');\r\n                $(\"#selectedtime\").val(time);\r\n                //$(\"#periodslotid\").val(periodslotid);\r\n            }else if (alreadySelected){\r\n                $(\"#t_\"+periodslotid).removeClass('appointment_slot_selected');\r\n                $(\"#selectedtime\").val('');\r\n                //$(\"#periodslotid\").val('');\r\n                $(\"#selectedTimeMsg\").html('');\r\n                \r\n                //clear all previously selected\r\n                $(\"#gp_periodslotid\").val('');\r\n                $(\"input[id^='ex_periodslotid']\").val('');\r\n                $(\"#gp_time\").html('');\r\n                $(\"#gp_time\").removeClass(\"appointment_slot\").removeClass(\"appointment_slot_reserved\");\r\n                $(\"span[id^='ex_time']\").html('');\r\n                $(\"span[id^='ex_time']\").removeClass(\"appointment_slot\").removeClass(\"appointment_slot_reserved\");\r\n            }\r\n\r\n           // $(\"input[id^='periodslotid']\" ).remove();\r\n            slots = getSelectedSlots();\r\n            let html = \"\";\r\n            let times = \"\";\r\n            //for (let i=0;i<slots.length;i++)\r\n            if (slots.length>0){\r\n                let slot = slots[0];\r\n               /* html += '<input type=\"hidden\" name=\"periodslotid[]\" id=\"periodslotid\" value=\"'+slot+'\"/>';\r\n                if (times !== ''){\r\n                    times += \", \";\r\n                }\r\n                times += $(\"#t_\"+slot).html();*/\r\n\r\n                $(\"#gp_time\").html($(\"#t_\"+slot).html());\r\n                $(\"#gp_time\").addClass(\"appointment_slot\").addClass(\"appointment_slot_reserved\");\r\n                $(\"#gp_periodslotid\").val(slot);\r\n\r\n                if (times !== ''){\r\n                    times += \", \";\r\n                }\r\n                times += $(\"#t_\"+slot).attr(\"slot-time\");\r\n\r\n                //if not one by one then auto select the related slots\r\n                if (bookingfor === '1'){\r\n                    let related = $(\"#t_\"+slot).attr(\"related-data\");\r\n                    let relatedData = related.split(\";\");\r\n                    if (appointmentmethod === '4'){//one by one                    \r\n                        slots.splice(0, 1);\r\n                        relatedData = slots;\r\n                    }\r\n                    for (let j=0;j<relatedData.length;j++){\r\n                        let relatedID = relatedData[j];\r\n                        //cloned starts from number 2\r\n                        $(\"#cloned\"+(j+2)).find(\"span#ex_time\").each(function() {\r\n                            if ($(\"#t_\"+relatedID).attr(\"slot-time\") !== undefined && $(\"#t_\"+relatedID).attr(\"slot-time\") !== ''){\r\n                                $(\"#t_\"+relatedID).addClass('appointment_slot_selected');\r\n                                $(this).html($(\"#t_\"+relatedID).attr(\"slot-time\"));\r\n                            }else if ($(\"#rel_\"+slot+'_'+relatedID).val() !== undefined && $(\"#rel_\"+relatedID).val() !== ''){\r\n                                $(this).html($(\"#rel_\"+slot+'_'+relatedID).val());\r\n                            }else{\r\n                                $(this).html($(\"#t_\"+slot).attr(\"slot-time\"));\r\n                            }\r\n                            $(this).addClass(\"appointment_slot\").addClass(\"appointment_slot_reserved\");\r\n\r\n                            if (times !== ''){\r\n                                times += \", \";\r\n                            }\r\n                            times += $(this).html();\r\n                        });\r\n                        $(\"#cloned\"+(j+2)).find(\"input#ex_periodslotid\").each(function() {\r\n                            $(this).val(relatedID);\r\n                        });\r\n                    }\r\n                }\r\n\r\n            }\r\n\r\n            $(\"#selectedTimeMsg\").html(times);\r\n            $(\"#selectedtime\").append(html);\r\n\r\n        }\r\n\r\n    }\r\n\r\n\r\n    function getSelectedSlots(){\r\n        var slots = new Array();\r\n        $.each($(\".appointment_slot_selected\"), function(index, elem){\r\n               slots[index] = parseInt(elem.id.replace(\"t_\", \"\"));\r\n        });\r\n        return slots;\r\n    }\r\n\r\n\r\n\r\n    function sendOTP(){\r\n\r\n        let phonenumber = $(\"#ind_phonenumber\").val();\r\n//        console.log(phonenumber);\r\n        let selectedTime = $(\"#selectedtime\").val();\r\n        let phonenumberprefix = $(\"#phonenumberprefix\").val();\r\n\r\n\r\n        if(selectedTime === ''){\r\n            alertify.error($(\"#alertmsg\").html());\r\n        }else{\r\n            $.ajax({\r\n                type: 'POST',\r\n                url: \"/api/v1/onetimepassword/sendOtpBookAppointment/\"+phonenumber+\"/\"+phonenumberprefix,\r\n                processData: false,\r\n                contentType: false\r\n            }).done(function (data, textStatus, jqXHR) {\r\n                if (textStatus.toUpperCase() == \"SUCCESS\" && data.code.toUpperCase() === \"SUCCESS\") {\r\n                    $(\"#onetimepassword-wrap\").show();\r\n                    $(\"#submitinfo\").show();\r\n                    $(\"#btn-new-appointment\").show();\r\n                    $(\"#recaptcha\").show();\r\n                    $(\"#submissionMsgCheck\").show();\r\n                    $(\"#submissiontext\").show();\r\n                    $(\"#btn-onetimepassword-wrap\").hide();\r\n                    setTimeout(function (){$(\"#btn-onetimepassword-wrap\").show()},10000 * 12); //10 seconds(milliseconds) * x to minutes\r\n                }else{\r\n                    alertify.error(data.message);\r\n                }\r\n\r\n            }).error(function (data, textStatus, jqXHR) {\r\n                alertify.error(data.message);\r\n            });\r\n        }\r\n\r\n\r\n    }\r\n\r\n    function checkAmount($this, method) {\r\n\r\n        let user = $(\"#otpuser\").val();\r\n        if(payment === true && user !== '' && user !== \"cc\"  ) {\r\n\r\n            var hours = Math.floor(refundHours / 60); // Calculate the whole number of hours\r\n            var remainingMinutes = refundHours % 60;\r\n\r\n            if(refundHours === null) {\r\n                refundHours = 0;\r\n            }\r\n            var content = `\r\n                ${ubi.getTranslationExt(\"frontend.checkamount1\")}<br><br>\r\n                ${ubi.getTranslationExt(\"frontend.checkamount3\")} ${serviceAmount} ${currency}<br>\r\n                ${ubi.getTranslationExt(\"frontend.checkamount4\")} ${vasAmount} ${currency}<br>\r\n                ${ubi.getTranslationExt(\"frontend.checkamount2\")} ${amount} ${currency}<br><br><br>\r\n                <div style='font-weight:bold;'>${ubi.getTranslationExt(\"frontend.checkamount13\")}</div><br>\r\n                <div style='font-weight:bold;'>${ubi.getTranslationExt(\"frontend.checkamount14\")}</div><br>\r\n                ${ubi.getTranslationExt(\"frontend.checkamount5\")}<br><br>\r\n                ${ubi.getTranslationExt(\"frontend.checkamount6\")}<br><br>\r\n                <div style='padding-left: 6px;'>${ubi.getTranslationExt(\"frontend.checkamount7\")}</div>\r\n                <div style='padding-left: 6px;'>${ubi.getTranslationExt(\"frontend.checkamount8\")}</div><br>\r\n                ${ubi.getTranslationExt(\"frontend.checkamount9\")}<br><br>\r\n                ${ubi.getTranslationExt(\"frontend.checkamount10\")}<br><br>\r\n                <div style='padding-left: 6px;'>${ubi.getTranslationExt(\"frontend.checkamount11\")}</div><br>\r\n                <div style='padding-left: 6px;'>${ubi.getTranslationExt(\"frontend.checkamount12\")}</div><br><br>\r\n                `;\r\n\r\n            //\r\n            // <div style='font-weight:bold;'>${ubi.getTranslationExt(\"frontend.checkamount15\")}</div><br>\r\n            //     <div style='padding-left: 6px;'> &bull;&nbsp;&nbsp;${ubi.getTranslationExt(\"frontend.checkamount16\")}</div><br>\r\n            //     <div style='padding-left: 6px;'> &bull;&nbsp;&nbsp;${ubi.getTranslationExt(\"frontend.checkamount17\")}</div><br>\r\n            //     <div style='padding-left: 6px;'> &bull;&nbsp;&nbsp;${ubi.getTranslationExt(\"frontend.checkamount18\")} ${refundHours} <div> ${ubi.getTranslationExt(\"frontend.checkamount188\")}</div><br>\r\n            //         <div style='padding-left: 4px;'> &bull;&nbsp;&nbsp;${ubi.getTranslationExt(\"frontend.checkamount19\")}</div><br><br>\r\n            //         <div style='font-weight:bold;' >${ubi.getTranslationExt(\"frontend.checkamount20\")}</div>\r\n\r\n            // Create a div to encapsulate the content with a fixed height and overflow-y: auto\r\n            var scrollableView = document.createElement('div');\r\n            scrollableView.style.maxHeight = '550px';\r\n            scrollableView.style.overflowY = 'auto';\r\n            scrollableView.innerHTML = content;\r\n\r\n             // Use the encapsulated content in the Alertify dialog\r\n            alertify.confirm(\r\n                ubi.getTranslationExt(\"frontend.paymentamount\"),\r\n                scrollableView,\r\n                function () {\r\n                    submitForm($this, method);\r\n                },\r\n                function () {\r\n                    // User clicked \"Cancel\" or \"No\"\r\n                    console.log(\"User clicked Cancel\");\r\n                }\r\n            ).set({\r\n                labels: { ok: \"Yes\", cancel: \"No\" },\r\n                reverseButtons: true,\r\n                transition: \"fade\",\r\n            });\r\n        }\r\n        else if (visapayment === true && user !== '' && user === \"cc\" ) {\r\n\r\n            console.log(\"inside visapayment\");\r\n\r\n            var hours = Math.floor(visarefundHours / 60); // Calculate the whole number of hours\r\n            var remainingMinutes = visarefundHours % 60;\r\n\r\n            if(visarefundHours === null) {\r\n                visarefundHours = 0;\r\n            }\r\n\r\n\r\n            var content = `\r\n                ${ubi.getTranslationExt(\"frontend.checkamount1\")}<br><br>\r\n                ${ubi.getTranslationExt(\"frontend.checkamount.visafee\")} ${visafeeAmount} ${visacurrency}<br>\r\n                ${ubi.getTranslationExt(\"frontend.checkamount4\")} ${vasAmount} ${currency}<br>\r\n                ${ubi.getTranslationExt(\"frontend.checkamount2\")} ${visaamount} ${visacurrency}<br><br><br>\r\n                <div style='font-weight:bold;'>${ubi.getTranslationExt(\"frontend.checkamount13\")}</div><br>\r\n                <div style='font-weight:bold;'>${ubi.getTranslationExt(\"frontend.checkamount14\")}</div><br>\r\n                ${ubi.getTranslationExt(\"frontend.checkamount5\")}<br><br>\r\n                ${ubi.getTranslationExt(\"frontend.checkamount6\")}<br><br>\r\n                <div style='padding-left: 6px;'>${ubi.getTranslationExt(\"frontend.checkamount7\")}</div>\r\n                <div style='padding-left: 6px;'>${ubi.getTranslationExt(\"frontend.checkamount8\")}</div><br>\r\n                ${ubi.getTranslationExt(\"frontend.checkamount9\")} <br><br>\r\n                ${ubi.getTranslationExt(\"frontend.checkamount10\")}<br><br>\r\n                <div style='padding-left: 6px;'>${ubi.getTranslationExt(\"frontend.checkamount11\")}</div><br>\r\n                <div style='padding-left: 6px;'>${ubi.getTranslationExt(\"frontend.checkamount12\")}</div><br><br>\r\n                `;\r\n\r\n            // Create a div to encapsulate the content with a fixed height and overflow-y: auto\r\n            var scrollableView = document.createElement('div');\r\n            scrollableView.style.maxHeight = '550px';\r\n            scrollableView.style.overflowY = 'auto';\r\n            scrollableView.innerHTML = content;\r\n\r\n            // Use the encapsulated content in the Alertify dialog\r\n            alertify.confirm(\r\n                ubi.getTranslationExt(\"frontend.paymentamount\"),\r\n                scrollableView,\r\n                function () {\r\n                    submitForm($this, method);\r\n                },\r\n                function () {\r\n                    // User clicked \"Cancel\" or \"No\"\r\n                    console.log(\"User clicked Cancel\");\r\n                }\r\n            ).set({\r\n                labels: { ok: \"Yes\", cancel: \"No\" },\r\n                reverseButtons: true,\r\n                transition: \"fade\",\r\n            });\r\n\r\n\r\n        }\r\n        else {\r\n            submitForm($this, method);\r\n        }\r\n    }\r\n\r\n    function submitForm($this, method){\r\n        //check if the time is selected\r\n        let bookingfor = $(\"#bookingfor\").val();\r\n        let members = 1;\r\n        members = getMembers();\r\n        /*if (bookingfor !== undefined && bookingfor !== '') {\r\n            if (bookingfor === '1'){\r\n                members = $(\"#members\").val();\r\n            }\r\n        }*/\r\n        /*let slots = getSelectedSlots();\r\n        let selectedSlots = slots.length;*/\r\n        let selectedSlots = 0;\r\n        if ($(\"#gp_periodslotid\").val() !== undefined && $(\"#gp_periodslotid\").val() !== ''){\r\n            selectedSlots++;\r\n        }\r\n\r\n        $('[id^=\"ex_periodslotid\"]').each(function() {\r\n               if ($(this).val() !== undefined && $(this).val() !== ''){\r\n                    selectedSlots++;\r\n                }\r\n        });\r\n\r\n\r\n        if ($(\"#selectedtime\").val() !== '' && selectedSlots==members && $('input[name=\"submitinfo\"]:checked').length > 0){\r\n           // ubi.crud[method]($this);\r\n            ubi.crud[method]($this, function (data) {\r\n                if (\"SUCCESS\" === data.code || \"INVALID\" === data.code) {\r\n                    var robj = data.returnobject;\r\n                    if ($(\"#\"+$this.id).attr('data-redirect').indexOf('stay')>= 0){\r\n                        $(\"#\"+$this.id).attr('data-redirect', '/appointments/result/' + robj);\r\n                        page('/appointments/result/' + robj);\r\n                    } else{\r\n                        page($(\"#\"+$this.id).attr('data-redirect'));\r\n                    }\r\n                }\r\n\r\n            }, {skipValidation: false}); // if true skip validation\r\n        }else if ($(\"#selectedtime\").val() === '' || selectedSlots<members){\r\n            alertify.error($(\"#alertmsg\").html());\r\n        }else{\r\n            //force to check the checkbox\r\n            var msgCheck = $(\"#submissionMsgCheck\").val();\r\n            alertify.error(msgCheck);\r\n        }\r\n\r\n    }\r\n\r\n    function selectPeriodslot($this){\r\n        //setPeriodslot();\r\n        var $this = $($this);\r\n        var formID = $this.attr('form');\r\n        var validatorResult = ubi.validator.validate(formID, setPeriodslot);\r\n        if (!validatorResult) {\r\n          logger.e(\"Please check the form fields again\");\r\n          ubi.scrollToSpecificElement('.parsley-error', 70, 500, true);\r\n          //alertify.error(\"Please check the form fields again\");\r\n          alertify.alert(\"Error\",\"Please check the form fields again\");\r\n          return false;\r\n        }\r\n    }\r\n    function loadAppointments(){\r\n\r\n    let email = $(\"#ind_email\").val();\r\n    let user = $(\"#otpuser\").val();\r\n\r\n    //check at edit appointment what kind of role has the applicant\r\n    if(user !== undefined && user !== '' && user === \"cc\"  ){\r\n            $(\"#btn-onetimepassword\").hide();\r\n            $(\"#onetimepassword\").hide();\r\n    }else{\r\n            //at create appointment you will know it from email\r\n            if (email !== 0 && email !== undefined && email !== '') {\r\n                // Country\r\n                ubi.loader.blocking.start();\r\n\r\n                //check validation user type, sms or email\r\n                $.get({\r\n                    url: \"/api/v1/country/bookappointmentype/\"+email,\r\n                    contentType: \"application/json; charset=utf-8\"\r\n                }).done(function (data, status, xhr) {\r\n                    if (\"SUCCESS\" === data.code) {\r\n                        logger.i(\"Info loaded successful\");\r\n                        var array = data.returnobject;\r\n                        for (var i = 0; i < array.length; i++) {\r\n                                var bookappointmentype = array[0].value;\r\n                                var otp = array[1].value;\r\n\r\n                                if(bookappointmentype === \"true\"&& otp === \"true\" ){\r\n                                    $(\"#btn-onetimepassword\").show();\r\n                                    $(\"#onetimepassword-wrap\").hide();\r\n                                    $(\"#submitinfo\").hide();\r\n                                    $(\"#submissionMsgCheck\").hide();\r\n                                    $(\"#submissiontext\").hide();\r\n                                    $(\"#btn-new-appointment\").hide();\r\n                                    $(\"#recaptcha\").hide();\r\n                                }else{\r\n                                    $(\"#btn-onetimepassword\").hide();\r\n                                    $(\"#onetimepassword\").hide();\r\n                                }\r\n                        }\r\n                    } else {\r\n                        alertify.error(data.message);\r\n                    }\r\n                }); //done\r\n            }\r\n    }\r\n   //if user is call center populate appointment types by vac\r\n    $(\"#vac\").change(function () {\r\n        let vac = $(\"#vac\").val();\r\n\r\n        if (vac !== 0 && vac !== undefined && vac !== '') {\r\n            // Vac\r\n            ubi.loader.blocking.start();\r\n            // send request to populate appointment type list\r\n            $.get({\r\n                url: \"/api/v1/vac/\" + vac + \"/appointmentypes\",\r\n                contentType: \"application/json; charset=utf-8\"\r\n                }).done(function (data, status, xhr) {\r\n                            if (\"SUCCESS\" === data.code) {\r\n                                console.log(\"Types loaded successful\");\r\n                                logger.i(\"Types loaded successful\");\r\n                                console.log(data);\r\n                                console.log(status);\r\n                                console.log(xhr);\r\n                                var array = data.returnobject;\r\n        //                        htmlAppointmenttypes += '<option value=\"\" text=\"\"></option>';\r\n                                var htmlAppointmenttypes = '<option value=\"\" ></option>';\r\n                                for (var i = 0; i < array.length; i++) {\r\n                                    htmlAppointmenttypes += '<option value=\"' + array[i] +'\">'\r\n                                    + ubi.getTranslationExt(\"frontend.message.period.type.\"+array[i])\r\n                                    + '</option>';\r\n                                }\r\n                                $(\"#type\").html(htmlAppointmenttypes);\r\n                            } else {\r\n                                alertify.error(data.message);\r\n                            }\r\n                            ubi.loader.blocking.stop();\r\n                        });\r\n                        $('#type').val('').trigger('change');\r\n                    }\r\n                    if (vac !== 0 && vac !== undefined && vac !== '') {\r\n        //                getTimezone(vac);\r\n                    }\r\n                });\r\n      let recaptcha = $(\"#recaptcha\").val();           \r\n      if (recaptcha !== undefined) {\r\n        enableCAPTCHA();\r\n      }\r\n      onChangeSelections();\r\n    }\r\n      function confirmDelete($this) {\r\n            alertify.confirm(ubi.getTranslationExt('frontend.message.deleteappointments.title'), ubi.getTranslationExt('frontend.message.deleteappointments.message'),\r\n                function(){\r\n                  ubi.crud.post($this);\r\n                },\r\n                function(){\r\n                    alertify.alert(ubi.getTranslationExt('frontend.message.deleteappointments.title'), ubi.getTranslationExt('frontend.message.deleteappointments.cancelled'));\r\n                }\r\n            ).set({\r\n                labels: {ok: ubi.getTranslationExt('frontend.message.deleteappointments.submit'), cancel: ubi.getTranslationExt('frontend.message.deleteappointmentsdeleteappointments.cancel')},\r\n                reverseButtons: true,\r\n                transition: 'fade'\r\n            });\r\n      }\r\n\r\n      function downloadAppointmentsFile(data,textStatus,jqXHR){\r\n\r\n        var robj = data.returnobject;\r\n        var validFileName = robj.fileName;\r\n\r\n        var bucketName = \"/b/excels\";\r\n        if(robj.repository && robj.repository !== \"\" && robj.repository !== undefined){\r\n            if(robj.repository === \"-\"){\r\n                bucketName = \"/file\";\r\n//                console.log(bucketName);\r\n            }else{\r\n                bucketName = \"/b/\"+robj.repository;\r\n//                console.log(bucketName);\r\n            }\r\n        }\r\n            window.open('/download/' + validFileName + bucketName +'/' + robj.fileDownloadUri);\r\n      }\r\n\r\n\r\n    router.addRoutePost('appointments', ubi.loadDotTag);\r\n    router.addRoutePost('appointments/result/:id');\r\n    router.addRoutePost('appointments/:id', loadAppointments);\r\n\r\n    window.selectTime = selectTime;\r\n    window.checkAmount = checkAmount;\r\n    window.submitForm = submitForm;\r\n    window.selectPeriodslot = selectPeriodslot;\r\n    window.confirmDelete = confirmDelete;\r\n    window.downloadAppointmentsFile = downloadAppointmentsFile;\r\n    window.sendOTP = sendOTP;\r\n\r\n})();\r\n\r\n\n/**\n * User profile management\n */\n\n(function () {\n    'use strict';\n\n    function onUserEvents() {\n        let countryID = $(\"#country\").val();\n        let userid = $(\"#id\").val();        \n        if ((userid === 0 || userid === undefined ||  userid === '' )\n                && countryID !== 0 && countryID !== undefined && countryID !== '' ) {\n            setLanguage(countryID)\n        }\n\n        $(\"#roles\").change(function () {\n            var countryRequired = true;\n            var vacRequired = true;\n            var tagentRequired = false;\n            var callcenterRequired = false;\n            $.each($(\"#roles  option:selected\"), function(index, elem){\n                if (elem.className && elem.className === 'nocountry' ){\n                    countryRequired = false;\n                    vacRequired = false;\n                }else if (elem.className && elem.className === 'onlycountry' ){\n                    countryRequired = true;\n                    vacRequired = false;\n                }else if (elem.className && elem.className === 'tagent' ){\n                    countryRequired = true;\n                    vacRequired = true;\n                    tagentRequired = true;\n                }else if (elem.className && elem.className === 'callcenter' ){\n                    countryRequired = true;   \n                    callcenterRequired = true;\n                    vacRequired = false;\n                }\n            }); \n            $(\"#country\").attr(\"required\", countryRequired);\n            if (countryRequired){                \n                $(\"#country-wrap\").addClass(\"required\");\n            }else{\n                $(\"#country-wrap\").removeClass(\"required\");\n            }\n            $(\"#vac\").attr(\"required\", vacRequired);\n            if (vacRequired){                \n                $(\"#vac-wrap\").addClass(\"required\");\n            }else{\n                $(\"#vac-wrap\").removeClass(\"required\");\n            }\n            $(\"#travelagent\").attr(\"required\", tagentRequired);\n            if (tagentRequired){                \n                $(\"#travelagent-wrap\").addClass(\"required\");\n                $(\"#travelagent-wrap\").removeClass(\"hidden\");\n            }else{\n                $(\"#travelagent-wrap\").removeClass(\"required\");\n                $(\"#travelagent-wrap\").addClass(\"hidden\");\n            }\n            $(\"#contractor\").attr(\"required\", callcenterRequired);\n            if (callcenterRequired){                \n                $(\"#contractor-wrap\").addClass(\"required\");\n            }else{\n                $(\"#contractor-wrap\").removeClass(\"required\");\n                $(\"#contractor\").html('<option value=\"\"></option>');\n            }\n            \n        });\n\n        $(\"#vac\").change(function () {\n            let vac = $(\"#vac\").val();\n            let travelagent = $(\"#travelagent\").val();\n            \n            if (vac !== 0 && vac !== undefined && vac !== '' &&\n                    travelagent != undefined) {\n                // Vac\n                ubi.loader.blocking.start();\n\n                // send request to populate travel agents list\n                $.get({\n                    url: \"/api/v1/vac/\" + vac + \"/travelagent\",\n                    contentType: \"application/json; charset=utf-8\"\n                }).done(function (data, status, xhr) {\n                    if (\"SUCCESS\" === data.code) {\n                        logger.i(\"TAs loaded successful\");\n                        $(\"#travelagent\").removeAttr(\"disabled\");\n                        var array = data.returnobject;\n                        var htmlVar = \"\";\n                        for (var i = 0; i < array.length; i++) {\n                            htmlVar += '<option value=\"' + array[i].id + '\">'\n                                + array[i].name\n                                + '</option>';\n                        }\n                        $(\"#travelagent\").html(htmlVar);\n                    } else {\n                        alertify.error(data.message);\n                    }\n                    ubi.loader.blocking.stop();\n                });\n                $('#travelagent').val('').trigger('change');\n            }\n            \n            if (vac !== 0 && vac !== undefined && vac !== '') {\n                getTimezone(vac);\n                \n            }\n        });\n\n        $(\"#country\").change(function () {\n            let country = $(\"#country\").val();\n            if (country !== 0 && country !== undefined && country !== '') {\n                // Country\n                ubi.loader.blocking.start();\n                let apiUrl = \"/api/v1/country/\" + country + \"/vac\";                           \n                $.each($(\"#roles  option:selected\"), function(index, elem){\n                    if (elem.className && elem.className === 'cons' ){\n                        apiUrl = \"/api/v1/country/\" + country + \"/consulatevac\";                        \n                    }\n                });                \n                \n                $.get({\n                    url: apiUrl,\n                    contentType: \"application/json; charset=utf-8\"\n                }).done(function (data, status, xhr) {\n                    if (\"SUCCESS\" === data.code) {\n                        logger.i(\"Info loaded successful\");\n                        $(\"#vac\").removeAttr(\"disabled\");\n                        var array = data.returnobject;\n                        var htmlVar = \"\";\n                        htmlVar += '<option value=\"\"></option>'\n                        for (var i = 0; i < array.length; i++) {\n                            htmlVar += '<option value=\"' + array[i].id + '\">'\n                                    + array[i].name\n                                    + '</option>';\n                        }\n                        $(\"#vac\").html(htmlVar);\n                    } else {\n                        alertify.error(data.message);\n                    }\n                    ubi.loader.blocking.stop();\n                }); //done\n                //$(\"#travelagent:selected\").prop(\"selected\", false)\n\n                //$('#vac').val('').trigger(\"change\");\n\n                let travelagent = $(\"#travelagent\").val();\n                if (travelagent != undefined){\n                    ubi.loader.blocking.start();\n                    apiUrl = \"/api/v1/country/\" + country + \"/travelagent\";\n\n                    $.get({\n                        url: apiUrl,\n                        contentType: \"application/json; charset=utf-8\"\n                    }).done(function (data, status, xhr) {\n                        if (\"SUCCESS\" === data.code) {\n                            logger.i(\"Info loaded successful\");\n                            $(\"#vac\").removeAttr(\"disabled\");\n                            var array = data.returnobject;\n                            var htmlVar = \"\";\n                            htmlVar += '<option value=\"\"></option>'\n                            for (var i = 0; i < array.length; i++) {\n                                htmlVar += '<option value=\"' + array[i].id + '\">'\n                                    + array[i].name\n                                    + '</option>';\n                            }\n                            $(\"#travelagent\").html(htmlVar);\n                        } else {\n                            alertify.error(data.message);\n                        }\n                        ubi.loader.blocking.stop();\n                    }); //done*/\n                }\n\n                setLanguage(country);\n                \n                 $.each($(\"#roles  option:selected\"), function(index, elem){\n                    if (elem.className && elem.className === 'callcenter' ){\n                       setCallcenter();\n                    }\n                });\n            }\n        });\n        \n    }//EoM onChangeCountry\n    \n    \n    function setCallcenter(){\n        let country = $(\"#country\").val();\n        if (country !== 0 && country !== undefined && country !== '') {\n            // Country\n            ubi.loader.blocking.start();\n            let apiUrl = \"/api/v1/contractor/\" + country;                           \n            \n            $.get({\n                url: apiUrl,\n                contentType: \"application/json; charset=utf-8\"\n            }).done(function (data, status, xhr) {\n                if (\"SUCCESS\" === data.code) {\n                    logger.i(\"Info loaded successful\");\n                    $(\"#contractor\").removeAttr(\"disabled\");\n                    var array = data.returnobject;\n                    var htmlVar = \"\";\n                    htmlVar += '<option value=\"\"></option>'\n                    for (var i = 0; i < array.length; i++) {\n                        htmlVar += '<option value=\"' + array[i].id + '\">'\n                                + array[i].name\n                                + '</option>';\n                    }\n                    $(\"#contractor\").html(htmlVar);\n                } else {\n                    alertify.error(data.message);\n                }\n            }); //done\n\n        }\n    }\n    \n    function setLanguage(country){    \n        let selectedLanguage = $(\"#language\").val();\n        $.get({\n            url: \"/api/v1/country/\" + country + \"/languages\",\n            contentType: \"application/json; charset=utf-8\"\n        }).done(function (data, status, xhr) {            \n            if (\"SUCCESS\" === data.code) {\n                logger.i(\"Info loaded successful\");\n                $(\"#language\").removeAttr(\"disabled\");\n                var array = data.returnobject;\n                var htmlVar = \"\";\n\n                htmlVar += '<option value=\"\"></option>'\n                for (var i = 0; i < array.length; i++) {\n                    htmlVar += '<option value=\"' + array[i].id + '\">'\n                            + array[i].value\n                            + '</option>';\n                }\n                $(\"#language\").html(htmlVar);\n                if (selectedLanguage != undefined){\n                    $(\"#language\").val(selectedLanguage);\n                    $(\"#language\").trigger();\n                }\n\n            } else {\n                alertify.error(data.message);\n            }\n        }); //done\n    }\n    \n    function getTimezone(vac){\n        // get the related timezone\n        $.get({\n            url: \"/api/v1/vac/\" + vac + \"/timezone\",\n            contentType: \"application/json; charset=utf-8\"\n        }).done(function (data, status, xhr) {\n            if (\"SUCCESS\" === data.code) {                \n                logger.i(\"TAs loaded successful\");\n                $(\"#timezone\").val(data.returnobject).trigger('change');;\n                \n            } else {\n                alertify.error(data.message);\n            }\n            ubi.loader.blocking.stop();\n        });\n    }\n                \n    function loadSearch() {\n                \n        $(\"#country\").change(function () {\n            varcommon.loadVacByCountry();\n        });        \n        \n    }//EoM loadSearch\n\n    function updateUserProfileHandler($this) {               \n        ubi.crud[\"post\"]($this, function (data) {\n            if (\"SUCCESS\" === data.code) {\n                $(\"#\"+$this.id).attr(\"data-submit\", \"/user/logout\");\n                console.log(\"logout\");\n                console.log($(\"#\"+$this.id).attr(\"data-submit\"));\n                ubi.logout($(\"#\"+$this.id));\n            }\n\n        }, {skipValidation: false}); // if true skip validation\n    }//EoM updateUserProfileHandler\n    \n    function changePassword() {\n        setTimeout(function () {\n            $(\"#btn-pass\").attr(\"data-submit\", \"/api/v1/user/logout\");\n            $(\"#btn-pass\").attr(\"data-redirect\", \"stay\");\n            \n            var ajaxOptions = {\n                url: \"/api/v1/user/logout\",\n                type: 'post'\n              };\n\n            ajaxOptions.contentType = \"application/json; charset=utf-8\";\n            \n            $.ajax(ajaxOptions).done(function (data, textStatus, jqXHR) {\n                    ubi.removeAccess();\n                    ubi.goHome();\n\n            });\n        }, 2000);\n            \n    }//EoM changePassword\n    \n    function saveprofile($this){\n        if ($($this).attr(\"profile\") !== undefined && $($this).attr(\"profile\") === \"true\" ) {            \n            ubi.crud.put($this, changeLang);           \n        }else{\n            ubi.crud.put($this);\n        }\n    }\n    \n    function changeLang(){\n        let locale = \"en_US\";\n        let language = $(\"#language\").val();\n        switch (language){\n            case \"en\": \n                locale = \"en_US\";\n                break;\n            case \"ru\": \n                locale = \"ru_RU\";\n                break;\n            case \"am\": \n                locale = \"am_AM\";\n                break;\n            case \"cn\": \n                locale = \"cn_CN\";\n                break;\n            case \"ar\": \n                locale = \"ar\";\n                break;\n            case \"ku\": \n                locale = \"ku\";\n                break;\n            case \"sr\": \n                locale = \"sr\";\n                break;\n            case \"sq\": \n                locale = \"sq\";\n                break;                        \n            case \"in\":\n                locale = \"in\";\n                break;\n            default:\n                locale = \"en_US\";\n        }\n        var value = $(\".lang-selector[data-lang='\"+locale+\"']\");\n        if (value !== undefined) {\n            value.click();\n        }\n    }\n    \n    function exportUsers($this){\n        \n    }\n    \n    function downloadUsersFile(data, textStatus, jqXHR){        \n        var robj = data.returnobject;\n        var validFileName = robj.fileName;\n        var bucketName = \"/b/excels\";\n        if (robj.repository && robj.repository !== \"\" && robj.repository !== undefined){                                    \n            if (robj.repository === \"-\"){\n                bucketName = \"/file\";\n            }else{\n                bucketName = \"/b/\"+ robj.repository;\n            }\n        }\n        window.open('/download/' + validFileName + bucketName+'/' + robj.fileDownloadUri);\n        \n    }\n    \n    router.addRoutePost('user/changepassword');\n    router.addRoutePost('user', loadSearch);\n    router.addRoutePost('user/:id', onUserEvents);\n\n    window.updateUserProfileHandler  = updateUserProfileHandler;\n    window.changePassword  = changePassword ;\n    window.saveprofile = saveprofile;\n    window.downloadUsersFile = downloadUsersFile;    \n\n})();\n\n/**\n * User profile management\n */\n\n(function () {\n    'use strict';\n                   \n\n    function downloadUsersFile(data, textStatus, jqXHR){        \n        var robj = data.returnobject;\n        var validFileName = robj.fileName;\n        var bucketName = \"/b/excels\";\n        if (robj.repository && robj.repository !== \"\" && robj.repository !== undefined){                                    \n            if (robj.repository === \"-\"){\n                bucketName = \"/file\";\n            }else{\n                bucketName = \"/b/\"+ robj.repository;\n            }\n        }\n        window.open('/download/' + validFileName + bucketName+'/' + robj.fileDownloadUri);\n        \n    }\n    \n    router.addRoutePost('trackuser');\n\n    window.downloadUsersFile = downloadUsersFile;    \n\n})();\n\n/**\n * User profile management\n */\n\n(function () {\n    'use strict';\n                   \n\n    function downloadVarFile(data, textStatus, jqXHR){        \n        var robj = data.returnobject;\n        var validFileName = robj.fileName;\n        var bucketName = \"/b/excels\";\n        if (robj.repository && robj.repository !== \"\" && robj.repository !== undefined){                                    \n            if (robj.repository === \"-\"){\n                bucketName = \"/file\";\n            }else{\n                bucketName = \"/b/\"+ robj.repository;\n            }\n        }\n        window.open('/download/' + validFileName + bucketName+'/' + robj.fileDownloadUri);\n        \n    }\n    \n    router.addRoutePost('trackvar');\n\n    window.downloadVarFile = downloadVarFile;    \n\n})();\n\n\n/**\n * Define notification crawl routing pages\n */\n\n(function () {\n\n    'use strict';\n\n    router.addRoutePost('booking-reference');\n\n})();\n\n/**\n * Define notification crawl routing pages\n */\n\n(function () {\n\n    'use strict';\n    \n    \n    function fileencryption(data, textStatus, jqXHR){        \n        var robj = data.returnobject;\n        var validFileName = robj.fileName;\n        var bucketName = \"/b/excels\";\n        if (robj.repository && robj.repository !== \"\" && robj.repository !== undefined){                                    \n            if (robj.repository === \"-\"){\n                bucketName = \"/file\";\n            }else{\n                bucketName = \"/b/\"+ robj.repository;\n            }\n        }\n        window.open('/download/' + validFileName + bucketName+'/' + robj.fileDownloadUri);\n        \n    }\n    \n    router.addRoutePost('fileencryption');\n    router.addRoutePost('fileencryptionresult');\n\n    window.fileencryption = fileencryption;\n})();\n(function () {\n\n    'use strict';\n\n    router.addRoutePost('emailtemplate');\n    router.addRoutePost('emailtemplate/add');\n    router.addRoutePost('emailtemplate/:id');\n\n})();\n/**\n * Define city routing pages\n */\n\n(function () {\n\n  'use strict';\n  \n    function changestatus(data, textStatus, jqXHR){\n        if (textStatus.toUpperCase() == \"SUCCESS\" && (data == \"\" || data === undefined || data.code.toUpperCase() === \"SUCCESS\")) {        \n            $('#btn-scan').hide();\n            $('#statusDiv').css('visibility', 'hidden');\n            if (data.returnobject!=null){\n                $(\"[id^='statusview']\" ).text(data.returnobject.value);\n            }\n         //   $('#statusview').text(data.returnobject.value);\n            \n        }\n    }\n    \n    function loadSearch() {\n        $( document ).ready(function() {\n            //$(\"#application\").focus();\n            //$( \"#application\" ).focus().focus();\n            setTimeout(function() { $( \"#application\" ).focus() }, 300);\n        });\n    }//EoM loadSearch\n\n  router.addRoutePost('changestatus', loadSearch);\n  \n  window.changestatus = changestatus;\n  \n})();\n\n/**\n * Define ipblocked routing pages\n */\n\n(function () {\n\n  'use strict';\n\n  router.addRoutePost('ipblocked');\n  router.addRoutePost('ipblocked/:id');\n\n})();\n\n/**\n * Define consulate routing pages\n */\n\n(function () {\n\n  'use strict';\n\n    function loadSearch() {\n                \n        $(\"#country\").change(function () {\n            varcommon.loadVacByCountry();\n        });        \n        \n    }//EoM loadSearch\n      \n  router.addRoutePost('financialsreport', loadSearch);\n  router.addRoutePost('financialsreport/analytical', loadSearch);\n  router.addRoutePost('financialsreport/summary', loadSearch);\n\n})();\n\n/**\n * Define city routing pages\n */\n\n(function () {\n\n  'use strict';\n\n  router.addRoutePost('offline');\n  router.addRoutePost('offline/generate');\n\n})();\n\n/**\n * Define version routing pages\n */\n\n(function () {\n\n  'use strict';\n\n  router.addRoutePost('version');  \n\n})();\n\n\n/**\n * Define notification crawl routing pages\n */\n\n(function () {\n\n    'use strict';\n\n    router.addRoutePost('scaneventin');\n    router.addRoutePost('scaneventout');\n   \n    \n})();\n/**\n * Define purging routing pages\n */\n\n(function () {\n\n  'use strict';    \n\n  function confirmPurge($this) {\n    var data = $($this);\n    var formID = data.attr('form'); //TODO - Check form attribute in old browsers (check in IE11 - passed)\n    var hasForm = (formID !== undefined && formID != \"\") ? true : false;\n    var filter = \"\";\n    var statusList = $('#filterstatuslist').val();\n    var lastUpdated = $('#numoflastupdated').val();\n    if (statusList.includes('3') && lastUpdated.length !== 0) {\n        //console.log(\"status includes new \" + statusList);\n        alert(ubi.getTranslationExt('frontend.purging.new'));\n        return;\n    } else {\n        console.log(\"status does not include new\");\n    }\n    if (hasForm) {\n        // Define form\n        var $form = $('form#' + formID);\n        if ($form.length < 1) {\n          throw new TypeError(\"No form found with id='\" + formID + \"'\");\n        }\n\n        var fields = $form.serializeJSON(serializeJSON_OPTIONS);\n        var field;\n        for (field in fields) {\n          if (typeof fields[field] === 'string') {\n            fields[field] = fields[field].trim();\n            if (field === \"country\" || field === \"vac\" || field === \"filterstatus\"){\n              fields[field] = $( \"#\"+field+\" option:selected\" ).text();\n            }\n          }else if (field === \"filterstatuslist\"){              \n              var text = \"\";\n              $(\"#\"+field+\" option:selected\").each(function () {\n                var $this = $(this);\n                if ($this.length) {\n                 var selText = $this.text();\n                 if (text.length) {\n                  text += \", \";\n                 }\n                 text += selText;\n                }\n              });\n              fields[field] = \"[\"+text+\"]\";\n          }\n        }\n        filter = (JSON.stringify(fields));\n      }\n\n      alertify.confirm(ubi.getTranslationExt('frontend.message.purging.title'), ubi.getTranslationExt('frontend.message.purging.message') + \"\\n\"+filter,\n            function(){ \n              ubi.crud.post($this);\n            },\n            function(){                \n                alertify.alert(ubi.getTranslationExt('frontend.message.purging.title'), ubi.getTranslationExt('frontend.message.purging.cancelled'));\n            }\n        ).set({\n            labels: {ok: ubi.getTranslationExt('frontend.message.purging.submit'), cancel: ubi.getTranslationExt('frontend.message.purging.cancel')},           \n            reverseButtons: true,\n            transition: 'fade'\n        });\n  }\n\n  function confirmHalfPurge($this) {\n      var statusList = $('#filterstatuslist').val();\n      var lastUpdated = $('#numoflastupdated').val();\n      if (statusList.includes('3') && lastUpdated.length !== 0) {\n          //console.log(\"status includes new \" + statusList);\n          alert(ubi.getTranslationExt('frontend.purging.new'));\n          //return;\n      } else {\n          console.log(\"status does not include new\");\n          ubi.crud.post($this);\n      }\n  }\n\n  router.addRoutePost('purging'); \n  router.addRoutePost('purging/onebyone'); \n  router.addRoutePost('purging/unmask'); \n  router.addRoutePost('purging/unmask/onebyone'); \n  window.confirmPurge = confirmPurge;\n  window.confirmHalfPurge = confirmHalfPurge;\n  \n})();\n\n\n/**\n * Define notification crawl routing pages\n */\n\n(function () {\n\n    'use strict';\n\n    router.addRoutePost('passportsinvac');\n   \n    \n})();\n/**\n * Initialize router\n */\n\n(function () {\n\n  'use strict';\n\n  // Error pages\n  function error(ctx) {\n    if (\"code\" in ctx.params) {\n      switch (ctx.params.code) {\n        case \"403\":\n          $('body').removeClass('gvcw').addClass('bg-tech error');\n          $('#layout-container').html(\n            '<div id=\"logo\" onclick=\"location.replace(\\'/\\')\"><img src=\"/dist/images/logo.png\"/></div>' +\n            '<h1>Access denied!!!</h1>'\n          );\n          localStorage.removeItem(ubi.TOKEN_KEY_NAME);\n          break;\n        case \"404\":\n          $('body').removeClass('gvcw').addClass('bg-tech error');\n          $('#layout-container').html(\n            '<div id=\"logo\" onclick=\"location.replace(\\'/\\')\"><img src=\"/dist/images/logo.png\"/></div>' +\n            '<h1>Page not found!!!</h1>' +\n            '<div id=\"back\" onclick=\"ubi.goHome()\">Homepage</div>'\n        );\n          break;\n        default:\n          $('body').removeClass('gvcw').addClass('bg-tech error');\n          $('#layout-container').html(\n            '<div id=\"logo\" onclick=\"location.replace(\\'/\\')\"><img src=\"/dist/images/logo.png\"/></div>' +\n            '<h1>Unknown error occurred. Please contact the system administrator.</h1>'\n          );\n      }\n    }\n  }\n\n  // Page not found\n  function notFound(ctx) {\n    logger.e(\"Could not find pathname: \" + ctx.pathname);\n    //logger.d(\"Current state: \" + JSON.stringify(ctx));\n\n    $('body').removeClass('gvcw').addClass('bg-tech error');\n    $('#layout-container').html(\n      '<div id=\"logo\" onclick=\"location.replace(\\'/\\')\"><img src=\"/dist/images/logo.png\"/></div>' +\n      '<h1>Page not found!!!</h1>' +\n      '<div id=\"back\" onclick=\"ubi.goHome()\">Homepage</div>'\n    );\n  }\n\n  // setup error pages and then initialize\n  router.addRouteCallback('error/:code', error);\n  router.addRouteCallback('*', notFound);\n\n  router.init();\n\n})();\n\n//# sourceMappingURL=data:application/json;charset=utf8;base64,\n"
